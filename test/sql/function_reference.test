# name: test/sql/function_reference.test
# description: Public reference descriptions and examples are available to DuckDB's .manual
# group: [sql]

require miint

query TTTI
SELECT function_name, function_type, parameters[1], coalesce(length(description), 0) > 0
FROM duckdb_functions()
WHERE extension_name = 'miint'
  AND function_name IN ('read_fastx', 'parse_gff_attributes', 'prodigal_proteins')
ORDER BY function_name;
----
parse_gff_attributes	macro	kvp_string	true
prodigal_proteins	table_macro	relation	true
read_fastx	table	filename	true

query IIII
SELECT starts_with(reader.examples[1], 'SELECT * FROM ''sequences.fasta'';'),
       list_contains(reader.examples, 'SELECT * FROM read_fastx(''R1.fastq'', sequence2 = ''R2.fastq'');'),
       starts_with(scalar_macro.examples[1], 'SELECT parse_gff_attributes('),
       list_contains(table_macro.examples, 'SELECT * FROM prodigal_proteins(''genes'');')
FROM duckdb_functions() AS reader, duckdb_functions() AS scalar_macro, duckdb_functions() AS table_macro
WHERE reader.extension_name = 'miint' AND reader.function_name = 'read_fastx'
  AND scalar_macro.extension_name = 'miint' AND scalar_macro.function_name = 'parse_gff_attributes'
  AND table_macro.extension_name = 'miint' AND table_macro.function_name = 'prodigal_proteins';
----
true	true	true	true

query TII
SELECT function_name,
       starts_with(split_part(description, 'Full documentation: ', 2), 'https://')
           AND ends_with(description, section),
       NOT contains(array_to_string(examples, chr(10)), 'Full documentation: ')
FROM duckdb_functions()
JOIN (VALUES
    ('parse_gff_attributes', '/reading/#parse_gff_attributeskvp_string'),
    ('prodigal_proteins', '/gene_prediction/#writing-prodigals-fasta'),
    ('read_fastx', '/reading/#fasta-and-fastq')
) AS reference(function_name, section) USING (function_name)
WHERE extension_name = 'miint'
ORDER BY function_name;
----
parse_gff_attributes	true	true
prodigal_proteins	true	true
read_fastx	true	true

query TIIII
SELECT function_name,
       function_type = 'table' AND parameters[1] = parameter_name,
       starts_with(split_part(description, 'Full documentation: ', 2), 'https://')
           AND ends_with(description, '/reading/#' || anchor),
       starts_with(examples[1], first_example),
       option_example IS NULL OR list_contains(examples, option_example)
FROM duckdb_functions()
JOIN (VALUES
    ('read_alignment_header', 'path', 'read_alignment_headerpath',
     'SELECT tid, reference, length FROM read_alignment_header(''reads.bam'') ORDER BY tid;', NULL),
    ('read_alignments', 'filename', 'sam-and-bam',
     'SELECT * FROM ''alignments.sam'';', 'SELECT read_id, sequence, qual FROM read_alignments(''alignments.sam'', include_seq_qual = true);'),
    ('read_paf', 'filename', 'paf',
     'SELECT * FROM ''alignments.paf'';', 'SELECT * FROM read_paf(''samples/*.paf.gz'', include_filepath = true);'),
    ('read_sequences_sam', 'filename', 'read_sequences_samfilename',
     'SELECT read_id, sequence1, qual1 FROM read_sequences_sam(''reads.bam'');', 'SELECT * FROM read_sequences_sam(''samples/*.bam'', include_filepath = true);')
) AS reference(function_name, parameter_name, anchor, first_example, option_example) USING (function_name)
WHERE extension_name = 'miint'
ORDER BY function_name;
----
read_alignment_header	true	true	true	true
read_alignments	true	true	true	true
read_paf	true	true	true	true
read_sequences_sam	true	true	true	true
