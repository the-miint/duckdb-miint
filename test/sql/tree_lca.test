does not exist

# =============================================================================
# Each relation is read exactly once, at execution. The volatility sits in a column
# the read must evaluate (docs/internals/reading-tables-views.md), and it is inert.
# =============================================================================

statement ok
CREATE SEQUENCE tree_seq START 1;

statement ok
CREATE SEQUENCE pairs_seq START 1;

statement ok
CREATE VIEW ex1_volatile AS
SELECT node_index, parent_index, name, branch_length + 0 * nextval('tree_seq') AS branch_length FROM ex1;

statement ok
CREATE VIEW pairs_volatile AS SELECT concat(a, repeat('x', 0 * nextval('pairs_seq'))) AS a, b FROM ex1_pairs;

statement ok
EXPLAIN SELECT * FROM tree_lca('ex1_volatile', 'pairs_volatile');

query I
WITH got AS MATERIALIZED (SELECT * FROM tree_lca('ex1_volatile', 'pairs_volatile')),
     want AS MATERIALIZED (SELECT * FROM tree_lca('ex1', 'ex1_pairs'))
SELECT (SELECT count(*) FROM (FROM got EXCEPT ALL FROM want)) + (SELECT count(*) FROM (FROM want EXCEPT ALL FROM got));
----
0

query II
SELECT currval('tree_seq'), currval('pairs_seq');
----
10	6

# Planning reads no rows.
statement ok
CREATE VIEW boom AS SELECT CAST(error('read at planning') AS VARCHAR) AS a, b FROM ex1_pairs;

statement ok
EXPLAIN SELECT * FROM tree_lca('ex1', 'boom');

statement error
SELECT * FROM tree_lca('ex1', 'boom');
----
read at planning

# =============================================================================
# Enough pairs for several threads: every pair answered exactly once, whatever the
# thread count. A caterpillar of 5000 tips, every edge of length 1: t_0 and t_1 are
# siblings, and t_(i+1) (i >= 1) hangs off the parent of t_i's parent, so t_i and
# t_(i+1) meet at t_(i+1)'s parent, 2 apart for i = 0 and 3 apart after.
# =============================================================================

statement ok
CREATE TABLE cat_newick AS
SELECT repeat('(', 4999) || 't0:1,t1:1' || string_agg('):1,t' || i || ':1', '' ORDER BY i) || ');' AS nwk
FROM generate_series(2, 4999) AS s(i);

statement ok
COPY cat_newick TO '{TEST_DIR}/caterpillar.nwk' (FORMAT csv, HEADER false, DELIMITER E'\t');

statement ok
CREATE TABLE cat AS SELECT * FROM read_newick('{TEST_DIR}/caterpillar.nwk');

statement ok
CREATE TABLE cat_pairs AS SELECT 't' || i AS a, 't' || (i + 1) AS b FROM range(4999) AS s(i);

statement ok
SET threads = 8;

statement ok
CREATE TABLE cat_many AS SELECT * FROM tree_lca('cat', 'cat_pairs');

statement ok
SET threads = 1;

statement ok
CREATE TABLE cat_one AS SELECT * FROM tree_lca('cat', 'cat_pairs');

statement ok
RESET threads;

query II
SELECT count(*), count(DISTINCT (a, b)) FROM cat_many;
----
4999	4999

query I
SELECT (SELECT count(*) FROM (SELECT * FROM cat_many EXCEPT ALL SELECT * FROM cat_one))
     + (SELECT count(*) FROM (SELECT * FROM cat_one EXCEPT ALL SELECT * FROM cat_many));
----
0

query I
SELECT count(*) FROM cat_many r JOIN cat c ON c.name = r.b
WHERE r.lca_index IS DISTINCT FROM c.parent_index OR r.distance IS DISTINCT FROM CASE WHEN r.a = 't0' THEN 2 ELSE 3 END;
----
0

# =============================================================================
# Relation names are quoted where the SQL is built: a name that unquoted
# concatenation (the first call's pairs) or a naive "-wrap (the second call's) would
# turn into two statements reads the relation it names, and nothing else runs. Each
# name starts with a relation that exists, so either mistake gives a valid first
# statement. Reads are streamed, and a streamed read refuses a second statement, so
# the call fails; a reader that ran it would drop the victim.
# =============================================================================

statement ok
CREATE TABLE injection_victim AS SELECT 1 AS x;

statement ok
CREATE TABLE "ex1; DROP TABLE injection_victim; --" AS SELECT * FROM ex1;

statement ok
CREATE TABLE "ex1_pairs; DROP TABLE injection_victim; --" AS SELECT * FROM ex1_pairs;

statement ok
CREATE TABLE "ex1_pairs""; DROP TABLE injection_victim; --" AS SELECT * FROM ex1_pairs;

query I
SELECT count(*) FROM tree_lca('ex1; DROP TABLE injection_victim; --', 'ex1_pairs; DROP TABLE injection_victim; --');
----
6

query I
SELECT count(*) FROM tree_lca('ex1', 'ex1_pairs"; DROP TABLE injection_victim; --');
----
6

query I
SELECT count(*) FROM injection_victim;
----
1

# TEMP relations resolve as permanent ones do
# (docs/internals/reading-tables-views.md, "TEMP tables and views").
statement ok
CREATE TEMP TABLE tmp_tree AS SELECT * FROM ex1;

statement ok
CREATE TEMP VIEW tmp_pairs AS SELECT * FROM ex1_pairs;

query I
WITH got AS MATERIALIZED (SELECT * FROM tree_lca('tmp_tree', 'tmp_pairs')),
     want AS MATERIALIZED (SELECT * FROM tree_lca('ex1', 'ex1_pairs'))
SELECT (SELECT count(*) FROM (FROM got EXCEPT ALL FROM want)) + (SELECT count(*) FROM (FROM want EXCEPT ALL FROM got));
----
0
