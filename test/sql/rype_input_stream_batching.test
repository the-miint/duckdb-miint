# name: test/sql/rype_input_stream_batching.test
# description: RYpe input stream must produce identical results across Arrow batch boundaries
# group: [sql]

#
# RypeInputStream closes an Arrow record batch once its sequence payload reaches
# a byte ceiling (RYPE_ARROW_BATCH_BYTES, 256 MiB) so that peak memory stops
# scaling with the corpus (the-miint/Qiita#459). Crossing that ceiling for real
# would need a quarter-gigabyte fixture, so this file lowers it with
# `SET miint_rype_arrow_batch_bytes`.
#
# That setting exists so this file can run in EVERY lane. It was briefly an
# environment variable with a `require-env` guard, which was wrong twice over:
# require-env is for optional dependencies that may genuinely be absent (a
# runtime binary, a compile-time feature, downloaded data), not for a knob the
# extension itself owns, and the guard meant the batch-boundary invariant below
# — the load-bearing one for this whole code path — was skipped by `make test`
# and by every CI lane except the single one that runs run_tests.sh.
#
# What can break when one logical scan becomes many Arrow batches:
#
#   * Surrogate ids. Column 0 of each batch carries base + (i - from), where
#     base is the running RypeIdMap size. If the id map and the batches ever
#     fall out of lockstep, RYpe echoes back a surrogate that resolves to some
#     other read's identifier — silently, with no error, and only for reads
#     after the first boundary. That is the failure this file exists to catch,
#     and it is invisible in a single-batch run.
#   * A source DataChunk left partly consumed by the byte ceiling rather than
#     by the row ceiling — the resume path in FetchBatch.
#   * On the RYpe side, rype_classify_arrow_ex accumulating several input
#     batches into one classification pass.
#
# The invariants below are the same content-based ones as
# rype_row_id_correspondence.test: each read_id must carry the classification of
# ITS OWN sequence. Reads are engineered against data/rype/test.ryxdi in
# RY-space:
#   "two_*"   carries GGGGCCCC content -> exactly {bucket_alpha, bucket_gamma}
#   "three_*" carries ACGTACGT content -> exactly {bucket_alpha, bucket_beta, bucket_gamma}
# A mis-paired surrogate shows up as a "two_*" read carrying bucket_beta.

require miint

# 512 bytes: roughly nine reads per Arrow batch, so the 4000-read fixture below
# spans hundreds of batches.
statement ok
SET miint_rype_arrow_batch_bytes = 512;

# =============================================================================
# Fixture
# =============================================================================
# 4000 reads of 56 sequence bytes each = 224000 bytes total. Against the
# lowered ceiling this is hundreds of Arrow batches, and because 56 does not
# divide the ceiling the boundaries land mid-read-run rather than lining up
# with any chunk boundary.
#
# Interleaved so the two content classes straddle every batch boundary: if
# batching lost or shifted reads, a run of one class would inherit the other's
# buckets.

statement ok
CREATE TABLE seqs AS
SELECT
    CASE WHEN i % 2 = 0
         THEN 'two_'   || lpad((i::INTEGER)::VARCHAR, 6, '0')
         ELSE 'three_' || lpad((i::INTEGER)::VARCHAR, 6, '0')
    END AS read_id,
    CASE WHEN i % 2 = 0
         THEN repeat('GGGGCCCC', 7)
         ELSE repeat('ACGTACGT', 7)
    END AS sequence1
FROM range(0, 4000) t(i);

query II
SELECT count(*), count(DISTINCT length(sequence1)) FROM seqs;
----
4000	1

# =============================================================================
# rype_classify across many Arrow batches
# =============================================================================

statement ok
CREATE TEMP TABLE classify_run AS
SELECT * FROM rype_classify('data/rype/test.ryxdi', 'seqs', threshold := 0.05);

# The load-bearing invariant: no "two_*" read may carry bucket_beta. A surrogate
# that drifts by even one position across a batch boundary produces these.
query I
SELECT count(*) FROM classify_run WHERE read_id LIKE 'two_%' AND bucket_name = 'bucket_beta';
----
0

query I
SELECT count(*) FROM (
    SELECT read_id, list_sort(list(bucket_name)) AS buckets
    FROM classify_run WHERE read_id LIKE 'two_%' GROUP BY read_id
) WHERE buckets != ['bucket_alpha', 'bucket_gamma'];
----
0

query I
SELECT count(*) FROM (
    SELECT read_id, list_sort(list(bucket_name)) AS buckets
    FROM classify_run WHERE read_id LIKE 'three_%' GROUP BY read_id
) WHERE buckets != ['bucket_alpha', 'bucket_beta', 'bucket_gamma'];
----
0

# 2000*2 + 2000*3 = 10000. Catches reads dropped at a boundary, which the
# per-read invariants above cannot see.
query I
SELECT count(*) FROM classify_run;
----
10000

query I
SELECT count(DISTINCT read_id) FROM classify_run;
----
4000

statement ok
DROP TABLE classify_run;

# =============================================================================
# Determinism: batching must not make the result order-dependent
# =============================================================================

statement ok
CREATE TEMP TABLE run1 AS
SELECT * FROM rype_classify('data/rype/test.ryxdi', 'seqs', threshold := 0.05);

statement ok
CREATE TEMP TABLE run2 AS
SELECT * FROM rype_classify('data/rype/test.ryxdi', 'seqs', threshold := 0.05);

query I
SELECT (
    (SELECT count(*) FROM (SELECT * FROM run1 EXCEPT SELECT * FROM run2)) +
    (SELECT count(*) FROM (SELECT * FROM run2 EXCEPT SELECT * FROM run1))
);
----
0

statement ok
DROP TABLE run1;

statement ok
DROP TABLE run2;

# =============================================================================
# A single read larger than the byte ceiling must still flow
# =============================================================================
# FetchBatch forces the first row of an empty batch even when it alone exceeds
# the ceiling. Without that, the stream would return an empty batch forever and
# the query would either hang or silently return nothing.

statement ok
CREATE TABLE oversized AS SELECT * FROM (VALUES
    ('small_a', repeat('GGGGCCCC', 7)),
    ('huge',    repeat('ACGTACGT', 2000)),
    ('small_b', repeat('GGGGCCCC', 7))
) AS t(read_id, sequence1);

query I
SELECT count(DISTINCT read_id)
FROM rype_classify('data/rype/test.ryxdi', 'oversized', threshold := 0.05);
----
3

query I
SELECT count(*) FROM rype_classify('data/rype/test.ryxdi', 'oversized', threshold := 0.05)
WHERE read_id LIKE 'small_%' AND bucket_name = 'bucket_beta';
----
0

# =============================================================================
# rype_extract_minimizer_set across many Arrow batches
# =============================================================================
# Extraction has no index pass behind it, so it takes the byte ceiling with no
# RYpe-side accumulation. Reads sharing content must still share a minimizer
# set — a drifting surrogate splits one class into several distinct sets.

statement ok
CREATE TEMP TABLE extract_run AS
SELECT * FROM rype_extract_minimizer_set('seqs', 32, 10);

query I
SELECT count(*) FROM extract_run;
----
4000

query I
SELECT count(DISTINCT (fwd_set, rc_set)) FROM extract_run WHERE read_id LIKE 'two_%';
----
1

query I
SELECT count(DISTINCT (fwd_set, rc_set)) FROM extract_run WHERE read_id LIKE 'three_%';
----
1

query I
SELECT count(DISTINCT (fwd_set, rc_set)) FROM extract_run;
----
2

statement ok
DROP TABLE extract_run;

# =============================================================================
# rype_extract_strand_minimizers across many Arrow batches
# =============================================================================

statement ok
CREATE TEMP TABLE strand_run AS
SELECT * FROM rype_extract_strand_minimizers('seqs', 32, 10);

query I
SELECT count(*) FROM strand_run;
----
4000

query I
SELECT count(DISTINCT (fwd_hashes, fwd_positions, rc_hashes, rc_positions))
FROM strand_run WHERE read_id LIKE 'two_%';
----
1

query I
SELECT count(DISTINCT (fwd_hashes, fwd_positions, rc_hashes, rc_positions))
FROM strand_run;
----
2

statement ok
DROP TABLE strand_run;

# =============================================================================
# rype_log_ratio across many Arrow batches
# =============================================================================
# One row per input read, and the ratio must follow the read's own content:
#   num_*   -> +inf (numerator only)
#   denom_* -> -inf (denominator only)
# A surrogate that drifts across a batch boundary swaps these signs.

statement ok
CREATE TABLE lr_seqs AS
SELECT
    CASE WHEN i % 2 = 0
         THEN 'num_'   || lpad((i::INTEGER)::VARCHAR, 6, '0')
         ELSE 'denom_' || lpad((i::INTEGER)::VARCHAR, 6, '0')
    END AS read_id,
    CASE WHEN i % 2 = 0
         THEN repeat('GGCCTTAA', 7)
         ELSE repeat('AATTAATT', 7)
    END AS sequence1
FROM range(0, 2000) t(i);

statement ok
CREATE TEMP TABLE lr_run AS
SELECT * FROM rype_log_ratio(
    'data/rype/test_numerator.ryxdi', 'data/rype/test_denominator.ryxdi', 'lr_seqs');

query I
SELECT count(*) FROM lr_run;
----
2000

query I
SELECT count(*) FROM lr_run WHERE read_id LIKE 'num_%' AND log_ratio != 'inf'::DOUBLE;
----
0

query I
SELECT count(*) FROM lr_run WHERE read_id LIKE 'denom_%' AND log_ratio != '-inf'::DOUBLE;
----
0

statement ok
DROP TABLE lr_run;

# =============================================================================
# Every id type must survive a batch boundary
# =============================================================================
# RypeIdMap stores identifiers three different ways — an int64_t vector for
# BIGINT, a hugeint_t vector for UUID, and a byte arena plus offsets for VARCHAR
# — and AppendRange writes into whichever one applies while the Arrow batch is
# being built. The surrogate is `base + (i - from)` where base is the map's
# running size, so a boundary is exactly where a per-type bookkeeping slip
# (arena offset, validity index) would put a read's classification onto its
# neighbour's identifier. The VARCHAR sections above cover one of the three.
#
# These cases join the result back to the source row rather than reading the
# class out of the identifier, so the assertion works for an opaque id and is
# strictly stronger: it checks every read against its OWN sequence.

statement ok
CREATE TABLE seqs_bigint AS
SELECT
    i::BIGINT AS read_id,
    CASE WHEN i % 2 = 0
         THEN repeat('GGGGCCCC', 7)
         ELSE repeat('ACGTACGT', 7)
    END AS sequence1
FROM range(0, 4000) t(i);

statement ok
CREATE TEMP TABLE bigint_run AS
SELECT read_id, list_sort(list(bucket_name)) AS buckets
FROM rype_classify('data/rype/test.ryxdi', 'seqs_bigint', threshold := 0.05)
GROUP BY read_id;

query I
SELECT count(*) FROM bigint_run r JOIN seqs_bigint s USING (read_id)
WHERE r.buckets != CASE WHEN s.sequence1 = repeat('GGGGCCCC', 7)
                        THEN ['bucket_alpha', 'bucket_gamma']
                        ELSE ['bucket_alpha', 'bucket_beta', 'bucket_gamma'] END;
----
0

# The join above is vacuous if it matched nothing.
query I
SELECT count(*) FROM bigint_run r JOIN seqs_bigint s USING (read_id);
----
4000

statement ok
CREATE TABLE seqs_uuid AS
SELECT
    gen_random_uuid() AS read_id,
    CASE WHEN i % 2 = 0
         THEN repeat('GGGGCCCC', 7)
         ELSE repeat('ACGTACGT', 7)
    END AS sequence1
FROM range(0, 4000) t(i);

statement ok
CREATE TEMP TABLE uuid_run AS
SELECT read_id, list_sort(list(bucket_name)) AS buckets
FROM rype_classify('data/rype/test.ryxdi', 'seqs_uuid', threshold := 0.05)
GROUP BY read_id;

query I
SELECT count(*) FROM uuid_run r JOIN seqs_uuid s USING (read_id)
WHERE r.buckets != CASE WHEN s.sequence1 = repeat('GGGGCCCC', 7)
                        THEN ['bucket_alpha', 'bucket_gamma']
                        ELSE ['bucket_alpha', 'bucket_beta', 'bucket_gamma'] END;
----
0

query I
SELECT count(*) FROM uuid_run r JOIN seqs_uuid s USING (read_id);
----
4000

statement ok
DROP TABLE bigint_run;

statement ok
DROP TABLE uuid_run;

# =============================================================================
# A NULL identifier, past the first batch
# =============================================================================
# A NULL id is carried through the map rather than rejected. Placing it well
# beyond the first boundary checks that the map's validity bookkeeping is indexed
# the same way as the surrogates around it: a slip would move the NULL onto a
# neighbouring read, or drop a read entirely.
#
# BIGINT because its NULL is unambiguous. The two id representations differ here
# by design and rype_classify_bigint.test:81 pins the reason — a NULL id travels
# as the empty string, which the codec resolves back to SQL NULL for BIGINT and
# UUID but leaves as an empty string for VARCHAR. The VARCHAR case is asserted
# below so the divergence is stated rather than assumed.

statement ok
CREATE TABLE seqs_null_id AS
SELECT
    CASE WHEN i = 2500 THEN NULL ELSE i::BIGINT END AS read_id,
    repeat('GGGGCCCC', 7) AS sequence1
FROM range(0, 4000) t(i);

statement ok
CREATE TEMP TABLE null_id_run AS
SELECT * FROM rype_classify('data/rype/test.ryxdi', 'seqs_null_id', threshold := 0.05);

# Exactly the one NULL-identified read, carrying its own two buckets.
query II
SELECT count(*), count(DISTINCT bucket_name) FROM null_id_run WHERE read_id IS NULL;
----
2	2

query I
SELECT count(DISTINCT read_id) FROM null_id_run WHERE read_id IS NOT NULL;
----
3999

# Uniform content, so every read must land on the same two buckets — a shifted
# identifier would show up as a missing or duplicated read_id above.
query I
SELECT count(*) FROM (
    SELECT read_id, list_sort(list(bucket_name)) AS buckets
    FROM null_id_run WHERE read_id IS NOT NULL GROUP BY read_id
) WHERE buckets != ['bucket_alpha', 'bucket_gamma'];
----
0

statement ok
DROP TABLE null_id_run;

# The VARCHAR divergence, same position past the same boundary: empty string,
# not SQL NULL, and still exactly one read.

statement ok
CREATE TABLE seqs_null_varchar AS
SELECT
    CASE WHEN i = 2500 THEN NULL ELSE 'r' || lpad((i::INTEGER)::VARCHAR, 6, '0') END AS read_id,
    repeat('GGGGCCCC', 7) AS sequence1
FROM range(0, 4000) t(i);

query III
SELECT
    count(*) FILTER (WHERE read_id IS NULL),
    count(DISTINCT read_id) FILTER (WHERE read_id = ''),
    count(DISTINCT read_id)
FROM rype_classify('data/rype/test.ryxdi', 'seqs_null_varchar', threshold := 0.05);
----
0	1	4000
