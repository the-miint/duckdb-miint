# A column whose type is NULL (a literal NULL in a view) is refused too, if without its name.
statement ok
CREATE OR REPLACE VIEW bad AS SELECT * REPLACE (NULL AS position) FROM hand;

statement error
SELECT * FROM prodigal_gff_lines('bad');
----
prodigal_gff_lines: row 1 has a NULL where its line needs a value

statement ok
CREATE OR REPLACE VIEW bad AS SELECT * REPLACE (E'c\t1' AS read_id) FROM hand;

statement error
SELECT * FROM prodigal_gff_lines('bad');
----
control character

statement ok
CREATE OR REPLACE VIEW bad AS SELECT * REPLACE ('#c1' AS read_id) FROM hand;

statement error
SELECT * FROM prodigal_gff_lines('bad');
----
starts with '#'

statement ok
CREATE OR REPLACE VIEW bad AS SELECT * REPLACE ('7' AS strand) FROM hand;

statement error
SELECT * FROM prodigal_gff_lines('bad');
----
strand must be '+' or '-'

statement ok
CREATE OR REPLACE VIEW bad AS SELECT * REPLACE ('.' AS strand) FROM hand;

statement error
SELECT * FROM prodigal_gff_lines('bad');
----
strand must be '+' or '-'

statement ok
