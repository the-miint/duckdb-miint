# =============================================================================
# Labels. A tree table may carry text labels in a `label` VARCHAR column, so that `name` can keep
# an id type (VARCHAR, BIGINT or UUID). A node's Newick label is its name, or its label where the
# name is NULL or ''; a node with both a non-empty name and a non-empty label is an error, since
# Newick holds one label per node.
# =============================================================================

statement ok
COPY (SELECT node_index, parent_index, CASE WHEN is_tip THEN name END AS name, branch_length,
             CASE WHEN NOT is_tip THEN 'n' || node_index END AS label
      FROM read_newick('data/newick/simple.nwk'))
TO '{TEST_DIR}/label_internal.nwk' (FORMAT NEWICK);

query T
SELECT trim(content) FROM read_text('{TEST_DIR}/label_internal.nwk');
----
((A:0.1,B:0.2)n2:0.3,C:0.4)n4;

# read_newick reads the labels back as names: Newick has one label slot.
query T
SELECT name FROM read_newick('{TEST_DIR}/label_internal.nwk') WHERE NOT is_tip ORDER BY name;
----
n2
n4

# read_newick names an unnamed internal node '', which counts as no name.
statement ok
COPY (SELECT node_index, parent_index, name, branch_length,
             CASE WHEN NOT is_tip THEN 'n' || node_index END AS label
      FROM read_newick('data/newick/simple.nwk'))
TO '{TEST_DIR}/label_empty_name.nwk' (FORMAT NEWICK);

query T
SELECT trim(content) FROM read_text('{TEST_DIR}/label_empty_name.nwk');
----
((A:0.1,B:0.2)n2:0.3,C:0.4)n4;

# Typed tip ids and text labels in one tree.
statement ok
COPY (SELECT node_index, parent_index, CASE WHEN is_tip THEN node_index + 100 END AS name, branch_length,
             CASE WHEN NOT is_tip THEN 'n' || node_index END AS label
      FROM read_newick('data/newick/simple.nwk'))
TO '{TEST_DIR}/label_bigint_name.nwk' (FORMAT NEWICK);

query T
SELECT trim(content) FROM read_text('{TEST_DIR}/label_bigint_name.nwk');
----
((100:0.1,101:0.2)n2:0.3,103:0.4)n4;

# A taxonomy label holds spaces and ';', so it is quoted, and read back whole.
statement ok
COPY (SELECT node_index, parent_index, CASE WHEN is_tip THEN name END AS name, branch_length,
             CASE WHEN node_index = 2 THEN 'f__Enterobacteriaceae; g__Escherichia' END AS label
      FROM read_newick('data/newick/simple.nwk'))
TO '{TEST_DIR}/label_quoted.nwk' (FORMAT NEWICK);

query T
SELECT name FROM read_newick('{TEST_DIR}/label_quoted.nwk') WHERE node_index = 2;
----
f__Enterobacteriaceae; g__Escherichia

# A label of '' counts as no label.
statement ok
COPY (SELECT node_index, parent_index, name, branch_length, '' AS label
      FROM read_newick('data/newick/simple.nwk'))
TO '{TEST_DIR}/label_empty.nwk' (FORMAT NEWICK);

query T
SELECT trim(content) FROM read_text('{TEST_DIR}/label_empty.nwk');
----
((A:0.1,B:0.2):0.3,C:0.4);

# A NULL label, stored or written as a literal, is no label.
statement ok
CREATE TABLE null_label AS
SELECT node_index, parent_index, name, branch_length, CAST(NULL AS VARCHAR) AS label
FROM read_newick('data/newick/simple.nwk');

statement ok
COPY (SELECT * FROM null_label) TO '{TEST_DIR}/null_label.nwk' (FORMAT NEWICK);

query T
SELECT trim(content) FROM read_text('{TEST_DIR}/null_label.nwk');
----
((A:0.1,B:0.2):0.3,C:0.4);

statement ok
COPY (SELECT node_index, parent_index, name, branch_length, NULL AS label FROM read_newick('data/newick/simple.nwk'))
TO '{TEST_DIR}/null_literal_label.nwk' (FORMAT NEWICK);

query T
SELECT trim(content) FROM read_text('{TEST_DIR}/null_literal_label.nwk');
----
((A:0.1,B:0.2):0.3,C:0.4);

statement error
COPY (SELECT node_index, parent_index, name, branch_length, 'x' AS label
      FROM read_newick('data/newick/simple.nwk'))
TO '{TEST_DIR}/label_and_name.nwk' (FORMAT NEWICK);
----
node 0 has both a name ('A') and a label ('x')

statement error
COPY (SELECT node_index, parent_index, name, node_index::INTEGER AS label FROM read_newick('data/newick/simple.nwk'))
TO '{TEST_DIR}/integer_label.nwk' (FORMAT NEWICK);
----
Binder Error: COPY FORMAT NEWICK: column 'label' must be VARCHAR, got INTEGER

# 1500 cherries under one root, more rows than one output batch (STANDARD_VECTOR_SIZE): tips 0..2999,
# named 100000 + i; cherry k (row 3000 + k, labeled 'c' || k) holds tips 2k and 2k+1; the root (row
# 4500) is labeled 'root'. node_index is ten times the row, so a label looked up by node_index
# instead of by row would land on the wrong node.
statement ok
CREATE TABLE cherries AS
SELECT i * 10 AS node_index,
       CASE WHEN i < 3000 THEN 100000 + i END::BIGINT AS name,
       1.0::DOUBLE AS branch_length,
       CAST(NULL AS BIGINT) AS edge_id,
       (CASE WHEN i < 3000 THEN 3000 + i // 2 WHEN i < 4500 THEN 4500 END * 10)::BIGINT AS parent_index,
       CASE WHEN i >= 3000 AND i < 4500 THEN 'c' || (i - 3000) WHEN i = 4500 THEN 'root' END AS label
FROM range(4501) AS r(i);

# More rows than one batch: every chunk's labels are written, each on its own node.
statement ok
COPY (SELECT * FROM cherries) TO '{TEST_DIR}/cherries.nwk' (FORMAT NEWICK);

query II
SELECT count(*) FILTER (WHERE name LIKE 'c%'), max(name) FILTER (WHERE parent_index IS NULL)
FROM read_newick('{TEST_DIR}/cherries.nwk');
----
1500	root

query I
WITH back AS (SELECT * FROM read_newick('{TEST_DIR}/cherries.nwk'))
SELECT count(*) FROM back AS t JOIN back AS p ON t.parent_index = p.node_index
WHERE t.is_tip AND p.name IS DISTINCT FROM 'c' || ((t.name::BIGINT - 100000) // 2);
----
0
