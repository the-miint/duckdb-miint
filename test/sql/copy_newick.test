statement ok
CREATE TABLE missing_node_index AS
SELECT name, branch_length, parent_index FROM read_newick('data/newick/simple.nwk');

statement error
COPY missing_node_index TO '{TEST_DIR}/missing.nwk' (FORMAT NEWICK);
----
node_index

statement ok
DROP TABLE missing_node_index;

# Missing parent_index should error
statement ok
CREATE TABLE missing_parent AS
SELECT node_index, name, branch_length FROM read_newick('data/newick/simple.nwk');

statement error
COPY missing_parent TO '{TEST_DIR}/missing.nwk' (FORMAT NEWICK);
