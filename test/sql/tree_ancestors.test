# =============================================================================
# Each relation is read exactly once, at execution. The volatility sits in a column the
# read must evaluate (docs/internals/reading-tables-views.md), and it is inert.
# =============================================================================

statement ok
CREATE SEQUENCE tree_seq START 1;

statement ok
CREATE SEQUENCE nodes_seq START 1;

statement ok
CREATE VIEW ex1_volatile AS
SELECT node_index, parent_index, name, branch_length + 0 * nextval('tree_seq') AS branch_length FROM ex1;

statement ok
CREATE VIEW nodes_volatile AS SELECT node_index + 0 * nextval('nodes_seq') AS node_index FROM nodes_ah;

statement ok
EXPLAIN SELECT * FROM tree_ancestors('ex1_volatile', nodes_table := 'nodes_volatile');

query I
SELECT count(*) FROM (
    SELECT * FROM tree_ancestors('ex1_volatile', nodes_table := 'nodes_volatile')
    EXCEPT SELECT * FROM tree_ancestors('ex1', nodes_table := 'nodes_ah'));
----
0

query II
SELECT currval('tree_seq'), currval('nodes_seq');
----
10	2

# Planning reads no rows.
statement ok
CREATE VIEW boom AS SELECT CAST(error('read at planning') AS BIGINT) AS node_index FROM nodes_ah;

statement ok
EXPLAIN SELECT * FROM tree_ancestors('ex1', nodes_table := 'boom');

statement error
SELECT * FROM tree_ancestors('ex1', nodes_table := 'boom');
----
read at planning

# =============================================================================
# Rows stream: one node's ancestors can run past an output chunk, and the next call
# carries on where it stopped. A caterpillar of 5000 tips, every edge of length 1: t_0
# and t_1 are 4999 edges from the root and t_i (i >= 2) 5000 - i. Its first 200 tips have
# 980,299 (node, ancestor) rows in all, spread over several threads; each node has every
# edge count from 0 to its depth exactly once, at the ancestor that many levels up.
# =============================================================================

statement ok
CREATE TABLE cat_newick AS
SELECT repeat('(', 4999) || 't0:1,t1:1' || string_agg('):1,t' || i || ':1', '' ORDER BY i) || ');' AS nwk
FROM generate_series(2, 4999) AS s(i);

statement ok
COPY cat_newick TO '{TEST_DIR}/caterpillar.nwk' (FORMAT csv, HEADER false, DELIMITER E'\t');

statement ok
CREATE TABLE cat AS SELECT * FROM read_newick('{TEST_DIR}/caterpillar.nwk');

statement ok
CREATE TABLE cat_nodes AS SELECT node_index FROM cat WHERE is_tip AND CAST(substr(name, 2) AS BIGINT) < 200;

statement ok
CREATE TABLE cat_depths AS SELECT * FROM tree_node_depths('cat');

statement ok
SET threads = 8;

statement ok
CREATE TABLE cat_many AS SELECT * FROM tree_ancestors('cat', nodes_table := 'cat_nodes');

statement ok
SET threads = 1;

statement ok
CREATE TABLE cat_one AS SELECT * FROM tree_ancestors('cat', nodes_table := 'cat_nodes');

statement ok
RESET threads;

query III
SELECT count(*), count(DISTINCT (node_index, edges)),
       (SELECT sum(depth + 1) FROM cat_depths JOIN cat_nodes USING (node_index))
FROM cat_many;
----
980299	980299	980299

query I
SELECT (SELECT count(*) FROM (SELECT * FROM cat_many EXCEPT ALL SELECT * FROM cat_one))
     + (SELECT count(*) FROM (SELECT * FROM cat_one EXCEPT ALL SELECT * FROM cat_many));
----
0

query I
SELECT count(*) FROM cat_many r
JOIN cat_depths dn ON dn.node_index = r.node_index
JOIN cat_depths da ON da.node_index = r.ancestor_index
WHERE da.depth <> dn.depth - r.edges OR r.distance <> r.edges OR r.edges > dn.depth;
----
0

# =============================================================================
# Relation names are quoted where the SQL is built. nodes_table is read first: under
# unquoted concatenation the first call's, and under a naive "-wrap the second's, would
# read the nodes and then run the DROP.
# =============================================================================

statement ok
CREATE TABLE injection_victim AS SELECT 1 AS x;

statement ok
CREATE TABLE "ex1; DROP TABLE injection_victim; --" AS SELECT * FROM ex1;

statement ok
CREATE TABLE "nodes_ah; DROP TABLE injection_victim; --" AS SELECT * FROM nodes_ah;

statement ok
CREATE TABLE "nodes_ah""; DROP TABLE injection_victim; --" AS SELECT * FROM nodes_ah;

query I
SELECT count(*) FROM tree_ancestors('ex1; DROP TABLE injection_victim; --',
                                    nodes_table := 'nodes_ah; DROP TABLE injection_victim; --');
----
6

query I
SELECT count(*) FROM tree_ancestors('ex1', nodes_table := 'nodes_ah"; DROP TABLE injection_victim; --');
----
6

query I
SELECT count(*) FROM injection_victim;
----
1

# TEMP relations resolve as permanent ones do
# (docs/internals/reading-tables-views.md, "TEMP tables and views").
statement ok
CREATE TEMP TABLE tmp_tree AS SELECT * FROM ex1;

statement ok
CREATE TEMP VIEW tmp_nodes AS SELECT * FROM nodes_ah;

query I
SELECT count(*) FROM (
    SELECT * FROM tree_ancestors('tmp_tree', nodes_table := 'tmp_nodes')
    EXCEPT SELECT * FROM tree_ancestors('ex1', nodes_table := 'nodes_ah'));
----
0
