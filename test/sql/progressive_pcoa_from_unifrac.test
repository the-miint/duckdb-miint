----

# ── Per-batch quality evidence (batch, batch_anchor_m2) ──────────────────────
# Same contract as progressive_pcoa_from_distances: the approximation reports the
# procrustes disparity of the anchor-overlap fit that placed each batch, and the
# anchor rows report NULL because they define the frame rather than being fitted
# into it. Pinned here too so the two progressive functions cannot drift apart.
query I
SELECT list_contains(list(column_name), 'batch') AND list_contains(list(column_name), 'batch_anchor_m2')
FROM (DESCRIBE SELECT * FROM progressive_pcoa_from_unifrac('ft', 'tree', n_dims := 3, n_anchors := 15, batch_size := 12, seed := 42));
----
true

query II
SELECT count(*) FILTER (WHERE batch IS NULL AND batch_anchor_m2 IS NOT NULL),
       count(*) FILTER (WHERE batch IS NOT NULL AND batch_anchor_m2 IS NULL)
FROM progressive_pcoa_from_unifrac('ft', 'tree', n_dims := 3, n_anchors := 15, batch_size := 12, seed := 42);
----
0	0

# the anchors are exactly the rows with a NULL batch
query I
SELECT count(DISTINCT sample_id) FROM progressive_pcoa_from_unifrac('ft', 'tree',
    n_dims := 3, n_anchors := 15, batch_size := 12, seed := 42) WHERE batch IS NULL;
----
15

# one disparity value per batch, and it is finite (UniFrac is not Euclidean, so no
# ~0 bound is asserted here — the from_distances test pins that on an exact
# Euclidean fixture; what matters here is that the number is real and reported)
query I
SELECT bool_and(batch_anchor_m2 >= 0.0 AND isfinite(batch_anchor_m2))
FROM progressive_pcoa_from_unifrac('ft', 'tree', n_dims := 3, n_anchors := 15, batch_size := 12, seed := 42)
WHERE batch IS NOT NULL;
----
true

# ── PHYSICAL SORT ORDER IS A PERFORMANCE KNOB, NOT A SEMANTIC ONE.
#    docs/diversity.md advises storing the feature table sorted by sample_id so a
#    batch's slice query prunes to that batch's own rows instead of scanning the
#    whole sample_id column (measured 9 ms vs 33 ms per batch at 104 M rows). That
#    advice is only safe to give if layout cannot change the answer: samples are
#    enumerated with ORDER BY sample_id::VARCHAR before batching, so a shuffled
#    table must produce bit-identical coordinates. If this ever fails, the
#    enumeration has started depending on scan order and the doc advice is a bug. ──
statement ok
CREATE TABLE ft_shuffled AS SELECT * FROM ft ORDER BY hash(sample_id || feature_id);

statement ok
CREATE TABLE ft_sorted AS SELECT * FROM ft ORDER BY sample_id;

# ── TEMPORARY DIAGNOSTIC (PR #244). The exact-equality assertion further down
#    fails on linux_amd64 — all 240 rows of the symmetric difference — and does NOT
#    reproduce on macOS/arm64 at threads 1, 2, 4 or 14, so it is an fp32 summation
#    -order effect or a genuine order dependence, and the count alone cannot tell
#    which. These five brackets separate the two so the fix is chosen from data:
#      c1  do the two layouts assign samples to the SAME batches? (the semantic
#          question — enumeration is ORDER BY sample_id, so this must hold)
#      c2-c4  bracket the coordinate difference: 1e-12 / 1e-9 / 1e-6
#      c5  did the UniFrac DISTANCES themselves move? (localizes it to the compute
#          rather than to the progressive machinery)
#    c1 and c5 true with the magnitude at ~1e-12 means the exact assertion is simply
#    stricter than fp32 permits on x86 and should become a tolerance. c1 or c5 false
#    means scan order is reaching the answer, which is a real bug and the doc advice
#    in docs/diversity.md would be wrong. Remove this block with whichever fix wins. ──
query IIIII
WITH a AS (SELECT sample_id, axis, coordinate, batch
           FROM progressive_pcoa_from_unifrac('ft_sorted', 'tree', variant := 'weighted_normalized',
               n_dims := 3, n_anchors := 15, batch_size := 12, seed := 42)),
     b AS (SELECT sample_id, axis, coordinate, batch
           FROM progressive_pcoa_from_unifrac('ft_shuffled', 'tree', variant := 'weighted_normalized',
               n_dims := 3, n_anchors := 15, batch_size := 12, seed := 42)),
     j AS (SELECT a.coordinate AS ca, b.coordinate AS cb, a.batch AS ba, b.batch AS bb
           FROM a JOIN b USING (sample_id, axis)),
     d AS (SELECT coalesce(max(abs(x.distance - y.distance)), 0.0) AS dd
           FROM unifrac_distances('ft_sorted', 'tree', variant := 'weighted_normalized') x
           JOIN unifrac_distances('ft_shuffled', 'tree', variant := 'weighted_normalized') y
             USING (sample_a, sample_b))
SELECT count(*) FILTER (WHERE ba IS DISTINCT FROM bb) = 0,
       max(abs(ca - cb)) < 1e-12,
       max(abs(ca - cb)) < 1e-9,
       max(abs(ca - cb)) < 1e-6,
       (SELECT dd FROM d) < 1e-12
FROM j;
----
true	true	true	true	true

# and the same comparison the way the docs tell users to make it: as ordinations,
# through procrustes. M^2 is frame-invariant, so this is the claim that matters —
# "layout does not change the ordination" — independent of last-bit coordinate noise.
statement ok
CREATE TABLE dg_ord_sorted AS
SELECT sample_id, axis, coordinate FROM progressive_pcoa_from_unifrac('ft_sorted', 'tree',
    variant := 'weighted_normalized', n_dims := 3, n_anchors := 15, batch_size := 12, seed := 42);

statement ok
CREATE TABLE dg_ord_shuffled AS
SELECT sample_id, axis, coordinate FROM progressive_pcoa_from_unifrac('ft_shuffled', 'tree',
    variant := 'weighted_normalized', n_dims := 3, n_anchors := 15, batch_size := 12, seed := 42);

query I
SELECT max(m2) < 1e-12 FROM procrustes('dg_ord_sorted', 'dg_ord_shuffled', permutations := 0);
----
true

query I
WITH a AS (SELECT sample_id, axis, coordinate, batch, batch_anchor_m2
           FROM progressive_pcoa_from_unifrac('ft_sorted', 'tree', variant := 'weighted_normalized',
               n_dims := 3, n_anchors := 15, batch_size := 12, seed := 42)),
     b AS (SELECT sample_id, axis, coordinate, batch, batch_anchor_m2
           FROM progressive_pcoa_from_unifrac('ft_shuffled', 'tree', variant := 'weighted_normalized',
               n_dims := 3, n_anchors := 15, batch_size := 12, seed := 42))
SELECT (SELECT count(*) FROM (SELECT * FROM a EXCEPT ALL SELECT * FROM b))
     + (SELECT count(*) FROM (SELECT * FROM b EXCEPT ALL SELECT * FROM a));
----
0

# ── SHEARING MUST NOT MOVE A COORDINATE.
#    The bind shears the tree to the feature-table's features, and each block
#    shears again to that block's features, because libssu's cost scales with the
#    tree it is handed (measured 1.83 s -> 0.61 s on a 700-sample block of a
#    197,711-feature table). That is only legitimate if a tree carrying tips the
#    table never uses produces exactly the same ordination as one pruned to fit.
#    Branches leading only to unused tips are traversed by no sample, so they
#    belong to neither the numerator nor the denominator of any UniFrac distance —
#    if this test ever fails, the shear is dropping or reweighting a branch that
#    some sample does traverse, and every coordinate is suspect. ──
statement ok
CREATE TABLE tree_extra AS
SELECT * FROM tree
UNION ALL
-- extra tips as siblings of real tips under Int1 (node 2), so pruning them must
-- leave Int1 with its original two children and its original branch length
SELECT 100 + i, 'UNUSED_SIB_' || i, 0.9, NULL::BIGINT, 2, true FROM range(3) a(i)
UNION ALL
-- an entire subtree off the root containing no used tip, which must vanish whole
SELECT 200, 'UnusedInternal', 0.35, NULL::BIGINT, 8, false
UNION ALL
SELECT 300 + i, 'UNUSED_SUB_' || i, 1.1, NULL::BIGINT, 200, true FROM range(4) b(i);

# the extended tree really is bigger, and really does cover the used features
query II
SELECT (SELECT count(*) FROM tree), (SELECT count(*) FROM tree_extra);
----
9	17

query I
WITH tight AS (SELECT sample_id, axis, coordinate, batch, batch_anchor_m2
               FROM progressive_pcoa_from_unifrac('ft', 'tree', variant := 'weighted_normalized',
                   n_dims := 3, n_anchors := 15, batch_size := 12, seed := 42)),
     extra AS (SELECT sample_id, axis, coordinate, batch, batch_anchor_m2
               FROM progressive_pcoa_from_unifrac('ft', 'tree_extra', variant := 'weighted_normalized',
                   n_dims := 3, n_anchors := 15, batch_size := 12, seed := 42))
SELECT (SELECT count(*) FROM (SELECT * FROM tight EXCEPT ALL SELECT * FROM extra))
     + (SELECT count(*) FROM (SELECT * FROM extra EXCEPT ALL SELECT * FROM tight));
----
0

# Unweighted is the variant most sensitive to a spurious branch — a branch's mere
# presence enters the denominator — so pin it too. It needs its own fixture:
# every sample in `ft` carries every feature, which makes unweighted UniFrac
# identically zero (1 distinct distance) and the procrustes fit degenerate. Here
# feature f is present only when bit f of ((s % 31) + 1) is set, giving 1-5
# features per sample and 172 distinct distances.
statement ok
CREATE TABLE ft_pa AS
SELECT 's' || s AS sample_id, 'GG_OTU_' || (f + 1) AS feature_id, (1 + (s * 7 + f * 13) % 11)::DOUBLE AS value
FROM range(40) t(s), range(5) u(f) WHERE (((s % 31) + 1) >> f) & 1 = 1;

query I
SELECT count(DISTINCT distance) > 1 FROM unifrac_distances('ft_pa', 'tree', variant := 'unweighted', seed := 42);
----
true

query I
WITH tight AS (SELECT sample_id, axis, coordinate FROM progressive_pcoa_from_unifrac('ft_pa', 'tree',
                   variant := 'unweighted', n_dims := 3, n_anchors := 15, batch_size := 12, seed := 42)),
     extra AS (SELECT sample_id, axis, coordinate FROM progressive_pcoa_from_unifrac('ft_pa', 'tree_extra',
                   variant := 'unweighted', n_dims := 3, n_anchors := 15, batch_size := 12, seed := 42))
SELECT (SELECT count(*) FROM (SELECT * FROM tight EXCEPT ALL SELECT * FROM extra))
     + (SELECT count(*) FROM (SELECT * FROM extra EXCEPT ALL SELECT * FROM tight));
----
0
