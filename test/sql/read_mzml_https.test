# name: test/sql/read_mzml_https.test
# description: Test read_mzml from HTTP URL
# group: [sql]

# NOTE: Skipped in CI because httpfs is disabled at build time.
# Active coverage is in test/shell/read_https.sh (uses LOAD httpfs at runtime).

require miint

require httpfs

require-env MIINT_HTTPS_TEST_URL

# mzML via HTTP
query I
SELECT COUNT(*) FROM read_mzml(getenv('MIINT_HTTPS_TEST_URL') || '/mzml/basic_3spectra.mzML');
----
3

# Multiple remote mzML files
query I
SELECT COUNT(*) FROM read_mzml([
    getenv('MIINT_HTTPS_TEST_URL') || '/mzml/basic_3spectra.mzML',
    getenv('MIINT_HTTPS_TEST_URL') || '/mzml/compressed.mzML'
]);
----
4

