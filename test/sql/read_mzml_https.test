# name: test/sql/read_mzml_https.test
# description: Test read_mzml from HTTP URL
# group: [sql]

# `make test` skips this file because httpfs is not linked into unittest;
# run_tests.sh runs it in its httpfs pass.

require miint

require httpfs

require-env MIINT_HTTPS_TEST_URL

# mzML via HTTP
query I
SELECT COUNT(*) FROM read_mzml('${MIINT_HTTPS_TEST_URL}/mzml/basic_3spectra.mzML');
----
3

# Multiple remote mzML files
query I
SELECT COUNT(*) FROM read_mzml([
    '${MIINT_HTTPS_TEST_URL}/mzml/basic_3spectra.mzML',
    '${MIINT_HTTPS_TEST_URL}/mzml/compressed.mzML'
]);
----
4

