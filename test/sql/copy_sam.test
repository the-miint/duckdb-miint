statement error
COPY (SELECT 'r1' AS read_id, 0::USMALLINT AS flags, 'ctg1' AS reference,
             1::BIGINT AS position, 60::UTINYINT AS mapq, '1M' AS cigar,
             '*' AS mate_reference, 0::BIGINT AS mate_position, NULL::BIGINT AS template_length)
TO '__TEST_DIR__/null_tlen.sam' (FORMAT SAM, REFERENCE_LENGTHS 'null_id_refs');
