Column 'template_length' is NULL for read: r1

# Both spellings of the same NULL are pinned. Reading a string_t out of an invalid slot is
# undefined, and the two differed in practice: a NULL materialized in a TABLE yielded "" and was
# written silently, while an inline constant-NULL vector yielded garbage that tripped a
# different htslib error ("CIGAR length invalid at position 1"). Neither is acceptable, and only
# the validity check makes the outcome independent of the vector's representation.
statement error
COPY (SELECT 'r1' AS read_id, 0::USMALLINT AS flags, 'ctg1' AS reference,
             1::BIGINT AS position, 60::UTINYINT AS mapq, NULL::VARCHAR AS cigar,
             '*' AS mate_reference, 0::BIGINT AS mate_position, 0::BIGINT AS template_length)
TO '__TEST_DIR__/null_cigar_inline.sam' (FORMAT SAM, REFERENCE_LENGTHS 'null_id_refs');
----
Column 'cigar' is NULL for read: r1

# On an UNMAPPED record (FLAG 0x4) a NULL cigar/position/mapq is accepted and written as the SAM
# sentinels, because there is no alignment that substituting them could discard -- the hazard the
# rejection guards against exists only on a mapped record.
#
# This is what makes align_minimap2(include_unmapped := true) output writable: those rows carry
# NULL reference/position/mapq/cigar by design (#185), and without this the two features could not
# be composed at all.
statement ok
COPY (SELECT 'r1' AS read_id, 4::USMALLINT AS flags, NULL::VARCHAR AS reference,
             NULL::BIGINT AS position, NULL::UTINYINT AS mapq, NULL::VARCHAR AS cigar,
             '*' AS mate_reference, 0::BIGINT AS mate_position, 0::BIGINT AS template_length)
TO '__TEST_DIR__/null_cigar_unmapped.sam' (FORMAT SAM, REFERENCE_LENGTHS 'null_id_refs');

query III
SELECT read_id, flags, reference FROM read_sam('__TEST_DIR__/null_cigar_unmapped.sam');
----
r1	4	*

# Mapped (0x4 clear) + no CIGAR, in both spellings.
statement error
COPY (SELECT 'r1' AS read_id, 0::USMALLINT AS flags, 'ctg1' AS reference,
             1::BIGINT AS position, 60::UTINYINT AS mapq, '' AS cigar,
             '*' AS mate_reference, 0::BIGINT AS mate_position, 0::BIGINT AS template_length)
TO '__TEST_DIR__/empty_cigar.sam' (FORMAT SAM, REFERENCE_LENGTHS 'null_id_refs');
----
Mapped read 'r1' has no CIGAR (flags=0)

statement error
COPY (SELECT 'r1' AS read_id, 0::USMALLINT AS flags, 'ctg1' AS reference,
             1::BIGINT AS position, 60::UTINYINT AS mapq, '*' AS cigar,
             '*' AS mate_reference, 0::BIGINT AS mate_position, 0::BIGINT AS template_length)
TO '__TEST_DIR__/star_cigar_mapped.sam' (FORMAT SAM, REFERENCE_LENGTHS 'null_id_refs');
----
Mapped read 'r1' has no CIGAR (flags=0)

# Unmapped (0x4 set) + no CIGAR is legitimate and must keep working, in both spellings. This is
# the read_alignments round trip: the reader hands back '' for an on-disk '*'.
statement ok
COPY (SELECT 'r_star' AS read_id, 4::USMALLINT AS flags, '*' AS reference,
             0::BIGINT AS position, 0::UTINYINT AS mapq, '*' AS cigar,
             '*' AS mate_reference, 0::BIGINT AS mate_position, 0::BIGINT AS template_length
      UNION ALL
      SELECT 'r_empty', 4::USMALLINT, '*', 0::BIGINT, 0::UTINYINT, '',
             '*', 0::BIGINT, 0::BIGINT)
TO '__TEST_DIR__/unmapped_no_cigar.sam' (FORMAT SAM, REFERENCE_LENGTHS 'null_id_refs');

query III
SELECT read_id, flags, cigar FROM read_sam('__TEST_DIR__/unmapped_no_cigar.sam') ORDER BY read_id;
----
r_empty	4	(empty)
r_star	4	(empty)

statement ok
DROP TABLE null_cigar_aln;

statement ok
DROP TABLE null_id_refs;

# --- REFERENCE_LENGTHS must cover every reference used (issue #198) ---
#
# WHY THIS MATTERS: GetReferenceTID appends a missing reference to the header with a sentinel
# length. That exists for headerless SAM, where it is correct -- but it ran unconditionally,
# including after sam_hdr_write() had already serialized the header. The appended @SQ therefore
# never reached the file, so the record's reference was unrepresentable in the output: SAM read
# it back as '*' (name silently gone), BAM dropped the record entirely. No error, no warning,
# exit 0, and `samtools quickcheck` passes because the file is structurally fine.
#
# An incomplete table is easy to produce by accident -- a join that drops rows, a filtered contig
# list, or SELECT DISTINCT reference taken from a different alignment set than the one being
# written. Supplying REFERENCE_LENGTHS asserts it is the complete reference set, so a gap is a
# caller error and is now refused.
statement ok
CREATE TABLE gap_refs AS
SELECT * FROM (VALUES ('ctg000001', 1000::BIGINT), ('ctg000003', 1000::BIGINT)) t(reference, length);

statement ok
CREATE TABLE gap_aln AS
SELECT 'r' || i AS read_id, 0::USMALLINT AS flags, 'ctg00000' || i AS reference,
       1::BIGINT AS position, 2::BIGINT AS stop_position, 60::UTINYINT AS mapq, '1M' AS cigar,
       '*' AS mate_reference, 0::BIGINT AS mate_position, 0::BIGINT AS template_length
FROM range(1, 4) t(i);

# BAM was the worst case: the record vanished and COUNT(*) came back 2 instead of 3.
statement error
COPY gap_aln TO '__TEST_DIR__/gap.bam' (FORMAT BAM, REFERENCE_LENGTHS 'gap_refs');
----
Column 'reference' is 'ctg000002' for read 'r2', which is not in the REFERENCE_LENGTHS table

statement error
COPY gap_aln TO '__TEST_DIR__/gap.sam' (FORMAT SAM, REFERENCE_LENGTHS 'gap_refs');
----
not in the REFERENCE_LENGTHS table

# mate_reference resolves through the same header, so a gap there loses RNEXT the same way.
statement error
COPY (SELECT 'r1' AS read_id, 0::USMALLINT AS flags, 'ctg000001' AS reference,
             1::BIGINT AS position, 60::UTINYINT AS mapq, '1M' AS cigar,
             'ctg000002' AS mate_reference, 1::BIGINT AS mate_position, 0::BIGINT AS template_length)
TO '__TEST_DIR__/gap_mate.bam' (FORMAT BAM, REFERENCE_LENGTHS 'gap_refs');
----
Column 'mate_reference' is 'ctg000002' for read 'r1', which is not in the REFERENCE_LENGTHS table

# Headerless SAM keeps the dynamic-append behaviour: with no @SQ lines on disk there is no
# on-disk header to diverge from, and every RNAME is written verbatim. Losing this would break
# the documented INCLUDE_HEADER=false mode, so it is asserted rather than left implicit.
statement ok
COPY gap_aln TO '__TEST_DIR__/gap_headerless.sam' (FORMAT SAM, INCLUDE_HEADER false, REFERENCE_LENGTHS 'gap_refs');

query T
SELECT split_part(line, chr(9), 3) AS rname
FROM read_csv('__TEST_DIR__/gap_headerless.sam', delim='\x1f', header=false,
              columns={'line':'VARCHAR'}, auto_detect=false, quote='', escape='')
WHERE line NOT LIKE '@%' ORDER BY rname;
----
ctg000001
ctg000002
ctg000003

# Positive control: with an exhaustive table all three records survive. This is the assertion
# that would have caught #198 -- the bug's signature was a silently short count.
statement ok
CREATE TABLE gap_refs_all AS
SELECT 'ctg00000' || i AS reference, 1000::BIGINT AS length FROM range(1, 4) t(i);

statement ok
COPY gap_aln TO '__TEST_DIR__/nogap.bam' (FORMAT BAM, REFERENCE_LENGTHS 'gap_refs_all');

query I
SELECT COUNT(*) FROM read_sam('__TEST_DIR__/nogap.bam');
----
3

query T
SELECT DISTINCT reference FROM read_sam('__TEST_DIR__/nogap.bam') ORDER BY reference;
----
ctg000001
ctg000002
ctg000003

statement ok
