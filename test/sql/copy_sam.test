             1::BIGINT AS position, 60::UTINYINT AS mapq, '1M' AS cigar,
             '*' AS mate_reference, NULL::BIGINT AS mate_position, 0::BIGINT AS template_length)
TO '__TEST_DIR__/null_mate_position.sam' (FORMAT SAM, REFERENCE_LENGTHS 'null_id_refs');
