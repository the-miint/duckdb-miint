query I
WITH depths AS (SELECT sample_id, sum("count") d, any_value(cluster_id) cid FROM c_sD10 GROUP BY sample_id),
     shared AS (SELECT a.sample_id sa, b.sample_id sb,
                       sum(least(a."count"::DOUBLE/da.d, b."count"::DOUBLE/db.d)) smin
                FROM c_sD10 a JOIN depths da ON a.sample_id=da.sample_id
                             JOIN c_sD10 b ON a.otu_id=b.otu_id AND a.sample_id<b.sample_id
                             JOIN depths db ON b.sample_id=db.sample_id
                GROUP BY a.sample_id, b.sample_id),
     pairs AS (SELECT da.cid ca, db.cid cb, 2.0 - 2.0*coalesce(sh.smin,0) l1
               FROM depths da JOIN depths db ON da.sample_id<db.sample_id
               LEFT JOIN shared sh ON sh.sa=da.sample_id AND sh.sb=db.sample_id),
     s AS (SELECT avg(CASE WHEN ca<>cb THEN l1 END)/avg(CASE WHEN ca=cb THEN l1 END) v FROM pairs)
SELECT count(*) FROM s, clust_oracle o
WHERE o.param_set='cluster_subtle_D10' AND o.statistic='dissim_ratio' AND (s.v < o.lo OR s.v > o.hi);
----
0

# Cross-check: prominent clusters separate more than subtle at D=1000 -- the core
# Kuczynski-2010 cluster signature. prominent/subtle share seed + sizes + species,
# so their perturbation standard-normals are common (scaled 1.0/0.5 vs 0.1/0.1): a
# coupled comparison. Margin 0.1 keeps it robust (oracle means differ by ~0.64).
query I
WITH ratio_of AS (
  SELECT 'p' k, avg(CASE WHEN ca<>cb THEN l1 END)/avg(CASE WHEN ca=cb THEN l1 END) v FROM (
    SELECT da.cid ca, db.cid cb, 2.0-2.0*coalesce(sh.smin,0) l1
    FROM (SELECT sample_id,sum("count") d,any_value(cluster_id) cid FROM c_pD1000 GROUP BY sample_id) da
    JOIN (SELECT sample_id,sum("count") d,any_value(cluster_id) cid FROM c_pD1000 GROUP BY sample_id) db ON da.sample_id<db.sample_id
    LEFT JOIN (SELECT a.sample_id sa,b.sample_id sb,sum(least(a."count"::DOUBLE/x.d,b."count"::DOUBLE/y.d)) smin
               FROM c_pD1000 a JOIN (SELECT sample_id,sum("count") d FROM c_pD1000 GROUP BY sample_id) x ON a.sample_id=x.sample_id
                              JOIN c_pD1000 b ON a.otu_id=b.otu_id AND a.sample_id<b.sample_id
                              JOIN (SELECT sample_id,sum("count") d FROM c_pD1000 GROUP BY sample_id) y ON b.sample_id=y.sample_id
               GROUP BY 1,2) sh ON sh.sa=da.sample_id AND sh.sb=db.sample_id)
  UNION ALL
  SELECT 's' k, avg(CASE WHEN ca<>cb THEN l1 END)/avg(CASE WHEN ca=cb THEN l1 END) v FROM (
    SELECT da.cid ca, db.cid cb, 2.0-2.0*coalesce(sh.smin,0) l1
    FROM (SELECT sample_id,sum("count") d,any_value(cluster_id) cid FROM c_sD1000 GROUP BY sample_id) da
    JOIN (SELECT sample_id,sum("count") d,any_value(cluster_id) cid FROM c_sD1000 GROUP BY sample_id) db ON da.sample_id<db.sample_id
    LEFT JOIN (SELECT a.sample_id sa,b.sample_id sb,sum(least(a."count"::DOUBLE/x.d,b."count"::DOUBLE/y.d)) smin
               FROM c_sD1000 a JOIN (SELECT sample_id,sum("count") d FROM c_sD1000 GROUP BY sample_id) x ON a.sample_id=x.sample_id
                              JOIN c_sD1000 b ON a.otu_id=b.otu_id AND a.sample_id<b.sample_id
                              JOIN (SELECT sample_id,sum("count") d FROM c_sD1000 GROUP BY sample_id) y ON b.sample_id=y.sample_id
               GROUP BY 1,2) sh ON sh.sa=da.sample_id AND sh.sb=db.sample_id)
)
SELECT (SELECT v FROM ratio_of WHERE k='p') - (SELECT v FROM ratio_of WHERE k='s') > 0.1;
----
true
