query I
WITH s AS (SELECT (SELECT sum(c) FROM (SELECT otu_id, sum("count") c FROM c_sD1000 GROUP BY otu_id ORDER BY c DESC LIMIT 10))
                  / (SELECT sum("count") FROM c_sD1000) v)
SELECT count(*) FROM s, clust_oracle o
WHERE o.param_set='cluster_subtle_D1000' AND o.statistic='top10_frac' AND (s.v < o.lo OR s.v > o.hi);
