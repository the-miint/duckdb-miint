                  / (SELECT sum("count") FROM c_sD10) v)
SELECT count(*) FROM s, clust_oracle o
WHERE o.param_set='cluster_subtle_D10' AND o.statistic='top10_frac' AND (s.v < o.lo OR s.v > o.hi);
----
