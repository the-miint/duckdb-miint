# ---------- dissim_ratio = mean(inter-cluster L1) / mean(intra-cluster L1) on rel. abundances ----------
# L1_rel(a,b) = 2 - 2*sum_shared(min(ca/Da, cb/Db)); ratio = mean over inter pairs / mean over intra pairs.
query I
WITH depths AS (SELECT sample_id, sum("count") d, any_value(cluster_id) cid FROM c_pD1000 GROUP BY sample_id),
     shared AS (SELECT a.sample_id sa, b.sample_id sb,
                       sum(least(a."count"::DOUBLE/da.d, b."count"::DOUBLE/db.d)) smin
                FROM c_pD1000 a JOIN depths da ON a.sample_id=da.sample_id
                               JOIN c_pD1000 b ON a.otu_id=b.otu_id AND a.sample_id<b.sample_id
                               JOIN depths db ON b.sample_id=db.sample_id
                GROUP BY a.sample_id, b.sample_id),
     pairs AS (SELECT da.cid ca, db.cid cb, 2.0 - 2.0*coalesce(sh.smin,0) l1
               FROM depths da JOIN depths db ON da.sample_id<db.sample_id
               LEFT JOIN shared sh ON sh.sa=da.sample_id AND sh.sb=db.sample_id),
     s AS (SELECT avg(CASE WHEN ca<>cb THEN l1 END)/avg(CASE WHEN ca=cb THEN l1 END) v FROM pairs)
SELECT count(*) FROM s, clust_oracle o
WHERE o.param_set='cluster_prominent_D1000' AND o.statistic='dissim_ratio' AND (s.v < o.lo OR s.v > o.hi);
----
0

query I
WITH depths AS (SELECT sample_id, sum("count") d, any_value(cluster_id) cid FROM c_sD1000 GROUP BY sample_id),
     shared AS (SELECT a.sample_id sa, b.sample_id sb,
                       sum(least(a."count"::DOUBLE/da.d, b."count"::DOUBLE/db.d)) smin
                FROM c_sD1000 a JOIN depths da ON a.sample_id=da.sample_id
                               JOIN c_sD1000 b ON a.otu_id=b.otu_id AND a.sample_id<b.sample_id
                               JOIN depths db ON b.sample_id=db.sample_id
                GROUP BY a.sample_id, b.sample_id),
     pairs AS (SELECT da.cid ca, db.cid cb, 2.0 - 2.0*coalesce(sh.smin,0) l1
               FROM depths da JOIN depths db ON da.sample_id<db.sample_id
               LEFT JOIN shared sh ON sh.sa=da.sample_id AND sh.sb=db.sample_id),
     s AS (SELECT avg(CASE WHEN ca<>cb THEN l1 END)/avg(CASE WHEN ca=cb THEN l1 END) v FROM pairs)
SELECT count(*) FROM s, clust_oracle o
WHERE o.param_set='cluster_subtle_D1000' AND o.statistic='dissim_ratio' AND (s.v < o.lo OR s.v > o.hi);
----
0

