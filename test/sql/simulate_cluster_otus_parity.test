# name: test/sql/simulate_cluster_otus_parity.test
# description: simulate_cluster_otus statistical equivalence to the committed Kuczynski-2010 oracle bands
# group: [sql]

# Oracle bands generated OFFLINE from the actual Python-2.7 ord_survey cluster code
# over R=1000 replicates, committed as NUMBERS only under data/simsurvey/. Gated by
# MIINT_RESEMBLANCE_SIM_ORACLE_OK (exported by run_tests.sh when the SHA-pinned
# fixtures are intact). dissim_ratio = mean(inter-cluster L1)/mean(intra-cluster L1)
# on RELATIVE abundances; L1_rel = 2 - 2*sum_shared(min(ra,rb)) (the same shared-min
# identity as Bray-Curtis, no full-outer-join needed).

require miint

require-env MIINT_RESEMBLANCE_SIM_ORACLE_OK

statement ok
CREATE TABLE kbd AS SELECT * FROM read_csv_auto('data/simsurvey/keyboard_abundances.csv');

statement ok
CREATE TABLE clust_oracle AS SELECT * FROM read_csv_auto('data/simsurvey/cluster_oracle.csv');

# Table-function args can't be subqueries; stage the abundance vector as a constant.
statement ok
SET VARIABLE kbd_abund = (SELECT list(abund ORDER BY idx) FROM kbd);

# --- one realization per parameter set at a fixed seed (default cluster_sizes=[30,30,30]) ---
statement ok
CREATE TABLE c_pD10 AS SELECT * FROM simulate_cluster_otus(
  getvariable('kbd_abund'), 10, cluster_spacing := 1.0, sample_spacing := 0.5, seed := 42);

statement ok
CREATE TABLE c_sD10 AS SELECT * FROM simulate_cluster_otus(
  getvariable('kbd_abund'), 10, cluster_spacing := 0.1, sample_spacing := 0.1, seed := 42);

statement ok
CREATE TABLE c_pD1000 AS SELECT * FROM simulate_cluster_otus(
  getvariable('kbd_abund'), 1000, cluster_spacing := 1.0, sample_spacing := 0.5, seed := 42);

statement ok
CREATE TABLE c_sD1000 AS SELECT * FROM simulate_cluster_otus(
  getvariable('kbd_abund'), 1000, cluster_spacing := 0.1, sample_spacing := 0.1, seed := 42);

# ---------- richness_mean ----------
query I
WITH s AS (SELECT avg(r) v FROM (SELECT sample_id, count(*) r FROM c_pD10 GROUP BY sample_id))
SELECT count(*) FROM s, clust_oracle o
WHERE o.param_set='cluster_prominent_D10' AND o.statistic='richness_mean' AND (s.v < o.lo OR s.v > o.hi);
----
0

query I
WITH s AS (SELECT avg(r) v FROM (SELECT sample_id, count(*) r FROM c_sD10 GROUP BY sample_id))
SELECT count(*) FROM s, clust_oracle o
WHERE o.param_set='cluster_subtle_D10' AND o.statistic='richness_mean' AND (s.v < o.lo OR s.v > o.hi);
----
0

