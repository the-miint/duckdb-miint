WITH depths AS (SELECT sample_id, sum("count") d, any_value(cluster_id) cid FROM c_pD10 GROUP BY sample_id),
     shared AS (SELECT a.sample_id sa, b.sample_id sb,
                       sum(least(a."count"::DOUBLE/da.d, b."count"::DOUBLE/db.d)) smin
