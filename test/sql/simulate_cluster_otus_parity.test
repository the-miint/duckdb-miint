SELECT count(*) FROM s, clust_oracle o
WHERE o.param_set='cluster_prominent_D1000' AND o.statistic='richness_mean' AND (s.v < o.lo OR s.v > o.hi);
----
0

query I
WITH s AS (SELECT avg(r) v FROM (SELECT sample_id, count(*) r FROM c_sD1000 GROUP BY sample_id))
SELECT count(*) FROM s, clust_oracle o
WHERE o.param_set='cluster_subtle_D1000' AND o.statistic='richness_mean' AND (s.v < o.lo OR s.v > o.hi);
----
0

# ---------- top10_frac ----------
query I
WITH s AS (SELECT (SELECT sum(c) FROM (SELECT otu_id, sum("count") c FROM c_pD10 GROUP BY otu_id ORDER BY c DESC LIMIT 10))
                  / (SELECT sum("count") FROM c_pD10) v)
SELECT count(*) FROM s, clust_oracle o
WHERE o.param_set='cluster_prominent_D10' AND o.statistic='top10_frac' AND (s.v < o.lo OR s.v > o.hi);
----
0

