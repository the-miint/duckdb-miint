read_myloasm_mappings: read 's00001_lina_1000487_1016486_r+split0+split0+split0' has more than two +split levels

# Without the 'r<index>-' prefix this is not myloasm's PAF, and stripping a prefix that is not
# there would cut into the read's name.
statement ok
COPY (SELECT * FROM constructed_paf UNION ALL
      SELECT E's00001_lina_1000487_1016486_r\t1000\t0\t1000\t+\tu491ctg\t196466\t1000\t2000\t990\t990\t255\tshared_mini:90\tdiff_snp:0\tshared_snp:8')
TO '__TEST_DIR__/mappings_round2/3-mapping/map_to_unitigs.paf.gz'
(FORMAT csv, HEADER false, QUOTE '', ESCAPE '', DELIMITER E'\x01', COMPRESSION gzip);

