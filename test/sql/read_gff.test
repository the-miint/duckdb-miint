query II
SELECT position, phase FROM read_gff('data/gff/test.gff') WHERE type = 'CDS' ORDER BY position;
----
150	0
300	2

# Test NULL phase handling
query I
SELECT COUNT(*) FROM read_gff('data/gff/test.gff') WHERE phase IS NULL;
----
