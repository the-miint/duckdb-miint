# name: test/sql/read_gff.test
# description: Test read_gff function for reading GFF3 annotation files
# group: [sql]

require miint

# COORDINATE CONVENTION (issue #196): read_gff emits `stop_position` as 1-based HALF-OPEN
# [position, stop_position), normalizing GFF3's 1-based CLOSED `end` by +1 on read. This is
# the project-wide convention -- read_alignments, align_*, alignment_slice,
# compute_coverage_depth and genome_coverage are all half-open. Before normalization
# read_gff was the outlier while using the SAME column name, so feeding it to any of those
# type-checked, ran, raised nothing, and silently dropped the interval's last base.
# The raw GFF `end` is recoverable as `stop_position - 1`.
#
# The file's own values are end=500 for gene1 etc; the values below are those +1.

# Test basic GFF reading
query TTTIIRRTT
SELECT * FROM read_gff('data/gff/test.gff') ORDER BY seqid, position, type, stop_position;
----
chr1	NCBI	exon	100	201	NULL	+	NULL	{ID=exon1, Parent=transcript1}
chr1	NCBI	gene	100	501	NULL	+	NULL	{ID=gene1, Name=TEST1, biotype=protein_coding}
chr1	NCBI	mRNA	100	501	NULL	+	NULL	{ID=transcript1, Parent=gene1, Name=TEST1-RA}
chr1	NCBI	CDS	150	201	NULL	+	0	{ID=cds1, Parent=transcript1}
chr1	NCBI	CDS	300	451	NULL	+	2	{ID=cds2, Parent=transcript1}
chr1	NCBI	exon	300	501	50.5	+	NULL	{ID=exon2, Parent=transcript1}
chr2	Ensembl	gene	1000	2001	100.0	-	NULL	{ID=gene2, Name=TEST2}

# Test extracting specific columns
query TTT
SELECT seqid, type, attributes['ID'] AS feature_id FROM read_gff('data/gff/test.gff') WHERE type = 'gene' ORDER BY seqid;
----
chr1	gene	gene1
chr2	gene	gene2

