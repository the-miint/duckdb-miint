# Test attribute parsing - accessing nested values
query TT
SELECT attributes['ID'], attributes['Parent'] FROM read_gff('data/gff/test.gff') WHERE type = 'exon' ORDER BY attributes['ID'];
----
exon1	transcript1
exon2	transcript1

# Test attribute parsing - Name field
query TT
SELECT attributes['ID'], attributes['Name'] FROM read_gff('data/gff/test.gff') WHERE type = 'gene' ORDER BY attributes['ID'];
----
gene1	TEST1
gene2	TEST2

# Test feature length calculation.
# Under half-open coordinates a feature's length is (stop_position - position) -- no +1.
# The EXPECTED LENGTHS BELOW ARE UNCHANGED by normalization, which is the point: the
# biology is identical, only the representation moved. If these numbers ever shift, the
# normalization has changed a feature's meaning rather than its encoding.
query TII
SELECT type, MIN(stop_position - position) AS min_len, MAX(stop_position - position) AS max_len
FROM read_gff('data/gff/test.gff')
GROUP BY type
ORDER BY type;
----
CDS	51	151
exon	101	201
gene	401	1001
mRNA	401	401

# Test counting features by type
query TI
SELECT type, COUNT(*) AS count FROM read_gff('data/gff/test.gff') GROUP BY type ORDER BY count DESC, type;
----
CDS	2
exon	2
gene	2
mRNA	1

# Test joining parent-child relationships
query TTT
SELECT
    g.attributes['ID'] AS gene_id,
    g.attributes['Name'] AS gene_name,
    t.attributes['ID'] AS transcript_id
FROM read_gff('data/gff/test.gff') g
JOIN read_gff('data/gff/test.gff') t ON t.attributes['Parent'] = g.attributes['ID']
WHERE g.type = 'gene' AND t.type = 'mRNA'
ORDER BY gene_id;
----
gene1	TEST1	transcript1

# Test empty GFF file (only comments)
query I
SELECT COUNT(*) FROM read_gff('data/gff/empty.gff');
----
0

# Test seqid filtering
query TII
SELECT type, position, stop_position FROM read_gff('data/gff/test.gff') WHERE seqid = 'chr1' AND type = 'gene';
----
gene	100	501

# Test range overlap query.
# Half-open [position, stop_position) overlaps the closed probe window [100, 200] iff
# position <= 200 AND stop_position > 100. Note the strict `>` -- with half-open ends,
# `stop_position >= 100` would also match an interval that ENDS exactly at 100 and
# therefore does not overlap it. Same result set here, but the idiom gets copied.
query TTII
SELECT seqid, type, position, stop_position
FROM read_gff('data/gff/test.gff')
WHERE seqid = 'chr1' AND position <= 200 AND stop_position > 100
ORDER BY position, type;
----
chr1	exon	100	201
chr1	gene	100	501
chr1	mRNA	100	501
chr1	CDS	150	201

# Test source field
query T
SELECT DISTINCT source FROM read_gff('data/gff/test.gff') ORDER BY source;
----
Ensembl
NCBI

# Test attribute key existence
query I
SELECT COUNT(*) FROM read_gff('data/gff/test.gff') WHERE attributes['biotype'] IS NOT NULL;
----
1

# Test complex attribute filtering
query TT
SELECT type, attributes['ID']
FROM read_gff('data/gff/test.gff')
WHERE type = 'gene' AND attributes['biotype'] = 'protein_coding';
----
gene	gene1

# Test that ## comment lines are filtered out (should not appear in results)
# The test.gff file has ##gff-version 3 and ##sequence-region lines which should not appear
statement ok
CREATE TABLE gff_data AS SELECT * FROM read_gff('data/gff/test.gff');

query I
SELECT COUNT(*) FROM gff_data WHERE seqid LIKE '##%';
----
0

statement ok
DROP TABLE gff_data;

# GFF3 spec requires %XX percent-decoding of attribute keys and values (reserved
# chars ;=&, must be encoded). read_gff must decode them, and must not truncate a
# value at a second '=' — a raw '=' inside a value (e.g. an insert name "gc=0.46")
# would otherwise collapse distinct features onto one ID.

# Raw '=' inside a value must survive intact (regression: values truncated at 2nd '=')
query T
SELECT attributes['ID'] FROM read_gff('data/gff/encoded.gff') WHERE type = 'insert' ORDER BY position;
----
SynDNA_gc=0.46
SynDNA_gc=0.50

# The two inserts must remain distinct IDs, not collapse to one
query I
SELECT COUNT(DISTINCT attributes['ID']) FROM read_gff('data/gff/encoded.gff') WHERE type = 'insert';
----
2

# Percent-encoded reserved characters in values must be decoded
# ID=gene%3D1 -> gene=1 ; taxon%3A9606 -> taxon:9606 ; a%2Cb%3Bc%26d -> a,b;c&d
query TTT
SELECT attributes['ID'], attributes['Dbxref'], attributes['desc']
FROM read_gff('data/gff/encoded.gff') WHERE position = 500;
----
gene=1	taxon:9606	a,b;c&d

# %20 must decode to a space
query T
SELECT attributes['Note'] FROM read_gff('data/gff/encoded.gff') WHERE type = 'insert' ORDER BY position;
----
first insert
second insert

# Percent-encoded characters in KEYS must be decoded too (weird%20key -> "weird key")
query T
SELECT attributes['weird key'] FROM read_gff('data/gff/encoded.gff') WHERE position = 700;
----
val

# Multi-byte UTF-8 percent-encoding must decode correctly (caf%C3%A9 -> café)
query T
SELECT attributes['Name'] FROM read_gff('data/gff/encoded.gff') WHERE position = 900;
----
café

# Test error: nonexistent file
statement error
SELECT * FROM read_gff('data/gff/nonexistent.gff');
----
data/gff/nonexistent.gff

# --- GFF3 sequence section (##FASTA), issue #186 ---
#
# WHY THIS MATTERS: prokka and bakta ALWAYS append the genome after ##FASTA, so this is the
# common case, not a corner one. read_gff is a read_csv over the whole file, so every line
# of the appended FASTA used to come back as a row with the nucleotide/header text in
# `seqid` and every other column NULL. Those rows do not fail at parse time -- they flow
# downstream and either inflate feature counts silently or fail later with a misleading
# error. A 99-feature prokka file returned 1638 rows.
#
# data/gff/withfasta.gff has 4 feature lines, then a 2-contig genome after ##FASTA whose
# first header carries a TAB-separated description and which contains a blank line -- both
# real-world shapes that must not be mistaken for feature lines.
query I
SELECT COUNT(*) FROM read_gff('data/gff/withfasta.gff');
----
4

# The specific failure mode: no row may carry FASTA text in seqid. Counting alone would
# pass if we dropped a real feature and kept a junk row, so pin the actual contents.
query TTTII
SELECT seqid, source, type, position, stop_position
FROM read_gff('data/gff/withfasta.gff')
ORDER BY seqid, position;
----
ctg1	prokka	CDS	10	21
ctg1	prokka	CDS	30	41
ctg1	prokka	rRNA	50	61
ctg2	prokka	CDS	5	16

# A feature line whose attributes field is EMPTY (a trailing tab, so the 9th field parses
# as NULL) is LEGITIMATE and must survive. This is why the malformed-line check below tests
# only the 8 mandatory fields and treats attributes as optional -- keying off the
# attributes column would reject real prokka output.
query TI
SELECT type, position FROM read_gff('data/gff/withfasta.gff')
WHERE attributes IS NULL OR cardinality(attributes) = 0;
----
rRNA	50

# Every row must be a real feature: source/type are never NULL once FASTA is excluded.
query I
SELECT COUNT(*) FROM read_gff('data/gff/withfasta.gff') WHERE source IS NULL OR type IS NULL;
----
0

# --- Malformed feature lines fail loud (issue #186) ---
#
# A line with only SOME of the 8 mandatory fields is a broken GFF line, not FASTA content,
# and is not silently droppable: dropping it would trade one silent wrong answer for
# another. The check must fire whichever columns are selected or filtered on, including
# `SELECT type FROM read_gff(...)`, the shape the issue reported (why it can fail to:
# docs/internals/duckdb-engine-notes.md, "Validation in a table macro").
statement error
SELECT COUNT(*) FROM read_gff('data/gff/malformed.gff');
----
malformed GFF feature line

# Must also fire when only an unrelated column is projected (the pruning case above).
statement error
SELECT type FROM read_gff('data/gff/malformed.gff');
----
malformed GFF feature line

# Must ALSO fire when the caller adds its own WHERE predicate that the malformed row does not
# match. If the optimizer were to evaluate that cheap conjunct first and discard the row, the
# error would never fire and a broken line would vanish silently -- the exact failure class
# this check exists to prevent. malformed.gff's valid row is type='gene' and its malformed row
# is type='CDS', so these filters genuinely discriminate between them.
statement error
SELECT type FROM read_gff('data/gff/malformed.gff') WHERE type = 'gene';
----
malformed GFF feature line

statement error
SELECT type FROM read_gff('data/gff/malformed.gff') WHERE type = 'no_such_type';
----
malformed GFF feature line

statement error
SELECT COUNT(*) FROM read_gff('data/gff/malformed.gff') WHERE position > 1000000;
----
malformed GFF feature line

# An IN list was one filter the ungated macro let through.
statement error
SELECT COUNT(*) FROM read_gff('data/gff/malformed.gff') WHERE type IN ('gene', 'mRNA');
----
malformed GFF feature line

# A filter on any one column, here one that matches neither line, still raises: each
# column carries the check, so removing it from any one column fails this loop.
foreach col seqid source type position stop_position score strand phase attributes

statement error
SELECT COUNT(*) FROM read_gff('data/gff/malformed.gff') WHERE ${col}::VARCHAR = 'no_such_value';
----
malformed GFF feature line

endloop

# A last line holding only a seqid and a source, as a download cut off mid-line leaves.
# Counting features that have an ID must not quietly leave it out.
statement ok
COPY (SELECT * FROM (VALUES (E'##gff-version 3'), (E'ctg1\tprodigal\tCDS\t1\t50\t.\t+\t0\tID=c1'),
                            (E'ctg1\tprodigal')) t(line))
TO '__TEST_DIR__/truncated.gff' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '', DELIMITER E'\x01');

statement error
SELECT COUNT(*) FROM read_gff('__TEST_DIR__/truncated.gff') WHERE attributes['ID'] IS NOT NULL;
----
malformed GFF feature line

# A filter that selects other contigs still reads the malformed line, so it still raises.
statement ok
COPY (SELECT * FROM (VALUES (E'ctg1\tsrc\tgene\t1\t50\t.\t+\t.\tID=g1'), (E'ctg2\tsrc\tgene\t1')) t(line))
TO '__TEST_DIR__/broken_ctg2.gff' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '', DELIMITER E'\x01');

statement error
SELECT COUNT(*) FROM read_gff('__TEST_DIR__/broken_ctg2.gff') WHERE seqid LIKE 'ctg1%';
----
malformed GFF feature line (expected 9 tab-separated fields, found fewer): ctg2

# A seqid is mandatory. A line whose first field is empty is a broken feature line, raised
# like one with missing fields, not dropped. (An empty line, or one of tabs alone, has no
# fields at all and is skipped.)
statement ok
COPY (SELECT * FROM (VALUES (E'ctg1\tsrc\tgene\t1\t50\t.\t+\t.\tID=g1'), (E''), (E'\t\t\t\t\t\t\t\t'),
                            (E'\tsrc\tgene\t60\t90\t.\t+\t.\tID=g2')) t(line))
TO '__TEST_DIR__/empty_seqid.gff' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '', DELIMITER E'\x01');

statement error
SELECT COUNT(*) FROM read_gff('__TEST_DIR__/empty_seqid.gff');
----
malformed GFF feature line (empty seqid): src gene 60 90

statement ok
COPY (SELECT * FROM (VALUES (E'ctg1\tsrc\tgene\t1\t50\t.\t+\t.\tID=g1'), (E''), (E'\t\t\t\t\t\t\t\t'),
                            (E'ctg1\tsrc\tgene\t60\t90\t2.5\t.\t1\tID=g2')) t(line))
TO '__TEST_DIR__/blank_lines.gff' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '', DELIMITER E'\x01');

# Each column's type, and '.' as NULL for score, strand and phase.
query TTTTTTTTTTTT
SELECT seqid, typeof(position), typeof(stop_position), score, typeof(score), strand, typeof(strand), phase,
       typeof(phase), attributes['ID'], typeof(attributes), typeof(seqid)
FROM read_gff('__TEST_DIR__/blank_lines.gff') ORDER BY position;
----
ctg1	INTEGER	INTEGER	NULL	DOUBLE	+	VARCHAR	NULL	INTEGER	g1	MAP(VARCHAR, VARCHAR)	VARCHAR
ctg1	INTEGER	INTEGER	2.5	DOUBLE	NULL	VARCHAR	1	INTEGER	g2	MAP(VARCHAR, VARCHAR)	VARCHAR

# --- A field that is present but not a number ---
#
# Start and end must be integers, and score and phase numbers or '.'. A line that breaks
# this is malformed, so it fails the scan even when no number is read (COUNT(*)), instead
# of being counted as a feature and failing only when its position is selected.
foreach bad E'ctg1\tsrc\tgene\tabc\t50\t.\t+\t.\tID=g1' E'ctg1\tsrc\tgene\t1\t5O\t.\t+\t.\tID=g1' E'ctg1\tsrc\tgene\t1\t50\thigh\t+\t.\tID=g1' E'ctg1\tsrc\tCDS\t1\t50\t.\t+\tx\tID=g1'

statement ok
COPY (SELECT * FROM (VALUES (E'ctg1\tsrc\tgene\t1\t50\t1e3\t+\t0\tID=g0'), (${bad})) t(line))
TO '__TEST_DIR__/not_a_number.gff' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '', DELIMITER E'\x01');

statement error
SELECT COUNT(*) FROM read_gff('__TEST_DIR__/not_a_number.gff');
----
malformed GFF feature line (start, end, score or phase is not a number)

endloop

# --- '#' and '"' inside a line ---
#
# GFF3 has no end-of-line comments, and a seqid must escape '#', so only a line that starts
# with '#' is a comment or directive; a '#' later in a line is data. A value holding one,
# as an attribute value often does, comes back whole.
statement ok
COPY (SELECT * FROM (VALUES (E'ctg1\tsrc\tgene\t1\t50\t.\t+\t.\tID=g1;Note=see #3 for details;Name=abc')) t(line))
TO '__TEST_DIR__/hash_attribute.gff' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '', DELIMITER E'\x01');

query TTTI
SELECT attributes['ID'], attributes['Note'], attributes['Name'], cardinality(attributes)
FROM read_gff('__TEST_DIR__/hash_attribute.gff');
----
g1	see #3 for details	abc	3

# Comment and directive lines are skipped whatever they hold, tabs included. GFF3 has no
# quoting either, so a '"' is an ordinary character: an unmatched one in a comment must not
# swallow the feature lines after it, and a field that starts with one reads as written.
statement ok
COPY (SELECT * FROM (VALUES (E'##gff-version 3'), (E'# made by "tool"'), (E'#\twith\ttabs'), (E'#\t"open'),
                            (E'ctg1\tsrc#2\tgene\t1\t50\t.\t+\t.\tID=g1'), (E'###'),
                            (E'ctg1\t"quoted\tgene\t60\t90\t.\t+\t.\tID=g2;Note=x"'))
                     t(line))
TO '__TEST_DIR__/hash.gff' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '', DELIMITER E'\x01');

query ITT
SELECT position, source, attributes['Note'] FROM read_gff('__TEST_DIR__/hash.gff') ORDER BY position;
----
1	src#2	NULL
60	"quoted	x"

# Every line is split into fields, comments included, so a comment line with more than the
# nine fields a feature line may have fails the scan rather than being read in part.
statement ok
COPY (SELECT * FROM (VALUES (E'#\ta\tb\tc\td\te\tf\tg\th\ti'), (E'ctg1\tsrc\tgene\t1\t50\t.\t+\t.\tID=g1')) t(line))
TO '__TEST_DIR__/wide_comment.gff' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '', DELIMITER E'\x01');

statement error
SELECT count(*) FROM read_gff('__TEST_DIR__/wide_comment.gff');
----
Expected Number of Columns: 9 Found: 10

# --- Composition with genome_coverage (issue #196) ---
#
# genome_coverage computes SUM(stop - start) over compressed intervals -- half-open
# arithmetic. Before normalization, read_gff -> genome_coverage under-counted EVERY feature
# by exactly one base, silently. This is the test that would have caught it: two features
# of 11 bases each on ctg1 (10-20 and 30-40 closed) plus one of 11 (50-60) = 33 covered.
statement ok
CREATE TABLE gc_feats AS
SELECT seqid AS reference, position, stop_position FROM read_gff('data/gff/withfasta.gff') WHERE seqid = 'ctg1';

statement ok
CREATE TABLE gc_totals AS SELECT 'g1' AS genome_id, 100::BIGINT AS total_length;

statement ok
CREATE TABLE gc_map AS SELECT 'ctg1' AS contig_id, 'g1' AS genome_id;

query TI
SELECT genome_id, covered FROM genome_coverage('gc_feats', 'gc_totals', 'gc_map');
----
g1	33

statement ok
DROP TABLE gc_feats;

statement ok
DROP TABLE gc_totals;

statement ok
DROP TABLE gc_map;
