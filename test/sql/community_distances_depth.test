# ── Claim 1: Jaccard on prominent clusters plateaus by 1000 seqs/sample ──────────
# Good (>=0.85) at 1000, and 100000 gives no substantial gain over 1000.
# seed=42: kmeans 0.68 (D10) -> 1.0 (D1000) -> 1.0 (D100000).
query I
SELECT (SELECT kmeans_quality FROM dq WHERE metric='jaccard' AND condition='prominent' AND depth=1000) >= 0.85
   AND (SELECT kmeans_quality FROM dq WHERE metric='jaccard' AND condition='prominent' AND depth=100000)
     - (SELECT kmeans_quality FROM dq WHERE metric='jaccard' AND condition='prominent' AND depth=1000) <= 0.05;
----
true

# ── Claim 2a: Gower on PROMINENT clusters is already effective at moderate depth ─
# (deep sequencing not needed when the clusters are prominent). seed=42: 1.0 @ D1000.
query I
SELECT (SELECT kmeans_quality FROM dq WHERE metric='gower' AND condition='prominent' AND depth=1000) >= 0.85;
----
true

# ── Claim 2b: Gower on SUBTLE clusters needs deep sequencing ─────────────────────
# poor (<0.85) at 10 and 1000, good (>=0.85) only at 100000, and strictly improving
# with depth. seed=42: 0.50 (D10) -> 0.55 (D1000) -> 1.0 (D100000).
query I
SELECT (SELECT kmeans_quality FROM dq WHERE metric='gower' AND condition='subtle' AND depth=10) < 0.85
   AND (SELECT kmeans_quality FROM dq WHERE metric='gower' AND condition='subtle' AND depth=1000) < 0.85
   AND (SELECT kmeans_quality FROM dq WHERE metric='gower' AND condition='subtle' AND depth=100000) >= 0.85
   AND (SELECT kmeans_quality FROM dq WHERE metric='gower' AND condition='subtle' AND depth=100000)
     > (SELECT kmeans_quality FROM dq WHERE metric='gower' AND condition='subtle' AND depth=1000);
----
true

# ── Claim 3: Morisita-Horn on subtle clusters fails at EVERY depth ───────────────
# k-means quality stays below 0.85 at 10, 1000 and 100000 (persists even at 10M in
# the paper). seed=42: max over depths ~0.47.
query I
SELECT (SELECT max(kmeans_quality) FROM dq WHERE metric='morisita_horn' AND condition='subtle') < 0.85;
----
true

# ── Claim 4: the metric matters even at huge depth (variance != recovery) ────────
# At 100000 seqs, Gower recovers the subtle clusters while Morisita-Horn does not,
# for the SAME data. seed=42: Gower 1.0 vs Morisita-Horn 0.42.
query I
SELECT (SELECT kmeans_quality FROM dq WHERE metric='gower' AND condition='subtle' AND depth=100000)
     - (SELECT kmeans_quality FROM dq WHERE metric='morisita_horn' AND condition='subtle' AND depth=100000) > 0.4;
----
true
