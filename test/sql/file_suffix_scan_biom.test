# name: test/sql/file_suffix_scan_biom.test
# description: A .biom file named in FROM is read by read_biom, in a build that reads BIOM
# group: [sql]

require miint

require-env HDF5_AVAILABLE

# FROM 'x.biom' is shorthand for FROM read_biom('x.biom') and nothing else.
query I
SELECT count(*) FROM 'data/biom/test.biom'
----
15

query I
SELECT count(*) FROM ((FROM 'data/biom/test.biom' EXCEPT ALL FROM read_biom('data/biom/test.biom'))
            UNION ALL (FROM read_biom('data/biom/test.biom') EXCEPT ALL FROM 'data/biom/test.biom'))
----
0

# A .biom file is HDF5 and never gzip, so .biom.gz is not claimed: DuckDB says no reader
# handles it instead of read_biom failing on it. What the file holds is never read.
statement ok
COPY (SELECT 1 AS x) TO '{TEST_DIR}/fss_unclaimed.biom.gz' (FORMAT csv, COMPRESSION gzip);

statement error
FROM '{TEST_DIR}/fss_unclaimed.biom.gz'
----
No extension found that is capable of reading the file
