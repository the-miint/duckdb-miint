# =============================================================================
# Each relation is read exactly once, at execution. The volatility sits in a column
# the read must evaluate (an unreferenced nextval() would be pruned; see
# rype_single_read.test), and it is inert.
# =============================================================================

statement ok
CREATE SEQUENCE tree_seq START 1;

statement ok
CREATE SEQUENCE targets_seq START 1;

statement ok
CREATE SEQUENCE queries_seq START 1;

statement ok
CREATE VIEW ex1_volatile AS
SELECT node_index, parent_index, name, branch_length + 0 * nextval('tree_seq') AS branch_length FROM ex1;

statement ok
CREATE VIEW targets_volatile AS SELECT concat(name, repeat('x', 0 * nextval('targets_seq'))) AS name FROM ex1_targets;

statement ok
CREATE VIEW queries_volatile AS SELECT concat(name, repeat('x', 0 * nextval('queries_seq'))) AS name FROM ex1_queries;

# EXPLAIN binds without executing, and binding reads no rows.
statement ok
EXPLAIN SELECT * FROM tree_nearest_tip('ex1_volatile', 'targets_volatile', 'queries_volatile');

query TTR
SELECT query, target, round(distance, 12)
FROM tree_nearest_tip('ex1_volatile', 'targets_volatile', 'queries_volatile') ORDER BY query;
----
B	A	0.3
F	A	1.9
G	A	2.0

# 10 tree rows, 2 targets, 3 queries, each evaluated once (a root length is NULL, and
# NULL + 0 * nextval still evaluates nextval).
query III
SELECT currval('tree_seq'), currval('targets_seq'), currval('queries_seq');
----
10	2	3

# One relation as both targets and queries (every tip against the others, the call that
# exclude_self is for) is read once too, so both roles see the same rows. Identifiers are
# case-insensitive, so it is the same relation however its name is spelled.
statement ok
CREATE SEQUENCE both_seq START 1;

statement ok
CREATE VIEW both_volatile AS SELECT concat(name, repeat('x', 0 * nextval('both_seq'))) AS name FROM ex1 WHERE is_tip;

query TTR
SELECT query, target, round(distance, 12) FROM tree_nearest_tip('ex1', 'both_volatile', 'BOTH_VOLATILE') ORDER BY query;
----
A	B	0.3
B	A	0.3
D	A	1.3
F	G	1.3
G	F	1.3

# 5 tips, evaluated once.
query I
SELECT currval('both_seq');
----
5

# Planning reads no rows: a view whose rows cannot be read still plans.
statement ok
CREATE VIEW boom AS SELECT CAST(error('read at planning') AS VARCHAR) AS name FROM ex1_targets;

statement ok
EXPLAIN SELECT * FROM tree_nearest_tip('ex1', 'boom', 'ex1_queries');

statement error
SELECT * FROM tree_nearest_tip('ex1', 'boom', 'ex1_queries');
----
read at planning

# =============================================================================
# Enough queries for several threads: every query answered exactly once, and the
# answers do not depend on how many threads share the work.
# A caterpillar of 5000 tips, every edge of length 1: t_i (i >= 2) hangs off the node
# above t_(i-1)'s. t_0 and t_1 are siblings at 2; t_2 is 3 from t_0, t_1 and t_3; every
# later t_i is 3 from both neighbours (the last from its one), and the tie goes to the
# neighbour whose name sorts first as text, so t_11 beats t_9.
# =============================================================================

statement ok
CREATE TABLE cat_newick AS
SELECT repeat('(', 4999) || 't0:1,t1:1' || string_agg('):1,t' || i || ':1', '' ORDER BY i) || ');' AS nwk
FROM generate_series(2, 4999) AS s(i);

statement ok
COPY cat_newick TO '{TEST_DIR}/caterpillar.nwk' (FORMAT csv, HEADER false, DELIMITER E'\t');

statement ok
CREATE TABLE cat AS SELECT * FROM read_newick('{TEST_DIR}/caterpillar.nwk');

statement ok
CREATE TABLE cat_tips AS SELECT name FROM cat WHERE is_tip;

statement ok
SET threads = 8;

statement ok
CREATE TABLE cat_many AS SELECT * FROM tree_nearest_tip('cat', 'cat_tips', 'cat_tips');

statement ok
SET threads = 1;

statement ok
CREATE TABLE cat_one AS SELECT * FROM tree_nearest_tip('cat', 'cat_tips', 'cat_tips');

query III
SELECT count(*), count(DISTINCT query), count(*) FILTER (WHERE target IS NULL) FROM cat_many;
----
5000	5000	0

query I
SELECT (SELECT count(*) FROM (SELECT * FROM cat_many EXCEPT ALL SELECT * FROM cat_one))
     + (SELECT count(*) FROM (SELECT * FROM cat_one EXCEPT ALL SELECT * FROM cat_many));
----
0

query TTRI
SELECT query, target, distance, n_tied FROM cat_many WHERE query IN ('t0', 't1', 't2', 't3', 't4999') ORDER BY query;
----
t0	t1	2.0	1
t1	t0	2.0	1
t2	t0	3.0	3
t3	t2	3.0	2
t4999	t4998	3.0	1

query I
SELECT count(*) FROM (SELECT *, CAST(substr(query, 2) AS BIGINT) AS i FROM cat_many)
WHERE i BETWEEN 3 AND 4998
  AND NOT (target = least('t' || (i - 1), 't' || (i + 1)) AND distance = 3 AND n_tied = 2);
----
0

statement ok
RESET threads;
