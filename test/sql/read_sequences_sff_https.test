# name: test/sql/read_sequences_sff_https.test
# description: Test read_sequences_sff from HTTP URL
# group: [sql]

# `make test` skips this file because httpfs is not linked into unittest;
# run_tests.sh runs it in its httpfs pass.

require miint

require httpfs

require-env MIINT_HTTPS_TEST_URL

# SFF via HTTP
query I
SELECT COUNT(*) FROM read_sequences_sff('${MIINT_HTTPS_TEST_URL}/sff/basic_2reads.sff');
----
2

# Multiple remote SFF files
query I
SELECT COUNT(*) FROM read_sequences_sff([
    '${MIINT_HTTPS_TEST_URL}/sff/basic_2reads.sff',
    '${MIINT_HTTPS_TEST_URL}/sff/single_read.sff'
]);
----
3

