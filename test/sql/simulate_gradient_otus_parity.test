query I
WITH depths AS (SELECT sample_id, sum("count") d, any_value(gradient_position) pos FROM g_sn100 GROUP BY sample_id),
     shared AS (SELECT a.sample_id sa, b.sample_id sb, sum(least(a."count", b."count")) c
                FROM g_sn100 a JOIN g_sn100 b ON a.otu_id=b.otu_id AND a.sample_id < b.sample_id
                GROUP BY a.sample_id, b.sample_id),
     bc AS (SELECT 1.0 - 2.0*coalesce(sh.c,0)/(da.d+db.d) bcval, abs(da.pos-db.pos) dpos
            FROM depths da JOIN depths db ON da.sample_id < db.sample_id
            LEFT JOIN shared sh ON sh.sa=da.sample_id AND sh.sb=db.sample_id),
     s AS (SELECT corr(bcval, dpos) v FROM bc)
SELECT count(*) FROM s, grad_oracle o
WHERE o.param_set='gradient_subtle_N100_D1000' AND o.statistic='dist_decay_corr' AND (s.v < o.lo OR s.v > o.hi);
----
0

# Cross-check: distance-decay is stronger for prominent (c=0.5) than subtle (c=1.0)
# -- the qualitative Kuczynski-2010 gradient signature. g_pn20/g_sn20 share seed,
# num_samples and species count, so their optima + underlying standard-normal draws
# are common (only the noise scale differs, 0.5x vs 1.0x): a coupled comparison, not
# two independent draws. A margin of 0.1 keeps it robust without depending on that
# coupling being exact (oracle means differ by ~0.44, far above the margin).
query I
WITH corr_of AS (
  SELECT 'p20' k, corr(bcval,dpos) v FROM (
    SELECT 1.0-2.0*coalesce(sh.c,0)/(da.d+db.d) bcval, abs(da.pos-db.pos) dpos
    FROM (SELECT sample_id,sum("count") d,any_value(gradient_position) pos FROM g_pn20 GROUP BY sample_id) da
    JOIN (SELECT sample_id,sum("count") d,any_value(gradient_position) pos FROM g_pn20 GROUP BY sample_id) db ON da.sample_id<db.sample_id
    LEFT JOIN (SELECT a.sample_id sa,b.sample_id sb,sum(least(a."count",b."count")) c FROM g_pn20 a JOIN g_pn20 b ON a.otu_id=b.otu_id AND a.sample_id<b.sample_id GROUP BY 1,2) sh ON sh.sa=da.sample_id AND sh.sb=db.sample_id)
  UNION ALL
  SELECT 's20' k, corr(bcval,dpos) v FROM (
    SELECT 1.0-2.0*coalesce(sh.c,0)/(da.d+db.d) bcval, abs(da.pos-db.pos) dpos
    FROM (SELECT sample_id,sum("count") d,any_value(gradient_position) pos FROM g_sn20 GROUP BY sample_id) da
    JOIN (SELECT sample_id,sum("count") d,any_value(gradient_position) pos FROM g_sn20 GROUP BY sample_id) db ON da.sample_id<db.sample_id
    LEFT JOIN (SELECT a.sample_id sa,b.sample_id sb,sum(least(a."count",b."count")) c FROM g_sn20 a JOIN g_sn20 b ON a.otu_id=b.otu_id AND a.sample_id<b.sample_id GROUP BY 1,2) sh ON sh.sa=da.sample_id AND sh.sb=db.sample_id)
)
SELECT (SELECT v FROM corr_of WHERE k='p20') - (SELECT v FROM corr_of WHERE k='s20') > 0.1;
----
true
