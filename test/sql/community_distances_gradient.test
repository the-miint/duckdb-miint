SELECT 'gower', 0.5,
       abs((SELECT corr(c0, gp) FROM j)),
       abs((SELECT corr(rc0::DOUBLE, rgp::DOUBLE) FROM r)),
       abs((SELECT corr(c1, (gp - (SELECT v FROM mg)) * (gp - (SELECT v FROM mg))) FROM j));

# ── Claim 1: every metric recovers the gradient on PC1 when clean ───────────────
# (|Pearson| and |Spearman| of PC1 vs true position both high). seed=42: chi2
# 0.99, euclidean 0.98, gower 0.95 — threshold 0.85 with margin.
query I
SELECT count(*) FROM gq WHERE noise = 0.0 AND (pc1_pearson <= 0.85 OR pc1_spearman <= 0.85);
----
0

# ── Claim 2: no metric escapes the arch when clean (strong PC2 quadratic) ───────
# seed=42 PC2-arch: chi2 0.96, euclidean 0.97, gower 0.93 — threshold 0.85.
query I
SELECT count(*) FROM gq WHERE noise = 0.0 AND pc2_arch <= 0.85;
----
0

# Euclidean specifically shows the strong arch the paper highlights (> 0.9).
query I
SELECT pc2_arch > 0.9 FROM gq WHERE metric = 'euclidean' AND noise = 0.0;
----
true

# ── Claim 3: chi-square is noise-robust; Gower degrades ─────────────────────────
# At noise 0.5, chi-square keeps strong PC1 recovery (> 0.80; seed=42 0.86),
# while Gower has clearly collapsed (< 0.80; seed=42 0.04).
query I
SELECT pc1_pearson > 0.80 FROM gq WHERE metric = 'chisq' AND noise = 0.5;
----
true

query I
SELECT pc1_pearson < 0.80 FROM gq WHERE metric = 'gower' AND noise = 0.5;
----
true

# chi-square recovery under noise strictly exceeds Gower's (robust > sensitive).
query I
SELECT (SELECT pc1_pearson FROM gq WHERE metric = 'chisq' AND noise = 0.5)
     > (SELECT pc1_pearson FROM gq WHERE metric = 'gower' AND noise = 0.5);
----
true

# ── Claim 4: chi-square degrades LESS than Gower under the same noise ───────────
# (chi2_clean - chi2_noisy) < (gower_clean - gower_noisy). seed=42: 0.13 < 0.92.
query I
SELECT ((SELECT pc1_pearson FROM gq WHERE metric = 'chisq' AND noise = 0.0)
      - (SELECT pc1_pearson FROM gq WHERE metric = 'chisq' AND noise = 0.5))
     < ((SELECT pc1_pearson FROM gq WHERE metric = 'gower' AND noise = 0.0)
      - (SELECT pc1_pearson FROM gq WHERE metric = 'gower' AND noise = 0.5));
----
true
