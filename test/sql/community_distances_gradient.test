# ===== Gower, no noise =====
statement ok
CREATE OR REPLACE TABLE g AS SELECT * FROM simulate_gradient_otus(getvariable('soil'), 50, 1000, noise := 0.0, seed := 42);

statement ok
CREATE OR REPLACE TABLE gf AS SELECT sample_id, otu_id AS feature_id, "count" AS value FROM g;

statement ok
CREATE OR REPLACE TABLE dd AS SELECT * FROM community_distances('gf', 'gower');

