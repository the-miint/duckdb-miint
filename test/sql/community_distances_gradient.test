# name: test/sql/community_distances_gradient.test
# description: Kuczynski-2010 Fig 2 gradient signatures via the EXACT paper metrics (chi-square / Euclidean / Gower) through simulate_gradient_otus -> community_distances -> pcoa
# group: [sql]

# Faithful reproduction of the paper's Fig-2 qualitative claims (not numeric
# parity — the paper's exact seeds/replicate counts are unpublished). The
# generative model is our shipped simulate_gradient_otus on the committed soil
# abundance vector (D=1000 seqs/sample, equal depth), the distances are the
# paper's exact metrics via community_distances, the ordination is classical
# PCoA via pcoa, and the quality metric is |corr| of a sample's PC coordinate
# vs its true gradient position. Equal per-sample depth means raw counts vs
# relative abundance only rescale distances, which does not change the PCoA
# shape or these correlations. Signatures verified seed-stable over 5 seeds; the
# committed thresholds use seed=42 with margin. The noisy runs pin noise_type
# explicitly so these thresholds cannot drift if the function's default changes
# (the clean runs skip perturbation entirely, so noise_type is dead there).
#
# Paper Fig-2 claims encoded below:
#   - every metric recovers the gradient on PC1 when clean; none escapes the
#     characteristic arch (strong PC2-vs-position quadratic) -- incl. Euclidean;
#   - chi-square is robust to per-sample noise (PC1 recovery stays high);
#   - Gower is good with no noise but degrades sharply under it.
#
# NOTE: community_distances/pcoa take a table NAME (resolved over a separate
# connection), so each stage is materialized as a real table, not a CTE.

require miint

# pcoa is registered only with the scikit-bio-binaries feature (MIINT_HAS_UNIFRAC).
require-env UNIFRAC_AVAILABLE

statement ok
CREATE TABLE soil AS SELECT * FROM read_csv_auto('data/simsurvey/soil_abundances.csv');

statement ok
SET VARIABLE soil = (SELECT list(abund ORDER BY idx) FROM soil);

# Per-(metric, noise) gradient-recovery quality, accumulated into one table so
# the assertions read as cross-metric / cross-noise comparisons.
statement ok
CREATE TABLE gq(metric VARCHAR, noise DOUBLE, pc1_pearson DOUBLE, pc1_spearman DOUBLE, pc2_arch DOUBLE);

# ===== chi-square, no noise =====
statement ok
CREATE OR REPLACE TABLE g AS SELECT * FROM simulate_gradient_otus(getvariable('soil'), 50, 1000, noise := 0.0, seed := 42);

statement ok
CREATE OR REPLACE TABLE gf AS SELECT sample_id, otu_id AS feature_id, "count" AS value FROM g;

statement ok
CREATE OR REPLACE TABLE dd AS SELECT * FROM community_distances('gf', 'chisq');

statement ok
CREATE OR REPLACE TABLE pc AS SELECT * FROM pcoa('dd', n_dims := 3, seed := 42);

statement ok
INSERT INTO gq
WITH pos AS (SELECT DISTINCT sample_id::VARCHAR sid, gradient_position gp FROM g),
     a0 AS (SELECT sample_id sid, coordinate c FROM pc WHERE axis = 0),
     a1 AS (SELECT sample_id sid, coordinate c FROM pc WHERE axis = 1),
     j AS (SELECT p.sid, p.gp, a0.c c0, a1.c c1 FROM pos p JOIN a0 USING (sid) JOIN a1 USING (sid)),
     r AS (SELECT gp, c0, c1, rank() OVER (ORDER BY gp) rgp, rank() OVER (ORDER BY c0) rc0 FROM j),
     mg AS (SELECT avg(gp) v FROM j)
SELECT 'chisq', 0.0,
       abs((SELECT corr(c0, gp) FROM j)),
       abs((SELECT corr(rc0::DOUBLE, rgp::DOUBLE) FROM r)),
       abs((SELECT corr(c1, (gp - (SELECT v FROM mg)) * (gp - (SELECT v FROM mg))) FROM j));

# ===== chi-square, noise 0.5 =====
statement ok
CREATE OR REPLACE TABLE g AS SELECT * FROM simulate_gradient_otus(getvariable('soil'), 50, 1000, noise := 0.5, noise_type := '+species', seed := 42);

statement ok
CREATE OR REPLACE TABLE gf AS SELECT sample_id, otu_id AS feature_id, "count" AS value FROM g;

statement ok
CREATE OR REPLACE TABLE dd AS SELECT * FROM community_distances('gf', 'chisq');

statement ok
CREATE OR REPLACE TABLE pc AS SELECT * FROM pcoa('dd', n_dims := 3, seed := 42);

statement ok
INSERT INTO gq
WITH pos AS (SELECT DISTINCT sample_id::VARCHAR sid, gradient_position gp FROM g),
     a0 AS (SELECT sample_id sid, coordinate c FROM pc WHERE axis = 0),
     a1 AS (SELECT sample_id sid, coordinate c FROM pc WHERE axis = 1),
     j AS (SELECT p.sid, p.gp, a0.c c0, a1.c c1 FROM pos p JOIN a0 USING (sid) JOIN a1 USING (sid)),
     r AS (SELECT gp, c0, c1, rank() OVER (ORDER BY gp) rgp, rank() OVER (ORDER BY c0) rc0 FROM j),
     mg AS (SELECT avg(gp) v FROM j)
SELECT 'chisq', 0.5,
       abs((SELECT corr(c0, gp) FROM j)),
       abs((SELECT corr(rc0::DOUBLE, rgp::DOUBLE) FROM r)),
       abs((SELECT corr(c1, (gp - (SELECT v FROM mg)) * (gp - (SELECT v FROM mg))) FROM j));

