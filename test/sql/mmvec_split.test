# name: test/sql/mmvec_split.test
# description: mmvec_train_test_split partitions samples reproducibly, and composes with fit/predict/score into a held-out evaluation (always run; fixtures are inline)
# group: [sql]

require miint

# Ten samples, four microbes, three metabolites, every cell nonzero. Generated by
# formula rather than typed out: these are INPUTS, not expected values, and nothing
# below asserts a number that came from the oracle -- P5 is about composition, so
# what matters is only that no feature column is all-zero (which mmvec_fit rejects)
# for any subset the split might choose.
statement ok
CREATE TABLE microbes AS
SELECT 'S' || lpad(CAST(s AS VARCHAR), 2, '0') AS sample_id,
       'm' || CAST(f AS VARCHAR) AS feature_id,
       CAST(1 + (s * 7 + f * 13) % 9 AS DOUBLE) AS value
FROM range(1, 11) a(s), range(1, 5) b(f);

statement ok
CREATE TABLE metabolites AS
SELECT 'S' || lpad(CAST(s AS VARCHAR), 2, '0') AS sample_id,
       'b' || CAST(f AS VARCHAR) AS feature_id,
       CAST(1 + (s * 5 + f * 11) % 7 AS DOUBLE) AS value
FROM range(1, 11) a(s), range(1, 4) b(f);

query II
SELECT count(DISTINCT sample_id), count(*) FROM microbes;
----
10	40

# ---------------------------------------------------------------------------
# Shape: one row per SAMPLE, not per cell, and sample_id keeps its own type.
# ---------------------------------------------------------------------------

query I
SELECT string_agg(column_name, ',') FROM (
  DESCRIBE SELECT * FROM mmvec_train_test_split('microbes', 0.3, 0)
);
----
sample_id,split

query I
SELECT count(*) FROM mmvec_train_test_split('microbes', 0.3, 0);
----
10

query I
SELECT count(*) FROM (
  SELECT DISTINCT sample_id FROM microbes
  EXCEPT
  SELECT sample_id FROM mmvec_train_test_split('microbes', 0.3, 0)
);
----
0

# ---------------------------------------------------------------------------
# It is a PARTITION: two labels, nothing lost, nothing in both. The pipeline below
# depends on this -- a sample that fell through the cracks would silently shrink
# the training set, and one in both would leak test data into the fit.
# ---------------------------------------------------------------------------

query I
SELECT count(*) FROM mmvec_train_test_split('microbes', 0.3, 0) WHERE split NOT IN ('train', 'test');
----
0

query II
SELECT count(*) FILTER (split = 'test'), count(*) FILTER (split = 'train')
FROM mmvec_train_test_split('microbes', 0.3, 0);
----
3	7

query I
SELECT count(DISTINCT sample_id) FROM mmvec_train_test_split('microbes', 0.3, 0);
----
10

# ---------------------------------------------------------------------------
# The test count is exactly round(n * test_fraction). 0.35 of 10 is the tie, and it
# rounds AWAY from zero to 4 -- pinned so nobody quietly swaps in a truncation.
# ---------------------------------------------------------------------------

query IIII
SELECT
  (SELECT count(*) FILTER (split = 'test') FROM mmvec_train_test_split('microbes', 0.0, 0)),
  (SELECT count(*) FILTER (split = 'test') FROM mmvec_train_test_split('microbes', 0.24, 0)),
  (SELECT count(*) FILTER (split = 'test') FROM mmvec_train_test_split('microbes', 0.35, 0)),
  (SELECT count(*) FILTER (split = 'test') FROM mmvec_train_test_split('microbes', 1.0, 0));
----
0	2	4	10

# ---------------------------------------------------------------------------
# Reproducibility, which is the whole reason this is a macro and not `random()`.
# ---------------------------------------------------------------------------

# Same seed, same answer.
query I
SELECT count(*) FROM (
  SELECT * FROM mmvec_train_test_split('microbes', 0.3, 0)
  EXCEPT ALL
  SELECT * FROM mmvec_train_test_split('microbes', 0.3, 0)
);
----
0

# THE assertion that makes "deterministic" mean something: the physical row order
# of the input is not information. The split is a function of (sample_id, seed),
# so a reversed table -- or one with every row duplicated -- must give the same
# partition, not merely the same counts.
statement ok
CREATE TABLE microbes_reversed AS SELECT * FROM microbes ORDER BY sample_id DESC, feature_id DESC;

statement ok
CREATE TABLE microbes_doubled AS SELECT * FROM microbes UNION ALL SELECT * FROM microbes;

query I
SELECT count(*) FROM (
  SELECT * FROM mmvec_train_test_split('microbes_reversed', 0.3, 0)
  EXCEPT ALL
  SELECT * FROM mmvec_train_test_split('microbes', 0.3, 0)
);
----
0

query I
SELECT count(*) FROM (
  SELECT * FROM mmvec_train_test_split('microbes_doubled', 0.3, 0)
  EXCEPT ALL
  SELECT * FROM mmvec_train_test_split('microbes', 0.3, 0)
);
----
0

# A different seed gives a different partition. A spot check on two seeds, not a
# guarantee about every pair -- with 10 choose 3 = 120 possible test sets, two
# seeds can coincide, and a test that demanded otherwise would be asserting
# something md5 does not promise.
query I
SELECT count(*) > 0 FROM (
  SELECT * FROM mmvec_train_test_split('microbes', 0.3, 7)
  EXCEPT
  SELECT * FROM mmvec_train_test_split('microbes', 0.3, 0)
);
----
true

# ... but the SIZE is a property of test_fraction alone, whatever the seed does.
query I
SELECT count(*) FILTER (split = 'test') FROM mmvec_train_test_split('microbes', 0.3, 7);
----
3

# THE PARTITION ITSELF, carved. Every other assertion in this file is a property
# that any pseudo-random assignment would satisfy, so this is the only one that
# pins WHICH function does the assigning -- swapping md5 for DuckDB's hash() passes
# all of them and fails only here.
#
# Pinning it is safe precisely BECAUSE it is md5: md5 is a specified algorithm, so
# this partition is the same one a reader gets after a DuckDB upgrade, in another
# session, on another platform. That is the property a recorded train/test split in
# a paper needs, and it is why the macro does not use hash() -- hash() is an
# internal detail free to change between versions, and this line would then be a
# fragile test of it rather than a durable test of us. If this ever fails, the
# question is what changed about the SPLIT, not what to update the expectation to.
query I
SELECT string_agg(sample_id, ',' ORDER BY sample_id)
FROM mmvec_train_test_split('microbes', 0.3, 0) WHERE split = 'test';
----
S01,S02,S09

# ---------------------------------------------------------------------------
# Id types pass through untouched, so the result joins back to the feature table
# without a cast. The PARTITION legitimately differs from the VARCHAR one -- the
# split is a function of the id as text, and '101' is not 'S01'.
# ---------------------------------------------------------------------------

statement ok
CREATE TABLE microbes_bigint AS
SELECT CAST(100 + CAST(substr(sample_id, 2) AS BIGINT) AS BIGINT) AS sample_id, feature_id, value FROM microbes;

query II
SELECT DISTINCT typeof(sample_id), typeof(split) FROM mmvec_train_test_split('microbes_bigint', 0.3, 0);
----
BIGINT	VARCHAR

query I
SELECT count(*) FILTER (split = 'test') FROM mmvec_train_test_split('microbes_bigint', 0.3, 0);
----
3

statement ok
CREATE TABLE microbes_uuid AS
SELECT CAST('00000000-0000-4000-8000-0000000000' || substr(sample_id, 2) AS UUID) AS sample_id, feature_id, value
FROM microbes;

query I
SELECT DISTINCT typeof(sample_id) FROM mmvec_train_test_split('microbes_uuid', 0.3, 0);
----
UUID

# ---------------------------------------------------------------------------
# Degenerate and invalid input.
# ---------------------------------------------------------------------------

statement ok
CREATE TABLE microbes_empty AS SELECT * FROM microbes WHERE false;

query I
SELECT count(*) FROM mmvec_train_test_split('microbes_empty', 0.3, 0);
----
0

# Out of range is an error, not a silent all-train or all-test. Both directions,
# because clamping either one would look reasonable and be wrong.
statement error
SELECT * FROM mmvec_train_test_split('microbes', 1.5, 0);
----
test_fraction must be in [0, 1], got 1.5

statement error
SELECT * FROM mmvec_train_test_split('microbes', -0.1, 0);
----
test_fraction must be in [0, 1], got -0.1

# NULL needs its own arm and cannot ride on the range test above. SQL's
# three-valued logic makes `NULL < 0 OR NULL > 1` evaluate to NULL, not true, so
# a NULL falls straight past a range test, makes n_test NULL, makes `rn <= n_test`
# NULL, and lands every sample in the ELSE branch. The failure mode is therefore
# not an error but a silent all-train split -- precisely what the range check
# exists to prevent, arriving through the one door it does not cover.
statement error
SELECT * FROM mmvec_train_test_split('microbes', NULL, 0);
----
test_fraction must not be NULL

# A NULL seed fails the same way for a different reason: md5(NULL || ...) is NULL
# for every row, so the ordering collapses to plain alphabetical by sample_id and
# the split looks seeded without being seeded.
statement error
SELECT * FROM mmvec_train_test_split('microbes', 0.3, NULL);
----
seed must not be NULL

# CHARACTERIZATION, not an endorsement: on an EMPTY relation neither guard fires.
# A table macro's body is evaluated per output row and CASE branches are lazy, so
# with no rows there is nothing to evaluate and a bad parameter passes unremarked.
#
# Left as-is deliberately. The guards exist to stop a silent all-train or
# all-test split, and with zero samples there is no split to get wrong -- empty
# in, empty out, which is what the valid-fraction case above already returns.
# Making a parameter check fire independently of the data would mean a
# row-independent UNION ALL branch with a typed NULL id column, which is real
# complexity in an already-dense macro for no change in outcome. Pinned here so
# the behaviour is a decision on record rather than something nobody noticed.
query II
SELECT (SELECT count(*) FROM mmvec_train_test_split('microbes_empty', 99.0, 0)),
       (SELECT count(*) FROM mmvec_train_test_split('microbes_empty', NULL, 0));
----
0	0

# ---------------------------------------------------------------------------
# THE PIPELINE: split -> fit on train -> restrict the test tables to the model's
# features -> predict -> score. This is the worked example the docs will carry, and
# the reason the split macro exists at all.
#
# The feature filter is not decoration. A sample-wise split routinely leaves
# test-only features behind, and both mmvec_predict and mmvec_score reject those by
# design (there is no P(Y | unknown microbe)). To make that case certain rather than
# lucky, the fixture below plants a rare feature on exactly the samples the split
# chose for test -- derived from the split itself, so it holds whichever samples
# md5 happens to pick and does not pin DuckDB's hashing.
# ---------------------------------------------------------------------------

statement ok
CREATE TABLE sample_split AS SELECT * FROM mmvec_train_test_split('microbes', 0.3, 42);

statement ok
CREATE TABLE microbes_aug AS
SELECT * FROM microbes
UNION ALL
SELECT sample_id, 'm_rare' AS feature_id, 3.0 AS value FROM sample_split WHERE split = 'test';

statement ok
CREATE TABLE metabolites_aug AS
SELECT * FROM metabolites
UNION ALL
SELECT sample_id, 'b_rare' AS feature_id, 2.0 AS value FROM sample_split WHERE split = 'test';

statement ok
CREATE TABLE x_train AS
SELECT * FROM microbes_aug WHERE sample_id IN (SELECT sample_id FROM sample_split WHERE split = 'train');

statement ok
CREATE TABLE y_train AS
SELECT * FROM metabolites_aug WHERE sample_id IN (SELECT sample_id FROM sample_split WHERE split = 'train');

statement ok
CREATE TABLE x_test AS
SELECT * FROM microbes_aug WHERE sample_id IN (SELECT sample_id FROM sample_split WHERE split = 'test');

statement ok
CREATE TABLE y_test AS
SELECT * FROM metabolites_aug WHERE sample_id IN (SELECT sample_id FROM sample_split WHERE split = 'test');

# The split really did hold data back, and the rare features really are test-only.
query IIII
SELECT (SELECT count(DISTINCT sample_id) FROM x_train),
       (SELECT count(DISTINCT sample_id) FROM x_test),
       (SELECT count(*) FROM x_train WHERE feature_id = 'm_rare'),
       (SELECT count(*) FROM x_test WHERE feature_id = 'm_rare');
----
7	3	0	3

statement ok
CREATE TABLE model AS SELECT * FROM mmvec_fit('x_train', 'y_train', dimensions := 2, max_iter := 200);

# The model was fitted on the four common microbes and the three common
# metabolites; the rare features are not in it, because the fit never saw them.
query III
SELECT count(DISTINCT x_feature_id) FILTER (modality = 'x'),
       count(DISTINCT y_feature_id) FILTER (modality = 'y'),
       count(*) FILTER (x_feature_id = 'm_rare' OR y_feature_id = 'b_rare')
FROM model;
----
4	3	0

# So the naive next step FAILS, and says exactly what to do about it. This is the
# expected experience of a first-time user, which is why the message carries the
# predicate rather than just the diagnosis.
statement error
SELECT * FROM mmvec_predict('model', 'x_test');
----
1 feature(s) the model was never fitted on (m_rare)

statement error
SELECT * FROM mmvec_score('model', 'x_test', 'y_test');
----
m_rare

# The documented fix, verbatim from the error message.
statement ok
CREATE TABLE x_test_filtered AS
SELECT * FROM x_test
WHERE feature_id IN (SELECT DISTINCT x_feature_id FROM model WHERE modality = 'x');

statement ok
CREATE TABLE y_test_filtered AS
SELECT * FROM y_test
WHERE feature_id IN (SELECT DISTINCT y_feature_id FROM model WHERE modality = 'y');

# Three held-out samples x three metabolites, each sample a composition.
query II
SELECT count(*), count(DISTINCT sample_id) FROM mmvec_predict('model', 'x_test_filtered');
----
9	3

query I
SELECT count(*) FROM (
  SELECT sample_id FROM mmvec_predict('model', 'x_test_filtered')
  GROUP BY sample_id HAVING abs(sum(proportion) - 1.0) > 1e-12
);
----
0

# The samples predicted for are exactly the held-out ones -- the fit never saw them.
query I
SELECT count(*) FROM (
  SELECT DISTINCT sample_id FROM mmvec_predict('model', 'x_test_filtered')
  EXCEPT
  SELECT sample_id FROM sample_split WHERE split = 'test'
);
----
0

# And the whole thing scores. Q^2 = 1 - SS_res/SS_tot with SS_res >= 0, so it is at
# most 1 for any model whatsoever; it is unbounded BELOW, so no lower bound is
# asserted -- a floor here would be a claim about how well this synthetic fixture
# generalizes, which is not what P5 is testing.
query II
SELECT count(*), bool_and(q_squared <= 1.0) FROM mmvec_score('model', 'x_test_filtered', 'y_test_filtered');
----
1	true

query I
SELECT isfinite(q_squared) FROM mmvec_score('model', 'x_test_filtered', 'y_test_filtered');
----
true
