# name: test/sql/predict_genes_validation.test
# description: predict_genes bind-time checks. Bind never starts gpl-boundary, so these run wherever the function is compiled in (PREDICT_GENES_AVAILABLE); predict_genes.test runs it.
# group: [sql]

require miint

require-env PREDICT_GENES_AVAILABLE

statement ok
CREATE TABLE contigs AS SELECT 'g' AS genome, 0 AS sequence_index, 'c1' AS read_id, 'ACGTACGTACGT' AS sequence1;

# genome_id is required: it defines what a genome is.
statement error
SELECT * FROM predict_genes('contigs');
----
genome_id

statement error
SELECT * FROM predict_genes('contigs', genome_id := 'nope');
----
nope

statement error
SELECT * FROM predict_genes('contigs', genome_id := NULL);
----
genome_id

statement error
SELECT * FROM predict_genes('missing_table', genome_id := 'genome');
----
missing_table

statement error
SELECT * FROM predict_genes(NULL, genome_id := 'genome');
----
non-NULL

# Prodigal is the only method.
statement error
SELECT * FROM predict_genes('contigs', genome_id := 'genome', method := 'glimmer');
----
glimmer

statement error
SELECT * FROM predict_genes('contigs', genome_id := 'genome', method := NULL);
----
method

# The input's columns.
statement ok
CREATE TABLE no_seq AS SELECT 'g' AS genome, 0 AS sequence_index, 'c1' AS read_id;

statement error
SELECT * FROM predict_genes('no_seq', genome_id := 'genome');
----
sequence1

statement ok
CREATE TABLE no_id AS SELECT 'g' AS genome, 0 AS sequence_index, 'ACGT' AS sequence1;

statement error
SELECT * FROM predict_genes('no_id', genome_id := 'genome');
----
read_id

statement ok
CREATE TABLE double_genome AS SELECT 1.5::DOUBLE AS genome, 0 AS sequence_index, 'c1' AS read_id, 'ACGT' AS sequence1;

statement error
SELECT * FROM predict_genes('double_genome', genome_id := 'genome');
----
DOUBLE

statement ok
CREATE TABLE double_id AS SELECT 'g' AS genome, 0 AS sequence_index, 1.5::DOUBLE AS read_id, 'ACGT' AS sequence1;

statement error
SELECT * FROM predict_genes('double_id', genome_id := 'genome');
----
read_id

statement ok
CREATE TABLE int_seq AS SELECT 'g' AS genome, 0 AS sequence_index, 'c1' AS read_id, 7 AS sequence1;

statement error
SELECT * FROM predict_genes('int_seq', genome_id := 'genome');
----
sequence1

# order_by: sequence_index by default, the column read_fastx adds; another relation names its own.
statement ok
CREATE TABLE no_index AS SELECT 'g' AS genome, 'c1' AS read_id, 'ACGT' AS sequence1, 'x' AS label;

statement error
SELECT * FROM predict_genes('no_index', genome_id := 'genome');
----
sequence_index

statement error
SELECT * FROM predict_genes('no_index', genome_id := 'genome', order_by := 'label');
----
order_by

# Metagenomic mode takes translation table 11 only. (The tables single-genome mode takes are gpl-boundary's, read
# when the call runs: predict_genes.test.)
statement error
SELECT * FROM predict_genes('contigs', genome_id := 'genome', meta_mode := true, trans_table := 4);
----
trans_table

# A model file is single-genome mode's.
statement error
SELECT * FROM predict_genes('contigs', genome_id := 'genome', meta_mode := true, training_path := 'x.trn');
----
training_path

statement error
SELECT * FROM predict_genes('contigs', genome_id := 'genome', training_path := '');
----
training_path

# NULL knobs are refused rather than read as their defaults.
statement error
SELECT * FROM predict_genes('contigs', genome_id := 'genome', meta_mode := NULL);
----
meta_mode

statement error
SELECT * FROM predict_genes('contigs', genome_id := 'genome', closed_ends := NULL);
----
closed_ends

# The output's columns, without running anything.
query II
SELECT column_name, column_type FROM (DESCRIBE SELECT * FROM predict_genes('contigs', genome_id := 'genome'));
----
genome_id	VARCHAR
read_id	VARCHAR
gene_index	INTEGER
position	BIGINT
stop_position	BIGINT
strand	VARCHAR
partial_left	BOOLEAN
partial_right	BOOLEAN
start_type	VARCHAR
rbs_motif	VARCHAR
rbs_spacer	VARCHAR
score	DOUBLE
cscore	DOUBLE
sscore	DOUBLE
rscore	DOUBLE
uscore	DOUBLE
tscore	DOUBLE
confidence	DOUBLE
gene_gc_content	DOUBLE
protein	VARCHAR
contig_length	BIGINT
contig_gc_content	DOUBLE
translation_table	INTEGER
uses_sd	BOOLEAN
meta_bin	INTEGER
model_desc	VARCHAR
model_gc_content	DOUBLE
status	VARCHAR
error	VARCHAR

# EXPLAIN binds without running the call.
statement ok
EXPLAIN SELECT * FROM predict_genes('contigs', genome_id := 'genome');

# -----------------------------------------------------------------------------
# Chunked input: a relation with chunk_data, keyed by read_id or feature_idx, its genomes from mapping_table
# -----------------------------------------------------------------------------
statement ok
CREATE TABLE chunks AS SELECT 'c1' AS read_id, 0 AS chunk_index, 'ACGTACGT' AS chunk_data;

statement ok
CREATE TABLE mapping AS SELECT 'c1' AS read_id, 'g' AS genome_id;

# Its output columns, read_id keeping the key's type and genome_id the mapping's.
query TT
SELECT column_name, column_type FROM (DESCRIBE SELECT * FROM predict_genes('chunks', mapping_table := 'mapping'))
WHERE column_name IN ('genome_id', 'read_id');
----
genome_id	VARCHAR
read_id	VARCHAR

statement ok
CREATE TABLE fchunks AS SELECT 7::BIGINT AS feature_idx, 0 AS chunk_index, 'ACGT'::BLOB AS chunk_data;

statement ok
CREATE TABLE fmapping AS SELECT 7::BIGINT AS feature_idx, 42::BIGINT AS genome_id;

query TT
SELECT column_name, column_type FROM (DESCRIBE SELECT * FROM predict_genes('fchunks', mapping_table := 'fmapping'))
WHERE column_name IN ('genome_id', 'read_id');
----
genome_id	BIGINT
read_id	BIGINT

statement error
SELECT * FROM predict_genes('chunks');
----
mapping_table

statement error
SELECT * FROM predict_genes('chunks', mapping_table := 'mapping', genome_id := 'genome_id');
----
genome_id is for a relation of a contig per row

statement error
SELECT * FROM predict_genes('chunks', mapping_table := 'mapping', order_by := 'chunk_index');
----
order_by is for a relation of a contig per row

statement error
SELECT * FROM predict_genes('contigs', genome_id := 'genome', mapping_table := 'mapping');
----
mapping_table is for chunked input

statement error
SELECT * FROM predict_genes('chunks', mapping_table := 'missing_mapping');
----
missing_mapping

statement ok
CREATE TABLE both_keys AS SELECT 'c1' AS read_id, 1::BIGINT AS feature_idx, 0 AS chunk_index, 'ACGT' AS chunk_data;

statement error
SELECT * FROM predict_genes('both_keys', mapping_table := 'mapping');
----
must have one key column, read_id or feature_idx, naming each chunk's contig (it has both)

statement ok
CREATE TABLE no_key AS SELECT 0 AS chunk_index, 'ACGT' AS chunk_data;

statement error
SELECT * FROM predict_genes('no_key', mapping_table := 'mapping');
----
(it has neither)

statement ok
CREATE TABLE chunks_no_index AS SELECT 'c1' AS read_id, 'ACGT' AS chunk_data;

statement error
SELECT * FROM predict_genes('chunks_no_index', mapping_table := 'mapping');
----
chunk_index

statement ok
CREATE TABLE text_index AS SELECT 'c1' AS read_id, 'a' AS chunk_index, 'ACGT' AS chunk_data;

statement error
SELECT * FROM predict_genes('text_index', mapping_table := 'mapping');
----
chunk_index column of 'text_index' must be an integer type

statement ok
CREATE TABLE int_data AS SELECT 'c1' AS read_id, 0 AS chunk_index, 5 AS chunk_data;

statement error
SELECT * FROM predict_genes('int_data', mapping_table := 'mapping');
----
chunk_data column of 'int_data' must be VARCHAR or BLOB

statement ok
CREATE TABLE double_key AS SELECT 1.5 AS read_id, 0 AS chunk_index, 'ACGT' AS chunk_data;

statement error
SELECT * FROM predict_genes('double_key', mapping_table := 'mapping');
----
read_id column of 'double_key' must be

statement ok
CREATE TABLE mapping_no_genome AS SELECT 'c1' AS read_id, 'g' AS genome;

statement error
SELECT * FROM predict_genes('chunks', mapping_table := 'mapping_no_genome');
----
mapping_table 'mapping_no_genome' must have read_id and genome_id

statement ok
CREATE TABLE mapping_double_genome AS SELECT 'c1' AS read_id, 1.5 AS genome_id;

statement error
SELECT * FROM predict_genes('chunks', mapping_table := 'mapping_double_genome');
----
genome_id column of mapping_table 'mapping_double_genome' must be

# A mapping_table keyed by the other key column.
statement error
SELECT * FROM predict_genes('chunks', mapping_table := 'fmapping');
----
mapping_table 'fmapping' must have read_id and genome_id
