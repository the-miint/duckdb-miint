statement error
SELECT * FROM massql('QUERY MS2DATA BLAH', 'spectra')
----
parse error

statement error
SELECT * FROM massql('', 'spectra')
----
empty query

# ===== Cycle 20: X offset patterns =====

# X offset pair: MS2PROD=X AND MS2PROD=X+100
# Spec 1: peaks 150,250 (diff 100). Spec 2: peaks 120,220,320,420 (diff 100).
query I rowsort
SELECT spectrum_index FROM massql('QUERY scannum(MS2DATA) WHERE MS2PROD=X AND MS2PROD=X+100', 'spectra')
----
1
2

# X offset triplet: only spectrum 2 has 3 peaks spaced by 100
query I
SELECT spectrum_index FROM massql('QUERY scannum(MS2DATA) WHERE MS2PROD=X AND MS2PROD=X+100 AND MS2PROD=X+200', 'spectra')
----
2

# X offset + metadata: RTMIN=1.7 eliminates spectrum 1 (RT=1.6)
query I
SELECT spectrum_index FROM massql('QUERY scannum(MS2DATA) WHERE MS2PROD=X AND MS2PROD=X+100 AND RTMIN=1.7', 'spectra')
----
2

# X offset with tolerance qualifier
query I rowsort
SELECT spectrum_index FROM massql('QUERY scannum(MS2DATA) WHERE MS2PROD=X:TOLERANCEMZ=0.1 AND MS2PROD=X+100', 'spectra')
----
1
2

# X offset with scaninfo aggregation
query II rowsort
SELECT spectrum_index, ms_level FROM massql('QUERY scaninfo(MS2DATA) WHERE MS2PROD=X AND MS2PROD=X+100', 'spectra')
----
1	2
2	2

# X offset no match
query I
SELECT COUNT(*) FROM massql('QUERY scannum(MS2DATA) WHERE MS2PROD=X AND MS2PROD=X+500', 'spectra')
----
0

# X offset snapshot: generated SQL uses WITH (no longer RECURSIVE)
query T
SELECT massql_to_sql('QUERY scannum(MS2DATA) WHERE MS2PROD=X AND MS2PROD=X+100', 'spectra') LIKE '%WITH %'
----
true

# ===== Cycle 21: Cross-level X (MS1MZ=X AND MS2PREC=X) =====

# Both MS2 spectra have precursors (200, 300) matching MS1 peaks
query I rowsort
SELECT spectrum_index FROM massql('QUERY scannum(MS2DATA) WHERE MS1MZ=X AND MS2PREC=X', 'spectra')
----
1
2

# Cross-level + metadata: CHARGE=2 keeps only spectrum 1
query I
SELECT spectrum_index FROM massql('QUERY scannum(MS2DATA) WHERE MS1MZ=X AND MS2PREC=X AND CHARGE=2', 'spectra')
----
1

# Cross-level with scaninfo aggregation
query II rowsort
SELECT spectrum_index, ms_level FROM massql('QUERY scaninfo(MS2DATA) WHERE MS1MZ=X AND MS2PREC=X', 'spectra')
----
1	2
2	2

# Cross-level snapshot: does NOT use WITH RECURSIVE
query T
SELECT massql_to_sql('QUERY scannum(MS2DATA) WHERE MS1MZ=X AND MS2PREC=X', 'spectra') LIKE '%WITH RECURSIVE%'
----
false

# Cross-level snapshot: uses mz_within for tolerance matching
query T
SELECT massql_to_sql('QUERY scannum(MS2DATA) WHERE MS1MZ=X AND MS2PREC=X', 'spectra') LIKE '%mz_within(%'
----
true

# ===== Cycle 22: Peak pair / iron pattern =====

# formula(Fe) as constant: no MS2 peaks near 55.93
query I
SELECT COUNT(*) FROM massql('QUERY scannum(MS2DATA) WHERE MS2PROD=formula(Fe)', 'spectra')
----
0

# Peak pair: MS2PROD=X AND MS2PROD=2*(X-10)
# X=120: 2*120-20=220 (peak at 220 ✓). X=220: 2*220-20=420 (peak at 420 ✓)
# Only spectrum 2 has the right peak spacing
query I
SELECT spectrum_index FROM massql('QUERY scannum(MS2DATA) WHERE MS2PROD=X AND MS2PROD=2*(X-10)', 'spectra')
----
2

# Peak pair with scaninfo aggregation
query II
SELECT spectrum_index, ms_level FROM massql('QUERY scaninfo(MS2DATA) WHERE MS2PROD=X AND MS2PROD=2*(X-10)', 'spectra')
----
2	2

# Peak pair with formula: valid query but no matches in this data
query I
SELECT COUNT(*) FROM massql('QUERY scannum(MS2DATA) WHERE MS2PROD=X AND MS2PROD=2*(X-formula(Fe))', 'spectra')
----
0

# Peak pair snapshot: uses WITH (no longer RECURSIVE)
query T
SELECT massql_to_sql('QUERY scannum(MS2DATA) WHERE MS2PROD=X AND MS2PROD=2*(X-10)', 'spectra') LIKE '%WITH %'
----
true

# ===== Phase 7 Cycle 9: Y-only transpiler =====

statement ok
CREATE TABLE y_test AS SELECT * FROM read_mzml('data/mzml/intensity_match.mzML');

# Y-only: ref at 150 (Y), match at 250 (Y*0.5), 10% tolerance
# Spectrum 0: 150->1000, 250->500 -> Y*0.5=500, actual=500 -> MATCH
# Spectrum 1: 150->1000, 250->490 -> Y*0.5=500, actual=490, within 10% -> MATCH
# Spectrum 2: 150->1000, 250->200 -> Y*0.5=500, actual=200, outside 10% -> NO MATCH
# Spectrum 3: 150->1000, 250->500 -> Y*0.5=500, actual=500 -> MATCH
query I rowsort
SELECT spectrum_index FROM massql('QUERY scannum(MS2DATA) WHERE MS2PROD=150:INTENSITYMATCH=Y:INTENSITYMATCHREFERENCE AND MS2PROD=250:INTENSITYMATCH=Y*0.5:INTENSITYMATCHPERCENT=10', 'y_test')
----
0
1
3

# ===== Phase 7 Cycle 10: X+Y offset pattern =====

statement ok
CREATE TABLE ixy AS SELECT * FROM read_mzml('data/mzml/isotope_pattern_xy.mzML');

# X+Y isotope pattern: ref at X (Y), match at X+1.003 (Y*0.30 ± 30%)
# Spectrum 0: 500->10000, 501.003->3000 -> Y*0.30=3000, actual=3000 -> MATCH
# Spectrum 1: 600->8000, 601.003->5000 -> Y*0.30=2400, actual=5000, outside 30% -> NO
# Spectrum 2: 700->5000, 701.003->1500 -> Y*0.30=1500, actual=1500 -> MATCH
query I rowsort
SELECT spectrum_index FROM massql('QUERY scannum(MS1DATA) WHERE MS1MZ=X:TOLERANCEMZ=0.01:INTENSITYMATCH=Y:INTENSITYMATCHREFERENCE AND MS1MZ=X+1.003:TOLERANCEMZ=0.01:INTENSITYMATCH=Y*0.30:INTENSITYMATCHPERCENT=30', 'ixy')
----
0
2

# ===== Phase 7 Cycle 12: Y + non-Y composition =====

# Y-pattern + metadata filter (RTMIN): only spectra with RT >= 2.0
# From y_test: spectra 0(RT=1), 1(RT=2), 2(RT=3), 3(RT=4)
# Y-match: spectra 0,1,3 match Y*0.5 ± 10%
# RTMIN=2: filters to RT >= 2.0 -> spectra 1,2,3 survive
# Intersection: spectra 1 and 3
query I rowsort
SELECT spectrum_index FROM massql('QUERY scannum(MS2DATA) WHERE MS2PROD=150:INTENSITYMATCH=Y:INTENSITYMATCHREFERENCE AND MS2PROD=250:INTENSITYMATCH=Y*0.5:INTENSITYMATCHPERCENT=10 AND RTMIN=2', 'y_test')
----
1
3

# Y-pattern with FILTER clause: return only peaks near mz=250
query I
SELECT COUNT(*) FROM massql('QUERY MS2DATA WHERE MS2PROD=150:INTENSITYMATCH=Y:INTENSITYMATCHREFERENCE AND MS2PROD=250:INTENSITYMATCH=Y*0.5:INTENSITYMATCHPERCENT=10 FILTER MS2PROD=250', 'y_test')
----
3

# ===== Phase 7 Cycle 11: X-dependent Y expression =====

# X+Y with X-dependent Y expression: Y*(0.30+(0.0*X)) is equivalent to Y*0.30 (x_coeff=0 simplifies)
# This tests the code path where y_expr_has_x=true but result is effectively same
query I rowsort
SELECT spectrum_index FROM massql('QUERY scannum(MS1DATA) WHERE MS1MZ=X:TOLERANCEMZ=0.01:INTENSITYMATCH=Y:INTENSITYMATCHREFERENCE AND MS1MZ=X+1.003:TOLERANCEMZ=0.01:INTENSITYMATCH=Y*(0.30+(0.0*X)):INTENSITYMATCHPERCENT=30', 'ixy')
----
0
2

# ===== Phase 7 Cycle 13: OTHERSCAN qualifier =====

# OTHERSCAN: peak at mz=250 found in scan 0 (RT=1.0). RT window ±1.5 covers scans 0,1,2.
# y_test: spectra 0(RT=1), 1(RT=2), 2(RT=3), 3(RT=4). All have mz=250 peak.
# Scan 0 has mz=250 (within 0.1 Da). RT window ±1.5 from RT=1.0 covers RT=[0,2.5] -> scans 0,1.
# Scan 1 also has mz=250 (within default tolerance). RT window ±1.5 from RT=2.0 covers RT=[0.5,3.5] -> scans 0,1,2.
# Scan 2 also has mz=250. RT window ±1.5 from RT=3.0 covers RT=[1.5,4.5] -> scans 1,2,3.
# Scan 3 also has mz=250. RT window ±1.5 from RT=4.0 covers RT=[2.5,5.5] -> scans 2,3.
# Union: all 4 scans qualify
query I rowsort
SELECT spectrum_index FROM massql('QUERY scannum(MS2DATA) WHERE MS2PROD=250:OTHERSCAN=rtrange(left=1.5,right=1.5)', 'y_test')
----
0
1
2
3

# OTHERSCAN with narrow RT window: only scan 0 directly matches mz=350 with intensity >= 100
# (all scans have mz=350: spec 0->100, spec 1->100, spec 2->100, spec 3->500)
# Actually all scans have the peak. Window ±0.1 from each: basically just the scan itself.
# So result = all 4 scans (each matches directly, expands trivially to itself)
query I
SELECT COUNT(*) FROM massql('QUERY scannum(MS2DATA) WHERE MS2PROD=350:OTHERSCAN=rtrange(left=0.1,right=0.1)', 'y_test')
----
4

# OTHERSCAN SQL shape check: should contain a subquery JOIN pattern
query T
SELECT massql_to_sql('QUERY scannum(MS2DATA) WHERE MS2PROD=226.18:OTHERSCAN=rtrange(left=0.5,right=0.5)', 'spectra') LIKE '%retention_time%'
----
true

# ===== Phase 7 Cycle 16: Kitchen-sink composition tests =====

# Composition 1: aminoaciddelta + INTENSITYTICPERCENT + EXCLUDED
# aminoaciddelta(AG) folds to ~128.058 — no peaks at that m/z in our data
# EXCLUDED means "spectra that do NOT have this peak" — so all spectra qualify
# Using basic_3spectra data (3 spectra: 0=MS1, 1=MS2, 2=MS2)
query I
SELECT COUNT(*) FROM massql('QUERY scannum(MS2DATA) WHERE MS2PROD=aminoaciddelta(AG):INTENSITYTICPERCENT=5:EXCLUDED', 'spectra')
----
2

# Composition 2: scanrangesum + ANY (no m/z filter, all peaks binned)
# All MS2 peaks from spectra in basic_3spectra get binned
query I
SELECT COUNT(*) > 0 AS has_rows FROM massql('QUERY scanrangesum(MS2DATA) WHERE MS2PROD=ANY', 'spectra')
----
true

# Composition 3: OTHERSCAN + metadata filter (RTMIN)
# y_test: spectra 0(RT=1), 1(RT=2), 2(RT=3), 3(RT=4). All have mz=150.
# RTMIN=3 limits base to RT >= 3.0 -> spectra 2,3
# mz=150 matches in both spec 2,3. OTHERSCAN ±0.5 expands trivially (RT diff is 1.0 > 0.5)
# Spec 2 (RT=3): nearby is only spec 2 itself (RT=2 is 1.0 away > 0.5 from RT=3). Actually no,
# spec 3 (RT=4) is 1.0 away from spec 2, also > 0.5. So each scan only expands to itself.
# Both spec 2 and 3 have mz=150, so both qualify.
query I rowsort
SELECT spectrum_index FROM massql('QUERY scannum(MS2DATA) WHERE MS2PROD=150:OTHERSCAN=rtrange(left=0.5,right=0.5) AND RTMIN=3', 'y_test')
----
2
3

# Composition 4: Y-pattern + EXCLUDED (non-Y condition)
# Y-match: spectra 0,1,3 match Y*0.5 ± 10%
# EXCLUDED MS2PROD=350 with INTENSITYVALUE=400: spectra where mz=350 has intensity >= 400
# intensity_match data: spec 0: 350->100, spec 1: 350->100, spec 2: 350->100, spec 3: 350->500
# So INTENSITYVALUE=400 at mz=350 matches only spec 3. EXCLUDED = NOT IN {3}.
# Y-match ∩ NOT {3} = {0, 1}
query I rowsort
SELECT spectrum_index FROM massql('QUERY scannum(MS2DATA) WHERE MS2PROD=150:INTENSITYMATCH=Y:INTENSITYMATCHREFERENCE AND MS2PROD=250:INTENSITYMATCH=Y*0.5:INTENSITYMATCHPERCENT=10 AND MS2PROD=350:INTENSITYVALUE>400:EXCLUDED', 'y_test')
----
0
1

# Composition 5: MATCHCOUNT with INTENSITYPERCENT
# basic_3spectra: spec 1 has peaks at 150(i_norm=1.0), 250(i_norm=0.5)
# spec 2 has peaks at 120(0.2), 220(1.0), 320(0.48), 420(0.32)
# OR list (150 OR 250) with MATCHCOUNT range(min=2,max=2) + INTENSITYPERCENT=10
# spec 1: 150(1.0>=0.1 ✓) and 250(0.5>=0.1 ✓) → count=2 → match
# spec 2: no 150 or 250 → count=0 → no match
query I
SELECT spectrum_index FROM massql('QUERY scannum(MS2DATA) WHERE MS2PROD=(150 OR 250):MATCHCOUNT=range(min=2,max=2):INTENSITYPERCENT=10', 'spectra')
----
1

# ===== Error: OTHERSCAN with OR list is unsupported =====

statement error
SELECT * FROM massql('QUERY scannum(MS2DATA) WHERE MS2PROD=(150 OR 250):OTHERSCAN=rtrange(left=0.5,right=0.5)', 'spectra')
----
OTHERSCAN is not supported with OR value lists
