# name: test/sql/read_mzxml_https.test
# description: Test read_mzxml from HTTP URL
# group: [sql]

# NOTE: Skipped in CI because httpfs is disabled at build time.
# Active coverage is in test/shell/read_https.sh (uses LOAD httpfs at runtime).

require miint

require httpfs

require-env MIINT_HTTPS_TEST_URL

# mzXML via HTTP
query I
SELECT COUNT(*) FROM read_mzxml(getenv('MIINT_HTTPS_TEST_URL') || '/mzxml/basic_3spectra.mzXML');
----
3

# Multiple remote mzXML files
query I
SELECT COUNT(*) FROM read_mzxml([
    getenv('MIINT_HTTPS_TEST_URL') || '/mzxml/basic_3spectra.mzXML',
    getenv('MIINT_HTTPS_TEST_URL') || '/mzxml/compressed.mzXML'
]);
----
4

