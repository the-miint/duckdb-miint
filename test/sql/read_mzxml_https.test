# name: test/sql/read_mzxml_https.test
# description: Test read_mzxml from HTTP URL
# group: [sql]

# `make test` skips this file because httpfs is not linked into unittest;
# run_tests.sh runs it in its httpfs pass.

require miint

require httpfs

require-env MIINT_HTTPS_TEST_URL

# mzXML via HTTP
query I
SELECT COUNT(*) FROM read_mzxml('${MIINT_HTTPS_TEST_URL}/mzxml/basic_3spectra.mzXML');
----
3

# Multiple remote mzXML files
query I
SELECT COUNT(*) FROM read_mzxml([
    '${MIINT_HTTPS_TEST_URL}/mzxml/basic_3spectra.mzXML',
    '${MIINT_HTTPS_TEST_URL}/mzxml/compressed.mzXML'
]);
----
4

