# name: test/sql/sylph_index_create.test
# description: test sylph_index_create table function (build a .syldb)
# group: [sql]

require miint

require-env SYLPH_AVAILABLE

# --- registration ---------------------------------------------------------

query I
SELECT count(*) FROM duckdb_functions() WHERE function_name = 'sylph_index_create';
----
1

query T
SELECT function_type FROM duckdb_functions() WHERE function_name = 'sylph_index_create';
----
table

# --- build a .syldb from the 3 bundled E. coli references -----------------
# One row per contig; filepath is the genome key (one GenomeSketch per file).
statement ok
CREATE TABLE refs AS
  SELECT * FROM read_fastx('data/sylph/tiny_refs/*.fasta.gz', include_filepath := true);

query I
SELECT count(DISTINCT filepath) FROM refs;
----
3

query TIII
SELECT regexp_replace(output_path, '.*/', ''), k, c, num_genomes
  FROM sylph_index_create(
    'refs', '{TEST_DIR}/miint_tiny.syldb',
    genome_id := 'filepath', order_by := 'sequence_index');
----
miint_tiny.syldb	31	200	3

# --- profile against our DB: full parity with the sylph CLI golden --------
# expected_profile.tsv is the sylph CLI's own sketch+profile output. Building
# with miint and profiling with miint must reproduce it exactly.
statement ok
CREATE TABLE k12_reads AS
  SELECT * FROM read_fastx(
    'data/sylph/tiny_reads_R1.fq.gz',
    sequence2 := 'data/sylph/tiny_reads_R2.fq.gz');

query TT
SELECT regexp_extract(genome_name, 'K12'),
       round(taxonomic_abundance, 2)
  FROM sylph_profile('k12_reads', '{TEST_DIR}/miint_tiny.syldb');
----
K12	100.00

# Every reported metric matches the CLI golden at its precision.
query TTTTI
SELECT round(taxonomic_abundance, 2),
       round(sequence_abundance, 2),
       round(adjusted_ani * 100.0, 2),
       round(naive_ani * 100.0, 2),
       kmers_reassigned
  FROM sylph_profile('k12_reads', '{TEST_DIR}/miint_tiny.syldb');
----
100.00	100.00	98.89	88.48	0

# Eff_cov golden 0.032 (band avoids 3rd-decimal FP flakiness).
query I
SELECT count(*) FROM sylph_profile('k12_reads', '{TEST_DIR}/miint_tiny.syldb')
  WHERE eff_cov BETWEEN 0.031 AND 0.033;
----
1

# --- parity against the committed CLI-built oracle DB ---------------------
# Profiling the same reads against our DB vs the oracle DB gives identical
# numbers (single K12 row each; compared to 6 dp).
query I
SELECT count(*)
  FROM sylph_profile('k12_reads', '{TEST_DIR}/miint_tiny.syldb') mine,
       sylph_profile('k12_reads', 'data/sylph/tiny.syldb') oracle
 WHERE round(mine.adjusted_ani, 6) = round(oracle.adjusted_ani, 6)
   AND round(mine.taxonomic_abundance, 6) = round(oracle.taxonomic_abundance, 6);
----
1

# contig_name matches exactly: a `comment` column triggers full-header
# reconstruction, matching sylph's first_contig_name.
query I
SELECT count(*)
  FROM sylph_profile('k12_reads', '{TEST_DIR}/miint_tiny.syldb') mine
  JOIN sylph_profile('k12_reads', 'data/sylph/tiny.syldb') oracle
    ON mine.contig_name = oracle.contig_name;
----
1

# --- parameters -----------------------------------------------------------

statement ok
SELECT num_genomes FROM sylph_index_create(
  'refs', '{TEST_DIR}/miint_query.syldb',
  genome_id := 'filepath', pseudotax := false);

query I
SELECT k FROM sylph_index_create(
  'refs', '{TEST_DIR}/miint_k21.syldb',
  genome_id := 'filepath', k := 21);
----
21

# BIGINT genome_id (Qiita uses BIGINT feature ids) builds the same 3 genomes.
statement ok
CREATE TABLE refs_bigint AS
  SELECT *, (hash(filepath) >> 1)::BIGINT AS feature_id
  FROM read_fastx('data/sylph/tiny_refs/*.fasta.gz', include_filepath := true);

query I
SELECT num_genomes FROM sylph_index_create(
  'refs_bigint', '{TEST_DIR}/miint_bigint.syldb',
  genome_id := 'feature_id', order_by := 'sequence_index');
----
3

# order_by picks the genome's contig_name: its contig with the lowest value, and on a tie (as
# when a genome comes from several files, each numbered from 1) the name that sorts last, as
# docs/profiling.md says. K12's one contig is split into two halves to make a two-contig genome.
statement ok
CREATE TABLE k12_halves AS
  WITH k12 AS (SELECT sequence1, length(sequence1) AS n
               FROM read_fastx('data/sylph/tiny_refs/e.coli-K12.fasta.gz'))
  SELECT 'g' AS genome, 'a_ctg' AS read_id, sequence1[1:n // 2] AS sequence1, 0 AS a_first, 1 AS tied FROM k12
  UNION ALL
  SELECT 'g', 'z_ctg', sequence1[n // 2 + 1:], 1, 1 FROM k12;

statement ok
SELECT * FROM sylph_index_create('k12_halves', '{TEST_DIR}/a_first.syldb', genome_id := 'genome', order_by := 'a_first');

statement ok
SELECT * FROM sylph_index_create('k12_halves', '{TEST_DIR}/tied.syldb', genome_id := 'genome', order_by := 'tied');

query TT
SELECT 'a_first', contig_name FROM sylph_profile('k12_reads', '{TEST_DIR}/a_first.syldb')
UNION ALL
SELECT 'tied', contig_name FROM sylph_profile('k12_reads', '{TEST_DIR}/tied.syldb')
ORDER BY 1;
----
a_first	a_ctg
tied	z_ctg

# --- error handling -------------------------------------------------------

# genome_id is required.
statement error
SELECT * FROM sylph_index_create('refs', '{TEST_DIR}/err.syldb');
----
genome_id

# Non-existent source table.
statement error
SELECT * FROM sylph_index_create('does_not_exist', '{TEST_DIR}/err.syldb', genome_id := 'filepath');
----

# Non-existent genome_id column.
statement error
SELECT * FROM sylph_index_create('refs', '{TEST_DIR}/err.syldb', genome_id := 'not_a_column');
----

# order_by defaults to read_fastx's sequence_index, so a source without that column names another.
statement ok
CREATE TABLE refs_no_index AS SELECT read_id, sequence1, filepath FROM refs;

statement error
SELECT * FROM sylph_index_create('refs_no_index', '{TEST_DIR}/err.syldb', genome_id := 'filepath');
----
<REGEX>:Binder Error: sylph_index_create: genome_id/order_by column check failed: .*sequence_index.*

# Unsupported k.
statement error
SELECT * FROM sylph_index_create('refs', '{TEST_DIR}/err.syldb', genome_id := 'filepath', k := 30);
----
k must be 21 or 31

# An order_by column that does not cast to BIGINT fails while a genome is read, on a worker
# thread; the error is the worker's own, not one wrapping DuckDB's serialized form of it.
statement error
SELECT * FROM sylph_index_create('refs', '{TEST_DIR}/err.syldb', genome_id := 'filepath', order_by := 'read_id');
----
<REGEX>:Invalid Input Error: sylph_index_create: failed to read genome .*: Conversion Error: Could not convert string .* to INT64.*

# When several genomes fail, the error is the first genome's in genome_id order, not the error
# that happened first, so a rerun reports the same genome. g1's order value comes only after a
# long aggregate, so g2, on the other thread, fails well before g1 does.
statement ok
CREATE VIEW two_bad_genomes AS
SELECT 'g1' AS genome, 'c1' AS read_id, 'ACGTACGTACGTACGTACGTACGTACGTACGTACGT' AS sequence1,
       (SELECT CASE WHEN sum(range % 7) > 0 THEN 'late' END FROM range(100000000)) AS ord
UNION ALL
SELECT 'g2', 'c2', 'ACGTACGTACGTACGTACGTACGTACGTACGTACGT', 'early';

statement error
SELECT * FROM sylph_index_create('two_bad_genomes', '{TEST_DIR}/err.syldb', genome_id := 'genome', order_by := 'ord',
                                 threads := 2);
----
<REGEX>:Invalid Input Error: sylph_index_create: failed to read genome g1: Conversion Error: Could not convert string 'late' to INT64.*
