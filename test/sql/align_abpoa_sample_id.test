# name: test/sql/align_abpoa_sample_id.test
# description: test align_abpoa sample_id named parameter
# group: [sql]

statement ok
PRAGMA enable_verification;

require miint

require-env ABPOA_AVAILABLE

# Build the base input: three 8bp DNA sequences with high similarity.
statement ok
CREATE TABLE abpoa_base AS
  SELECT read_id, sequence1 FROM read_fastx('data/mafft/tiny.fa');

# ----- Cycle 1: Error on invalid sample_id -----

statement ok
CREATE VIEW one_sample AS SELECT 'A' AS sample, * FROM abpoa_base;

statement error
SELECT * FROM align_abpoa('one_sample', sample_id := 'no_such_column')
----
sample_id column 'no_such_column' not found

statement error
SELECT * FROM align_abpoa('one_sample', sample_id := '')
----
sample_id column name must not be empty

# ----- Cycle 2: Output-column collision (case-insensitive) -----

statement error
SELECT * FROM align_abpoa('abpoa_base', sample_id := 'read_id')
----
collides with an output column

statement error
SELECT * FROM align_abpoa('abpoa_base', sample_id := 'sequence_index')
----
collides with an output column

statement error
SELECT * FROM align_abpoa('abpoa_base', sample_id := 'aligned_sequence')
----
collides with an output column

statement error
SELECT * FROM align_abpoa('abpoa_base', sample_id := 'ALIGNED_LENGTH')
----
collides with an output column

# ----- Cycle 3: Per-sample isolation with two samples -----

statement ok
CREATE VIEW multi_sample AS
  SELECT 'A' AS sample, * FROM abpoa_base
  UNION ALL
  SELECT 'B' AS sample, * FROM abpoa_base;

query TIITII
SELECT sample, sequence_index, read_id, aligned_sequence, original_length, aligned_length
  FROM align_abpoa('multi_sample', sample_id := 'sample')
  ORDER BY sample, sequence_index
----
A	0	s1	ACGTACGT	8	8
A	1	s2	ACGAACGT	8	8
A	2	s3	ACGTACGA	8	8
B	0	s1	ACGTACGT	8	8
B	1	s2	ACGAACGT	8	8
B	2	s3	ACGTACGA	8	8

# sequence_index is per-sample
query II
SELECT sample, MAX(sequence_index)
  FROM align_abpoa('multi_sample', sample_id := 'sample')
  GROUP BY sample ORDER BY sample
----
A	2
B	2

# ----- Cycle 4: Integer-typed sample_id round-trips -----

statement ok
CREATE VIEW int_sample AS
  SELECT 1 AS sample_num, * FROM abpoa_base
  UNION ALL
  SELECT 2 AS sample_num, * FROM abpoa_base;

query II
SELECT sample_num, COUNT(*)
  FROM align_abpoa('int_sample', sample_id := 'sample_num')
  GROUP BY sample_num ORDER BY sample_num
----
1	3
2	3

query T
SELECT typeof(sample_num) FROM align_abpoa('int_sample', sample_id := 'sample_num') LIMIT 1
----
INTEGER

# ----- Cycle 5: NULL sample values rejected at bind -----

statement ok
CREATE VIEW null_sample AS SELECT NULL::VARCHAR AS sid, * FROM abpoa_base;

statement error
SELECT * FROM align_abpoa('null_sample', sample_id := 'sid')
----
NULL values in sample_id column

# ----- Cycle 6: Empty relation -----

statement ok
CREATE VIEW empty_samples AS
  SELECT 'A' AS sample, * FROM abpoa_base WHERE 1=0;

statement error
SELECT * FROM align_abpoa('empty_samples', sample_id := 'sample')
----
has no non-NULL values

# ----- Cycle 7: Per-sample validation rules -----

statement ok
CREATE VIEW one_seq_sample AS
  SELECT 'A' AS sample, read_id, sequence1 FROM abpoa_base
  UNION ALL
  SELECT 'B' AS sample, 'solo' AS read_id, 'ACGTACGT' AS sequence1;

statement error
SELECT * FROM align_abpoa('one_seq_sample', sample_id := 'sample')
----
align_abpoa requires at least 2 sequences

# Duplicate read_id WITHIN a sample
statement ok
CREATE VIEW dup_within_sample AS
  SELECT 'A' AS sample, read_id, sequence1 FROM abpoa_base
  UNION ALL
  SELECT 'A', 's1', 'ACGTACGT';

statement error
SELECT * FROM align_abpoa('dup_within_sample', sample_id := 'sample')
----
duplicate read_id 's1'

# Same read_id across DIFFERENT samples is allowed
statement ok
CREATE VIEW same_id_diff_samples AS
  SELECT 'A' AS sample, * FROM abpoa_base
  UNION ALL
  SELECT 'B' AS sample, * FROM abpoa_base;

query TII
SELECT sample, read_id, sequence_index
  FROM align_abpoa('same_id_diff_samples', sample_id := 'sample')
  ORDER BY sample, sequence_index
----
A	s1	0
A	s2	1
A	s3	2
B	s1	0
B	s2	1
B	s3	2

# ----- Cycle 8: Single-sample equivalence -----

query ITTII
SELECT sequence_index, read_id, aligned_sequence, original_length, aligned_length
  FROM align_abpoa('one_sample', sample_id := 'sample')
  ORDER BY sequence_index
----
0	s1	ACGTACGT	8	8
1	s2	ACGAACGT	8	8
2	s3	ACGTACGA	8	8

# ----- Cycle 9: Parallelism (abPOA is thread-safe — true parallel execution) -----

statement ok
CREATE VIEW four_abpoa_samples AS
  SELECT 'A' AS sid, * FROM abpoa_base UNION ALL
  SELECT 'B' AS sid, * FROM abpoa_base UNION ALL
  SELECT 'C' AS sid, * FROM abpoa_base UNION ALL
  SELECT 'D' AS sid, * FROM abpoa_base;

statement ok
PRAGMA threads=4;

query TI
SELECT sid, COUNT(*) FROM align_abpoa('four_abpoa_samples', sample_id := 'sid')
  GROUP BY sid ORDER BY sid
----
A	3
B	3
C	3
D	3
