# ---------------------------------------------------------------------------
# The call itself. Checked at bind, before any relation is read.
# ---------------------------------------------------------------------------

statement error
SELECT * FROM absquant_cell_counts('b_counts', 'b_models', 'b_coverage', 'b_lengths', 'b_params',
                                   'cells_per_ul_of_sample', 0.1);
----
unsupported metric 'cells_per_ul_of_sample'; accepted: 'cells_per_g_of_gdna'

# The metric is a positional argument even though exactly one value is accepted,
# so that adding the three sample-level metrics adds VALUES rather than a new
# signature and a query written today keeps working.
query I
SELECT count(*) FROM absquant_cell_counts('b_counts', 'b_models', 'b_coverage', 'b_lengths', 'b_params',
                                          'CELLS_PER_G_OF_GDNA', 0.1);
----
7

statement error
SELECT * FROM absquant_cell_counts(NULL, 'b_models', 'b_coverage', 'b_lengths', 'b_params',
                                   'cells_per_g_of_gdna', 0.1);
----
argument 1 must not be NULL

statement error
SELECT * FROM absquant_cell_counts('b_counts', 'b_models', 'b_coverage', 'b_lengths', 'b_params',
                                   'cells_per_g_of_gdna', NULL);
----
argument 7 must not be NULL

statement error
SELECT * FROM absquant_cell_counts('b_counts', 'b_models', 'b_coverage', 'b_lengths', 'b_params',
                                   'cells_per_g_of_gdna', 0.1, min_rsquared := NULL);
----
min_rsquared must not be NULL

