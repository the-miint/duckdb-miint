# ---------------------------------------------------------------------------
# Both thresholds are constrained to [0, 1].
#
# min_coverage because coverage is a fraction here (D9) -- pysyndna accepts
# fractions or percents and explicitly leaves it to the caller to pass a
# matching threshold, which makes `min_coverage := 10` against fractional
# coverages a filter that silently keeps everything. min_rsquared because r^2 is
# a squared correlation and cannot leave [0, 1], so a threshold outside it keeps
# every sample or none with no indication which.
# ---------------------------------------------------------------------------

statement error
SELECT * FROM absquant_cell_counts('b_counts', 'b_models', 'b_coverage', 'b_lengths', 'b_params',
                                   'cells_per_g_of_gdna', 10.0);
----
min_coverage must be between 0 and 1 inclusive

statement error
SELECT * FROM absquant_cell_counts('b_counts', 'b_models', 'b_coverage', 'b_lengths', 'b_params',
                                   'cells_per_g_of_gdna', -0.1);
----
min_coverage must be between 0 and 1 inclusive

statement error
SELECT * FROM absquant_cell_counts('b_counts', 'b_models', 'b_coverage', 'b_lengths', 'b_params',
                                   'cells_per_g_of_gdna', 0.1, min_rsquared := 1.5);
----
min_rsquared must be between 0 and 1 inclusive

# Both endpoints are legal on both.
statement ok
SELECT * FROM absquant_cell_counts('b_counts', 'b_models', 'b_coverage', 'b_lengths', 'b_params',
                                   'cells_per_g_of_gdna', 1.0, min_rsquared := 0.0);

# ---------------------------------------------------------------------------
# The column contract for each relation, surfaced by its LIMIT 0 schema probe
# before anything is materialized. DuckDB's own candidate-binding hint comes
# along with the message.
# ---------------------------------------------------------------------------

statement ok
CREATE TABLE no_value AS SELECT sample_id, feature_id FROM b_counts;

statement error
SELECT * FROM absquant_cell_counts('no_value', 'b_models', 'b_coverage', 'b_lengths', 'b_params',
                                   'cells_per_g_of_gdna', 0.1);
----
must expose (sample_id VARCHAR, feature_id VARCHAR, value DOUBLE)

statement ok
CREATE TABLE no_slope AS SELECT sample_id, intercept, rvalue FROM b_models;

statement error
SELECT * FROM absquant_cell_counts('b_counts', 'no_slope', 'b_coverage', 'b_lengths', 'b_params',
                                   'cells_per_g_of_gdna', 0.1);
----
must expose (sample_id VARCHAR, slope DOUBLE, intercept DOUBLE, rvalue DOUBLE)

statement ok
CREATE TABLE no_coverage AS SELECT sample_id, feature_id FROM b_coverage;

statement error
SELECT * FROM absquant_cell_counts('b_counts', 'b_models', 'no_coverage', 'b_lengths', 'b_params',
                                   'cells_per_g_of_gdna', 0.1);
----
must expose (sample_id VARCHAR, feature_id VARCHAR, coverage DOUBLE)

statement ok
CREATE TABLE no_len AS SELECT feature_id FROM b_lengths;

statement error
SELECT * FROM absquant_cell_counts('b_counts', 'b_models', 'b_coverage', 'no_len', 'b_params',
                                   'cells_per_g_of_gdna', 0.1);
----
must expose (feature_id VARCHAR, ogu_len_in_bp DOUBLE)

statement ok
CREATE TABLE no_mass AS SELECT sample_id, extracted_gdna_concentration_ng_ul, vol_extracted_elution_ul FROM b_params;

statement error
SELECT * FROM absquant_cell_counts('b_counts', 'b_models', 'b_coverage', 'b_lengths', 'no_mass',
                                   'cells_per_g_of_gdna', 0.1);
----
must expose (sample_id VARCHAR, sequenced_sample_gdna_mass_ng DOUBLE, extracted_gdna_concentration_ng_ul DOUBLE, vol_extracted_elution_ul DOUBLE)

# ---------------------------------------------------------------------------
# Malformed relations. Each of these is structurally impossible input that
# pysyndna would carry through to an inf, a NaN or a silently missing row.
# ---------------------------------------------------------------------------

statement ok
CREATE TABLE dup_counts AS SELECT * FROM b_counts UNION ALL SELECT * FROM b_counts WHERE sample_id = 's1' AND feature_id = 'f_both';

statement error
SELECT * FROM absquant_cell_counts('dup_counts', 'b_models', 'b_coverage', 'b_lengths', 'b_params',
                                   'cells_per_g_of_gdna', 0.1);
----
the counts relation has more than one row for the same (sample_id, feature_id): 's1 / f_both'

statement ok
CREATE TABLE dup_coverage AS SELECT * FROM b_coverage UNION ALL SELECT * FROM b_coverage WHERE sample_id = 's1' AND feature_id = 'f_both';

statement error
SELECT * FROM absquant_cell_counts('b_counts', 'b_models', 'dup_coverage', 'b_lengths', 'b_params',
                                   'cells_per_g_of_gdna', 0.1);
----
the coverage relation has more than one row for the same (sample_id, feature_id): 's1 / f_both'

statement ok
CREATE TABLE dup_lengths AS SELECT * FROM b_lengths UNION ALL SELECT * FROM b_lengths WHERE feature_id = 'f_both';

statement error
SELECT * FROM absquant_cell_counts('b_counts', 'b_models', 'b_coverage', 'dup_lengths', 'b_params',
                                   'cells_per_g_of_gdna', 0.1);
----
the feature lengths relation has more than one row for feature_id 'f_both'

statement ok
CREATE TABLE dup_models AS SELECT * FROM b_models UNION ALL SELECT * FROM b_models WHERE sample_id = 's1';

statement error
SELECT * FROM absquant_cell_counts('b_counts', 'dup_models', 'b_coverage', 'b_lengths', 'b_params',
                                   'cells_per_g_of_gdna', 0.1);
----
the models relation has more than one row for sample_id 's1'

statement ok
CREATE TABLE dup_params AS SELECT * FROM b_params UNION ALL SELECT * FROM b_params WHERE sample_id = 's1';

statement error
SELECT * FROM absquant_cell_counts('b_counts', 'b_models', 'b_coverage', 'b_lengths', 'dup_params',
                                   'cells_per_g_of_gdna', 0.1);
----
the sample parameters relation has more than one row for sample_id 's1'

# A negative read count. Zero is not reachable here -- the reader drops
# zero-valued cells before the core sees them -- but negative reaches it.
statement ok
CREATE TABLE neg_counts AS
SELECT sample_id, feature_id, CASE WHEN sample_id = 's1' AND feature_id = 'f_both' THEN -1.0 ELSE value END AS value
FROM b_counts;

statement error
SELECT * FROM absquant_cell_counts('neg_counts', 'b_models', 'b_coverage', 'b_lengths', 'b_params',
                                   'cells_per_g_of_gdna', 0.1);
----
read counts must be finite and positive; offending (sample_id / feature_id): 's1 / f_both'

# Coverage as a percent. pysyndna's own fixtures store 92.597 and compare it
# against min_coverage = 10; handing those to miint's fractional threshold would
# keep every feature and quietly disable the filter.
statement ok
CREATE TABLE pct_coverage AS SELECT sample_id, feature_id, coverage * 100.0 AS coverage FROM b_coverage;

statement error
SELECT * FROM absquant_cell_counts('b_counts', 'b_models', 'pct_coverage', 'b_lengths', 'b_params',
                                   'cells_per_g_of_gdna', 0.1);
----
coverage must be present and a fraction between 0 and 1 inclusive, not a percent

# A NULL coverage arrives as NaN and fails the same test, which is why the
# message says "present" as well as in-range.
statement ok
CREATE TABLE null_coverage AS
SELECT sample_id, feature_id, CASE WHEN sample_id = 's1' AND feature_id = 'f_both' THEN NULL ELSE coverage END AS coverage
FROM b_coverage;

statement error
SELECT * FROM absquant_cell_counts('b_counts', 'b_models', 'null_coverage', 'b_lengths', 'b_params',
                                   'cells_per_g_of_gdna', 0.1);
----
coverage must be present and a fraction between 0 and 1 inclusive, not a percent; offending (sample_id / feature_id): 's1 / f_both'

# Both denominators must be positive and finite. pysyndna divides by each with
# no check: a zero genome length yields inf cells for that OGU in every sample,
# and a zero sequenced gDNA mass yields inf for every OGU in that sample. Zero
# is the case its NaN/negative parameter screen structurally cannot see.
statement ok
CREATE TABLE zero_lengths AS
SELECT feature_id, CASE WHEN feature_id = 'f_both' THEN 0.0 ELSE ogu_len_in_bp END AS ogu_len_in_bp FROM b_lengths;

statement error
SELECT * FROM absquant_cell_counts('b_counts', 'b_models', 'b_coverage', 'zero_lengths', 'b_params',
                                   'cells_per_g_of_gdna', 0.1);
----
ogu_len_in_bp must be finite and positive; offending feature_id 'f_both'

statement ok
CREATE TABLE zero_mass AS
SELECT sample_id, CASE WHEN sample_id = 's1' THEN 0.0 ELSE sequenced_sample_gdna_mass_ng END
           AS sequenced_sample_gdna_mass_ng,
       extracted_gdna_concentration_ng_ul, vol_extracted_elution_ul
FROM b_params;

statement error
SELECT * FROM absquant_cell_counts('b_counts', 'b_models', 'b_coverage', 'b_lengths', 'zero_mass',
                                   'cells_per_g_of_gdna', 0.1);
----
sequenced_sample_gdna_mass_ng must not be zero; offending sample_id 's1'

# An rvalue outside [-1, 1] is a malformed models relation, not a weak model:
# squaring it gives an r^2 above 1 that passes any legal min_rsquared. A
# non-finite one is the different case tested above -- a warning, not an error.
statement ok
CREATE TABLE bad_r_models AS
SELECT sample_id, slope, intercept, CASE WHEN sample_id = 's1' THEN 1.5 ELSE rvalue END AS rvalue,
       pvalue, stderr, intercept_stderr
FROM b_models;

statement error
SELECT * FROM absquant_cell_counts('b_counts', 'bad_r_models', 'b_coverage', 'b_lengths', 'b_params',
                                   'cells_per_g_of_gdna', 0.1);
----
rvalue must be between -1 and 1 inclusive; offending sample_id 's1'

# A NULL key in a reference relation is refused outright rather than dropped: an
# unnamed row cannot be joined to anything.
statement ok
CREATE TABLE null_key_lengths AS SELECT * FROM b_lengths UNION ALL SELECT NULL, 1000.0;

statement error
SELECT * FROM absquant_cell_counts('b_counts', 'b_models', 'b_coverage', 'null_key_lengths', 'b_params',
                                   'cells_per_g_of_gdna', 0.1);
----
has a row with a NULL feature_id

statement ok
CREATE TABLE null_key_params AS SELECT * FROM b_params UNION ALL SELECT NULL, 2.0, 100.0, 5.0, 0.02, 200.0, 4.0;

statement error
SELECT * FROM absquant_cell_counts('b_counts', 'b_models', 'b_coverage', 'b_lengths', 'null_key_params',
                                   'cells_per_g_of_gdna', 0.1);
----
has a row with a NULL sample_id

# ---------------------------------------------------------------------------
# Id consistency. The counts relation is the subject: every cell it names must
# be describable, or nothing defined can be said about it. The reverse never has
# to hold -- a lengths table is a whole reference database, a parameters table a
# whole study -- so reference relations may describe far more than the counts do.
# ---------------------------------------------------------------------------

statement ok
CREATE TABLE short_lengths AS SELECT * FROM b_lengths WHERE feature_id <> 'f_both';

statement error
SELECT * FROM absquant_cell_counts('b_counts', 'b_models', 'b_coverage', 'short_lengths', 'b_params',
                                   'cells_per_g_of_gdna', 0.1);
----
which the feature lengths relation has no ogu_len_in_bp row for

statement ok
CREATE TABLE short_params AS SELECT * FROM b_params WHERE sample_id <> 's1';

statement error
SELECT * FROM absquant_cell_counts('b_counts', 'b_models', 'b_coverage', 'b_lengths', 'short_params',
                                   'cells_per_g_of_gdna', 0.1);
----
which the sample parameters relation does not describe

# The one pysyndna validates only by AXIS: it checks the sample id set and the
# feature id set separately, so a sample and a feature can each be present while
# their PAIR is not. Its left join then yields NaN; `NaN >= min_coverage` is
# false so the cell is dropped, and `NaN < min_coverage` is false too so it never
# even joins the too-low-coverage log. The cell disappears in silence.
statement ok
CREATE TABLE holed_coverage AS SELECT * FROM b_coverage WHERE NOT (sample_id = 's1' AND feature_id = 'f_both');

statement error
SELECT * FROM absquant_cell_counts('b_counts', 'b_models', 'holed_coverage', 'b_lengths', 'b_params',
                                   'cells_per_g_of_gdna', 0.1);
----
which the coverage relation has no row for; every counted cell needs a coverage to be filtered on

# Both axes of that hole are individually satisfied, which is exactly why an
# axis-wise check passes it.
query I
SELECT count(*) >= 1 FROM holed_coverage WHERE sample_id = 's1';
----
true

query I
SELECT count(*) >= 1 FROM holed_coverage WHERE feature_id = 'f_both';
----
true

# Reference relations describing MORE than the counts do is ordinary usage.
statement ok
CREATE TABLE wide_lengths AS SELECT * FROM b_lengths UNION ALL SELECT 'f_unused', 4242.0;

query TTR
(SELECT * FROM absquant_cell_counts('b_counts', 'b_models', 'b_coverage', 'wide_lengths', 'b_params',
                                    'cells_per_g_of_gdna', 0.1)
 EXCEPT SELECT * FROM b_mine)
UNION ALL
(SELECT * FROM b_mine
 EXCEPT SELECT * FROM absquant_cell_counts('b_counts', 'b_models', 'b_coverage', 'wide_lengths', 'b_params',
                                           'cells_per_g_of_gdna', 0.1));
----

# ... and their unused rows are not screened, deliberately narrower than
# absquant_fit_models, which screens every concentration because it sums the
# whole relation into a denominator. Nothing here is summed, so a lengths table
# of ten thousand genomes must not fail a query over four of them.
statement ok
CREATE TABLE bad_unused_lengths AS SELECT * FROM b_lengths UNION ALL SELECT 'f_unused', -1.0;

query TTR
(SELECT * FROM absquant_cell_counts('b_counts', 'b_models', 'b_coverage', 'bad_unused_lengths', 'b_params',
                                    'cells_per_g_of_gdna', 0.1)
 EXCEPT SELECT * FROM b_mine)
UNION ALL
(SELECT * FROM b_mine
 EXCEPT SELECT * FROM absquant_cell_counts('b_counts', 'b_models', 'b_coverage', 'bad_unused_lengths', 'b_params',
                                           'cells_per_g_of_gdna', 0.1));
----

# ---------------------------------------------------------------------------
# Empty relations. Each empties for a different reason and must not be confused
# with the others.
# ---------------------------------------------------------------------------

statement ok
CREATE TABLE empty_counts AS SELECT * FROM b_counts WHERE false;

# No counts: nothing to compute, and not an error. There is no cell to be unable
# to describe, so every id-consistency check is vacuously satisfied.
query I
SELECT count(*) FROM absquant_cell_counts('empty_counts', 'b_models', 'b_coverage', 'b_lengths', 'b_params',
                                          'cells_per_g_of_gdna', 0.1);
----
0

# No models: every sample is reported as having none, and the result is empty
# rather than an error.
statement ok
CREATE TABLE empty_models AS SELECT * FROM b_models WHERE false;

query I
SELECT count(*) FROM absquant_cell_counts('b_counts', 'empty_models', 'b_coverage', 'b_lengths', 'b_params',
                                          'cells_per_g_of_gdna', 0.1);
----
0

# No coverage, no lengths, no parameters: each IS an error, because now every
# counted cell names something no relation can describe.
statement ok
CREATE TABLE empty_coverage AS SELECT * FROM b_coverage WHERE false;

statement error
SELECT * FROM absquant_cell_counts('b_counts', 'b_models', 'empty_coverage', 'b_lengths', 'b_params',
                                   'cells_per_g_of_gdna', 0.1);
----
which the coverage relation has no row for

statement ok
CREATE TABLE empty_lengths AS SELECT * FROM b_lengths WHERE false;

statement error
SELECT * FROM absquant_cell_counts('b_counts', 'b_models', 'b_coverage', 'empty_lengths', 'b_params',
                                   'cells_per_g_of_gdna', 0.1);
----
which the feature lengths relation has no ogu_len_in_bp row for

statement ok
CREATE TABLE empty_params AS SELECT * FROM b_params WHERE false;

statement error
SELECT * FROM absquant_cell_counts('b_counts', 'b_models', 'b_coverage', 'b_lengths', 'empty_params',
                                   'cells_per_g_of_gdna', 0.1);
----
which the sample parameters relation does not describe
