statement ok
DROP TABLE tl_uuid;

statement ok
DROP TABLE sg_uuid;

statement ok
DROP TABLE sam_aln;

statement ok
DROP TABLE sam_sg;

statement ok
DROP TABLE sam_tl;

statement ok
DROP VIEW p3_view;

statement ok
DROP VIEW p3_tview;

statement ok
DROP TABLE p3_base;

statement ok
DROP TABLE p3_tl;

statement ok
DROP TABLE p3_sg;

statement ok
DROP TABLE p3_empty;

statement ok
DROP TABLE p3_degen;

statement ok
DROP TABLE p3_nullsample;

statement ok
DROP TABLE p3_two;

statement ok
DROP TABLE p3_sg2;

statement ok
DROP TABLE p3_tl_zero;

statement ok
DROP TABLE p3_tl_null;

statement ok
DROP TABLE p3_sg_dup;

statement ok
DROP TABLE p3_tl_extra;

statement ok
DROP TABLE p3_sg_multi;

statement ok
DROP TABLE p3_tl_multi;

statement ok
DROP TABLE p3_aln1;

statement ok
DROP TABLE p3_sg_bi;

statement ok
DROP TABLE p3_tl_vc;

statement ok
DROP TABLE p3_tl_unconv;

statement ok
DROP TABLE p3_no_sample;

statement ok
DROP TABLE p3_prune_tl;
