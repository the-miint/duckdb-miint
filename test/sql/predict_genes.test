# genome_id names the column; the output's column is genome_id whatever the input's is called.
query I
SELECT count(*) FROM predict_genes('anthus', genome_id := 'genome', method := 'prodigal', meta_mode := true)
WHERE genome_id = 'anthus';
----
22

