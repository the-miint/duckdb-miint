# -----------------------------------------------------------------------------
# A model file (the CLI's -t): written when missing, read when present
# -----------------------------------------------------------------------------

# Writing a model takes exactly one genome.
statement error
SELECT * FROM predict_genes('two', genome_id := 'genome', training_path := '{TEST_DIR}/two.trn');
----
training_path

statement ok
CREATE TABLE trained AS
SELECT * FROM predict_genes('anthus', genome_id := 'genome', training_path := '{TEST_DIR}/anthus.trn');

query I
SELECT count(*) FROM ((SELECT * FROM as_cli('single') EXCEPT ALL SELECT * FROM as_cli('trained'))
                      UNION ALL (SELECT * FROM as_cli('trained') EXCEPT ALL SELECT * FROM as_cli('single')));
----
0

# Now present, the model calls every genome's genes: 'small' needs no training of its own.
query II
SELECT genome_id, bool_and(status = 'ok')
FROM predict_genes('two', genome_id := 'genome', training_path := '{TEST_DIR}/anthus.trn')
GROUP BY genome_id ORDER BY genome_id;
----
anthus	true
small	true

statement ok
CREATE TABLE two_trained AS
SELECT * FROM predict_genes('two', genome_id := 'genome', training_path := '{TEST_DIR}/anthus.trn')
WHERE genome_id = 'anthus';

query I
SELECT count(*) FROM ((SELECT * FROM as_cli('single') EXCEPT ALL SELECT * FROM as_cli('two_trained'))
                      UNION ALL (SELECT * FROM as_cli('two_trained') EXCEPT ALL SELECT * FROM as_cli('single')));
----
0

# A genome with no genes: a row for each of its contigs (as for any contig without genes), then one for the
# genome, both status no_genes. With open ends even poly-A gets an edge gene, so the model here is trained with
# closed_ends, and the genomes are called with it.
statement ok
CREATE TABLE barren AS
SELECT * FROM anthus
UNION ALL
SELECT 'barren' AS genome, 0 AS sequence_index, 'polyA' AS read_id, repeat('A', 2000) AS sequence1;

statement ok
SELECT * FROM predict_genes('anthus', genome_id := 'genome', training_path := '{TEST_DIR}/closed.trn',
                            closed_ends := true);

statement ok
CREATE TABLE barren_genes AS
SELECT * FROM predict_genes('barren', genome_id := 'genome', training_path := '{TEST_DIR}/closed.trn',
                            closed_ends := true);

# With closed ends, 4 of anthus' contigs have no genes, as in the CLI's -c run: rows of their own, and the genome,
# which has genes, none.
query IIIII
SELECT count(*) FILTER (WHERE status = 'ok'), count(*) FILTER (WHERE status = 'no_genes' AND read_id IS NOT NULL),
       count(*) FILTER (WHERE read_id IS NULL), count(DISTINCT read_id), count(error)
FROM barren_genes WHERE genome_id = 'anthus';
----
107	4	0	22	0

query IIIIIIII
SELECT read_id, gene_index, contig_length, contig_gc_content, translation_table, model_desc, status, error
FROM barren_genes WHERE genome_id = 'barren' ORDER BY read_id NULLS LAST;
----
polyA	NULL	2000	0.0	11	NULL	no_genes	NULL
NULL	NULL	NULL	NULL	NULL	NULL	no_genes	NULL

