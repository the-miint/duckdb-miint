# name: test/sql/predict_genes.test
# description: predict_genes(method := 'prodigal') against a real gpl-boundary daemon (>= 0.5.0), checked against the Prodigal CLI's own output on anthus_aco.fas (data/prodigal/README.md)
# group: [sql]

require miint

require-env GPL_BOUNDARY_AVAILABLE

statement ok
CREATE TABLE anthus AS
SELECT 'anthus' AS genome, sequence_index, read_id, sequence1 FROM read_fastx('data/prodigal/anthus_aco.fas.gz');

query I
SELECT count(*) FROM anthus;
----
22

# -----------------------------------------------------------------------------
# Single-genome mode (the default): one model trained on the genome, then its genes.
# -----------------------------------------------------------------------------
statement ok
CREATE TABLE single AS SELECT * FROM predict_genes('anthus', genome_id := 'genome');

query IIII
SELECT count(*), count(DISTINCT read_id), count(*) FILTER (WHERE status = 'ok'), count(error) FROM single;
----
129	22	129	0

# A file's lines, numbered.
statement ok
CREATE MACRO file_lines(path) AS TABLE
SELECT row_number() OVER () AS i, line
FROM read_csv(path, columns = {'line': 'VARCHAR'}, delim = E'\x1f', quote = '', escape = '', header = false,
              auto_detect = false);

# The CLI's GFF, field by field, as the CLI prints each value.
statement ok
CREATE MACRO ref_genes(path) AS TABLE
WITH lines AS (
    SELECT string_split(line, E'\t') AS f FROM file_lines(path) WHERE NOT starts_with(line, '#')
)
SELECT f[1] AS read_id, split_part(regexp_extract(f[9], 'ID=([^;]*)', 1), '_', 2)::INTEGER AS gene_index,
       f[4]::BIGINT AS position, f[5]::BIGINT + 1 AS stop_position, f[7] AS strand,
       regexp_extract(f[9], 'partial=([^;]*)', 1) AS partial,
       regexp_extract(f[9], 'start_type=([^;]*)', 1) AS start_type,
       regexp_extract(f[9], 'rbs_motif=([^;]*)', 1) AS rbs_motif,
       regexp_extract(f[9], 'rbs_spacer=([^;]*)', 1) AS rbs_spacer,
       regexp_extract(f[9], 'gc_cont=([^;]*)', 1) AS gc, regexp_extract(f[9], 'conf=([^;]*)', 1) AS conf,
       regexp_extract(f[9], ';score=([^;]*)', 1) AS score, regexp_extract(f[9], 'cscore=([^;]*)', 1) AS cscore,
       regexp_extract(f[9], 'sscore=([^;]*)', 1) AS sscore, regexp_extract(f[9], 'rscore=([^;]*)', 1) AS rscore,
       regexp_extract(f[9], 'uscore=([^;]*)', 1) AS uscore, regexp_extract(f[9], 'tscore=([^;]*)', 1) AS tscore
FROM lines;

statement ok
CREATE TABLE ref_single AS SELECT * FROM ref_genes('data/prodigal/ref_single.gff.gz');

statement ok
CREATE MACRO as_cli(rel) AS TABLE
SELECT read_id, gene_index, position, stop_position, strand,
       partial_left::INTEGER::VARCHAR || partial_right::INTEGER::VARCHAR AS partial, start_type,
       coalesce(rbs_motif, 'None') AS rbs_motif, coalesce(rbs_spacer, 'None') AS rbs_spacer,
       printf('%.3f', gene_gc_content) AS gc, printf('%.2f', confidence) AS conf, printf('%.2f', score) AS score,
       printf('%.2f', cscore) AS cscore, printf('%.2f', sscore) AS sscore, printf('%.2f', rscore) AS rscore,
       printf('%.2f', uscore) AS uscore, printf('%.2f', tscore) AS tscore
FROM query_table(rel) WHERE gene_index IS NOT NULL;

query I
SELECT count(*) FROM ((SELECT * FROM ref_single EXCEPT ALL SELECT * FROM as_cli('single'))
                      UNION ALL (SELECT * FROM as_cli('single') EXCEPT ALL SELECT * FROM ref_single));
----
0

# Proteins equal the CLI's -a records (unwrapped; the header is <contig>_<gene_index>).
query I
SELECT count(*) FROM read_fastx('data/prodigal/ref_single.proteins.gz') p
FULL JOIN single s ON p.read_id = s.read_id || '_' || s.gene_index AND p.sequence1 = s.protein
WHERE p.read_id IS NULL OR s.read_id IS NULL;
----
0

# The CLI's per-contig "# Model Data" line: one model for the whole genome.
statement ok
CREATE MACRO model_data(path) AS TABLE
WITH lines AS (SELECT * FROM file_lines(path))
SELECT regexp_extract(sd.line, 'seqhdr="([^"]*)', 1) AS read_id,
       regexp_extract(md.line, 'run_type=([^;]*)', 1) AS run_type,
       regexp_extract(md.line, 'model="([^"]*)"', 1) AS model,
       regexp_extract(md.line, 'gc_cont=([^;]*)', 1) AS gc_cont,
       regexp_extract(md.line, 'transl_table=([^;]*)', 1)::INTEGER AS transl_table,
       regexp_extract(md.line, 'uses_sd=([^;]*)', 1) = '1' AS uses_sd,
       regexp_extract(sd.line, 'seqlen=([^;]*)', 1)::BIGINT AS seqlen
FROM lines sd JOIN lines md ON md.i = sd.i + 1
WHERE sd.line LIKE '# Sequence Data:%' AND md.line LIKE '# Model Data:%';

query I
SELECT count(*) FROM (
    (SELECT read_id, gc_cont, transl_table, uses_sd, seqlen FROM model_data('data/prodigal/ref_single.gff.gz')
     WHERE read_id IN (SELECT read_id FROM single)
     EXCEPT
     SELECT DISTINCT read_id, printf('%.2f', model_gc_content * 100), translation_table, uses_sd, contig_length
     FROM single)
    UNION ALL
    (SELECT DISTINCT read_id, printf('%.2f', model_gc_content * 100), translation_table, uses_sd, contig_length
     FROM single
     EXCEPT
     SELECT read_id, gc_cont, transl_table, uses_sd, seqlen FROM model_data('data/prodigal/ref_single.gff.gz')));
----
0

# Single-genome mode has no metagenomic bin.
query II
SELECT count(meta_bin), count(model_desc) FROM single;
----
0	0

# -----------------------------------------------------------------------------
# Metagenomic mode
# -----------------------------------------------------------------------------
statement ok
CREATE TABLE meta AS SELECT * FROM predict_genes('anthus', genome_id := 'genome', meta_mode := true);

# copy_gff_prodigal.test reads this output, and the single-genome one, saved (data/prodigal/README.md); they are
# still predict_genes' output.
query II
SELECT (SELECT count(*) FROM ((SELECT * FROM single EXCEPT ALL FROM read_csv('data/prodigal/anthus_single_genes.csv.gz'))
                              UNION ALL (FROM read_csv('data/prodigal/anthus_single_genes.csv.gz') EXCEPT ALL FROM single))),
       (SELECT count(*) FROM ((SELECT * FROM meta EXCEPT ALL FROM read_csv('data/prodigal/anthus_meta_genes.csv.gz'))
                              UNION ALL (FROM read_csv('data/prodigal/anthus_meta_genes.csv.gz') EXCEPT ALL FROM meta)));
----
0	0

statement ok
CREATE TABLE ref_meta AS SELECT * FROM ref_genes('data/prodigal/ref_meta.gff.gz');

query II
SELECT count(*), (SELECT count(*) FROM ref_meta) FROM meta;
----
22	22

query I
SELECT count(*) FROM ((SELECT * FROM ref_meta EXCEPT ALL SELECT * FROM as_cli('meta'))
                      UNION ALL (SELECT * FROM as_cli('meta') EXCEPT ALL SELECT * FROM ref_meta));
----
0

query I
SELECT count(*) FROM read_fastx('data/prodigal/ref_meta.proteins.gz') p
FULL JOIN meta s ON p.read_id = s.read_id || '_' || s.gene_index AND p.sequence1 = s.protein
WHERE p.read_id IS NULL OR s.read_id IS NULL;
----
0

# Each contig's bin, as the CLI's Model Data names it.
query I
SELECT count(*) FROM (
    (SELECT read_id, model, gc_cont, transl_table, uses_sd FROM model_data('data/prodigal/ref_meta.gff.gz')
     EXCEPT
     SELECT DISTINCT read_id, model_desc, printf('%.2f', model_gc_content * 100), translation_table, uses_sd
     FROM meta)
    UNION ALL
    (SELECT DISTINCT read_id, model_desc, printf('%.2f', model_gc_content * 100), translation_table, uses_sd
     FROM meta
     EXCEPT
     SELECT read_id, model, gc_cont, transl_table, uses_sd FROM model_data('data/prodigal/ref_meta.gff.gz')));
----
0

query I
SELECT bool_and(meta_bin = split_part(model_desc, '|', 1)::INTEGER) FROM meta;
----
true

# -----------------------------------------------------------------------------
# Several genomes: each is called on its own; a failure is reported for its genome only
# -----------------------------------------------------------------------------

# Three contigs (2,880 bp) are too little to train a model on.
statement ok
CREATE TABLE two AS
SELECT * FROM anthus
UNION ALL
SELECT 'small' AS genome, sequence_index, read_id, sequence1 FROM anthus WHERE read_id IN ('61430_aco', '626029_aco', '630116_aco');

statement ok
CREATE TABLE two_single AS SELECT * FROM predict_genes('two', genome_id := 'genome');

query IIII
SELECT genome_id, count(*), any_value(status), count(error) FROM two_single GROUP BY genome_id ORDER BY genome_id;
----
anthus	129	ok	0
small	1	training_failed	1

# The failed genome's row carries only the genome and the failure.
query IIIII
SELECT read_id IS NULL, gene_index IS NULL, protein IS NULL, translation_table IS NULL, length(error) > 0
FROM two_single WHERE genome_id = 'small';
----
true	true	true	true	true

# The other genome's genes are those it gets on its own.
statement ok
CREATE TABLE two_anthus AS SELECT * FROM two_single WHERE genome_id = 'anthus';

query I
SELECT count(*) FROM ((SELECT * FROM as_cli('single') EXCEPT ALL SELECT * FROM as_cli('two_anthus'))
                      UNION ALL (SELECT * FROM as_cli('two_anthus') EXCEPT ALL SELECT * FROM as_cli('single')));
----
0

# The caller reruns the failed genome in metagenomic mode (as CheckM does).
statement ok
CREATE VIEW small_only AS SELECT * FROM two WHERE genome = 'small';

query II
SELECT count(*), bool_and(status = 'ok') FROM predict_genes('small_only', genome_id := 'genome', meta_mode := true);
----
3	true

