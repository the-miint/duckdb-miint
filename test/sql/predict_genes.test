# -----------------------------------------------------------------------------
statement ok
CREATE TABLE pair AS
SELECT * FROM anthus UNION ALL SELECT 'anthus2' AS genome, sequence_index, read_id, sequence1 FROM anthus;

statement ok
CREATE TABLE pair_genes AS SELECT * FROM predict_genes('pair', genome_id := 'genome');

query II
SELECT genome_id, count(*) FILTER (WHERE status = 'ok') FROM pair_genes GROUP BY genome_id ORDER BY genome_id;
----
anthus	129
anthus2	129

statement ok
CREATE TABLE pair_second AS SELECT * FROM pair_genes WHERE genome_id = 'anthus2';

query I
SELECT n FROM differs_from_cli('pair_second', 'data/prodigal/ref_single.gff.gz');
----
0

# -----------------------------------------------------------------------------
# Contigs without genes
# -----------------------------------------------------------------------------

# Metagenomic mode: a contig without genes (48 bp, too short for one) among others gets its own row, in its place;
# the others' genes are unchanged, and the genome, which has genes, gets no row of its own.
statement ok
CREATE TABLE mixed AS
SELECT genome, sequence_index * 2 AS ord, read_id, sequence1 FROM anthus
UNION ALL
SELECT 'anthus' AS genome, 21 AS ord, 'tiny' AS read_id, repeat('ACGTTGCA', 6) AS sequence1;

statement ok
CREATE TABLE mixed_genes AS
SELECT * FROM predict_genes('mixed', genome_id := 'genome', order_by := 'ord', meta_mode := true);

query I
SELECT count(*) FROM ((SELECT * FROM as_cli('mixed_genes') EXCEPT ALL SELECT * FROM as_cli('meta'))
                      UNION ALL (SELECT * FROM as_cli('meta') EXCEPT ALL SELECT * FROM as_cli('mixed_genes')));
----
0

query II
SELECT count(*) FILTER (WHERE status = 'ok'), list(read_id) FILTER (WHERE status <> 'ok') FROM mixed_genes;
----
22	[tiny]

query IIIIIII
SELECT gene_index IS NULL, protein IS NULL, contig_length, meta_bin IS NOT NULL, model_desc IS NOT NULL, status,
       error IS NULL
FROM mixed_genes WHERE read_id = 'tiny';
----
true	true	48	true	true	no_genes	true

# Metagenomic mode, a genome without genes: its contig's row, then the genome's.
statement ok
CREATE TABLE polya AS SELECT 'barren' AS genome, 0 AS sequence_index, 'polyA' AS read_id, repeat('A', 2000) AS sequence1;

query II
SELECT read_id, status
FROM predict_genes('polya', genome_id := 'genome', meta_mode := true, closed_ends := true)
ORDER BY read_id NULLS LAST;
----
polyA	no_genes
NULL	no_genes

# -----------------------------------------------------------------------------
# A model file that cannot be written or used fails the call, rather than one genome
# -----------------------------------------------------------------------------
statement error
SELECT * FROM predict_genes('anthus', genome_id := 'genome', training_path := '{TEST_DIR}/no_such_dir/x.trn');
----
no_such_dir

statement ok
COPY (SELECT 'not a model' AS x) TO '{TEST_DIR}/junk.trn' (FORMAT CSV, HEADER false);

statement error
SELECT * FROM predict_genes('anthus', genome_id := 'genome', training_path := '{TEST_DIR}/junk.trn');
----
predict_genes: prodigal refused the call

# -----------------------------------------------------------------------------
# A contig's genes do not depend on the others called with it: a genome split in two gets the same genes, in
# metagenomic mode and with a fixed model (so the batch size bounds memory, not results)
# -----------------------------------------------------------------------------
statement ok
CREATE TABLE halves AS
SELECT CASE WHEN sequence_index <= 11 THEN 'h1' ELSE 'h2' END AS genome, sequence_index, read_id, sequence1 FROM anthus;

statement ok
CREATE TABLE meta_halves AS SELECT * FROM predict_genes('halves', genome_id := 'genome', meta_mode := true);

query I
SELECT count(*) FROM ((SELECT * FROM as_cli('meta') EXCEPT ALL SELECT * FROM as_cli('meta_halves'))
                      UNION ALL (SELECT * FROM as_cli('meta_halves') EXCEPT ALL SELECT * FROM as_cli('meta')));
----
0

statement ok
CREATE TABLE model_halves AS
SELECT * FROM predict_genes('halves', genome_id := 'genome', training_path := '{TEST_DIR}/anthus.trn');

query I
SELECT count(*) FROM ((SELECT * FROM as_cli('single') EXCEPT ALL SELECT * FROM as_cli('model_halves'))
                      UNION ALL (SELECT * FROM as_cli('model_halves') EXCEPT ALL SELECT * FROM as_cli('single')));
----
0

# -----------------------------------------------------------------------------
# Chunked input: genomes stored in blocks, (read_id or feature_idx, chunk_index, chunk_data), mapped to genomes by
# mapping_table. A chunked genome's contigs are in key order, so it equals the contig-per-row call in read_id order.
# -----------------------------------------------------------------------------
statement ok
CREATE TABLE anthus_by_id AS SELECT genome, row_number() OVER (ORDER BY read_id) AS ord, read_id, sequence1 FROM anthus;

statement ok
CREATE TABLE anthus_chunks AS
SELECT read_id, c.chunk_index, c.chunk_data FROM (SELECT read_id, unnest(sequence_split(sequence1, 100)) AS c FROM anthus)
ORDER BY random();

statement ok
CREATE TABLE anthus_mapping AS SELECT read_id, genome AS genome_id FROM anthus;

statement ok
CREATE TABLE by_id AS SELECT * FROM predict_genes('anthus_by_id', genome_id := 'genome', order_by := 'ord');

query II
SELECT count(*), count(*) FILTER (WHERE status = 'ok') FROM predict_genes('anthus_chunks', mapping_table := 'anthus_mapping');
----
129	129

query I
SELECT count(*) FROM ((FROM by_id EXCEPT ALL FROM predict_genes('anthus_chunks', mapping_table := 'anthus_mapping'))
                      UNION ALL
                      (FROM predict_genes('anthus_chunks', mapping_table := 'anthus_mapping') EXCEPT ALL FROM by_id));
----
0

# Metagenomic mode too.
query I
SELECT count(*) FROM ((FROM predict_genes('anthus_by_id', genome_id := 'genome', order_by := 'ord', meta_mode := true)
                       EXCEPT ALL FROM predict_genes('anthus_chunks', mapping_table := 'anthus_mapping', meta_mode := true))
                      UNION ALL
                      (FROM predict_genes('anthus_chunks', mapping_table := 'anthus_mapping', meta_mode := true)
                       EXCEPT ALL FROM predict_genes('anthus_by_id', genome_id := 'genome', order_by := 'ord', meta_mode := true)));
----
0

# Keyed by feature_idx (BIGINT), with BLOB chunks; read_id is the feature_idx.
statement ok
CREATE TABLE feature_chunks AS
SELECT dense_rank() OVER (ORDER BY read_id)::BIGINT AS feature_idx, chunk_index, chunk_data::BLOB AS chunk_data
FROM anthus_chunks;

statement ok
CREATE TABLE feature_mapping AS SELECT DISTINCT feature_idx, 'anthus' AS genome_id FROM feature_chunks;

query III
SELECT count(*), count(DISTINCT read_id), any_value(typeof(read_id)) FROM predict_genes('feature_chunks', mapping_table := 'feature_mapping');
----
129	22	BIGINT

# A BLOB's bytes are the contig, as they are, not the text DuckDB prints for them: as text, 0x5C would be the four
# characters '\x5C', lengthening the contig and shifting every coordinate after it.
statement ok
CREATE TABLE odd_blob_chunks AS
SELECT feature_idx, chunk_index,
       CASE WHEN feature_idx = 1 AND chunk_index = 0 THEN 'ACGT\x5CACGT'::BLOB ELSE chunk_data END AS chunk_data
FROM feature_chunks;

query I
SELECT DISTINCT contig_length = (SELECT sum(octet_length(chunk_data)) FROM odd_blob_chunks WHERE feature_idx = 1)
FROM predict_genes('odd_blob_chunks', mapping_table := 'feature_mapping', meta_mode := true) WHERE read_id = 1;
----
true

# A byte outside 'A'..'z' is refused at its own position.
statement ok
CREATE OR REPLACE TABLE odd_blob_chunks AS
SELECT feature_idx, chunk_index,
       CASE WHEN feature_idx = 1 AND chunk_index = 0 THEN 'ACGT\xC3\xA9ACGT'::BLOB ELSE chunk_data END AS chunk_data
FROM feature_chunks;

statement error
SELECT * FROM predict_genes('odd_blob_chunks', mapping_table := 'feature_mapping', meta_mode := true);
----
contig '1' of genome 'anthus' has character 0xc3 at position 5

# Bytes that are not UTF-8 are refused.
statement ok
CREATE OR REPLACE TABLE odd_blob_chunks AS
SELECT feature_idx, chunk_index,
       CASE WHEN feature_idx = 1 AND chunk_index = 0 THEN 'ACGT\xAAACGT'::BLOB ELSE chunk_data END AS chunk_data
FROM feature_chunks;

statement error
SELECT * FROM predict_genes('odd_blob_chunks', mapping_table := 'feature_mapping', meta_mode := true);
----
could not convert blob to UTF8

# A contig whose chunks are all empty is named as such.
statement ok
CREATE TABLE empty_chunks AS
SELECT read_id, chunk_index, CASE WHEN read_id = '61430_aco' THEN '' ELSE chunk_data END AS chunk_data
FROM anthus_chunks;

statement error
SELECT * FROM predict_genes('empty_chunks', mapping_table := 'anthus_mapping', meta_mode := true);
----
contig '61430_aco' of genome 'anthus' has an empty chunk_data

# Chunks whose key mapping_table does not map, or maps to a NULL genome, are skipped, as rows with a NULL genome_id
# are.
statement ok
CREATE TABLE half_mapping AS
SELECT read_id, CASE WHEN read_id < 'M' THEN genome_id END AS genome_id FROM anthus_mapping WHERE read_id <> '61430_aco';

query I
SELECT count(DISTINCT read_id) = (SELECT count(*) FROM half_mapping WHERE genome_id IS NOT NULL)
FROM predict_genes('anthus_chunks', mapping_table := 'half_mapping', meta_mode := true);
----
true

# Malformed chunks are refused, naming the contig.
statement ok
CREATE TABLE gap_chunks AS SELECT * FROM anthus_chunks WHERE NOT (read_id = '61430_aco' AND chunk_index = 3);

statement error
SELECT * FROM predict_genes('gap_chunks', mapping_table := 'anthus_mapping', meta_mode := true);
----
the chunk_index values of contig '61430_aco' are not 0, 1, 2, ... with none missing or repeated

statement ok
CREATE TABLE repeated_chunks AS SELECT * FROM anthus_chunks UNION ALL SELECT * FROM anthus_chunks WHERE read_id = '61430_aco' AND chunk_index = 0;

statement error
SELECT * FROM predict_genes('repeated_chunks', mapping_table := 'anthus_mapping', meta_mode := true);
----
the chunk_index values of contig '61430_aco'

# A repeated index that also leaves one out: as many rows as indices, the largest one less than their count.
statement ok
CREATE TABLE repeated_gap_chunks AS
SELECT * REPLACE (CASE WHEN read_id = '61430_aco' AND chunk_index = 1 THEN 0 ELSE chunk_index END AS chunk_index)
FROM anthus_chunks;

statement error
SELECT * FROM predict_genes('repeated_gap_chunks', mapping_table := 'anthus_mapping', meta_mode := true);
----
the chunk_index values of contig '61430_aco'

statement ok
CREATE TABLE null_chunks AS SELECT * REPLACE (CASE WHEN read_id = '61430_aco' AND chunk_index = 2 THEN NULL ELSE chunk_data END AS chunk_data) FROM anthus_chunks;

statement error
SELECT * FROM predict_genes('null_chunks', mapping_table := 'anthus_mapping', meta_mode := true);
----
contig '61430_aco' has a NULL chunk_data

# A key mapped twice is refused: its contig would be in two genomes, or twice in one.
statement ok
CREATE TABLE twice_mapping AS SELECT * FROM anthus_mapping UNION ALL SELECT '61430_aco', 'other';

statement error
SELECT * FROM predict_genes('anthus_chunks', mapping_table := 'twice_mapping', meta_mode := true);
----
maps read_id '61430_aco' more than once

# Only the relation's keys mapped to a genome are checked: a key mapped twice that it does not have, or a second
# mapping to NULL, is not one it reads.
statement ok
CREATE TABLE other_twice_mapping AS
SELECT * FROM anthus_mapping UNION ALL SELECT 'not_here', 'a' UNION ALL SELECT 'not_here', 'b'
UNION ALL SELECT '61430_aco', NULL;

query I
SELECT count(*) FROM predict_genes('anthus_chunks', mapping_table := 'other_twice_mapping', meta_mode := true);
----
22

# A model is trained on a single chunked genome and written to training_path, as for contigs.
statement ok
SELECT * FROM predict_genes('anthus_chunks', mapping_table := 'anthus_mapping', training_path := '{TEST_DIR}/chunked.trn');

query I
SELECT count(*) FROM predict_genes('anthus_chunks', mapping_table := 'anthus_mapping', training_path := '{TEST_DIR}/chunked.trn')
WHERE status = 'ok';
----
129

statement ok
CREATE TABLE two_genome_mapping AS SELECT read_id, CASE WHEN read_id < 'M' THEN 'a' ELSE 'b' END AS genome_id FROM anthus;

statement error
SELECT * FROM predict_genes('anthus_chunks', mapping_table := 'two_genome_mapping', training_path := '{TEST_DIR}/chunked2.trn');
----
takes exactly one genome; 'anthus_chunks' has 2
