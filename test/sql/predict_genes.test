# -----------------------------------------------------------------------------
# Single-genome options reach training: each run equals the CLI's with the same option (data/prodigal/README.md)
# -----------------------------------------------------------------------------
statement ok
CREATE MACRO differs_from_cli(rel, ref) AS TABLE
SELECT count(*) AS n FROM ((SELECT * FROM ref_genes(ref) EXCEPT ALL SELECT * FROM as_cli(rel))
                           UNION ALL (SELECT * FROM as_cli(rel) EXCEPT ALL SELECT * FROM ref_genes(ref)));

# -c
statement ok
CREATE TABLE closed_genes AS SELECT * FROM predict_genes('anthus', genome_id := 'genome', closed_ends := true);

query I
SELECT n FROM differs_from_cli('closed_genes', 'data/prodigal/ref_single_c.gff.gz');
----
0

# -g 4: the model is trained with table 4, and the proteins are translated with it.
statement ok
CREATE TABLE table4_genes AS SELECT * FROM predict_genes('anthus', genome_id := 'genome', trans_table := 4);

query I
SELECT n FROM differs_from_cli('table4_genes', 'data/prodigal/ref_single_g4.gff.gz');
----
0

query II
SELECT DISTINCT translation_table, uses_sd FROM table4_genes;
----
4	false

query I
SELECT count(*) FROM read_fastx('data/prodigal/ref_single_g4.proteins.gz') p
FULL JOIN table4_genes s ON p.read_id = s.read_id || '_' || s.gene_index AND p.sequence1 = s.protein
WHERE p.read_id IS NULL OR s.read_id IS NULL;
----
0

# -m: on anthus_aco.fas it changes nothing, so on a copy with an N run inside each contig. Without it the CLI's
# default; with it the CLI's -m.
statement ok
CREATE TABLE masked AS
SELECT 'masked' AS genome, sequence_index, read_id, sequence1 FROM read_fastx('data/prodigal/anthus_masked.fas.gz');

statement ok
CREATE TABLE masked_off AS SELECT * FROM predict_genes('masked', genome_id := 'genome');

query I
SELECT n FROM differs_from_cli('masked_off', 'data/prodigal/ref_masked.gff.gz');
----
0

statement ok
CREATE TABLE masked_on AS SELECT * FROM predict_genes('masked', genome_id := 'genome', mask_regions := true);

query I
SELECT n FROM differs_from_cli('masked_on', 'data/prodigal/ref_masked_m.gff.gz');
----
0

# -----------------------------------------------------------------------------
# Contig order is order_by's: here read_id order is the reverse of the file's, and the genes are the file order's
# -----------------------------------------------------------------------------
statement ok
CREATE TABLE renamed AS
SELECT genome, sequence_index, printf('r%03d', 100 - sequence_index) AS read_id, read_id AS original, sequence1
FROM anthus;

statement ok
CREATE TABLE renamed_genes AS
SELECT g.* REPLACE (r.original AS read_id)
FROM predict_genes('renamed', genome_id := 'genome') g JOIN renamed r ON g.read_id = r.read_id;

query I
SELECT n FROM differs_from_cli('renamed_genes', 'data/prodigal/ref_single.gff.gz');
----
0

# -----------------------------------------------------------------------------
