SELECT 42::BIGINT AS genome, sequence_index, row_number() OVER (ORDER BY read_id)::BIGINT AS read_id, sequence1
FROM anthus;

query III
SELECT typeof(genome_id), typeof(read_id), count(*) FROM predict_genes('int_ids', genome_id := 'genome', meta_mode := true)
GROUP BY ALL;
