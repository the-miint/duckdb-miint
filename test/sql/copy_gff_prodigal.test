# name: test/sql/copy_gff_prodigal.test
# description: COPY ... (FORMAT GFF, DIALECT 'prodigal') of predict_genes' columns writes Prodigal's own GFF, "# Model Data" included, checked against the CLI's file on anthus_aco.fas (data/prodigal/README.md)
# group: [sql]

require miint

require-env GPL_BOUNDARY_AVAILABLE

statement ok
CREATE TABLE anthus AS
SELECT 'anthus' AS genome, sequence_index, read_id, sequence1 FROM read_fastx('data/prodigal/anthus_aco.fas');

# A file's lines, in order. The CLI's reference files name the Prodigal that made them (2.6.3) and keep the CR
# of anthus_aco.fas's CRLF headers in seqhdr; both are normalized away here and nowhere else.
statement ok
CREATE MACRO lines_of(path) AS TABLE
SELECT i, replace(replace(replace(line, 'v2.6.3', 'v2.6.5'), E'\r', ''), E'\t', ' | ') AS line FROM (
    SELECT unnest(range(len(s))) AS i, unnest(s) AS line
    FROM (SELECT string_split(rtrim(content, E'\n'), E'\n') AS s FROM read_text(path))
);

statement ok
COPY (SELECT * FROM predict_genes('anthus', genome_id := 'genome') ORDER BY read_id, gene_index)
TO '{TEST_DIR}/single.gff' (FORMAT GFF, DIALECT 'prodigal');

# The rows reach COPY in the CLI's contig order only if asked to; read_fastx's order is the file's.
statement ok
CREATE TABLE contig_order AS SELECT read_id, row_number() OVER () AS seqnum FROM anthus;

statement ok
COPY (SELECT g.* FROM predict_genes('anthus', genome_id := 'genome') g JOIN contig_order USING (read_id)
      ORDER BY seqnum, gene_index)
TO '{TEST_DIR}/single_cli_order.gff' (FORMAT GFF, DIALECT 'prodigal');

query I
SELECT count(*) FROM ((SELECT * FROM lines_of('data/prodigal/ref_single.gff')
                       EXCEPT SELECT * FROM lines_of('{TEST_DIR}/single_cli_order.gff'))
                      UNION ALL
                      (SELECT * FROM lines_of('{TEST_DIR}/single_cli_order.gff')
                       EXCEPT SELECT * FROM lines_of('data/prodigal/ref_single.gff')));
----
0

statement ok
COPY (SELECT g.* FROM predict_genes('anthus', genome_id := 'genome', meta_mode := true) g
      JOIN contig_order USING (read_id) ORDER BY seqnum, gene_index)
TO '{TEST_DIR}/meta_cli_order.gff' (FORMAT GFF, DIALECT 'prodigal');

query I
SELECT count(*) FROM ((SELECT * FROM lines_of('data/prodigal/ref_meta.gff')
                       EXCEPT SELECT * FROM lines_of('{TEST_DIR}/meta_cli_order.gff'))
                      UNION ALL
                      (SELECT * FROM lines_of('{TEST_DIR}/meta_cli_order.gff')
                       EXCEPT SELECT * FROM lines_of('data/prodigal/ref_meta.gff')));
----
0

# read_gff reads it, and CheckM's reading of the translation table (checkm/prodigal.py) finds 11.
query I
SELECT count(*) FROM read_gff('{TEST_DIR}/single.gff');
----
129

query I
SELECT DISTINCT regexp_extract(line, 'transl_table=([0-9]+)', 1) FROM lines_of('{TEST_DIR}/single.gff')
WHERE line LIKE '# Model Data:%';
----
11

# Rows for a genome without genes are not features, and are skipped.
statement ok
CREATE TABLE two AS
SELECT * FROM anthus
UNION ALL
SELECT 'small' AS genome, sequence_index, read_id, sequence1 FROM anthus WHERE read_id IN ('61430_aco', '626029_aco', '630116_aco');

statement ok
COPY (SELECT * FROM predict_genes('two', genome_id := 'genome') ORDER BY genome_id, read_id, gene_index)
TO '{TEST_DIR}/two.gff' (FORMAT GFF, DIALECT 'prodigal');

query I
SELECT count(*) FROM read_gff('{TEST_DIR}/two.gff');
----
129

# SOURCE names the program in column 2.
statement ok
COPY (SELECT * FROM predict_genes('anthus', genome_id := 'genome', meta_mode := true) ORDER BY read_id, gene_index)
TO '{TEST_DIR}/source.gff' (FORMAT GFF, DIALECT 'prodigal', SOURCE 'Prodigal_v2.6.5_miint');

query I
SELECT DISTINCT source FROM read_gff('{TEST_DIR}/source.gff');
----
Prodigal_v2.6.5_miint

# A contig without genes gets its header lines and its seqnum, as in the CLI's file (gene.c's print_genes writes
# them whatever the gene count): here 'tiny', the 11th of 23 contigs (sequence_index starts at 1).
statement ok
CREATE TABLE mixed AS
SELECT genome, sequence_index * 2 AS ord, read_id, sequence1 FROM anthus
UNION ALL
SELECT 'anthus' AS genome, 21 AS ord, 'tiny' AS read_id, repeat('ACGTTGCA', 6) AS sequence1;

statement ok
COPY (SELECT * FROM predict_genes('mixed', genome_id := 'genome', order_by := 'ord', meta_mode := true))
TO '{TEST_DIR}/mixed.gff' (FORMAT GFF, DIALECT 'prodigal');

query I
SELECT count(*) FROM lines_of('{TEST_DIR}/mixed.gff') WHERE line LIKE '# Sequence Data:%';
----
23

# Its two header lines, then straight to the next contig's.
query I
SELECT CASE WHEN line LIKE '# Model Data:%' THEN '# Model Data' ELSE line END FROM lines_of('{TEST_DIR}/mixed.gff')
WHERE i BETWEEN (SELECT i FROM lines_of('{TEST_DIR}/mixed.gff') WHERE line LIKE '%seqhdr="tiny"%')
            AND (SELECT i FROM lines_of('{TEST_DIR}/mixed.gff') WHERE line LIKE '%seqhdr="tiny"%') + 2
ORDER BY i;
----
# Sequence Data: seqnum=11;seqlen=48;seqhdr="tiny"
# Model Data
# Sequence Data: seqnum=12;seqlen=960;seqhdr="AMNH13589_aco"

# The contigs after it are numbered after it.
query I
SELECT DISTINCT split_part(line, ' | ', 1) FROM lines_of('{TEST_DIR}/mixed.gff') WHERE line LIKE '%ID=13\_%' ESCAPE '\';
----
KU25127_aco

# PARTITION_BY genome_id writes a file per genome, each numbered from 1 as the CLI numbers a file of its own;
# genome_id itself need not be written.
statement ok
CREATE TABLE pair AS
SELECT * FROM anthus UNION ALL SELECT 'anthus2' AS genome, sequence_index, read_id, sequence1 FROM anthus;

statement ok
COPY (SELECT * FROM predict_genes('pair', genome_id := 'genome', meta_mode := true))
TO '{TEST_DIR}/by_genome' (FORMAT GFF, DIALECT 'prodigal', PARTITION_BY (genome_id));

query II
SELECT regexp_extract(filename, 'genome_id=([^/]*)', 1) AS genome,
       list(regexp_extract(line, 'seqnum=([0-9]+)', 1)::INTEGER ORDER BY i)[1:2]
FROM (SELECT filename, unnest(range(len(s))) AS i, unnest(s) AS line
      FROM (SELECT filename, string_split(content, E'\n') AS s FROM read_text('{TEST_DIR}/by_genome/*/*.gff')))
WHERE line LIKE '# Sequence Data:%' GROUP BY genome ORDER BY genome;
----
anthus	[1, 2]
anthus2	[1, 2]

# Each file is the one-genome run's.
statement ok
COPY (SELECT * FROM predict_genes('anthus', genome_id := 'genome', meta_mode := true))
TO '{TEST_DIR}/meta_alone.gff' (FORMAT GFF, DIALECT 'prodigal');

query I
SELECT count(*) FROM ((SELECT * FROM lines_of('{TEST_DIR}/meta_alone.gff')
                       EXCEPT ALL SELECT * FROM lines_of('{TEST_DIR}/by_genome/genome_id=anthus2/data_0.gff'))
                      UNION ALL
                      (SELECT * FROM lines_of('{TEST_DIR}/by_genome/genome_id=anthus2/data_0.gff')
                       EXCEPT ALL SELECT * FROM lines_of('{TEST_DIR}/meta_alone.gff')));
----
0
