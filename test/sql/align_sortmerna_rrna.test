# name: test/sql/align_sortmerna_rrna.test
# description: Test align_sortmerna_rrna table function
# group: [sql]

require miint

require-env SORTMERNA_AVAILABLE

# Sample query table for schema-level tests below.
statement ok
CREATE TABLE smr_q (read_id VARCHAR, sequence1 VARCHAR);

# --- Output schema ---
query II
SELECT column_name, column_type FROM (
    DESCRIBE SELECT * FROM align_sortmerna_rrna(
        'smr_q', ref_paths := ['ext/sortmerna/test_data/test_ref.fasta'])
) ORDER BY column_name;
----
aligned	INTEGER
cigar	VARCHAR
coverage	DOUBLE
e_value	DOUBLE
edit_distance	INTEGER
identity	DOUBLE
read_id	VARCHAR
ref_end	INTEGER
ref_name	VARCHAR
ref_start	INTEGER
score	INTEGER
segment_idx	INTEGER
strand	INTEGER

# --- ref_paths is required ---
statement error
SELECT * FROM align_sortmerna_rrna('smr_q');
----
ref_paths

# --- ref_paths must be non-empty ---
statement error
SELECT * FROM align_sortmerna_rrna('smr_q', ref_paths := []);
----
ref_paths

# --- ref_paths takes exactly one file ---
# SortMeRNA builds one index from one reference file. A second file must be
# refused at bind: ignoring it would leave reads that match only it unaligned,
# with no error.
statement error
SELECT * FROM align_sortmerna_rrna('smr_q', ref_paths := [
    'ext/sortmerna/test_data/test_ref.fasta', 'ext/sortmerna/test_data/gg_13_8_ref_set.fasta']);
----
ref_paths accepts one FASTA path (got 2)

# --- Single-end forward alignment against golden values ---
# Goldens from tools/sortmerna_oracle.sh, the native CLI
# (AB271211 vs ext/sortmerna/test_data/test_ref.fasta). Identity/coverage are
# library full-precision values equivalent to BLAST's rounded 93.5 / 96.2.
statement ok
CREATE TABLE smr_fwd (read_id VARCHAR, sequence1 VARCHAR);

statement ok
INSERT INTO smr_fwd VALUES (
  'AB271211',
  ''
);

query IIIIIIIIIII
SELECT read_id, aligned, strand, ref_name, ref_start, ref_end, cigar, score,
       edit_distance,
       round(identity, 1) AS identity_1dp,
       round(coverage, 1) AS coverage_1dp
FROM align_sortmerna_rrna(
    'smr_fwd', ref_paths := ['ext/sortmerna/test_data/test_ref.fasta'], num_threads := 1);
----
AB271211	1	1	Unc49508	1	1446	57S57M2I12M2D4M2I29M1D11M2I3M2D11M1I7M1D13M5D4M3D9M2D3M7D1260M	2430	94	93.5	96.2

# --- Reverse-complement read → strand=0 ---
statement ok
CREATE TABLE smr_rc (read_id VARCHAR, sequence1 VARCHAR);

statement ok
INSERT INTO smr_rc VALUES (
  'AB271211_rc',
  ''
);

query IIIIIIIII
SELECT strand, ref_name, ref_start, ref_end, cigar, score, edit_distance,
       round(identity, 1), round(coverage, 1)
FROM align_sortmerna_rrna(
    'smr_rc', ref_paths := ['ext/sortmerna/test_data/test_ref.fasta'], num_threads := 1);
----
0	Unc49508	1	1446	57S57M2I12M2D4M2I29M1D11M2I3M2D11M1I7M1D13M5D4M3D9M2D3M7D1260M	2430	94	93.5	96.2

# --- Paired-end: one input row → two output rows with segment_idx 0/1 ---
statement ok
CREATE TABLE smr_pe (read_id VARCHAR, sequence1 VARCHAR, sequence2 VARCHAR);

statement ok
INSERT INTO smr_pe SELECT read_id, sequence1, sequence1 AS sequence2 FROM smr_fwd;

query IIII
SELECT segment_idx, strand, ref_start, ref_end
FROM align_sortmerna_rrna(
    'smr_pe', ref_paths := ['ext/sortmerna/test_data/test_ref.fasta'],
    num_threads := 1, paired := true)
ORDER BY segment_idx;
----
0	1	1	1446
1	1	1	1446

# --- Paired flag mismatch at bind ---
statement error
SELECT * FROM align_sortmerna_rrna(
    'smr_fwd', ref_paths := ['ext/sortmerna/test_data/test_ref.fasta'], paired := true);
----
paired

# --- Multi-batch streaming: 3000 rows force >1 QuerySequenceStream sub-batch
# (default STANDARD_VECTOR_SIZE = 2048). Cross-join with the 1-row smr_fwd
# table replicates the AB271211 sequence 3000 times, each tagged with a
# unique synthetic read_id r0..r2999. Every row must appear in the output
# with aligned=1 and identical ref/coords/score to confirm the streaming
# refill path preserves per-row identity.
statement ok
CREATE TABLE smr_big AS
  SELECT 'r' || (range % 3000) AS read_id, sequence1
  FROM generate_series(0, 2999) AS t(range), smr_fwd;

query II
SELECT COUNT(*), COUNT(DISTINCT read_id) FROM smr_big;
----
3000	3000

query III
SELECT COUNT(*), COUNT(DISTINCT read_id), COUNT(*) FILTER (WHERE aligned = 1)
FROM align_sortmerna_rrna(
    'smr_big', ref_paths := ['ext/sortmerna/test_data/test_ref.fasta'], num_threads := 1);
----
3000	3000	3000

# Every aligned row should report the same ref/coords/score (identical input).
query IIIII
SELECT COUNT(DISTINCT ref_name), COUNT(DISTINCT ref_start), COUNT(DISTINCT ref_end),
       COUNT(DISTINCT score), COUNT(DISTINCT edit_distance)
FROM align_sortmerna_rrna(
    'smr_big', ref_paths := ['ext/sortmerna/test_data/test_ref.fasta'], num_threads := 1);
----
1	1	1	1	1

# --- evalue: the library reports every hit, so the threshold is applied in
# the wrapper. Shorter pieces of AB271211 score lower and so have larger
# e-values (len40 ~5e-10, len32 ~3e-7). With evalue := 1e-9, len32's hit is
# reported as a read with no hit; the other rows are unchanged.
statement ok
CREATE TABLE smr_ev AS
  SELECT 'len' || len AS read_id, substr(sequence1, 300, len) AS sequence1
  FROM smr_fwd, (VALUES (32), (40), (60), (200)) t(len);

query IIIIIII
SELECT read_id, aligned, strand, ref_name, cigar, score, edit_distance
FROM align_sortmerna_rrna(
    'smr_ev', ref_paths := ['ext/sortmerna/test_data/test_ref.fasta'], num_threads := 1)
ORDER BY read_id;
----
len200	1	1	Unc49508	6S194M	333	11
len32	1	1	Unc49508	6S26M	42	2
len40	1	1	Unc49508	6S34M	53	3
len60	1	1	Unc49508	6S54M	88	4

query IIIIIII
SELECT read_id, aligned, strand, ref_name, cigar, score, edit_distance
FROM align_sortmerna_rrna(
    'smr_ev', ref_paths := ['ext/sortmerna/test_data/test_ref.fasta'], num_threads := 1,
    evalue := 1e-9)
ORDER BY read_id;
----
len200	1	1	Unc49508	6S194M	333	11
len32	0	-1	(empty)	(empty)	-1	-1
len40	1	1	Unc49508	6S34M	53	3
len60	1	1	Unc49508	6S54M	88	4

# evalue := 0 keeps only a hit whose e-value is exactly 0: AB271211's
# full-length hit underflows to 0, its pieces do not.
statement ok
CREATE TABLE smr_ev0 AS SELECT * FROM smr_fwd UNION ALL SELECT * FROM smr_ev;

query III
SELECT read_id, aligned, e_value
FROM align_sortmerna_rrna(
    'smr_ev0', ref_paths := ['ext/sortmerna/test_data/test_ref.fasta'], num_threads := 1, evalue := 0)
ORDER BY read_id;
----
AB271211	1	0.0
len200	0	0.0
len32	0	0.0
len40	0	0.0
len60	0	0.0

# A negative or NaN evalue would keep every hit, as if none were given, so it
# is refused rather than silently ignored.
statement error
SELECT * FROM align_sortmerna_rrna(
    'smr_ev', ref_paths := ['ext/sortmerna/test_data/test_ref.fasta'], evalue := -1e-5);
----
align_sortmerna_rrna: evalue must be a non-negative number

statement error
SELECT * FROM align_sortmerna_rrna(
    'smr_ev', ref_paths := ['ext/sortmerna/test_data/test_ref.fasta'], evalue := CAST('nan' AS DOUBLE));
----
align_sortmerna_rrna: evalue must be a non-negative number
