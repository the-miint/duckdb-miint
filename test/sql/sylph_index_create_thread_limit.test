# name: test/sql/sylph_index_create_thread_limit.test
# description: sylph_index_create builds its index when its worker threads cannot start
# group: [sql]

require miint

require-env SYLPH_AVAILABLE

# Held back from the main pass: run_tests.sh runs this file under an RLIMIT_NPROC that no new
# thread fits in. sylph_index_create then sketches every genome on the thread that called it,
# rather than failing the query or ending the process.
require-env MIINT_NPROC_LIMIT_TEST

statement ok
SET threads = 1;

statement ok
CREATE TABLE refs AS
  SELECT * FROM read_fastx('data/sylph/tiny_refs/*.fasta.gz', include_filepath := true);

# threads := 2 asks for a second thread, which cannot start.
query I
SELECT num_genomes
  FROM sylph_index_create(
    'refs', '{TEST_DIR}/thread_limit.syldb',
    genome_id := 'filepath', order_by := 'sequence_index', threads := 2);
----
3

# The bytes a build on one sketching thread writes for these references, taken from a build
# with threads := 1 and no limit (with more threads the genomes can be written in another
# order). sylph_profile cannot check this index here, as it needs a thread pool of its own.
query I
SELECT md5(content) FROM read_blob('{TEST_DIR}/thread_limit.syldb');
----
77d70771867efa0297e15e9bef3a502d
