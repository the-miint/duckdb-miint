# name: test/sql/read_fastx.test
# description: test read_fastx table function
# group: [sql]

statement ok
PRAGMA enable_verification;

# Before we load the extension, this will fail
statement error
SELECT * FROM read_fastx('foo', 'bar');
----
Catalog Error: Table Function with name read_fastx does not exist!

# Require statement will ensure this test is run with this extension loaded
require miint

# Confirm the extension fails when files are not found
statement error
SELECT * FROM read_fastx('missing_file1', sequence2='missing_file2');
----
IO Error: File not found: missing_file1

query IIIIIII
SELECT * FROM read_fastx('data/fastq/foo.r1.fastq.gz', sequence2='data/fastq/foo.r2.fastq.gz')
----
1	foo1	comment-1	ATGC	TGCAT	[40, 39, 38, 37]	[36, 35, 34, 33, 32]
2	foo2	comment-2	ATGCT	TGCATC	[40, 39, 38, 37, 36]	[36, 35, 34, 33, 32, 31]

query IIIIIII
SELECT * FROM read_fastx('data/fastq/bar.r1.fastq.gz', sequence2='data/fastq/bar.r2.fastq.gz')
----
1	bar1	NULL	AA	CCC	[40, 40]	[39, 39, 39]
2	bar2	NULL	GG	GGG	[40, 40]	[39, 39, 39]
3	bar3	NULL	TT	TTT	[40, 40]	[39, 39, 39]

# mismatched read IDs
statement error
SELECT * FROM read_fastx('data/fastq/foo.r1.fastq.gz', sequence2='data/fastq/foo.r2.fastq.mismatched-ids.fastq.gz')
----
Invalid Error: Mismatched read IDs: foo1/1 vs foo2/2

# different number of reads
statement error
SELECT * FROM read_fastx('data/fastq/foo.r1.fastq.gz', sequence2='data/fastq/foo.r2.fastq.missing-read.fastq.gz')
----
Invalid Error: Mismatched number of records: missing mate for foo2/1

# single end
query IIIIIII
SELECT * FROM read_fastx('data/fastq/foo.r1.fastq.gz')
----
1	foo1	comment-1	ATGC	NULL	[40, 39, 38, 37]	NULL
2	foo2	comment-2	ATGCT	NULL	[40, 39, 38, 37, 36]	NULL

# interleaved
# alternative phred offset
#statement error
#select * from read_fastx('fail-missing-tests');

# ===== NEW TESTS FOR EXPANDED FUNCTIONALITY =====

# Test FASTA format (no quality scores - should be NULL)
query IIIIIII
SELECT * FROM read_fastx('data/fastq/test.fa')
----
1	seq1	test sequence 1	ATGCATGCATGC	NULL	NULL	NULL
2	seq2	NULL	GGCCGGCCGGCC	NULL	NULL	NULL

# Test FASTA with whitespace in sequences (should be stripped)
query IIIIIII
SELECT * FROM read_fastx('data/fastq/sequence_with_spaces.fasta')
----
1	foo	NULL	AATTGGCCAAATATAGCGCGTA	NULL	NULL	NULL
2	bar	NULL	GGTTAACCGGTTAATTGG	NULL	NULL	NULL
3	baz	NULL	AAAAAAAAAA	NULL	NULL	NULL

# Every ASCII whitespace byte inside a sequence line is stripped, not only spaces: the
# fixture carries tab, vertical tab, form feed, a space and a lone '\r' inside lines, as well
# as CRLF line endings, whose '\r' the line reader drops. Run single-end and paired, since the
# two paths strip separately.
query II
SELECT sequence_index, sequence1 FROM read_fastx('data/fastq/sequence_with_ascii_whitespace.fasta')
----
1	ACGTACGT
2	AACCGGTT

query III
SELECT sequence_index, sequence1, sequence2
FROM read_fastx('data/fastq/sequence_with_ascii_whitespace.fasta',
                sequence2 := 'data/fastq/sequence_with_ascii_whitespace.fasta')
----
1	ACGTACGT	ACGTACGT
2	AACCGGTT	AACCGGTT

# Test VARCHAR[] single-end (multiple files, each with per-file sequence_index)
# Note: sequence_index now resets to 1 for each file, so we need include_filepath to distinguish
query IIIIIIII
SELECT * FROM read_fastx(['data/fastq/small_a.fq', 'data/fastq/small_b.fq'], include_filepath=true)
ORDER BY filepath, sequence_index
----
1	read_a1	NULL	AAAA	NULL	[40, 40, 40, 40]	NULL	data/fastq/small_a.fq
2	read_a2	NULL	TTTT	NULL	[39, 39, 39, 39]	NULL	data/fastq/small_a.fq
1	read_b1	NULL	GGGG	NULL	[38, 38, 38, 38]	NULL	data/fastq/small_b.fq
2	read_b2	NULL	CCCC	NULL	[37, 37, 37, 37]	NULL	data/fastq/small_b.fq

# Test VARCHAR[] paired-end (per-file sequence_index)
query IIIIIIII
SELECT * FROM read_fastx(['data/fastq/small_a_r1.fq', 'data/fastq/small_b_r1.fq'],
                          sequence2=['data/fastq/small_a_r2.fq', 'data/fastq/small_b_r2.fq'],
                          include_filepath=true)
ORDER BY filepath, sequence_index
----
1	pair_a1	NULL	AAAA	TTTT	[40, 40, 40, 40]	[39, 39, 39, 39]	data/fastq/small_a_r1.fq
1	pair_b1	NULL	GGGG	CCCC	[38, 38, 38, 38]	[37, 37, 37, 37]	data/fastq/small_b_r1.fq

# Test include_filepath parameter with single file
query IIIIIIII
SELECT * FROM read_fastx('data/fastq/small_a.fq', include_filepath=true)
----
1	read_a1	NULL	AAAA	NULL	[40, 40, 40, 40]	NULL	data/fastq/small_a.fq
2	read_a2	NULL	TTTT	NULL	[39, 39, 39, 39]	NULL	data/fastq/small_a.fq

# Test include_filepath with paired-end
query IIIIIIII
SELECT * FROM read_fastx('data/fastq/small_a_r1.fq', 
                          sequence2='data/fastq/small_a_r2.fq',
                          include_filepath=true)
----
1	pair_a1	NULL	AAAA	TTTT	[40, 40, 40, 40]	[39, 39, 39, 39]	data/fastq/small_a_r1.fq

# Test COUNT with VARCHAR[] to verify all records read
query I
SELECT COUNT(*) FROM read_fastx(['data/fastq/small_a.fq', 'data/fastq/small_b.fq', 'data/fastq/small_c.fq'])
----
5

# Test parallel execution (set preserve_insertion_order=false)
statement ok
SET preserve_insertion_order=false;

query I
SELECT COUNT(*) FROM read_fastx(['data/fastq/foo.r1.fastq.gz', 'data/fastq/bar.r1.fastq.gz'])
----
5

statement ok
SET preserve_insertion_order=true;

# ===== PER-FILE SEQUENCE_INDEX TESTS =====

# Test: single file sequence_index works as expected (1 to N)
query I
SELECT sequence_index FROM read_fastx('data/fastq/bar.r1.fastq.gz')
ORDER BY sequence_index
----
1
2
3

# Test: multiple files each start from 1 (verified with include_filepath)
query II
SELECT sequence_index, filepath FROM read_fastx(
    ['data/fastq/small_a.fq', 'data/fastq/small_b.fq', 'data/fastq/small_c.fq'],
    include_filepath=true
)
ORDER BY filepath, sequence_index
----
1	data/fastq/small_a.fq
2	data/fastq/small_a.fq
1	data/fastq/small_b.fq
2	data/fastq/small_b.fq
1	data/fastq/small_c.fq

# Test: paired-end reads increment sequence_index once per pair (not twice)
query II
SELECT sequence_index, read_id FROM read_fastx(
    'data/fastq/foo.r1.fastq.gz',
    sequence2='data/fastq/foo.r2.fastq.gz'
)
ORDER BY sequence_index
----
1	foo1
2	foo2

# Test: multiple paired-end files each start from 1
query II
SELECT sequence_index, filepath FROM read_fastx(
    ['data/fastq/small_a_r1.fq', 'data/fastq/small_b_r1.fq'],
    sequence2=['data/fastq/small_a_r2.fq', 'data/fastq/small_b_r2.fq'],
    include_filepath=true
)
ORDER BY filepath, sequence_index
----
1	data/fastq/small_a_r1.fq
1	data/fastq/small_b_r1.fq

# Test: verify sequence_index resets for each file with larger dataset
# foo has 2 sequences, bar has 3 sequences, so we expect indices [1,2,3]
query I
SELECT COUNT(DISTINCT sequence_index) FROM read_fastx(
    ['data/fastq/foo.r1.fastq.gz', 'data/fastq/bar.r1.fastq.gz'],
    include_filepath=true
)
----
3

# Note: stdin testing (e.g., cat file.fq | duckdb -c "SELECT * FROM read_fastx('-')")
# is not easily done in this test framework, but stdin is treated as a single file,
# so sequence_index behavior should match single file tests (indices 1 to N)

# Error: empty file should throw
statement error
SELECT * FROM read_fastx('data/fastq/empty.fq');
----
Invalid Error: Empty file

# allow_empty reads an empty file as no records, for tools that write a file whether or not
# they have records for it. Other files in the same scan are read as usual.
query I
SELECT count(*) FROM read_fastx('data/fastq/empty.fq', allow_empty := true);
----
0

query I
SELECT count(*) FROM read_fastx(['data/fastq/empty.fq', 'data/fastq/small_a.fq', 'data/fastq/empty.fq'], allow_empty := true);
----
2

query I
SELECT count(*) FROM read_fastx('data/fastq/empty.fq', sequence2 := 'data/fastq/empty.fq', allow_empty := true);
----
0

# One empty file with read-ahead off (one thread) and on (four; SequenceReader::ReadAheadFits).
statement ok
SET threads = 1;

query I
SELECT count(*) FROM read_fastx('data/fastq/empty.fq', allow_empty := true);
----
0

statement ok
SET threads = 4;

query I
SELECT count(*) FROM read_fastx('data/fastq/empty.fq', allow_empty := true);
----
0

statement ok
RESET threads;

statement error
SELECT * FROM read_fastx('data/fastq/empty.fq', allow_empty := false);
----
Invalid Error: Empty file

# One empty mate is a broken pair, not an empty one, so it is still an error.
statement error
SELECT * FROM read_fastx('data/fastq/empty.fq', sequence2 := 'data/fastq/small_a_r2.fq', allow_empty := true);
----
Empty file: data/fastq/empty.fq

statement error
SELECT * FROM read_fastx('data/fastq/small_a_r1.fq', sequence2 := 'data/fastq/empty.fq', allow_empty := true);
----
Empty file: data/fastq/empty.fq

# Error: mismatched array lengths
statement error
SELECT * FROM read_fastx(['data/fastq/small_a.fq', 'data/fastq/small_b.fq'], 
                          sequence2=['data/fastq/small_a_r2.fq']);
----
Invalid Input Error: Mismatched array lengths

# Error: stdin with sequence2
statement error
SELECT * FROM read_fastx('-', sequence2='data/fastq/small_a_r2.fq');
----
Invalid Input Error: stdin cannot be used with sequence2

# '-' as sequence2 is a file name, not stdin, and no such file exists: refused when the query binds
statement error
SELECT * FROM read_fastx('data/fastq/small_a.fq', sequence2='-');
----
File not found: -

# Error: stdin with VARCHAR[]
statement error
SELECT * FROM read_fastx(['-', 'data/fastq/small_a.fq']);
----
Invalid Input Error: stdin

# Error: mixed FASTA/FASTQ paired-end
statement error
SELECT * FROM read_fastx('data/fastq/test_r1.fa', sequence2='data/fastq/test_r2.fq');
----
Invalid Error: Cannot mix FASTA and FASTQ formats

# --- Row estimate ---

# The planner's row estimate is the input's size over 50 bytes, with gzip counted at four
# times its size, so a join probes read_fastx instead of hashing a multi-GB file into memory
# (why: EstimateFileScanCardinality in src/include/table_function_common.hpp).
# data/minimap2/subject.fasta is 4641666 bytes: 4641666 / 50 = 92833.
query II
EXPLAIN SELECT * FROM read_fastx('data/minimap2/subject.fasta');
----
physical_plan	<REGEX>:.*~92,833 rows.*

# e.coli-K12.fasta.gz is 1424962 bytes: 1424962 * 4 / 50 = 113996.
query II
EXPLAIN SELECT * FROM read_fastx('data/sylph/tiny_refs/e.coli-K12.fasta.gz');
----
physical_plan	<REGEX>:.*~113,996 rows.*

# Every file counts, mates included: (75584 + 75624) / 50 = 3024.
query II
EXPLAIN SELECT * FROM read_fastx('data/merge/ltp_50_R1.fq', sequence2 := 'data/merge/ltp_50_R2.fq');
----
physical_plan	<REGEX>:.*~3,024 rows.*

# A remote file's size is not read while planning, so it gets a large constant.
query II
EXPLAIN SELECT * FROM read_fastx('https://example.invalid/reads.fq');
----
physical_plan	<REGEX>:.*~10,000,000 rows.*
