# name: test/sql/gtdb_label.test
# description: gtdb_label and gtdb_species_label split GTDB names into base names and suffixes
# group: [sql]

require miint

# GTDB marks the parts of a split taxon with a suffix: Bacillota_A, Pseudomonas_E. The
# split gives the base name, which groups the parts, and the suffix without its
# underscore. A suffix is runs of capitals and digits joined by single underscores, so
# Y_123 is one suffix.
statement ok
CREATE TABLE labels(i INTEGER, name VARCHAR);

statement ok
INSERT INTO labels VALUES (1, 'Bacillota_A'), (2, 'Pseudomonas_E'), (3, 'Bacillota'), (4, 'CAG-41'), (5, 'UBA1234'),
(6, 'Foo_Y_123'), (7, 'Foo_A1');

query ITT
SELECT i, gtdb_label(name).base, gtdb_label(name).suffix FROM labels ORDER BY i;
----
1	Bacillota	A
2	Pseudomonas	E
3	Bacillota	NULL
4	CAG-41	NULL
5	UBA1234	NULL
6	Foo	Y_123
7	Foo	A1

# A name that does not fit gives NULL, not an error: a trailing or doubled underscore, a
# suffix with lower case or nothing before or after the underscore, a rank prefix (pass
# the name, as parse_lineage returns it), a space or a dot, an empty name.
statement ok
CREATE TABLE bad_labels(i INTEGER, name VARCHAR);

statement ok
INSERT INTO bad_labels VALUES (1, 'Foo_A_'), (2, 'Foo__A'), (3, 'Foo_a'), (4, '_A'), (5, 'Foo_'), (6, 'p__Bacillota'),
(7, 'Foo bar'), (8, 'Foo.bar'), (9, ''), (10, 'Foo_A bar'), (11, NULL);

query IT
SELECT i, gtdb_label(name) FROM bad_labels ORDER BY i;
----
1	NULL
2	NULL
3	NULL
4	NULL
5	NULL
6	NULL
7	NULL
8	NULL
9	NULL
10	NULL
11	NULL

# Species: the genus label, one space, then the epithet, each with an optional suffix.
# The epithet may hold single spaces and dots (bar subsp. baz); its suffix sits only at
# its very end.
statement ok
CREATE TABLE species(i INTEGER, name VARCHAR);

statement ok
INSERT INTO species VALUES (1, 'Pseudomonas_E fluorescens_B'), (2, 'Escherichia coli'),
(3, 'Prevotella sp000434975'), (4, 'Foo bar subsp. baz_A'), (5, 'Bacillus_A cereus'), (6, 'Foo bar_Y_123');

query ITTTT
SELECT i, s.genus_base, s.genus_suffix, s.epithet, s.epithet_suffix
FROM (SELECT i, gtdb_species_label(name) AS s FROM species) ORDER BY i;
----
1	Pseudomonas	E	fluorescens	B
2	Escherichia	NULL	coli	NULL
3	Prevotella	NULL	sp000434975	NULL
4	Foo	NULL	bar subsp. baz	A
5	Bacillus	A	cereus	NULL
6	Foo	NULL	bar	Y_123

# A suffix inside the epithet, doubled or edge spaces, a genus alone, and malformed
# suffixes give NULL.
statement ok
CREATE TABLE bad_species(i INTEGER, name VARCHAR);

statement ok
INSERT INTO bad_species VALUES (1, 'Foo bar_A subsp. baz'), (2, 'Foo  bar'), (3, 'Foo bar '), (4, ' Foo bar'),
(5, 'Foo'), (6, 'Foo_A'), (7, 'Foo bar_'), (8, 'Foo bar__A'), (9, 'Foo_A_ bar'), (10, 'Foo bar_a'), (11, ''),
(12, NULL);

query IT
SELECT i, gtdb_species_label(name) FROM bad_species ORDER BY i;
----
1	NULL
2	NULL
3	NULL
4	NULL
5	NULL
6	NULL
7	NULL
8	NULL
9	NULL
10	NULL
11	NULL
12	NULL

# Literal arguments take other paths through the executor than table rows: a literal
# NULL never reaches the function, and a literal's one row comes back as a constant.
query TTTT
SELECT gtdb_label('Bacillota_A').suffix, gtdb_label(NULL) IS NULL, gtdb_species_label('Foo bar_A').epithet_suffix,
       gtdb_species_label(NULL).epithet IS NULL;
----
A	true	A	true

# Names that reach the functions through a selection vector rather than flat. A filter
# operator that passes half of each vector hands its rows on with a selection. The LIMIT
# keeps the filter out of the table scan, which would copy the rows it selects; a small
# result, a few rows, is copied flat too, so neither would test this.
statement ok
CREATE TABLE many AS
SELECT i, CASE WHEN i % 2 = 0 THEN 'Bacillota_A' ELSE 'Pseudomonas' END AS name,
       CASE WHEN i % 2 = 0 THEN 'Pseudomonas_E fluorescens_B' ELSE 'Escherichia coli' END AS species
FROM range(8192) t(i);

query IIII
SELECT count(*), count(*) FILTER (WHERE gtdb_label(name).suffix = 'A'),
       count(*) FILTER (WHERE gtdb_species_label(species).genus_suffix = 'E'),
       count(*) FILTER (WHERE gtdb_species_label(species).epithet_suffix = 'B')
FROM (SELECT * FROM many LIMIT 100000) WHERE i % 2 = 0;
----
4096	4096	4096	4096

query TT
SELECT typeof(gtdb_label('Foo_A')), typeof(gtdb_species_label('Foo bar'));
----
STRUCT(base VARCHAR, suffix VARCHAR)	STRUCT(genus_base VARCHAR, genus_suffix VARCHAR, epithet VARCHAR, epithet_suffix VARCHAR)

# =============================================================================
# The functions against a regular expression for the same rules, on two sets of strings:
# - short: every string of up to six characters over a, B, 0, '-', '_', ' ' and '.'
#   (137,256 of them);
# - swept: every printable ASCII character, and two that are not ASCII, in each position
#   the rules treat differently (1,934 distinct strings). This reaches the edges of each
#   character class (Z, @, [, `, {, /, :) and the characters a name or an epithet must
#   refuse, which the seven characters of the short set cannot.
# They must agree on every string. The counts of strings the expression accepts were
# computed twice, here with RE2 and separately with Python's re, and agree; they show
# the agreement is not vacuous. Six characters cannot hold a species with both suffixes
# (A_B c_D is seven), so those come from the swept set and the hand-written rows above.
# =============================================================================

statement ok
CREATE TABLE strs AS
WITH RECURSIVE s(x) AS (
    SELECT unnest(['a', 'B', '0', '-', '_', ' ', '.'])
    UNION ALL
    SELECT x || c FROM s, (SELECT unnest(['a', 'B', '0', '-', '_', ' ', '.']) AS c) WHERE length(x) < 6
)
SELECT x FROM s;

statement ok
CREATE TABLE swept AS
SELECT DISTINCT replace(t, '?', c) AS x
FROM (SELECT chr(i::INTEGER) AS c FROM range(32, 127) r(i) UNION ALL SELECT 'é' UNION ALL SELECT 'ß') chars,
     (SELECT unnest(['?', 'A?', '?A', 'A?A', 'A_?', 'A_B?', 'A_?B', 'A_B_?', 'A ?', 'A b?', 'A ?b', 'A? b', 'A_? b',
                     'A_B? b', 'A b_?', 'A b ?', 'A b?c d', 'A b c?', 'A b c_?', 'A_B b_?']) AS t) templates;

query II
SELECT (SELECT count(*) FROM strs), (SELECT count(*) FROM swept);
----
137256	1934

statement ok
CREATE TABLE cases AS SELECT 'short' AS strings, x FROM strs UNION ALL SELECT 'swept', x FROM swept;

statement ok
CREATE TABLE label_oracle AS
SELECT strings, x, CASE WHEN regexp_full_match(x, '[A-Za-z0-9-]+(?:_[A-Z0-9]+(?:_[A-Z0-9]+)*)?')
                        THEN {'base': r.base, 'suffix': NULLIF(r.suffix, '')} END AS want
FROM (SELECT strings, x, regexp_extract(x, '^([A-Za-z0-9-]+)(?:_([A-Z0-9]+(?:_[A-Z0-9]+)*))?$', ['base', 'suffix']) AS r
      FROM cases);

query TIII
SELECT strings, count(*) FILTER (WHERE gtdb_label(x) IS DISTINCT FROM want), count(want), count(want.suffix)
FROM label_oracle GROUP BY strings ORDER BY strings;
----
short	0	6844	1384
swept	0	394	143

statement ok
CREATE TABLE species_oracle AS
SELECT strings, x, CASE WHEN regexp_full_match(x, '[A-Za-z0-9-]+(?:_[A-Z0-9]+(?:_[A-Z0-9]+)*)? [A-Za-z0-9.-]+(?: [A-Za-z0-9.-]+)*(?:_[A-Z0-9]+(?:_[A-Z0-9]+)*)?')
                        THEN {'genus_base': r.genus_base, 'genus_suffix': NULLIF(r.genus_suffix, ''),
                              'epithet': r.epithet, 'epithet_suffix': NULLIF(r.epithet_suffix, '')} END AS want
FROM (SELECT strings, x, regexp_extract(x, '^([A-Za-z0-9-]+)(?:_([A-Z0-9]+(?:_[A-Z0-9]+)*))? ([A-Za-z0-9.-]+(?: [A-Za-z0-9.-]+)*)(?:_([A-Z0-9]+(?:_[A-Z0-9]+)*))?$',
                                       ['genus_base', 'genus_suffix', 'epithet', 'epithet_suffix']) AS r
      FROM cases);

query TIIIII
SELECT strings, count(*) FILTER (WHERE gtdb_species_label(x) IS DISTINCT FROM want), count(want),
       count(want.genus_suffix), count(want.epithet_suffix),
       count(*) FILTER (WHERE want.genus_suffix IS NOT NULL AND want.epithet_suffix IS NOT NULL)
FROM species_oracle GROUP BY strings ORDER BY strings;
----
short	0	11260	480	480	0
swept	0	627	108	108	36
