# name: test/sql/sylph_two_stage.test
# description: two-stage (.syl2db) sylph databases — profiling parity with .syldb, and building one
# group: [sql]

require miint

require-env SYLPH_AVAILABLE

statement ok
CREATE TABLE k12_reads AS
  SELECT * FROM read_fastx(
    'data/sylph/tiny_reads_R1.fq.gz',
    sequence2 := 'data/sylph/tiny_reads_R2.fq.gz');

# --- profiling a CLI-converted .syl2db -----------------------------------
# data/sylph/tiny.syl2db is `sylph convert-db-two-screen` over tiny.syldb. The
# stage-1 screen is an optimisation, not a different model: the CLI golden for
# it (expected_profile_two_stage.tsv) is identical to the plain golden, and so
# must miint's output be. The database kind is detected from the file, not
# the extension, so the call is the same as for a .syldb.
query TT
SELECT regexp_extract(genome_name, 'K12'),
       round(taxonomic_abundance, 2)
  FROM sylph_profile('k12_reads', 'data/sylph/tiny.syl2db');
----
K12	100.00

query I
SELECT count(*)
  FROM sylph_profile('k12_reads', 'data/sylph/tiny.syl2db') two,
       sylph_profile('k12_reads', 'data/sylph/tiny.syldb') plain
 WHERE two.contig_name = plain.contig_name
   AND round(two.adjusted_ani, 6) = round(plain.adjusted_ani, 6)
   AND round(two.naive_ani, 6) = round(plain.naive_ani, 6)
   AND round(two.eff_cov, 6) = round(plain.eff_cov, 6)
   AND round(two.taxonomic_abundance, 6) = round(plain.taxonomic_abundance, 6)
   AND round(two.sequence_abundance, 6) = round(plain.sequence_abundance, 6)
   AND two.kmers_reassigned = plain.kmers_reassigned;
----
1

# --- sylph 1.0 parameters --------------------------------------------------

# screen_ani is a fraction like min_ani. A permissive screen keeps K12.
query I
SELECT count(*)
  FROM sylph_profile('k12_reads', 'data/sylph/tiny.syl2db', screen_ani := 0.5);
----
1

statement error
SELECT * FROM sylph_profile('k12_reads', 'data/sylph/tiny.syl2db', screen_ani := 85);
----
must be in [0, 1]

# min_contain is the evidence floor on contained k-mers (default 7). An absurd
# floor drops K12 on both database kinds — pins the plumbing of the new FFI
# field for the two-stage path and the plain path alike.
query I
SELECT count(*)
  FROM sylph_profile('k12_reads', 'data/sylph/tiny.syl2db', min_contain := 100000000);
----
0

query I
SELECT count(*)
  FROM sylph_profile('k12_reads', 'data/sylph/tiny.syldb', min_contain := 100000000);
----
0

# --- building a .syl2db with sylph_index_create ---------------------------
# Without an explicit two_stage parameter, the output_path suffix decides.
statement ok
CREATE TABLE refs AS
  SELECT * FROM read_fastx('data/sylph/tiny_refs/*.fasta.gz', include_filepath := true);

query TIII
SELECT regexp_replace(output_path, '.*/', ''), k, c, num_genomes
  FROM sylph_index_create(
    'refs', '{TEST_DIR}/miint_tiny.syl2db',
    genome_id := 'filepath', order_by := 'sequence_index');
----
miint_tiny.syl2db	31	200	3

# A miint-built .syl2db profiles identically to the CLI-built one.
query I
SELECT count(*)
  FROM sylph_profile('k12_reads', '{TEST_DIR}/miint_tiny.syl2db') mine,
       sylph_profile('k12_reads', 'data/sylph/tiny.syl2db') oracle
 WHERE mine.contig_name = oracle.contig_name
   AND round(mine.adjusted_ani, 6) = round(oracle.adjusted_ani, 6)
   AND round(mine.taxonomic_abundance, 6) = round(oracle.taxonomic_abundance, 6);
----
1

# An explicit two_stage parameter wins over the suffix, in both directions.
# The file's first four bytes are the two-stage magic (readers detect the
# format from the file, never the name).
query I
SELECT num_genomes FROM sylph_index_create(
  'refs', '{TEST_DIR}/named_plain.syldb', genome_id := 'filepath', two_stage := true);
----
3

query T
SELECT decode(content[1:4]) FROM read_blob('{TEST_DIR}/named_plain.syldb');
----
SY2D

query I
SELECT num_genomes FROM sylph_index_create(
  'refs', '{TEST_DIR}/named_two.syl2db', genome_id := 'filepath', two_stage := false);
----
3

query I
SELECT count(*) FROM read_blob('{TEST_DIR}/named_two.syl2db') WHERE decode(content[1:4]) = 'SY2D';
----
0

# Either way, profiling does not care which name the file was given.
query I
SELECT count(*) FROM sylph_profile('k12_reads', '{TEST_DIR}/named_plain.syldb');
----
1

# The screen can be made sparser than the default ...
query I
SELECT num_genomes FROM sylph_index_create(
  'refs', '{TEST_DIR}/miint_tiny_sparse.syl2db',
  genome_id := 'filepath', screen_c := 5000);
----
3

# ... but never denser than the dense sketch, and the check fails at bind,
# before the (non-atomic) build runs.
statement error
SELECT * FROM sylph_index_create(
  'refs', '{TEST_DIR}/err.syl2db', genome_id := 'filepath', screen_c := 100);
----
screen_c

# A two-stage database always needs profiling k-mers, however it was requested.
statement error
SELECT * FROM sylph_index_create(
  'refs', '{TEST_DIR}/err.syl2db', genome_id := 'filepath', pseudotax := false);
----
pseudotax

statement error
SELECT * FROM sylph_index_create(
  'refs', '{TEST_DIR}/err.syldb', genome_id := 'filepath', two_stage := true, pseudotax := false);
----
pseudotax

# Two-stage-only knobs on a plain output are an error, not silently ignored.
statement error
SELECT * FROM sylph_index_create(
  'refs', '{TEST_DIR}/err.syldb', genome_id := 'filepath', screen_c := 5000);
----
two_stage

statement error
SELECT * FROM sylph_index_create(
  'refs', '{TEST_DIR}/err.syl2db', genome_id := 'filepath', two_stage := false, screen_c := 5000);
----
two_stage
