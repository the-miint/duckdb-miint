# name: test/sql/read_alignments_https.test
# description: Test read_alignments from HTTP URL
# group: [sql]

# `make test` skips this file because httpfs is not linked into unittest;
# run_tests.sh runs it in its httpfs pass.

require miint

require httpfs

require-env MIINT_HTTPS_TEST_URL

# SAM via HTTP
query I
SELECT COUNT(*) FROM read_alignments('${MIINT_HTTPS_TEST_URL}/sam/foo_has_header.sam');
----
4

# BAM via HTTP
query I
SELECT COUNT(*) FROM read_alignments('${MIINT_HTTPS_TEST_URL}/sam/foo_has_header.bam');
----
4

# BAM with tags via HTTP
query I
SELECT COUNT(*) FROM read_alignments('${MIINT_HTTPS_TEST_URL}/sam/foo_with_tags.bam');
----
2

# Multiple remote files via VARCHAR[]
query I
SELECT COUNT(*) FROM read_alignments([
    '${MIINT_HTTPS_TEST_URL}/sam/foo_has_header.sam',
    '${MIINT_HTTPS_TEST_URL}/sam/foo_has_header_2.sam'
]);
----
8

