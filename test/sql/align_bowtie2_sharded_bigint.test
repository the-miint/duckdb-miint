# name: test/sql/align_bowtie2_sharded_bigint.test
# description: align_bowtie2_sharded accepts BIGINT read_id columns (PR B).
# group: [sql]

#   Sharded bowtie2 uses prebuilt indexes (one per shard directory). The
#   query side (queries.read_id + read_to_shard.read_id) may be VARCHAR or
#   BIGINT and the two must match exactly. The subject side is always
#   VARCHAR because the prebuilt bowtie2 index stores reference names as
#   opaque bytes — same contract as align_minimap2_sharded.

require miint

require-env GPL_BOUNDARY_AVAILABLE

# NOTE: Set threads=1 because sqllogictest framework runs in a constrained mode
# that doesn't handle parallel table function execution well. Parallel execution
# works correctly in the DuckDB CLI with SET threads=2.
statement ok
SET threads=1;

# ---------------------------------------------------------------------------
# Setup: BIGINT queries + BIGINT read_to_shard. Reuses the prebuilt shards
# in data/bowtie2_shards/ (built from VARCHAR subject names ref1/ref2).
# ---------------------------------------------------------------------------

statement ok
CREATE TABLE queries_bigint AS SELECT * FROM (VALUES
    (1001::BIGINT, 'ACGTACGTACGTACGTACGTACGTACGTACGTACGTACGTACGTACGTACGT'),
    (1002::BIGINT, 'TGCATGCATGCATGCATGCATGCATGCATGCATGCATGCATGCATGCATGCA')
) AS t(read_id, sequence1);

statement ok
CREATE TABLE read_to_shard_bigint AS SELECT * FROM (VALUES
    (1001::BIGINT, 'shard_a'),
    (1002::BIGINT, 'shard_b')
) AS t(read_id, shard_name);

# Happy path: BIGINT read_id mirrors to the output. Reference stays VARCHAR
# (prebuilt-index opaque-bytes default — same as minimap2 sharded).
query II
SELECT read_id, reference
FROM align_bowtie2_sharded('queries_bigint',
    shard_directory := 'data/bowtie2_shards/',
    read_to_shard := 'read_to_shard_bigint')
WHERE flags & 4 = 0
ORDER BY read_id;
----
1001	ref1
1002	ref2

# Output type contract.
query III
SELECT typeof(read_id), typeof(reference), typeof(mate_reference)
FROM align_bowtie2_sharded('queries_bigint',
    shard_directory := 'data/bowtie2_shards/',
    read_to_shard := 'read_to_shard_bigint')
LIMIT 1;
----
BIGINT	VARCHAR	VARCHAR

# ---------------------------------------------------------------------------
# Mixed-type rejection: read_to_shard.read_id must match query.read_id.
# ---------------------------------------------------------------------------

statement ok
CREATE TABLE read_to_shard_varchar AS
SELECT CAST(read_id AS VARCHAR) AS read_id, shard_name FROM read_to_shard_bigint;

statement error
SELECT * FROM align_bowtie2_sharded('queries_bigint',
    shard_directory := 'data/bowtie2_shards/',
    read_to_shard := 'read_to_shard_varchar');
----
must match the query table's read_id type

statement ok
CREATE TABLE queries_varchar AS
SELECT CAST(read_id AS VARCHAR) AS read_id, sequence1 FROM queries_bigint;

statement error
SELECT * FROM align_bowtie2_sharded('queries_varchar',
    shard_directory := 'data/bowtie2_shards/',
    read_to_shard := 'read_to_shard_bigint');
----
must match the query table's read_id type

# ---------------------------------------------------------------------------
# Unsupported numeric types rejected at bind.
# ---------------------------------------------------------------------------

statement ok
CREATE TABLE queries_integer (read_id INTEGER, sequence1 VARCHAR);

statement error
SELECT * FROM align_bowtie2_sharded('queries_integer',
    shard_directory := 'data/bowtie2_shards/',
    read_to_shard := 'read_to_shard_bigint');
----
must be VARCHAR or BIGINT

statement ok
CREATE TABLE queries_hugeint (read_id HUGEINT, sequence1 VARCHAR);

statement error
SELECT * FROM align_bowtie2_sharded('queries_hugeint',
    shard_directory := 'data/bowtie2_shards/',
    read_to_shard := 'read_to_shard_bigint');
----
must be VARCHAR or BIGINT

statement ok
CREATE TABLE read_to_shard_hugeint (read_id HUGEINT, shard_name VARCHAR);

statement error
SELECT * FROM align_bowtie2_sharded('queries_bigint',
    shard_directory := 'data/bowtie2_shards/',
    read_to_shard := 'read_to_shard_hugeint');
----
must be VARCHAR or BIGINT

# ---------------------------------------------------------------------------
# NULL read_id: bowtie2_sharded inherits align_bowtie2's contract — both
# columns must be non-null because the daemon's input schema requires it.
# A BIGINT NULL is rejected by the same check as a VARCHAR NULL.
# ---------------------------------------------------------------------------

statement ok
CREATE TABLE queries_bigint_with_null (read_id BIGINT, sequence1 VARCHAR);

statement ok
INSERT INTO queries_bigint_with_null VALUES
    (1001, 'ACGTACGTACGTACGTACGTACGTACGTACGTACGTACGTACGTACGTACGT'),
    (NULL, 'GGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGG');

# Note the NULL-keyed row has no entry in read_to_shard_bigint, so the JOIN
# inside OpenCurrentShardStream filters it out before reaching the daemon —
# the mapped (1001) row still produces output.
query I
SELECT COUNT(*)
FROM align_bowtie2_sharded('queries_bigint_with_null',
    shard_directory := 'data/bowtie2_shards/',
    read_to_shard := 'read_to_shard_bigint')
WHERE flags & 4 = 0;
----
1
