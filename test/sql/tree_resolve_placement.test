# name: test/sql/tree_resolve_placement.test
# description: Test tree_resolve_placement table function for phylogenetic placement resolution
# group: [sql]

require miint

require json

# =============================================================================
# Setup
# =============================================================================

# Tree from with_edge_ids.nwk: ((A:0.1{0},B:0.2{1}):0.3{2},C:0.4{3}):0.0{4};
# 5 nodes: A(0), B(1), internal(2), C(3), root(4)
statement ok
CREATE TABLE ref_tree AS SELECT * FROM read_newick('data/newick/with_edge_ids.nwk');

# Single placement on edge 0 (A's edge, length 0.1)
statement ok
CREATE TABLE single_placement AS
SELECT * FROM (VALUES
    ('frag1', 0::BIGINT, 0.95::DOUBLE, 0.05::DOUBLE, 0.001::DOUBLE)
) AS t(fragment_id, edge_id, like_weight_ratio, distal_length, pendant_length);

# =============================================================================
# Error Cases
# =============================================================================

# Nonexistent tree table
statement error
SELECT * FROM tree_resolve_placement('no_tree', 'single_placement');
----
does not exist

# Nonexistent placements table
statement error
SELECT * FROM tree_resolve_placement('ref_tree', 'no_placements');
----
does not exist

# Tree table missing required node_index column
statement ok
CREATE TABLE bad_tree AS SELECT 1 AS x;

statement error
SELECT * FROM tree_resolve_placement('bad_tree', 'single_placement');
----
node_index

statement ok
DROP TABLE bad_tree;

# Placements table missing required columns
statement ok
CREATE TABLE bad_placements AS SELECT 1 AS x;

statement error
SELECT * FROM tree_resolve_placement('ref_tree', 'bad_placements');
----
fragment_id

statement ok
DROP TABLE bad_placements;

# Placements reference unknown edge_id
statement ok
CREATE TABLE bad_edge_placements AS
SELECT * FROM (VALUES
    ('frag1', 999::BIGINT, 0.95::DOUBLE, 0.05::DOUBLE, 0.001::DOUBLE)
) AS t(fragment_id, edge_id, like_weight_ratio, distal_length, pendant_length);

statement error
SELECT * FROM tree_resolve_placement('ref_tree', 'bad_edge_placements');
----
edge

statement ok
DROP TABLE bad_edge_placements;

# =============================================================================
# Basic: single placement
# =============================================================================

# Single placement adds 2 nodes (1 internal + 1 fragment tip)
# 5 original + 2 = 7
query I
SELECT COUNT(*) FROM tree_resolve_placement('ref_tree', 'single_placement');
----
7

# Placed fragment appears as a tip
query T
SELECT name FROM tree_resolve_placement('ref_tree', 'single_placement')
WHERE is_tip = true ORDER BY name;
----
A
B
C
frag1

# Still exactly one root
query I
SELECT COUNT(*) FROM tree_resolve_placement('ref_tree', 'single_placement')
WHERE parent_index IS NULL;
----
1

# Output has correct column types (no filepath column)
query ITRIIT rowsort
SELECT node_index, name, branch_length, edge_id, parent_index, is_tip
FROM tree_resolve_placement('ref_tree', 'single_placement')
WHERE parent_index IS NULL;
----
4
(empty)
0.0
4
NULL
false

# =============================================================================
# Multiple placements on same edge
# =============================================================================

statement ok
CREATE TABLE multi_placements AS
SELECT * FROM (VALUES
    ('frag1', 0::BIGINT, 0.95::DOUBLE, 0.05::DOUBLE, 0.001::DOUBLE),
    ('frag2', 0::BIGINT, 0.80::DOUBLE, 0.02::DOUBLE, 0.002::DOUBLE)
) AS t(fragment_id, edge_id, like_weight_ratio, distal_length, pendant_length);

# Two placements = 4 new nodes. 5 + 4 = 9
query I
SELECT COUNT(*) FROM tree_resolve_placement('ref_tree', 'multi_placements');
----
9

# Both fragments are tips
query T
SELECT name FROM tree_resolve_placement('ref_tree', 'multi_placements')
WHERE is_tip = true ORDER BY name;
----
A
B
C
frag1
frag2

# =============================================================================
# Works with views
# =============================================================================

statement ok
CREATE VIEW placement_view AS SELECT * FROM single_placement;

query I
SELECT COUNT(*) FROM tree_resolve_placement('ref_tree', 'placement_view');
----
7

statement ok
DROP VIEW placement_view;

# =============================================================================
# Works with tree from read_jplace_newick
# =============================================================================

# jplace tree has 7 nodes; use 2 valid placements (fragment3 targets root edge
# with branch_length=0.0, which distal_length=0.2 exceeds)
# 2 placements add 4 nodes = 11 total, 6 tips
statement ok
CREATE TABLE jplace_tree AS SELECT * FROM read_jplace_newick('data/jplace/test.jplace');

statement ok
CREATE TABLE jplace_placements AS
SELECT fragment AS fragment_id, edge_num::BIGINT AS edge_id,
       like_weight_ratio, distal_length, pendant_length
FROM read_jplace('data/jplace/test.jplace')
WHERE fragment != 'fragment3';

query I
SELECT COUNT(*) FROM tree_resolve_placement('jplace_tree', 'jplace_placements');
----
11

query I
SELECT COUNT(*) FROM tree_resolve_placement('jplace_tree', 'jplace_placements')
WHERE is_tip = true;
----
6

query T
SELECT name FROM tree_resolve_placement('jplace_tree', 'jplace_placements')
WHERE is_tip = true ORDER BY name;
----
A
B
C
D
fragment1
fragment2

# =============================================================================
# Schema matches read_newick (UNION ALL compatibility)
# =============================================================================

statement ok
SELECT node_index, name, branch_length, edge_id, parent_index, is_tip
FROM read_newick('data/newick/with_edge_ids.nwk')
UNION ALL
SELECT node_index, name, branch_length, edge_id, parent_index, is_tip
FROM tree_resolve_placement('ref_tree', 'single_placement');

# =============================================================================
# Placement types are checked when the rows are read
# =============================================================================

# A prepared call is not bound again when a view's types change with no change to the catalog,
# as a view over a CSV file does when the file is rewritten.
statement ok
COPY single_placement TO '{TEST_DIR}/changing_placements.csv';

statement ok
CREATE VIEW csv_placements AS SELECT * FROM read_csv('{TEST_DIR}/changing_placements.csv');

statement ok
PREPARE resolve_csv AS
SELECT name FROM tree_resolve_placement('ref_tree', 'csv_placements') WHERE is_tip ORDER BY name;

# A fragment_id that becomes another id type is read as the type it now has, and the placed tip
# is named with its text.
statement ok
COPY (SELECT 42 AS fragment_id, edge_id, like_weight_ratio, distal_length, pendant_length FROM single_placement)
TO '{TEST_DIR}/changing_placements.csv';

# read_csv now detects the column as BIGINT
query T
SELECT typeof(fragment_id) FROM read_csv('{TEST_DIR}/changing_placements.csv') LIMIT 1;
----
BIGINT

query T
EXECUTE resolve_csv;
----
42
A
B
C

# One that becomes a type ids do not take is refused.
statement ok
COPY (SELECT 4.5 AS fragment_id, edge_id, like_weight_ratio, distal_length, pendant_length FROM single_placement)
TO '{TEST_DIR}/changing_placements.csv';

statement error
EXECUTE resolve_csv;
----
<REGEX>:Invalid Input Error: Column 'fragment_id' in table 'csv_placements' must be VARCHAR, BIGINT, or UUID.*

query I
SELECT 1;
----
1

statement ok
DROP VIEW csv_placements;

# =============================================================================
# Cleanup
# =============================================================================

statement ok
DROP TABLE ref_tree;

statement ok
DROP TABLE single_placement;

statement ok
DROP TABLE multi_placements;

statement ok
DROP TABLE jplace_tree;

statement ok
DROP TABLE jplace_placements;

# =============================================================================
# Typed names and labels. `name` keeps its id type (VARCHAR, BIGINT or UUID), and an optional
# `label` VARCHAR column of text labels is carried through; the nodes a placement creates (an
# internal node on the edge, and the fragment's tip) have no label. A VARCHAR tree takes a
# fragment_id of any id type and names the tip with its text; a BIGINT or UUID tree takes
# fragment ids of its own type.
# Tree: ((A:0.1{0},B:0.2{1}):0.3{2},C:0.4{3}):0.0{4}; A, B, C are 1, 2, 3 in the typed trees.
# =============================================================================

statement ok
CREATE TABLE rp_text AS SELECT node_index, name, branch_length, edge_id, parent_index,
    CASE WHEN NOT is_tip THEN 'n' || node_index END AS label
FROM read_newick('data/newick/with_edge_ids.nwk');

statement ok
CREATE TABLE rp_big AS SELECT node_index,
    CASE name WHEN 'A' THEN 1 WHEN 'B' THEN 2 WHEN 'C' THEN 3 END::BIGINT AS name,
    branch_length, edge_id, parent_index, label
FROM rp_text;

statement ok
CREATE TABLE rp_uuid AS SELECT node_index,
    CASE WHEN name IS NOT NULL THEN ('00000000-0000-0000-0000-00000000000' || name)::UUID END AS name,
    branch_length, edge_id, parent_index, label
FROM rp_big;

statement ok
CREATE TABLE place_big AS SELECT * FROM (VALUES
    (100::BIGINT, 0::BIGINT, 0.95::DOUBLE, 0.05::DOUBLE, 0.001::DOUBLE)
) AS t(fragment_id, edge_id, like_weight_ratio, distal_length, pendant_length);

statement ok
CREATE TABLE place_uuid AS SELECT ('00000000-0000-0000-0000-000000000' || fragment_id)::UUID AS fragment_id,
    edge_id, like_weight_ratio, distal_length, pendant_length
FROM place_big;

statement ok
CREATE TABLE place_text AS SELECT fragment_id::VARCHAR AS fragment_id, edge_id, like_weight_ratio,
    distal_length, pendant_length
FROM place_big;

query T
SELECT DISTINCT typeof(name) FROM tree_resolve_placement('rp_big', 'place_big');
----
BIGINT

# The tree's nodes keep their names and labels; the placement appends an internal node and the
# fragment's tip, both unlabeled.
query IIT
SELECT node_index, name, label FROM tree_resolve_placement('rp_big', 'place_big') ORDER BY node_index;
----
0	1	NULL
1	2	NULL
2	NULL	n2
3	3	NULL
4	NULL	n4
5	NULL	NULL
6	100	NULL

query TTT
SELECT node_index, name, label FROM tree_resolve_placement('rp_uuid', 'place_uuid') ORDER BY node_index;
----
0	00000000-0000-0000-0000-000000000001	NULL
1	00000000-0000-0000-0000-000000000002	NULL
2	NULL	n2
3	00000000-0000-0000-0000-000000000003	NULL
4	NULL	n4
5	NULL	NULL
6	00000000-0000-0000-0000-000000000100	NULL

query T
SELECT DISTINCT typeof(name) FROM tree_resolve_placement('rp_uuid', 'place_uuid');
----
UUID

# A VARCHAR tree takes BIGINT and UUID fragment ids and names the tips with their text; its
# unnamed nodes stay ''.
query TTT
SELECT node_index, name, label FROM tree_resolve_placement('rp_text', 'place_big') ORDER BY node_index;
----
0	A	NULL
1	B	NULL
2	(empty)	n2
3	C	NULL
4	(empty)	n4
5	(empty)	NULL
6	100	NULL

query T
SELECT name FROM tree_resolve_placement('rp_text', 'place_uuid') WHERE node_index = 6;
----
00000000-0000-0000-0000-000000000100

# A typed tree takes fragment ids of its own type only: they become its tips' names.
statement error
SELECT * FROM tree_resolve_placement('rp_big', 'place_text');
----
'fragment_id' is VARCHAR

statement error
SELECT * FROM tree_resolve_placement('rp_uuid', 'place_big');
----
'fragment_id' is BIGINT

# Without a `label` column the output is the read_newick schema.
statement ok
CREATE TABLE rp_text_nolabel AS SELECT node_index, name, branch_length, edge_id, parent_index FROM rp_text;

query TT
SELECT column_name, column_type FROM (DESCRIBE SELECT * FROM tree_resolve_placement('rp_text_nolabel', 'place_big'));
----
node_index	BIGINT
name	VARCHAR
branch_length	DOUBLE
edge_id	BIGINT
parent_index	BIGINT
is_tip	BOOLEAN

statement ok
CREATE TABLE rp_label_int AS SELECT node_index, name, branch_length, edge_id, parent_index, 7 AS label FROM rp_text;

statement error
SELECT * FROM tree_resolve_placement('rp_label_int', 'place_big');
----
'label' must be VARCHAR, got INTEGER

statement ok
CREATE TABLE rp_int AS SELECT node_index, name::INTEGER AS name, branch_length, edge_id, parent_index FROM rp_big;

statement error
SELECT * FROM tree_resolve_placement('rp_int', 'place_big');
----
tip names must be VARCHAR, BIGINT, or UUID, but they are INTEGER

# A typed tree's fragment ids name its new tips, so their type is checked when the placements are
# read as well as at bind: a view can change type under a prepared statement.
statement ok
COPY (SELECT * FROM place_big) TO '{TEST_DIR}/prep_rp_place.csv';

statement ok
CREATE VIEW prep_rp_place AS SELECT * FROM read_csv('{TEST_DIR}/prep_rp_place.csv');

statement ok
PREPARE prep_rp AS SELECT name FROM tree_resolve_placement('rp_big', 'prep_rp_place') WHERE node_index = 6;

query I
EXECUTE prep_rp;
----
100

statement ok
COPY (SELECT 42::BIGINT AS fragment_id, edge_id, like_weight_ratio, distal_length, pendant_length FROM place_big)
TO '{TEST_DIR}/prep_rp_place.csv';

query I
EXECUTE prep_rp;
----
42

statement ok
COPY (SELECT '*' AS fragment_id, edge_id, like_weight_ratio, distal_length, pendant_length FROM place_big)
TO '{TEST_DIR}/prep_rp_place.csv';

statement error
EXECUTE prep_rp;
----
<REGEX>:.*tree_resolve_placement: column 'fragment_id' of 'prep_rp_place' is VARCHAR now but was BIGINT when the statement was bound.*
