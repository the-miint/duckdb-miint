# name: test/sql/mzml_scan_macros.test
# description: test mzml_scansum, mzml_scannum, mzml_scanmz, mzml_scanmaxint macros
# group: [sql]

statement ok
PRAGMA enable_verification;

require miint

statement ok
CREATE TABLE spectra AS SELECT * FROM read_mzml('data/mzml/basic_3spectra.mzML');

statement ok
CREATE TABLE all_peaks AS SELECT * FROM mzml_peaks(spectra);

statement ok
CREATE VIEW ms2_peaks AS SELECT * FROM all_peaks WHERE ms_level = 2;

# ----- mzml_scansum -----

# scansum all: spectrum 0=8000, 1=4500, 2=5000
query IR
SELECT spectrum_index, total_intensity
FROM mzml_scansum(all_peaks)
ORDER BY spectrum_index
----
0	8000.0
1	4500.0
2	5000.0

# scansum MS2 only
query IR
SELECT spectrum_index, total_intensity
FROM mzml_scansum(ms2_peaks)
ORDER BY spectrum_index
----
1	4500.0
2	5000.0

# ----- mzml_scannum -----

# scannum all: 3 distinct spectrum indices
query I
SELECT spectrum_index
FROM mzml_scannum(all_peaks)
ORDER BY spectrum_index
----
0
1
2

# scannum MS2: 2 spectra
query I
SELECT COUNT(*) FROM mzml_scannum(ms2_peaks)
----
2

# ----- mzml_scanmz -----

# scanmz all: distinct non-NULL precursor_mz values
query R
SELECT precursor_mz
FROM mzml_scanmz(all_peaks)
ORDER BY precursor_mz
----
200.0
300.0

# scanmz MS2
query R
SELECT precursor_mz
FROM mzml_scanmz(ms2_peaks)
ORDER BY precursor_mz
----
200.0
300.0

# ----- mzml_scanmaxint -----

# scanmaxint all: spectrum 0=5000, 1=3000, 2=2500
query IR
SELECT spectrum_index, max_intensity
FROM mzml_scanmaxint(all_peaks)
ORDER BY spectrum_index
----
0	5000.0
1	3000.0
2	2500.0

# scanmaxint MS2
query IR
SELECT spectrum_index, max_intensity
FROM mzml_scanmaxint(ms2_peaks)
ORDER BY spectrum_index
----
1	3000.0
2	2500.0

# ----- Edge cases -----

# Empty relation: all macros return 0 rows
statement ok
CREATE TABLE empty AS SELECT * FROM all_peaks WHERE 1=0;

query I
SELECT COUNT(*) FROM mzml_scansum(empty)
----
0

query I
SELECT COUNT(*) FROM mzml_scannum(empty)
----
0

query I
SELECT COUNT(*) FROM mzml_scanmz(empty)
----
0

query I
SELECT COUNT(*) FROM mzml_scanmaxint(empty)
----
0

# Single peak: scansum and scanmaxint agree
statement ok
CREATE VIEW one_peak AS SELECT * FROM all_peaks WHERE spectrum_index = 1 AND mz = 150;

query IR
SELECT spectrum_index, total_intensity FROM mzml_scansum(one_peak)
----
1	3000.0

query IR
SELECT spectrum_index, max_intensity FROM mzml_scanmaxint(one_peak)
----
1	3000.0

# scanmz from MS1 only: 0 rows (all precursor_mz NULL)
statement ok
CREATE VIEW ms1_peaks AS SELECT * FROM all_peaks WHERE ms_level = 1;

query I
SELECT COUNT(*) FROM mzml_scanmz(ms1_peaks)
----
0

# ----- Composability with mzml_peak_pair -----

# Construct iron_test table (same as mzml_macros.test)
statement ok
CREATE TABLE iron_test AS
SELECT 0 AS spectrum_index, 2 AS ms_level, 1.0 AS retention_time,
       'centroid' AS spectrum_type, 'positive' AS polarity,
       1000.0 AS base_peak_intensity, 2000.0 AS total_ion_current,
       200.0 AS precursor_mz, 2 AS precursor_charge, 1000.0 AS precursor_intensity,
       NULL::INTEGER AS ms1_scan_index, 'scan=1' AS spectrum_id, 1 AS scan_number,
       [200.0, 344.0650625] AS mz_array, [1000.0, 500.0] AS intensity_array;

# Materialize peak_pair result for composability with scan macros
statement ok
CREATE TABLE iron_peaks AS SELECT * FROM mzml_peak_pair('iron_test', 'Fe');

query IR
SELECT spectrum_index, total_intensity FROM mzml_scansum(iron_peaks)
----
0	1500.0

query I
SELECT COUNT(*) FROM mzml_scannum(iron_peaks)
----
1

query R
SELECT precursor_mz FROM mzml_scanmz(iron_peaks)
----
200.0

query IR
SELECT spectrum_index, max_intensity FROM mzml_scanmaxint(iron_peaks)
----
0	1000.0
