statement ok
CREATE TABLE t2_actual AS SELECT * FROM mmvec_ranks('fit');

query I
SELECT count(*) FROM t2_actual a JOIN t2_expected e USING (x_feature_id, y_feature_id);
----
48

query I
SELECT max(abs(a.rank - e.rank)) < 0.01 FROM t2_actual a JOIN t2_expected e USING (x_feature_id, y_feature_id);
----
true

# Not vacuous: the ranks are not all near zero, so agreeing to 0.01 is a real
# statement about the values rather than about their smallness.
query I
SELECT max(abs(rank)) > 0.5 FROM t2_actual;
----
true

# The row invariants hold on a fitted model too.
query I
SELECT count(*) FROM (
  SELECT x_feature_id FROM t2_actual GROUP BY x_feature_id
  HAVING abs(sum(rank)) > 1e-12 OR abs(sum(prob) - 1.0) > 1e-12
);
----
0

# Dropping the loss rows changes nothing -- they carry no parameters.
statement ok
CREATE TABLE fit_no_loss AS SELECT * FROM fit WHERE modality <> 'loss';

query I
SELECT count(*) FROM (
  SELECT * FROM mmvec_ranks('fit') EXCEPT ALL SELECT * FROM mmvec_ranks('fit_no_loss')
);
----
0

# The number of axes is read off the model, not assumed: a 1-component fit still
# yields the full d1 x d2 rank matrix, with the same row invariants.
statement ok
CREATE TABLE fit1 AS SELECT * FROM mmvec_fit('microbes', 'metabolites', dimensions := 1, max_iter := 200);

query I
SELECT count(*) FROM mmvec_ranks('fit1');
----
48

query I
SELECT count(*) FROM (
  SELECT x_feature_id FROM mmvec_ranks('fit1') GROUP BY x_feature_id
  HAVING abs(sum(rank)) > 1e-12 OR abs(sum(prob) - 1.0) > 1e-12
);
----
0

# And it is a different model from the 3-component one, so the axis count is
# genuinely being honoured rather than defaulted.
query I
SELECT count(*) > 0 FROM (
  SELECT rank FROM mmvec_ranks('fit1') EXCEPT SELECT rank FROM mmvec_ranks('fit')
);
----
true

# ---------------------------------------------------------------------------
# Id types are mirrored from the model relation, per modality independently, and
# the VALUES round-trip. The model is the only place the ids now live, so if the
# read-back lost the type there would be no way to join a rank matrix back to
# taxonomy or to a compound library.
# ---------------------------------------------------------------------------

statement ok
CREATE TABLE model_typed AS
SELECT modality,
       CASE WHEN modality = 'x' THEN CAST(10 + CAST(substr(x_feature_id, 2) AS BIGINT) AS BIGINT) END AS x_feature_id,
       CASE WHEN modality = 'y'
            THEN CAST('00000000-0000-4000-8000-0000000000a' || substr(y_feature_id, 2) AS UUID) END AS y_feature_id,
       axis, value
FROM fit WHERE modality <> 'loss';

query II
SELECT column_name, column_type FROM (
  DESCRIBE SELECT * FROM mmvec_ranks('model_typed')
) WHERE column_name LIKE '%feature_id' ORDER BY column_name;
----
x_feature_id	BIGINT
y_feature_id	UUID

query II
SELECT DISTINCT typeof(x_feature_id), typeof(y_feature_id) FROM mmvec_ranks('model_typed');
----
BIGINT	UUID

# The emitted ids are exactly the model's own distinct ids, on both sides.
query I
SELECT count(*) FROM (
  (SELECT DISTINCT x_feature_id FROM mmvec_ranks('model_typed')
   EXCEPT SELECT DISTINCT x_feature_id FROM model_typed WHERE modality = 'x')
  UNION ALL
  (SELECT DISTINCT x_feature_id FROM model_typed WHERE modality = 'x'
   EXCEPT SELECT DISTINCT x_feature_id FROM mmvec_ranks('model_typed'))
);
----
0

query I
SELECT count(*) FROM (
  (SELECT DISTINCT y_feature_id FROM mmvec_ranks('model_typed')
   EXCEPT SELECT DISTINCT y_feature_id FROM model_typed WHERE modality = 'y')
  UNION ALL
  (SELECT DISTINCT y_feature_id FROM model_typed WHERE modality = 'y'
   EXCEPT SELECT DISTINCT y_feature_id FROM mmvec_ranks('model_typed'))
);
----
0

# Renaming the features is presentational: the numbers are the same model.
query I
SELECT count(*) FROM (
  SELECT rank, prob FROM mmvec_ranks('model_typed')
  EXCEPT ALL
  SELECT rank, prob FROM mmvec_ranks('fit')
);
----
0

# The SAME check with UUID on the X side, which is not redundant with the case
# above. Output is row-major over (X feature, Y feature), so the X id repeats for
# d2 consecutive rows and is emitted once per run and copied thereafter, while the
# Y id is emitted afresh every row. Those are two different code paths, and the
# case above only exercises the run-copy for BIGINT. A UUID is 16 bytes of parsed
# hugeint rather than a machine integer, so a copy that reached for the wrong
# physical width would corrupt exactly here and nowhere else.

statement ok
CREATE TABLE model_uuid_x AS
SELECT modality,
       CASE WHEN modality = 'x'
            THEN CAST('00000000-0000-4000-8000-0000000000b' || substr(x_feature_id, 2) AS UUID) END AS x_feature_id,
       CASE WHEN modality = 'y' THEN CAST(20 + CAST(substr(y_feature_id, 2) AS BIGINT) AS BIGINT) END AS y_feature_id,
       axis, value
FROM fit WHERE modality <> 'loss';

query II
SELECT DISTINCT typeof(x_feature_id), typeof(y_feature_id) FROM mmvec_ranks('model_uuid_x');
----
UUID	BIGINT

# Every emitted X id is the model's own, and each appears exactly d2 times -- a
# run-copy that duplicated the wrong row would show up as a wrong count here.
query I
SELECT count(*) FROM (
  SELECT x_feature_id, count(*) AS n FROM mmvec_ranks('model_uuid_x') GROUP BY x_feature_id
) WHERE n <> (SELECT count(DISTINCT y_feature_id) FROM model_uuid_x WHERE modality = 'y');
----
0

query I
SELECT count(*) FROM (
  (SELECT DISTINCT x_feature_id FROM mmvec_ranks('model_uuid_x')
   EXCEPT SELECT DISTINCT x_feature_id FROM model_uuid_x WHERE modality = 'x')
  UNION ALL
  (SELECT DISTINCT x_feature_id FROM model_uuid_x WHERE modality = 'x'
   EXCEPT SELECT DISTINCT x_feature_id FROM mmvec_ranks('model_uuid_x'))
);
----
0

# And the numbers are still the same model, so the id plumbing did not disturb the
# cell each id is attached to.
query I
SELECT count(*) FROM (
  SELECT rank, prob FROM mmvec_ranks('model_uuid_x')
  EXCEPT ALL
  SELECT rank, prob FROM mmvec_ranks('fit')
);
----
0

# ---------------------------------------------------------------------------
# A model relation it cannot trust is rejected, loudly. These are the pure unit's
# checks surfacing through SQL -- the messages come from one place, so they cannot
# drift between the two layers.
# ---------------------------------------------------------------------------

statement error
SELECT * FROM mmvec_ranks('no_such_model');
----
no_such_model

statement ok
CREATE TABLE not_a_model AS SELECT 1 AS a, 2 AS b;

statement error
SELECT * FROM mmvec_ranks('not_a_model');
----
must expose (modality, x_feature_id, y_feature_id, axis, value)

# A filtered model is incomplete rather than smaller: guessing at the missing
# parameter would answer with a model the user never fitted.
statement ok
CREATE TABLE model_clipped AS SELECT * FROM fit WHERE NOT (modality = 'x' AND x_feature_id = 'm3' AND axis = 2);

statement error
SELECT * FROM mmvec_ranks('model_clipped');
----
'm3' is missing axis 2

# Two all-zero Y features is ambiguous: either could be the reference category.
statement ok
CREATE TABLE model_two_refs AS
SELECT modality, x_feature_id, y_feature_id, axis,
       CASE WHEN modality = 'y' AND y_feature_id = 'b4' THEN 0.0 ELSE value END AS value
FROM fit;

statement error
SELECT * FROM mmvec_ranks('model_two_refs');
----
2 all-zero Y features

# And none at all means nothing is pinned, so there is no reference category.
statement ok
CREATE TABLE model_no_ref AS
SELECT modality, x_feature_id, y_feature_id, axis,
       CASE WHEN modality = 'y' AND y_feature_id = 'b1' AND axis = 0 THEN 0.5 ELSE value END AS value
FROM fit;

statement error
SELECT * FROM mmvec_ranks('model_no_ref');
----
0 all-zero Y features

# A NULL parameter is not a parameter.
statement ok
CREATE TABLE model_null_value AS
SELECT modality, x_feature_id, y_feature_id, axis,
       CASE WHEN modality = 'x' AND x_feature_id = 'm1' AND axis = 1 THEN NULL ELSE value END AS value
FROM fit;

statement error
SELECT * FROM mmvec_ranks('model_null_value');
----
NULL axis or value

statement ok
CREATE TABLE model_null_modality AS
SELECT CASE WHEN modality = 'x' AND x_feature_id = 'm1' AND axis = 1 THEN NULL ELSE modality END AS modality,
       x_feature_id, y_feature_id, axis, value
FROM fit;

statement error
SELECT * FROM mmvec_ranks('model_null_modality');
----
NULL modality

# A modality='x' row whose x_feature_id is NULL names no feature. Reported as such
# rather than falling back to whichever id happens to be non-NULL, which would
# read a Y id as an X feature name and invent a feature.
statement ok
CREATE TABLE model_null_id AS
SELECT modality,
       CASE WHEN modality = 'x' AND x_feature_id = 'm1' THEN NULL ELSE x_feature_id END AS x_feature_id,
       y_feature_id, axis, value
FROM fit;

statement error
SELECT * FROM mmvec_ranks('model_null_id');
----
NULL feature id

# Modality is matched case-insensitively. mmvec_fit only ever emits lowercase, so
# this exists for a hand-built or round-tripped-through-something model relation --
# and it is tested rather than merely written, since nothing else would exercise it.
statement ok
CREATE TABLE model_upper AS SELECT upper(modality) AS modality, x_feature_id, y_feature_id, axis, value FROM fit;

query I
SELECT count(*) FROM (
  SELECT * FROM mmvec_ranks('model_upper') EXCEPT ALL SELECT * FROM mmvec_ranks('fit')
);
----
0

# An unrecognised modality is still rejected by name.
statement ok
CREATE TABLE model_bad_modality AS
SELECT CASE WHEN modality = 'loss' THEN 'diagnostic' ELSE modality END AS modality,
       x_feature_id, y_feature_id, axis, value
FROM fit;

statement error
SELECT * FROM mmvec_ranks('model_bad_modality');
----
modality 'diagnostic'
