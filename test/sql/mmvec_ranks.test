# ---------------------------------------------------------------------------
# Schema. Four columns; both id types mirrored from the model relation, since
# "ids in = ids out" has to survive being read back as well as written.
# ---------------------------------------------------------------------------

query I
SELECT string_agg(column_name, ',') FROM (
  DESCRIBE SELECT * FROM mmvec_ranks('t1_model')
);
----
x_feature_id,y_feature_id,rank,prob

query II
SELECT column_name, column_type FROM (
  DESCRIBE SELECT * FROM mmvec_ranks('t1_model')
) WHERE column_name IN ('rank','prob') ORDER BY column_name;
----
prob	DOUBLE
rank	DOUBLE

# ---------------------------------------------------------------------------
# EXACT parity with scikit-bio, through SQL. Every one of the 48 cells, joined to
# the carved expectation by BOTH ids -- so a transposed or mislabelled emission
# fails here rather than averaging out. theta packs four differently-shaped
# blocks, so a mislabelled coordinate stays in range and produces a plausible
# model of something else; only a per-cell comparison against an external value
# catches that.
# ---------------------------------------------------------------------------

statement ok
CREATE TABLE t1_actual AS SELECT * FROM mmvec_ranks('t1_model');

query I
SELECT count(*) FROM t1_actual;
----
48

# Every cell present exactly once, and every (x, y) pair matched -- so the max()
# below cannot pass by comparing a subset.
query I
SELECT count(*) FROM t1_actual a JOIN t1_expected e USING (x_feature_id, y_feature_id);
----
48

query I
SELECT max(abs(a.rank - e.rank)) < 1e-10 FROM t1_actual a JOIN t1_expected e USING (x_feature_id, y_feature_id);
----
true

query I
SELECT max(abs(a.prob - e.prob)) < 1e-10 FROM t1_actual a JOIN t1_expected e USING (x_feature_id, y_feature_id);
----
true

# The margin is not marginal: the measured agreement is far tighter than the
# threshold, so this is a real equality rather than a band that happens to hold.
query I
SELECT max(abs(a.rank - e.rank)) < 1e-15 FROM t1_actual a JOIN t1_expected e USING (x_feature_id, y_feature_id);
----
true

# ---------------------------------------------------------------------------
# The two invariants that define what these columns MEAN, independent of the
# oracle: ranks are logits centred within each X feature's row (so they sum to
# zero), and probs are that row's softmax (so they sum to one). A change that
# broke either would no longer be MMvec's ranks, whatever the numbers agreed with.
# ---------------------------------------------------------------------------

query I
SELECT count(*) FROM (
  SELECT x_feature_id FROM t1_actual GROUP BY x_feature_id HAVING abs(sum(rank)) > 1e-12
);
----
0

query I
SELECT count(*) FROM (
  SELECT x_feature_id FROM t1_actual GROUP BY x_feature_id HAVING abs(sum(prob) - 1.0) > 1e-12
);
----
0

# Every X feature carries the full Y set, including the reference category: 8 x 6.
query II
SELECT count(DISTINCT x_feature_id), count(DISTINCT y_feature_id) FROM t1_actual;
----
8	6

# The reference category is NOT all-zero in the output, unlike in the model. Its
# logit is pinned to zero, but row-centring subtracts the row mean from it like
# any other column -- so a "helpful" special case that emitted zeros here would
# be wrong, and the carved values above are what says so.
query I
SELECT count(*) FROM t1_actual WHERE y_feature_id = 'C1' AND abs(rank) < 1e-12;
----
0

# ---------------------------------------------------------------------------
# Over a REAL fit, straight from mmvec_fit's output -- the actual usage pattern,
# and the one that proves modality='loss' rows are ignored rather than mistaken
# for parameters (mmvec_fit emits 65 of them on this fixture).
#
# This comparison is a BAND, not equality, and cannot be otherwise: the fit starts
# from InitTheta(seed) where the oracle started from numpy's PCG64. The oracle
# independently measured how far that can move the answer -- max|dranks| 4.084e-04
# across four starting points under this stopping rule -- and kT2RankTol = 0.01
# leaves room for that while still catching anything structural.
# ---------------------------------------------------------------------------

statement ok
CREATE TABLE microbes AS
SELECT * FROM (VALUES
  ('S1','m1',1.0),('S1','m4',7.0),('S1','m6',2.0),('S1','m7',1.0),
  ('S2','m2',1.0),('S2','m3',2.0),('S2','m4',9.0),('S2','m5',1.0),('S2','m6',1.0),('S2','m8',1.0),
  ('S3','m1',2.0),('S3','m3',1.0),('S3','m4',6.0),('S3','m7',2.0),
  ('S4','m1',1.0),('S4','m2',2.0),('S4','m3',1.0),('S4','m4',8.0),('S4','m5',3.0),('S4','m6',1.0),('S4','m8',2.0),
  ('S5','m2',1.0),('S5','m3',3.0),('S5','m4',3.0),('S5','m5',1.0),('S5','m6',4.0),('S5','m7',1.0)
) t(sample_id, feature_id, value);

statement ok
CREATE TABLE metabolites AS
SELECT * FROM (VALUES
  ('S1','b2',1.0),('S1','b4',1.0),('S1','b5',1.0),('S1','b6',2.0),
  ('S2','b1',1.0),('S2','b3',2.0),('S2','b4',1.0),('S2','b5',5.0),
  ('S3','b2',3.0),('S3','b3',1.0),('S3','b5',1.0),('S3','b6',1.0),
  ('S4','b1',3.0),('S4','b2',1.0),('S4','b4',2.0),('S4','b5',2.0),
  ('S5','b3',4.0),('S5','b4',1.0),('S5','b5',7.0),('S5','b6',3.0)
) t(sample_id, feature_id, value);

statement ok
CREATE TABLE fit AS SELECT * FROM mmvec_fit('microbes', 'metabolites', dimensions := 3, max_iter := 1000);

# The loss rows are there, and mmvec_ranks still reads the model.
query I
SELECT count(*) > 0 FROM fit WHERE modality = 'loss';
----
true

statement ok
