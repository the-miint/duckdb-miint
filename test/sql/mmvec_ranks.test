# name: test/sql/mmvec_ranks.test
# description: mmvec_ranks reads a fitted model back and reproduces the carved scikit-bio T1 values exactly (always run; fixtures are inline)
# group: [sql]

require miint

# ---------------------------------------------------------------------------
# The T1 model, carved. These 56 rows ARE the oracle's kTheta from
# test/cpp/mmvec_oracle.hpp, unpacked into the model relation's shape --
# (modality, x_feature_id, y_feature_id, axis, value) -- with axis 1..3 the
# embedding coordinates and axis 0 the bias, and Y feature 'C1' (the reference
# category) carrying zeros on every axis because it holds no parameters at all.
#
# This is why M4 can do something M3 could not. A fit cannot be handed a theta
# from SQL, so mmvec_fit.test could only compare final_loss in a 1e-6 band against
# a differently-initialised run. A model relation, though, is just a table -- so
# the fitted state can be supplied directly and every derived quantity checked
# against scikit-bio EXACTLY, at 1e-10, through the whole SQL path.
#
# Values are the committed oracle's, transcribed at full precision and verified
# bit-identical after reconstruction; never regenerated at test time.
# ---------------------------------------------------------------------------

statement ok
CREATE TABLE t1_model AS
