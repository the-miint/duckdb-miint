# name: test/sql/align_sortmerna_subject_table.test
# description: align_sortmerna / align_sortmerna_rrna take their references from a table (subject_table)
# group: [sql]

#
# WHY THIS MATTERS
#
# References often already live in DuckDB: filtered out of a larger database,
# joined to a taxonomy, deduplicated. subject_table lets them be used without a
# round trip through a FASTA file, and it must never change the answer:
# the same sequences give the same alignments whichever way they arrive. The
# equivalence checks below compare every output column against ref_paths with
# the same sequences, after a positive control proves there are rows to compare.
#
# The reference column mirrors the subject table's read_id type, as in
# align_minimap2, so results join back to the subject table without a cast.
#

require miint

require-env SORTMERNA_AVAILABLE

# Fixtures straight from the FASTA files the ref_paths tests use, so the two
# paths are fed identical sequences. read_fastx splits the header at the first
# whitespace exactly as sortmerna does, so the ids agree too.
statement ok
CREATE TABLE smr_refs AS
SELECT read_id, sequence1 FROM read_fastx('ext/sortmerna/test_data/test_ref.fasta');

statement ok
CREATE TABLE smr_q AS
SELECT read_id, sequence1 FROM read_fastx('ext/sortmerna/test_data/test_read.fasta');

# A read with no hit, so the unaligned encoding is covered for every id type.
statement ok
INSERT INTO smr_q VALUES ('polyA', repeat('A', 150));

statement ok
CREATE TABLE smr_q_pe AS
SELECT read_id, sequence1, sequence1 AS sequence2 FROM smr_q WHERE read_id = 'AB271211';

# --- Positive control: the read aligns, so the comparisons below are not vacuous ---
query IIII
SELECT read_id, flags, reference, cigar IS NOT NULL
FROM align_sortmerna('smr_q', subject_table := 'smr_refs', num_threads := 1)
ORDER BY read_id;
----
AB271211	0	Unc49508	true
polyA	4	*	true

# --- Equivalence: subject_table and ref_paths give identical rows ---
# Symmetric difference over every column; EXCEPT ALL also catches duplicated
# or missing rows.
query I
SELECT COUNT(*) FROM (
    (SELECT * FROM align_sortmerna('smr_q', ref_paths := ['ext/sortmerna/test_data/test_ref.fasta'], num_threads := 1)
     EXCEPT ALL
     SELECT * FROM align_sortmerna('smr_q', subject_table := 'smr_refs', num_threads := 1))
    UNION ALL
    (SELECT * FROM align_sortmerna('smr_q', subject_table := 'smr_refs', num_threads := 1)
     EXCEPT ALL
     SELECT * FROM align_sortmerna('smr_q', ref_paths := ['ext/sortmerna/test_data/test_ref.fasta'], num_threads := 1))
);
----
0

query I
SELECT COUNT(*) FROM (
    (SELECT * FROM align_sortmerna('smr_q_pe', ref_paths := ['ext/sortmerna/test_data/test_ref.fasta'],
                                   num_threads := 1, paired := true)
     EXCEPT ALL
     SELECT * FROM align_sortmerna('smr_q_pe', subject_table := 'smr_refs', num_threads := 1, paired := true))
    UNION ALL
    (SELECT * FROM align_sortmerna('smr_q_pe', subject_table := 'smr_refs', num_threads := 1, paired := true)
     EXCEPT ALL
     SELECT * FROM align_sortmerna('smr_q_pe', ref_paths := ['ext/sortmerna/test_data/test_ref.fasta'],
                                   num_threads := 1, paired := true))
);
----
0

# The rrna schema carries e_value, identity and coverage, which SAM does not;
# they come from the loaded index, so they are compared as well.
query I
SELECT COUNT(*) FROM (
    (SELECT * FROM align_sortmerna_rrna('smr_q', ref_paths := ['ext/sortmerna/test_data/test_ref.fasta'], num_threads := 1)
     EXCEPT ALL
     SELECT * FROM align_sortmerna_rrna('smr_q', subject_table := 'smr_refs', num_threads := 1))
    UNION ALL
    (SELECT * FROM align_sortmerna_rrna('smr_q', subject_table := 'smr_refs', num_threads := 1)
     EXCEPT ALL
     SELECT * FROM align_sortmerna_rrna('smr_q', ref_paths := ['ext/sortmerna/test_data/test_ref.fasta'], num_threads := 1))
);
----
0

query I
SELECT COUNT(*) FROM (
    (SELECT * FROM align_sortmerna_rrna('smr_q_pe', ref_paths := ['ext/sortmerna/test_data/test_ref.fasta'],
                                        num_threads := 1, paired := true)
     EXCEPT ALL
     SELECT * FROM align_sortmerna_rrna('smr_q_pe', subject_table := 'smr_refs', num_threads := 1, paired := true))
    UNION ALL
    (SELECT * FROM align_sortmerna_rrna('smr_q_pe', subject_table := 'smr_refs', num_threads := 1, paired := true)
     EXCEPT ALL
     SELECT * FROM align_sortmerna_rrna('smr_q_pe', ref_paths := ['ext/sortmerna/test_data/test_ref.fasta'],
                                        num_threads := 1, paired := true))
);
----
0

# A view works the same as a table.
statement ok
CREATE VIEW smr_refs_view AS SELECT * FROM smr_refs;

query II
SELECT read_id, reference
FROM align_sortmerna('smr_q', subject_table := 'smr_refs_view', num_threads := 1)
WHERE flags = 0;
----
AB271211	Unc49508

# --- BIGINT reference ids: the reference columns mirror the subject type ---
statement ok
CREATE TABLE smr_refs_bigint AS SELECT 49508::BIGINT AS read_id, sequence1 FROM smr_refs;

query IIII
SELECT read_id, typeof(reference), typeof(mate_reference), reference
FROM align_sortmerna('smr_q', subject_table := 'smr_refs_bigint', num_threads := 1)
ORDER BY read_id;
----
AB271211	BIGINT	BIGINT	49508
polyA	BIGINT	BIGINT	NULL

# Joins back to the subject table with no cast: the point of mirroring the type.
query II
SELECT a.read_id, length(r.sequence1)
FROM align_sortmerna('smr_q', subject_table := 'smr_refs_bigint', num_threads := 1) a
JOIN smr_refs_bigint r ON a.reference = r.read_id;
----
AB271211	1469

# Paired, both mates on one reference: SAM writes "=" for mate_reference, which
# a BIGINT column cannot hold, so it is resolved to the reference itself.
query IIII
SELECT flags, reference, mate_reference, mate_position
FROM align_sortmerna('smr_q_pe', subject_table := 'smr_refs_bigint', num_threads := 1, paired := true)
ORDER BY flags;
----
67	49508	49508	1
131	49508	49508	1

query IIII
SELECT read_id, typeof(ref_name), ref_name, aligned
FROM align_sortmerna_rrna('smr_q', subject_table := 'smr_refs_bigint', num_threads := 1)
ORDER BY read_id;
----
AB271211	BIGINT	49508	1
polyA	BIGINT	NULL	0

# --- UUID reference ids ---
statement ok
CREATE TABLE smr_refs_uuid AS
SELECT '7a4e1c2b-0000-4000-8000-00000000c164'::UUID AS read_id, sequence1 FROM smr_refs;

query III
SELECT read_id, typeof(reference), reference
FROM align_sortmerna('smr_q', subject_table := 'smr_refs_uuid', num_threads := 1)
ORDER BY read_id;
----
AB271211	UUID	7a4e1c2b-0000-4000-8000-00000000c164
polyA	UUID	NULL

query IIII
SELECT flags, typeof(mate_reference), reference, mate_reference
FROM align_sortmerna('smr_q_pe', subject_table := 'smr_refs_uuid', num_threads := 1, paired := true)
ORDER BY flags;
----
67	UUID	7a4e1c2b-0000-4000-8000-00000000c164	7a4e1c2b-0000-4000-8000-00000000c164
131	UUID	7a4e1c2b-0000-4000-8000-00000000c164	7a4e1c2b-0000-4000-8000-00000000c164

query II
SELECT typeof(ref_name), ref_name
FROM align_sortmerna_rrna('smr_q', subject_table := 'smr_refs_uuid', num_threads := 1)
WHERE aligned = 1;
----
UUID	7a4e1c2b-0000-4000-8000-00000000c164

# With ref_paths the reference columns stay VARCHAR (FASTA header ids).
query II
SELECT typeof(reference), typeof(mate_reference)
FROM align_sortmerna('smr_q', ref_paths := ['ext/sortmerna/test_data/test_ref.fasta'], num_threads := 1)
LIMIT 1;
----
VARCHAR	VARCHAR

# --- Several references: each hit names the reference it hit ---
# The fixtures above hold one reference, so they cannot tell a hit named for
# the reference it hit from one named for the first reference. gg_13_8 holds 19
# references, and these reads hit many of them.
statement ok
CREATE TABLE smr_gg AS
SELECT read_id, sequence1 FROM read_fastx('ext/sortmerna/test_data/gg_13_8_ref_set.fasta');

statement ok
CREATE TABLE smr_set2 AS
SELECT read_id, sequence1
FROM read_fastx('ext/sortmerna/test_data/set2_environmental_study_550_amplicon.fasta')
ORDER BY read_id LIMIT 400;

# Neighbouring reads as mates, so many pairs hit two different references.
statement ok
CREATE TABLE smr_set2_pe AS
SELECT read_id, sequence1, lead(sequence1) OVER (ORDER BY read_id) AS sequence2
FROM smr_set2 QUALIFY sequence2 IS NOT NULL;

# Positive control: several references are hit, and some pairs straddle two.
query II
SELECT (SELECT COUNT(DISTINCT ref_name) > 1
        FROM align_sortmerna_rrna('smr_set2', subject_table := 'smr_gg', num_threads := 1)
        WHERE aligned = 1),
       (SELECT COUNT(*) > 0
        FROM align_sortmerna('smr_set2_pe', subject_table := 'smr_gg', paired := true, num_threads := 1)
        WHERE NOT alignment_is_unmapped(flags) AND NOT alignment_is_mate_unmapped(flags)
          AND mate_reference <> '=');
----
true	true

query I
SELECT COUNT(*) FROM (
    (SELECT * FROM align_sortmerna_rrna('smr_set2', ref_paths := ['ext/sortmerna/test_data/gg_13_8_ref_set.fasta'], num_threads := 1)
     EXCEPT ALL
     SELECT * FROM align_sortmerna_rrna('smr_set2', subject_table := 'smr_gg', num_threads := 1))
    UNION ALL
    (SELECT * FROM align_sortmerna_rrna('smr_set2', subject_table := 'smr_gg', num_threads := 1)
     EXCEPT ALL
     SELECT * FROM align_sortmerna_rrna('smr_set2', ref_paths := ['ext/sortmerna/test_data/gg_13_8_ref_set.fasta'], num_threads := 1))
);
----
0

query I
SELECT COUNT(*) FROM (
    (SELECT * FROM align_sortmerna('smr_set2_pe', ref_paths := ['ext/sortmerna/test_data/gg_13_8_ref_set.fasta'], paired := true, num_threads := 1)
     EXCEPT ALL
     SELECT * FROM align_sortmerna('smr_set2_pe', subject_table := 'smr_gg', paired := true, num_threads := 1))
    UNION ALL
    (SELECT * FROM align_sortmerna('smr_set2_pe', subject_table := 'smr_gg', paired := true, num_threads := 1)
     EXCEPT ALL
     SELECT * FROM align_sortmerna('smr_set2_pe', ref_paths := ['ext/sortmerna/test_data/gg_13_8_ref_set.fasta'], paired := true, num_threads := 1))
);
----
0

# BIGINT ids numbered in reverse name order, so they match neither the FASTA
# order nor the order of the names: a hit mapped back by position, not by id,
# names the wrong reference here.
statement ok
CREATE TABLE smr_gg_names AS
SELECT row_number() OVER (ORDER BY read_id DESC)::BIGINT AS id, read_id AS name FROM smr_gg;

statement ok
CREATE TABLE smr_gg_big AS
SELECT n.id AS read_id, g.sequence1 FROM smr_gg g JOIN smr_gg_names n ON g.read_id = n.name;

query I
SELECT COUNT(*) FROM (
    (SELECT a.read_id, n.name, a.cigar, a.score
     FROM align_sortmerna_rrna('smr_set2', subject_table := 'smr_gg_big', num_threads := 1) a
     JOIN smr_gg_names n ON a.ref_name = n.id
     EXCEPT ALL
     SELECT read_id, ref_name, cigar, score
     FROM align_sortmerna_rrna('smr_set2', ref_paths := ['ext/sortmerna/test_data/gg_13_8_ref_set.fasta'], num_threads := 1)
     WHERE aligned = 1)
    UNION ALL
    (SELECT read_id, ref_name, cigar, score
     FROM align_sortmerna_rrna('smr_set2', ref_paths := ['ext/sortmerna/test_data/gg_13_8_ref_set.fasta'], num_threads := 1)
     WHERE aligned = 1
     EXCEPT ALL
     SELECT a.read_id, n.name, a.cigar, a.score
     FROM align_sortmerna_rrna('smr_set2', subject_table := 'smr_gg_big', num_threads := 1) a
     JOIN smr_gg_names n ON a.ref_name = n.id)
);
----
0

# Paired, mapped on both sides: reference and mate_reference name the right
# references, with '=' resolved to the reference itself.
query I
SELECT COUNT(*) FROM (
    (SELECT a.read_id, a.flags, r.name, m.name
     FROM align_sortmerna('smr_set2_pe', subject_table := 'smr_gg_big', paired := true, num_threads := 1) a
     JOIN smr_gg_names r ON a.reference = r.id
     JOIN smr_gg_names m ON a.mate_reference = m.id
     EXCEPT ALL
     SELECT read_id, flags, reference, CASE WHEN mate_reference = '=' THEN reference ELSE mate_reference END
     FROM align_sortmerna('smr_set2_pe', ref_paths := ['ext/sortmerna/test_data/gg_13_8_ref_set.fasta'], paired := true, num_threads := 1)
     WHERE NOT alignment_is_unmapped(flags) AND NOT alignment_is_mate_unmapped(flags))
    UNION ALL
    (SELECT read_id, flags, reference, CASE WHEN mate_reference = '=' THEN reference ELSE mate_reference END
     FROM align_sortmerna('smr_set2_pe', ref_paths := ['ext/sortmerna/test_data/gg_13_8_ref_set.fasta'], paired := true, num_threads := 1)
     WHERE NOT alignment_is_unmapped(flags) AND NOT alignment_is_mate_unmapped(flags)
     EXCEPT ALL
     SELECT a.read_id, a.flags, r.name, m.name
     FROM align_sortmerna('smr_set2_pe', subject_table := 'smr_gg_big', paired := true, num_threads := 1) a
     JOIN smr_gg_names r ON a.reference = r.id
     JOIN smr_gg_names m ON a.mate_reference = m.id)
);
----
0

# --- Rows with a NULL read_id or sequence1 are skipped ---
# Such a row is not a reference, so adding it changes nothing.
statement ok
CREATE TABLE smr_refs_nulls AS
SELECT * FROM smr_refs
UNION ALL SELECT NULL, 'ACGTACGTACGTACGTACGTACGTACGT'
UNION ALL SELECT 'no_sequence', NULL;

query I
SELECT COUNT(*) FROM (
    (SELECT * FROM align_sortmerna_rrna('smr_q', subject_table := 'smr_refs', num_threads := 1)
     EXCEPT ALL
     SELECT * FROM align_sortmerna_rrna('smr_q', subject_table := 'smr_refs_nulls', num_threads := 1))
    UNION ALL
    (SELECT * FROM align_sortmerna_rrna('smr_q', subject_table := 'smr_refs_nulls', num_threads := 1)
     EXCEPT ALL
     SELECT * FROM align_sortmerna_rrna('smr_q', subject_table := 'smr_refs', num_threads := 1))
);
----
0

# --- Exactly one of ref_paths / subject_table ---
statement error
SELECT * FROM align_sortmerna('smr_q');
----
align_sortmerna requires exactly one of ref_paths or subject_table

statement error
SELECT * FROM align_sortmerna_rrna('smr_q', ref_paths := ['ext/sortmerna/test_data/test_ref.fasta'],
                                   subject_table := 'smr_refs');
----
align_sortmerna_rrna requires exactly one of ref_paths or subject_table

# --- Invalid subject tables ---
statement error
SELECT * FROM align_sortmerna('smr_q', subject_table := 'no_such_table');
----
Sequence table or view 'no_such_table' does not exist

statement ok
CREATE TABLE smr_refs_noseq AS SELECT read_id FROM smr_refs;

statement error
SELECT * FROM align_sortmerna('smr_q', subject_table := 'smr_refs_noseq');
----
missing required column 'sequence1'

statement ok
CREATE TABLE smr_refs_empty AS SELECT * FROM smr_refs WHERE false;

statement error
SELECT * FROM align_sortmerna('smr_q', subject_table := 'smr_refs_empty');
----
Subject table 'smr_refs_empty' is empty

statement ok
CREATE TABLE smr_refs_paired AS SELECT read_id, sequence1, sequence1 AS sequence2 FROM smr_refs;

statement error
SELECT * FROM align_sortmerna('smr_q', subject_table := 'smr_refs_paired');
----
Subjects cannot be paired-end

# The id becomes the FASTA header of the library's reference copy, where
# whitespace would end the id early and the output reference would no longer
# match the table. The library refuses it; the message must reach the user.
statement ok
CREATE TABLE smr_refs_space AS SELECT 'Unc 49508' AS read_id, sequence1 FROM smr_refs;

statement error
SELECT * FROM align_sortmerna('smr_q', subject_table := 'smr_refs_space');
----
id contains whitespace
