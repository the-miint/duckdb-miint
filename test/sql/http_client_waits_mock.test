# name: test/sql/http_client_waits_mock.test
# description: The NCBI, BLAST and ENA clients stop waiting at max_execution_time, and the interrupt reaches the query
# group: [sql]

require httpfs

require miint

require-env ENA_WEBIN_MOCK_URL

require-env MIINT_ENA_PORTAL_URL_BASE

require-env MIINT_ENA_CHECKLIST_URL_BASE

require-env MIINT_ENA_REPORTS_URL_BASE

# The HTTP clients wait between attempts, backing off 1, 2, 4 s and on: 7 s in all
# for ENA and read_ncbi_taxdump, 63 s for NCBI and BLAST. BLAST also waits for its
# own estimate of a search's length, up to an hour, then 15 s between polls, and
# NCBI and BLAST space their requests a third of a second apart. Every wait polls
# the query's interrupt check, which Ctrl-C and max_execution_time both trip; a
# test cannot press Ctrl-C, so the deadline stands in for it.
#
# Each query below waits, in the wait its comment names, from before its deadline
# until well after it. Waited out, it fails with an HTTP error, or succeeds,
# instead of failing as interrupted. The mock (test/scripts/ena_webin_mock.py)
# answers 503 to everything under /unavailable/, and to a GET whose path holds
# UNAVAILABLE.

statement ok
CREATE TABLE submit_unavailable AS SELECT 'submit_unavailable' AS read_id, 'ACGTACGTACGTACGTACGT' AS sequence1;

statement ok
CREATE TABLE rtoe_wait AS SELECT 'rtoe_wait' AS read_id, 'ACGTACGTACGTACGTACGT' AS sequence1;

statement ok
CREATE TABLE poll_wait AS SELECT 'poll_wait' AS read_id, 'ACGTACGTACGTACGTACGT' AS sequence1;

statement ok
CREATE TABLE status_unavailable AS SELECT 'status_unavailable' AS read_id, 'ACGTACGTACGTACGTACGT' AS sequence1;

statement ok
CREATE TABLE ready_at_once AS SELECT 'ready_at_once' AS read_id, 'ACGTACGTACGTACGTACGT' AS sequence1;

# Webin submissions through this secret get 503.
statement ok
CREATE SECRET webin_unavailable (
    TYPE ENA,
    USER 'Webin-99999',
    PASSWORD 'mock-password',
    ENDPOINT 'test',
    ENDPOINT_URL '{ENA_WEBIN_MOCK_URL}/unavailable'
);

statement ok
ATTACH '' AS ena (TYPE ENA, SECRET 'webin_unavailable');

# Through this one they succeed.
statement ok
CREATE SECRET webin_ok (
    TYPE ENA,
    USER 'Webin-99999',
    PASSWORD 'mock-password',
    ENDPOINT 'test',
    ENDPOINT_URL '{ENA_WEBIN_MOCK_URL}'
);

statement ok
ATTACH '' AS ena_ok (TYPE ENA, SECRET 'webin_ok');

# DuckDB's own retries of a GET answered 503 would otherwise run first
# (docs/internals/duckdb-engine-notes.md, "Interrupts and max_execution_time").
statement ok
SET GLOBAL http_retries = 0;

statement ok
SET max_execution_time = 300;

# --- ENA ---------------------------------------------------------------------

# A Portal search.
statement error
SELECT * FROM read_ena('ERR_UNAVAILABLE');
----
INTERRUPT Error: Query exceeded maximum execution time

# The same search from a LATERAL call, which skips an accession it cannot
# resolve. An interrupt is not such a failure: skipped, it would leave the
# query to succeed with no rows.
statement error
SELECT * FROM (VALUES ('ERR_UNAVAILABLE')) t(accession), LATERAL read_ena_sequences(accession);
----
INTERRUPT Error: Query exceeded maximum execution time

# A Webin submission. The alias check before it is a Portal search the mock
# answers; the POST goes under /unavailable/. The attempt is logged, and the
# query fails as interrupted, not as a failed submission.
statement error
INSERT INTO ena.projects (alias, title, project_type) VALUES ('waits_for_webin', 'never submitted', 'METAGENOMIC');
----
INTERRUPT Error: Query exceeded maximum execution time

# The checklist fetch before a sample submission. A checklist that cannot be
# fetched is skipped, and Webin validates instead; an interrupt is not that,
# and must stop the submission. VALIDATE skips the alias check, so after a
# skipped interrupt nothing else would wait before the POST.
statement ok
SET miint_ena_validate_only = true;

statement error
INSERT INTO ena_ok.samples (alias, taxon_id, checklist, attributes)
VALUES ('waits_for_checklist', 408170, 'UNAVAILABLE', MAP {'project name': 'never validated'});
----
INTERRUPT Error: Query exceeded maximum execution time

statement ok
RESET miint_ena_validate_only;

# Nothing was submitted.
query I
SELECT count(*) FROM ena_ok.submission_log WHERE object_type = 'samples';
----
0

# The Reports lookup that turns an alias into an accession, for a lifecycle
# function and for a DELETE.
statement error
SELECT * FROM ena_cancel(secret => 'webin_ok', refname => 'UNAVAILABLE_alias', kind => 'samples');
----
INTERRUPT Error: Query exceeded maximum execution time

statement error
DELETE FROM ena_ok.samples WHERE alias = 'UNAVAILABLE_alias';
----
INTERRUPT Error: Query exceeded maximum execution time

# --- NCBI --------------------------------------------------------------------

statement ok
SET miint_ncbi_eutils_url = '{ENA_WEBIN_MOCK_URL}/unavailable/eutils';

# epost, a POST.
statement error
SELECT * FROM read_ncbi('NC_000913.3');
----
INTERRUPT Error: Query exceeded maximum execution time

# efetch, a GET.
statement error
SELECT * FROM read_ncbi_annotation('NC_000913.3');
----
INTERRUPT Error: Query exceeded maximum execution time

# The taxdump download, a GET with its own retry loop.
statement error
SELECT * FROM read_ncbi_taxdump('{ENA_WEBIN_MOCK_URL}/unavailable/taxdump.tar.gz');
----
INTERRUPT Error: Query exceeded maximum execution time

# --- BLAST -------------------------------------------------------------------

statement ok
SET miint_blast_url = '{ENA_WEBIN_MOCK_URL}/unavailable/Blast.cgi';

# The submission, a POST.
statement error
SELECT * FROM blast('submit_unavailable');
----
INTERRUPT Error: Query exceeded maximum execution time

statement ok
SET miint_blast_url = '{ENA_WEBIN_MOCK_URL}/blast/Blast.cgi';

# BLAST's first poll follows the submission by its third-of-a-second spacing,
# and that wait stops at the deadline too. A later deadline lets each search
# below reach the wait it names first.
statement ok
SET max_execution_time = 1000;

# The mock picks how each search goes from its query's label. This one is
# estimated at 10 s, which the client waits before its first poll.
statement error
SELECT * FROM blast('rtoe_wait');
----
INTERRUPT Error: Query exceeded maximum execution time

# WAITING at the first poll, then 15 s to the next.
statement error
SELECT * FROM blast('poll_wait');
----
INTERRUPT Error: Query exceeded maximum execution time

# A poll answered with 503, a GET.
statement error
SELECT * FROM blast('status_unavailable');
----
INTERRUPT Error: Query exceeded maximum execution time

statement ok
RESET max_execution_time;

statement ok
RESET GLOBAL http_retries;

# The connection still works, and the mock's BLAST answers a search that is
# ready at once: the deadline, not the mock, stopped the searches above.
query TT
SELECT query_id, subject_id FROM blast('ready_at_once');
----
ready_at_once	ready_at_once

statement ok
DETACH ena;

statement ok
DETACH ena_ok;

statement ok
DROP SECRET webin_unavailable;

statement ok
DROP SECRET webin_ok;
