# name: test/sql/massql_ground_truth.test
# description: Ground truth tests comparing DuckDB massql() against Python MassQL reference.
# group: [sql]

# Reference data generated by: conda run -n massql python3 test/scripts/massql_ground_truth.py
# Python MassQL uses 1-based scan numbers; DuckDB uses 0-based spectrum_index.
# For X-offset patterns, Python returns one row per X-candidate per scan.
# Our transpiler returns one row per qualifying scan for scannum().
# Ground truth comparisons use unique_scan_count and spectrum_indices, not raw row_count.

require miint

statement ok
CREATE TABLE __gt_spectra AS SELECT * FROM read_mzml('data/mzml/basic_3spectra.mzML');

# ===== Group 1: Basic peak matching =====

# basic_ms2prod_220_raw: All peaks from scans with peak near 220
# Python: 4 rows, 1 unique scan [2], mz=[120,220,320,420], sum_i=5000
query I
SELECT COUNT(*) FROM massql('QUERY MS2DATA WHERE MS2PROD=220', '__gt_spectra')
----
4

# basic_ms2prod_220_scaninfo: 1 scan matching
query I
SELECT COUNT(*) FROM massql('QUERY scaninfo(MS2DATA) WHERE MS2PROD=220', '__gt_spectra')
----
1

# basic_ms2prod_220_scannum: spectrum_index=2
query I
SELECT spectrum_index FROM massql('QUERY scannum(MS2DATA) WHERE MS2PROD=220', '__gt_spectra')
----
2

# basic_ms2prec_200: spectrum_index=1
query I
SELECT spectrum_index FROM massql('QUERY scannum(MS2DATA) WHERE MS2PREC=200', '__gt_spectra')
----
1

# basic_ms2nl_80: spectrum_index=2 (neutral_loss=80 at mz=220, precursor=300)
query I
SELECT spectrum_index FROM massql('QUERY scannum(MS2DATA) WHERE MS2NL=80', '__gt_spectra')
----
2

# basic_ms1mz_200: spectrum_index=0
query I
SELECT spectrum_index FROM massql('QUERY scannum(MS1DATA) WHERE MS1MZ=200', '__gt_spectra')
----
0

# ===== Group 2: Metadata conditions =====

# meta_rtmin: RT >= 1.7 -> spectrum_index=2
query I
SELECT spectrum_index FROM massql('QUERY scannum(MS2DATA) WHERE RTMIN=1.7', '__gt_spectra')
----
2

# meta_polarity_positive: spectrum_index=1
query I
SELECT spectrum_index FROM massql('QUERY scannum(MS2DATA) WHERE POLARITY=Positive', '__gt_spectra')
----
1

# meta_charge_2: spectrum_index=1
query I
SELECT spectrum_index FROM massql('QUERY scannum(MS2DATA) WHERE CHARGE=2', '__gt_spectra')
----
1

# ===== Group 3: Intensity qualifiers =====

# qual_intensitypercent_gt50: MS1 peak at 200, i_norm=1.0 > 0.50 -> spectrum_index=0
query I
SELECT spectrum_index FROM massql('QUERY scannum(MS1DATA) WHERE MS1MZ=200:INTENSITYPERCENT>50', '__gt_spectra')
----
0

# qual_intensityvalue_gt3000: intensity(200)=5000 > 3000 -> spectrum_index=0
query I
SELECT spectrum_index FROM massql('QUERY scannum(MS1DATA) WHERE MS1MZ=200:INTENSITYVALUE>3000', '__gt_spectra')
----
0

# qual_intensityvalue_gt6000: intensity(200)=5000 < 6000 -> no match
query I
SELECT COUNT(*) FROM massql('QUERY scannum(MS1DATA) WHERE MS1MZ=200:INTENSITYVALUE>6000', '__gt_spectra')
----
0

# ===== Group 4: EXCLUDED qualifier =====

# qual_excluded: scans WITHOUT peak near 150 -> spectrum_index=2
query I
SELECT spectrum_index FROM massql('QUERY scannum(MS2DATA) WHERE MS2PROD=150:EXCLUDED', '__gt_spectra')
----
2

# ===== Group 5: AND multi-condition =====

# and_prod150_prec200: spectrum_index=1
query I
SELECT spectrum_index FROM massql('QUERY scannum(MS2DATA) WHERE MS2PROD=150 AND MS2PREC=200', '__gt_spectra')
----
1

# and_prod220_prec300: spectrum_index=2
query I
SELECT spectrum_index FROM massql('QUERY scannum(MS2DATA) WHERE MS2PROD=220 AND MS2PREC=300', '__gt_spectra')
----
2

# and_prod150_prec300_nomatch: no scan has both
query I
SELECT COUNT(*) FROM massql('QUERY scannum(MS2DATA) WHERE MS2PROD=150 AND MS2PREC=300', '__gt_spectra')
----
0

# ===== Group 6: OR + CARDINALITY =====

# or_150_250: spectrum_index=1
query I
SELECT spectrum_index FROM massql('QUERY scannum(MS2DATA) WHERE MS2PROD=(150 OR 250)', '__gt_spectra')
----
1

# card_min2: at least 2 of (150,250) -> spectrum_index=1
query I
SELECT spectrum_index FROM massql('QUERY scannum(MS2DATA) WHERE MS2PROD=(150 OR 250):CARDINALITY=range(min=2,max=5)', '__gt_spectra')
----
1

# card_max1: exactly 1 of (150,250) -> 0 (spectrum 1 matches both)
query I
SELECT COUNT(*) FROM massql('QUERY scannum(MS2DATA) WHERE MS2PROD=(150 OR 250):CARDINALITY=range(min=1,max=1)', '__gt_spectra')
----
0

# ===== Group 7: FILTER clause =====

# filter_same_peak: WHERE finds scan 2, FILTER keeps only peak near 220 -> 1 row
query I
SELECT COUNT(*) FROM massql('QUERY MS2DATA WHERE MS2PROD=220 FILTER MS2PROD=220', '__gt_spectra')
----
1

# filter_scansum: filtered to single peak near 220, intensity=2500
query R
SELECT total_intensity FROM massql('QUERY scansum(MS2DATA) WHERE MS2PROD=220 FILTER MS2PROD=220', '__gt_spectra')
----
2500.0

# filter_cross_peak: FILTER doesn't re-evaluate membership, scan still in result
query I
SELECT COUNT(*) FROM massql('QUERY scannum(MS2DATA) WHERE MS2PROD=220 FILTER MS2PROD=320', '__gt_spectra')
----
1

# ===== Group 8: Aggregation functions =====

# agg_scansum: total_intensity for spectrum 2 = 500+2500+1200+800 = 5000
query R
SELECT total_intensity FROM massql('QUERY scansum(MS2DATA) WHERE MS2PROD=220', '__gt_spectra')
----
5000.0

# agg_scanmaxint: max_intensity for spectrum 2 = 2500
query R
SELECT max_intensity FROM massql('QUERY scanmaxint(MS2DATA) WHERE MS2PROD=220', '__gt_spectra')
----
2500.0

# agg_scanmz: precursor_mz = 300.0
query R
SELECT precursor_mz FROM massql('QUERY scanmz(MS2DATA) WHERE MS2PROD=220', '__gt_spectra')
----
300.0

# ===== Group 9: Tolerance boundary =====
# Python MassQL default tolerance is 0.1 Da.
# DuckDB currently defaults to 0.5 Da — Cycle 1 will fix this.

# tol_default_within: 220.09 within 0.1 Da of 220 -> matches
query I
SELECT COUNT(*) FROM massql('QUERY scannum(MS2DATA) WHERE MS2PROD=220.09', '__gt_spectra')
----
1

# tol_default_outside: 220.11 outside 0.1 Da of 220 -> no match
query I
SELECT COUNT(*) FROM massql('QUERY scannum(MS2DATA) WHERE MS2PROD=220.11', '__gt_spectra')
----
0

# ===== Group 10: X-offset patterns =====
# Note: Python returns one row per X-candidate. Our transpiler deduplicates
# scannum to one row per scan. We verify unique_scan_count and spectrum_indices.

# xoffset_pair: scans with peaks 100 Da apart -> spectrum_indices=[1,2]
query I rowsort
SELECT spectrum_index FROM massql('QUERY scannum(MS2DATA) WHERE MS2PROD=X AND MS2PROD=X+100', '__gt_spectra')
----
1
2

# xoffset_triplet: three peaks spaced by 100 -> spectrum_index=2 only
query I
SELECT DISTINCT spectrum_index FROM massql('QUERY scannum(MS2DATA) WHERE MS2PROD=X AND MS2PROD=X+100 AND MS2PROD=X+200', '__gt_spectra')
----
2

# xoffset_plus_rtmin: pair with RT>=1.7 -> spectrum_index=2 only
query I
SELECT DISTINCT spectrum_index FROM massql('QUERY scannum(MS2DATA) WHERE MS2PROD=X AND MS2PROD=X+100 AND RTMIN=1.7', '__gt_spectra')
----
2

# xoffset_nomatch: no peaks 500 Da apart
query I
SELECT COUNT(*) FROM massql('QUERY scannum(MS2DATA) WHERE MS2PROD=X AND MS2PROD=X+500', '__gt_spectra')
----
0

# ===== Group 11: Cross-level X patterns =====

# crosslevel_ms1_ms2prec: MS2 scans whose precursor matches an MS1 peak
query I rowsort
SELECT spectrum_index FROM massql('QUERY scannum(MS2DATA) WHERE MS1MZ=X AND MS2PREC=X', '__gt_spectra')
----
1
2

# crosslevel_plus_charge: cross-level with charge=2 filter -> spectrum_index=1
query I
SELECT spectrum_index FROM massql('QUERY scannum(MS2DATA) WHERE MS1MZ=X AND MS2PREC=X AND CHARGE=2', '__gt_spectra')
----
1

# ===== Group 12: Cycle 2 — MATCHCOUNT, < operator, division =====

# MATCHCOUNT is alias for CARDINALITY — same result as card_min2
# Python: scan 2 (spectrum_index=1)
query I
SELECT spectrum_index FROM massql('QUERY scannum(MS2DATA) WHERE MS2PROD=(150 OR 250):MATCHCOUNT=range(min=2,max=5)', '__gt_spectra')
----
1

# Division constant folding: 400/2 = 200.0, matches MS2PREC=200 -> spectrum_index=1
# Python: scan 2 (spectrum_index=1)
query I
SELECT spectrum_index FROM massql('QUERY scannum(MS2DATA) WHERE MS2PREC=400/2', '__gt_spectra')
----
1

# LESS_THAN operator: INTENSITYPERCENT<50 on peak with i_norm=0.2 (20%) -> matches
# Note: Python MassQL has a bug — parser discards the < operator and always uses >.
# See localdocs/massql-bug.md for details. Our implementation uses correct < semantics.
# MS1 peak at 100 has i_norm=0.2 (20%), which IS < 50%.
query I
SELECT spectrum_index FROM massql('QUERY scannum(MS1DATA) WHERE MS1MZ=100:INTENSITYPERCENT<50', '__gt_spectra')
----
0

# LESS_THAN: peak at 200 has i_norm=1.0 (100%), NOT < 50% -> no match
query I
SELECT COUNT(*) FROM massql('QUERY scannum(MS1DATA) WHERE MS1MZ=200:INTENSITYPERCENT<50', '__gt_spectra')
----
0

# ===== Group 13: Cycle 3 — INTENSITYTICPERCENT =====

# qual_intensityticpercent_gt50: MS1 peak at 200, i_tic > 50%
# Python: scan 1 (spectrum_index=0). Matches our result.
query I
SELECT spectrum_index FROM massql('QUERY scannum(MS1DATA) WHERE MS1MZ=200:INTENSITYTICPERCENT>50', '__gt_spectra')
----
0

# ===== Group 14: Cycle 4 — MASSDEFECT =====

# massdefect_220: Peak at 220 with mass defect in (0.0, 0.5) — strict inequality
# Integer m/z has defect exactly 0.0, and 0.0 > 0.0 is false -> no match.
# Python MassQL bug: returns 1 row (MASSDEFECT ignored on MS2PROD).
query I
SELECT COUNT(*) FROM massql('QUERY scannum(MS2DATA) WHERE MS2PROD=220:MASSDEFECT=massdefect(min=0.0,max=0.5)', '__gt_spectra')
----
0

# MASSDEFECT that excludes all peaks — integer m/z has defect 0.0, not in [0.5, 0.9)
# Note: Python MassQL bug — returns 4 rows (MASSDEFECT ignored on MS2PROD).
# Our implementation correctly returns 0 rows.
query I
SELECT COUNT(*) FROM massql('QUERY scannum(MS2DATA) WHERE MS2PROD=220:MASSDEFECT=massdefect(min=0.5,max=0.9)', '__gt_spectra')
----
0

# ANY wildcard: all MS2 peaks from all MS2 scans
query I
SELECT COUNT(*) FROM massql('QUERY MS2DATA WHERE MS2PROD=ANY', '__gt_spectra')
----
6

# ANY + MASSDEFECT: all MS2 peaks with mass defect in (0.0, 0.1) — strict inequality
# All peaks in basic_3spectra have integer m/z (defect=0.0), and 0.0 > 0.0 is false, so 0 pass
query I
SELECT COUNT(*) FROM massql('QUERY MS2DATA WHERE MS2PROD=ANY:MASSDEFECT=massdefect(min=0.0,max=0.1)', '__gt_spectra')
----
0

# ===== Group 15: Cycle 6 — aminoaciddelta =====

# aminoaciddelta_nomatch: aminoaciddelta(AG) ~= 128.058, no peak near that m/z
# Python: 0 rows. Matches our result.
query I
SELECT COUNT(*) FROM massql('QUERY scannum(MS2DATA) WHERE MS2PROD=aminoaciddelta(AG)', '__gt_spectra')
----
0

# aminoaciddelta match: aminoaciddelta(G) = 57.02147 ≈ not near any peak
query I
SELECT COUNT(*) FROM massql('QUERY scannum(MS2DATA) WHERE MS2PROD=aminoaciddelta(G)', '__gt_spectra')
----
0

# ===== Group 16: Cycle 13 — OTHERSCAN =====

# otherscan_basic: MS2PROD=220 matches scan 3 (RT=1.8). ±0.5 min window
# includes scan 2 (RT=1.6, delta=0.2 min < 0.5). Our implementation expands.
# Note: Python MassQL bug — returns only scan 3 (OTHERSCAN ignored on MS2PROD).
# Our implementation correctly returns both scans.
query I rowsort
SELECT spectrum_index FROM massql('QUERY scannum(MS2DATA) WHERE MS2PROD=220:OTHERSCAN=rtrange(left=0.5,right=0.5)', '__gt_spectra')
----
1
2

# OTHERSCAN narrow window: ±0.1 min. Scan 2 is 0.2 min away, outside window.
query I
SELECT spectrum_index FROM massql('QUERY scannum(MS2DATA) WHERE MS2PROD=220:OTHERSCAN=rtrange(left=0.1,right=0.1)', '__gt_spectra')
----
2

# ===== Group 17: Explicit TOLERANCEMZ =====

# explicit_tol_wide: 1.0 Da tolerance still matches peak at 220
# Python: scan 3 (spectrum_index=2). Matches our result.
query I
SELECT spectrum_index FROM massql('QUERY scannum(MS2DATA) WHERE MS2PROD=220:TOLERANCEMZ=1.0', '__gt_spectra')
----
2

# explicit_tol_tight_miss: 0.05 Da tolerance, 220.06 is 0.06 away -> no match
# Python: 0 rows. Matches our result.
query I
SELECT COUNT(*) FROM massql('QUERY scannum(MS2DATA) WHERE MS2PROD=220.06:TOLERANCEMZ=0.05', '__gt_spectra')
----
0

# ===== Group 18: ANY wildcard =====

# any_ms2prod: ANY matches all MS2 scans with any peak -> 2 MS2 scans
# Note: Python MassQL returns 0 rows (ANY not supported). Our implementation is correct.
query I rowsort
SELECT spectrum_index FROM massql('QUERY scannum(MS2DATA) WHERE MS2PROD=ANY', '__gt_spectra')
----
1
2

# any_ms2prod_raw: all MS2 peaks -> 6 rows (2 peaks in spec 1 + 4 peaks in spec 2)
query I
SELECT COUNT(*) FROM massql('QUERY MS2DATA WHERE MS2PROD=ANY', '__gt_spectra')
----
6

# ===== Group 19: FILTER with intensity qualifier =====

# FILTER keeps only peaks near 220 with i_norm > 50%. Peak at 220 has i=2500, max=2500 -> i_norm=1.0 > 0.5.
# Python: 1 row. Matches our result.
query I
SELECT COUNT(*) FROM massql('QUERY MS2DATA WHERE MS2PROD=220 FILTER MS2PROD=220:INTENSITYPERCENT>50', '__gt_spectra')
----
1

# ===== Group 20: peptide() =====

# peptide b-ion for ACD at charge 1 — mass not near any peak in basic_3spectra
# Python: 0 rows. Matches our result.
query I
SELECT COUNT(*) FROM massql('QUERY scannum(MS2DATA) WHERE MS2PROD=peptide(ACD,charge=1,ion=b)', '__gt_spectra')
----
0

# ===== Group 21: SCANMIN/SCANMAX (Phase 8) =====

# meta_scanmin_2: scan_number >= 2 -> spectrum_indices=[1, 2]
# Python ground truth: scans [2, 3]
query I rowsort
SELECT spectrum_index FROM massql('QUERY scannum(MS2DATA) WHERE SCANMIN=2', '__gt_spectra')
----
1
2

# meta_scanmax_2: scan_number <= 2 -> spectrum_index=1
# Python ground truth: scans [2]
query I
SELECT spectrum_index FROM massql('QUERY scannum(MS2DATA) WHERE SCANMAX=2', '__gt_spectra')
----
1

# meta_scan_range: scan_number in [2, 3] -> spectrum_indices=[1, 2]
# Python ground truth: scans [2, 3]
query I rowsort
SELECT spectrum_index FROM massql('QUERY scannum(MS2DATA) WHERE SCANMIN=2 AND SCANMAX=3', '__gt_spectra')
----
1
2

# ===== Group 22: TOLERANCEPPM (Phase 8) =====

# tol_ppm_ms1: MS1MZ=200 with 5 ppm tolerance -> spectrum_index=0
# Python ground truth: scans [1]
query I
SELECT spectrum_index FROM massql('QUERY scannum(MS1DATA) WHERE MS1MZ=200:TOLERANCEPPM=5', '__gt_spectra')
----
0

# ===== Group 23: Phase 9 Cycle 2 — MOBILITY no-op =====

# Ground truth: MOBILITY no-op (matches Python: all MS2 scans)
query I rowsort
SELECT spectrum_index FROM massql('QUERY scannum(MS2DATA) WHERE MOBILITY=range(min=0,max=100)', '__gt_spectra')
----
1
2

# Ground truth: MOBILITY narrow range still no-op (matches Python; possible Bug 5)
query I rowsort
SELECT spectrum_index FROM massql('QUERY scannum(MS2DATA) WHERE MOBILITY=range(min=99,max=100)', '__gt_spectra')
----
1
2

# ===== Group 24: Phase 9 Cycle 3 — OTHERSCAN+OR =====

# Ground truth: OTHERSCAN+OR (Python returns scans [2] due to Bug 2; we correctly expand)
query I rowsort
SELECT spectrum_index FROM massql('QUERY scannum(MS2DATA) WHERE MS2PROD=(150 OR 250):OTHERSCAN=rtrange(left=0.5,right=0.5)', '__gt_spectra')
----
1
2

# ===== Group 25: Phase 9 Cycle 4 — X=range() and X=massdefect() =====

# Ground truth: X=range (matches Python: scans [2,3])
query I rowsort
SELECT spectrum_index FROM massql('QUERY scannum(MS2DATA) WHERE MS2PROD=X AND MS2PROD=X+100 AND X=range(min=100,max=300)', '__gt_spectra')
----
1
2

# Ground truth: X=massdefect inclusive (matches Python: defect=0.0 included)
query I rowsort
SELECT spectrum_index FROM massql('QUERY scannum(MS2DATA) WHERE MS2PROD=X AND MS2PROD=X+100 AND X=massdefect(min=0.0,max=0.5)', '__gt_spectra')
----
1
2

# Ground truth: X=massdefect exclusive (matches Python: 0 rows)
query I
SELECT COUNT(*) FROM massql('QUERY scannum(MS2DATA) WHERE MS2PROD=X AND MS2PROD=X+100 AND X=massdefect(min=0.1,max=0.9)', '__gt_spectra')
----
0

# ===== Group 26: Phase 9 Cycle 1 — PPM on X-offset =====

# Ground truth: PPM on X-offset (matches Python: scans [2,3])
query I rowsort
SELECT spectrum_index FROM massql('QUERY scannum(MS2DATA) WHERE MS2PROD=X:TOLERANCEPPM=10 AND MS2PROD=X+100:TOLERANCEPPM=10', '__gt_spectra')
----
1
2

# ===== Group 27: Degenerate edge cases (Cycle 17) =====

statement ok
CREATE TABLE __degen AS SELECT * FROM read_mzml('data/mzml/degenerate.mzML');

# MS2PROD=200: spectrum 0 is empty (invisible to massql), spectrum 2 has peaks at 200 -> 1 match
query I
SELECT COUNT(*) FROM massql('QUERY scannum(MS2DATA) WHERE MS2PROD=200', '__degen')
----
1

# Single-peak spectrum: MS2PROD=100 matches spectrum 1 only
query I
SELECT spectrum_index FROM massql('QUERY scannum(MS2DATA) WHERE MS2PROD=100', '__degen')
----
1

# Duplicate m/z: spectrum 2 has two peaks at 200.0. Query should match.
query I
SELECT spectrum_index FROM massql('QUERY scannum(MS2DATA) WHERE MS2PROD=200', '__degen')
----
2

# Duplicate m/z raw data: should return both peaks
query I
SELECT COUNT(*) FROM massql('QUERY MS2DATA WHERE MS2PROD=200', '__degen')
----
2

# Very large m/z: spectrum 3 has peak at 15000
query I
SELECT spectrum_index FROM massql('QUERY scannum(MS2DATA) WHERE MS2PROD=15000', '__degen')
----
3

# MS1 with precursor (malformed): MS1 queries should still find spectrum 4
query I
SELECT spectrum_index FROM massql('QUERY scannum(MS1DATA) WHERE MS1MZ=300', '__degen')
----
4

# MS2PREC on empty spectrum: spectrum 0 has precursor_mz=200 but 0 peaks.
# mzml_peaks() has no rows for empty spectra, so spectrum 0 is invisible to massql().
query I
SELECT spectrum_index FROM massql('QUERY scannum(MS2DATA) WHERE MS2PREC=200', '__degen')
----
1

# ANY on data with empty spectrum: should not return spectrum 0 (no peaks)
query I rowsort
SELECT spectrum_index FROM massql('QUERY scannum(MS2DATA) WHERE MS2PROD=ANY', '__degen')
----
1
2
3

# scansum on single-peak spectrum: total_intensity = 500
query R
SELECT total_intensity FROM massql('QUERY scansum(MS2DATA) WHERE MS2PROD=100', '__degen')
----
500.0

# scansum on duplicate-mz spectrum: total_intensity = 1000 + 500 = 1500
query R
SELECT total_intensity FROM massql('QUERY scansum(MS2DATA) WHERE MS2PROD=200', '__degen')
----
1500.0

# X-offset with no match in degenerate data: single-peak spectra can't form pairs
query I
SELECT COUNT(*) FROM massql('QUERY scannum(MS2DATA) WHERE MS2PROD=X AND MS2PROD=X+100', '__degen')
----
0

# EXCLUDED on degenerate data: spectra WITHOUT peak near 100
# Spectrum 0 is invisible (empty). Spectra 2 (peaks at 200) and 3 (peak at 15000) qualify.
query I rowsort
SELECT spectrum_index FROM massql('QUERY scannum(MS2DATA) WHERE MS2PROD=100:EXCLUDED', '__degen')
----
2
3
