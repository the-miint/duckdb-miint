# name: test/sql/read_fastx_https.test
# description: Test read_fastx from HTTP URL
# group: [sql]

# NOTE: Skipped in CI because httpfs is disabled at build time.
# Active coverage is in test/shell/read_https.sh (uses LOAD httpfs at runtime).

require miint

require httpfs

require-env MIINT_HTTPS_TEST_URL

# Uncompressed FASTQ via HTTP
query I
SELECT COUNT(*) FROM read_fastx(getenv('MIINT_HTTPS_TEST_URL') || '/fastq/small_a.fq');
----
2

# FASTA via HTTP
query I
SELECT COUNT(*) FROM read_fastx(getenv('MIINT_HTTPS_TEST_URL') || '/fastq/test.fa');
----
2

# Gzipped FASTQ via HTTP
query I
SELECT COUNT(*) FROM read_fastx(getenv('MIINT_HTTPS_TEST_URL') || '/fastq/foo.r1.fastq.gz');
----
2

# Paired-end gzipped FASTQ via HTTP
query III
SELECT COUNT(*), COUNT(sequence1), COUNT(sequence2) FROM read_fastx(
    getenv('MIINT_HTTPS_TEST_URL') || '/fastq/foo.r1.fastq.gz',
    sequence2=getenv('MIINT_HTTPS_TEST_URL') || '/fastq/foo.r2.fastq.gz'
);
----
2	2	2

