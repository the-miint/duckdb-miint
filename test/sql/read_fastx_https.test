# name: test/sql/read_fastx_https.test
# description: Test read_fastx from HTTP URL
# group: [sql]

# `make test` skips this file because httpfs is not linked into unittest;
# run_tests.sh runs it in its httpfs pass.

require miint

require httpfs

require-env MIINT_HTTPS_TEST_URL

# Uncompressed FASTQ via HTTP
query I
SELECT COUNT(*) FROM read_fastx('${MIINT_HTTPS_TEST_URL}/fastq/small_a.fq');
----
2

# FASTA via HTTP
query I
SELECT COUNT(*) FROM read_fastx('${MIINT_HTTPS_TEST_URL}/fastq/test.fa');
----
2

# Gzipped FASTQ via HTTP
query I
SELECT COUNT(*) FROM read_fastx('${MIINT_HTTPS_TEST_URL}/fastq/foo.r1.fastq.gz');
----
2

# Paired-end gzipped FASTQ via HTTP
query III
SELECT COUNT(*), COUNT(sequence1), COUNT(sequence2) FROM read_fastx(
    '${MIINT_HTTPS_TEST_URL}/fastq/foo.r1.fastq.gz',
    sequence2='${MIINT_HTTPS_TEST_URL}/fastq/foo.r2.fastq.gz'
);
----
2	2	2

