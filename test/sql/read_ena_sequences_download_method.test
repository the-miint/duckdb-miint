# name: test/sql/read_ena_sequences_download_method.test
# description: Test read_ena_sequences download_method parameter validation (no network required)
# group: [sql]

require miint

# ---- Invalid download_method values ----

statement error
SELECT * FROM read_ena_sequences('ERR1074767', download_method := 'invalid');
----
read_ena_sequences: download_method must be 'auto', 'aspera', or 'http'

statement error
SELECT * FROM read_ena_sequences('ERR1074767', download_method := 'ftp');
----
read_ena_sequences: download_method must be 'auto', 'aspera', or 'http'

statement error
SELECT * FROM read_ena_sequences('ERR1074767', download_method := '');
----
read_ena_sequences: download_method must be 'auto', 'aspera', or 'http'
