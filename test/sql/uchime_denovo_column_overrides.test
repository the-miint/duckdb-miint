# name: test/sql/uchime_denovo_column_overrides.test
# description: test detect_chimera_uchime_denovo id_col / sequence_col / count_col overrides
# group: [sql]

require miint

require-env VSEARCH_AVAILABLE

# Fixture with non-default column names — simulates feeding deblur output
# (which has 'abundance', not 'size') into uchime_denovo without rename.
statement ok
CREATE TABLE renamed_denovo AS
SELECT
    regexp_extract(read_id, '^([^;]+)', 1) AS feature_id,
    sequence1 AS sequence,
    CAST(regexp_extract(read_id, 'size=(\d+)', 1) AS INTEGER) AS abundance
FROM read_fastx('data/uchime/denovo_input.fasta');

# Override all three column names — should succeed and produce expected calls.
query TT
SELECT read_id, flag
  FROM detect_chimera_uchime_denovo('renamed_denovo',
                                    id_col := 'feature_id',
                                    sequence_col := 'sequence',
                                    count_col := 'abundance')
  ORDER BY read_id;
----
seq1	N
seq2	N
seq3	N
seq4	Y
seq5	Y
seq6	N

# Default names with the renamed table fail.
statement error
SELECT * FROM detect_chimera_uchime_denovo('renamed_denovo');
----
missing required column 'read_id'

# Empty override is rejected.
statement error
SELECT * FROM detect_chimera_uchime_denovo('renamed_denovo', count_col := '');
----
count_col must not be empty

# Per-sample path with column overrides — exercises LoadDenovoSequences's
# substitution of the overridden id/sequence/count names into the per-sample SQL.
statement ok
CREATE VIEW renamed_per_sample AS
  SELECT 'A' AS sid, * FROM renamed_denovo
  UNION ALL
  SELECT 'B' AS sid, * FROM renamed_denovo;

query TTT
SELECT sid, read_id, flag
  FROM detect_chimera_uchime_denovo('renamed_per_sample',
                                    id_col := 'feature_id',
                                    sequence_col := 'sequence',
                                    count_col := 'abundance',
                                    sample_id := 'sid')
  ORDER BY sid, read_id;
----
A	seq1	N
A	seq2	N
A	seq3	N
A	seq4	Y
A	seq5	Y
A	seq6	N
B	seq1	N
B	seq2	N
B	seq3	N
B	seq4	Y
B	seq5	Y
B	seq6	N
