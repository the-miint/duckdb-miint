# name: test/sql/read_biom_https.test
# description: Test read_biom from HTTP URL
# group: [sql]

# `make test` skips this file because httpfs is not linked into unittest;
# run_tests.sh runs it in its httpfs pass.

require miint

require httpfs

require-env MIINT_HTTPS_TEST_URL

require-env HDF5_AVAILABLE

# BIOM via HTTP
query I
SELECT COUNT(*) FROM read_biom('{MIINT_HTTPS_TEST_URL}/biom/test.biom');
----
15


# HDF5's reason for refusing a remote file comes with the URL. truncated.biom is the first 4 KiB of test.biom.
statement error
SELECT COUNT(*) FROM read_biom('{MIINT_HTTPS_TEST_URL}/biom/truncated.biom');
----
<REGEX>:IO Error: read_biom: cannot read '.*/biom/truncated\.biom': H5Fopen failed: truncated file.*
