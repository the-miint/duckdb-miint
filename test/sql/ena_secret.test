# name: test/sql/ena_secret.test
# description: Test CREATE SECRET (TYPE ENA, ...) parameter handling and redaction
# group: [sql]

require miint

# Literal password — secret created, password redacted in introspection output
statement ok
CREATE SECRET test_ena_lit (TYPE ENA, USER 'Webin-12345', PASSWORD 'shh', ENDPOINT 'test');

query III
SELECT name, type, provider FROM duckdb_secrets() WHERE name='test_ena_lit';
----
test_ena_lit	ena	config

query I
SELECT secret_string LIKE '%password=redacted%' FROM duckdb_secrets() WHERE name='test_ena_lit';
----
true

query I
SELECT secret_string LIKE '%password=shh%' FROM duckdb_secrets() WHERE name='test_ena_lit';
----
false

# user is NOT redacted
query I
SELECT secret_string LIKE '%user=Webin-12345%' FROM duckdb_secrets() WHERE name='test_ena_lit';
----
true

# explicit endpoint is preserved
query I
SELECT secret_string LIKE '%endpoint=test%' FROM duckdb_secrets() WHERE name='test_ena_lit';
----
true

statement ok
DROP SECRET test_ena_lit;

# Default endpoint is 'test' when not specified
statement ok
CREATE SECRET test_ena_default (TYPE ENA, USER 'Webin-X', PASSWORD 'shh');

query I
SELECT secret_string LIKE '%endpoint=test%' FROM duckdb_secrets() WHERE name='test_ena_default';
----
true

statement ok
DROP SECRET test_ena_default;

# Production endpoint is also accepted
statement ok
CREATE SECRET test_ena_prod (TYPE ENA, USER 'Webin-X', PASSWORD 'shh', ENDPOINT 'production');

query I
SELECT secret_string LIKE '%endpoint=production%' FROM duckdb_secrets() WHERE name='test_ena_prod';
----
true

statement ok
DROP SECRET test_ena_prod;

# Invalid endpoint rejected
statement error
CREATE SECRET test_ena_bad (TYPE ENA, USER 'Webin-X', PASSWORD 'shh', ENDPOINT 'staging');
----
ENA secret: endpoint must be 'test' or 'production'

# Missing user rejected
statement error
CREATE SECRET test_ena_no_user (TYPE ENA, PASSWORD 'shh');
----
ENA secret requires 'user'

# Missing password (no env / no file either) rejected
statement error
CREATE SECRET test_ena_no_pw (TYPE ENA, USER 'Webin-X');
----
ENA secret requires one of 'password', 'password_env', or 'password_file'

# Specifying password AND password_env rejected (ambiguous)
statement error
CREATE SECRET test_ena_both (TYPE ENA, USER 'Webin-X', PASSWORD 'a', PASSWORD_ENV 'B');
----
ENA secret: specify exactly one of 'password', 'password_env', 'password_file'

# Pointing password_env at an unset variable rejected with a helpful message
statement error
CREATE SECRET test_ena_bad_env (TYPE ENA, USER 'Webin-X', PASSWORD_ENV '__MIINT_DEFINITELY_UNSET_VAR__');
----
__MIINT_DEFINITELY_UNSET_VAR__

# Pointing password_file at a missing path rejected with a helpful message
statement error
CREATE SECRET test_ena_bad_file (TYPE ENA, USER 'Webin-X', PASSWORD_FILE '/nonexistent/__miint_no_such_pw__');
----
/nonexistent/__miint_no_such_pw__
