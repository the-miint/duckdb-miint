# name: test/sql/phylo_ancestral_ml_sym_parity.test
# description: phylo_ancestral_ml (Mk-ML, SYM) parity vs ape::ace(type="discrete", model="SYM")
# group: [sql]

# ape::ace(type="discrete", model="SYM") fits a symmetric rate matrix. The goldens under
# data/asr/ml_sym_* were generated OFFLINE by a dev-only R + ape script kept out of this
# BSD tree (../duckdb-miint-localdocs/gen_asr_oracle.R) and committed as NUMBERS only
# (never ape's code); run_tests.sh exports MIINT_ASR_PARITY_OK when the committed goldens
# are intact. Only the
# marginal posteriors are compared: they pin the convention (uniform root prior + marginal
# reconstruction) and confirm both optimizers reach the same MLE. Our posteriors match
# ape's fit$lik.anc to ~1e-6 on this 60-tip, 3-state SYM dataset. (Fitted rates are not
# compared: their ordering differs across tools, and ape's $loglik differs from ours by
# exactly log(k) -- ape's unnormalized flat root prior vs our normalized 1/k prior -- a
# constant that cancels in the normalized posteriors.)

require miint

require-env MIINT_ASR_PARITY_OK

statement ok
CREATE TABLE mls_tree AS SELECT * FROM read_csv_auto('data/asr/ml_sym_tree.csv', nullstr='');

statement ok
CREATE TABLE mls_traits AS SELECT * FROM read_csv_auto('data/asr/ml_sym_traits.csv');

statement ok
CREATE TABLE mls_expected AS SELECT * FROM read_csv_auto('data/asr/ml_sym_ml_expected.csv');

# Every internal-node marginal posterior matches ape's fit$lik.anc.
query I
SELECT count(*)
FROM phylo_ancestral_ml('mls_tree', 'mls_traits', model := 'SYM') a
JOIN mls_tree t ON a.node_index = t.node_index
JOIN mls_expected e ON t.name = e.name AND a.state = e.state::VARCHAR
WHERE abs(a.probability - e.probability) > 1e-5;
----
0

# The join covers all 59 internal nodes x 3 states = 177 rows (nothing unmatched).
query I
SELECT count(*)
FROM phylo_ancestral_ml('mls_tree', 'mls_traits', model := 'SYM') a
JOIN mls_tree t ON a.node_index = t.node_index
JOIN mls_expected e ON t.name = e.name AND a.state = e.state::VARCHAR;
----
177

# The SYM `rate` column is NULL (a rate matrix has no single scalar rate).
query I
SELECT count(*) FROM phylo_ancestral_ml('mls_tree', 'mls_traits', model := 'SYM') WHERE rate IS NOT NULL;
----
0
