# name: test/sql/read_sequences_sam_https.test
# description: Test read_sequences_sam from HTTP URL
# group: [sql]

# `make test` skips this file because httpfs is not linked into unittest;
# run_tests.sh runs it in its httpfs pass.

require miint

require httpfs

require-env MIINT_HTTPS_TEST_URL

# uBAM via HTTP
query I
SELECT COUNT(*) FROM read_sequences_sam('${MIINT_HTTPS_TEST_URL}/sam/ubam_no_sq.sam');
----
3

# Multiple remote files
query I
SELECT COUNT(*) FROM read_sequences_sam([
    '${MIINT_HTTPS_TEST_URL}/sam/ubam_no_sq.sam',
    '${MIINT_HTTPS_TEST_URL}/sam/ubam_no_sq_2.sam'
]);
----
5

