# name: test/sql/miint_versions.test
# description: Test miint_versions() table function
# group: [sql]

require miint

# All 8 libraries present
query I
SELECT COUNT(*) FROM miint_versions();
----
8

# No empty or null versions
query I
SELECT COUNT(*) FROM miint_versions() WHERE version = '' OR version IS NULL;
----
0

# All expected library names
query I
SELECT COUNT(*) FROM miint_versions()
WHERE library IN ('miint', 'htslib', 'minimap2', 'kseq++', 'WFA2-lib', 'HDF5', 'zlib', 'rype');
----
8

# Known stable versions (vendored/vcpkg — not submodule-dependent)
query I
SELECT version FROM miint_versions() WHERE library = 'kseq++';
----
1.1.2

query I
SELECT version FROM miint_versions() WHERE library = 'HDF5';
----
1.14.6
