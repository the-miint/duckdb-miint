# name: test/sql/miint_versions.test
# description: Test miint_versions() table function
# group: [sql]

require miint

# At least 8 core libraries always present (HDF5, vsearch, mafft, and abpoa are optional)
query I
SELECT COUNT(*) >= 8 FROM miint_versions();
----
true

# No empty or null versions
query I
SELECT COUNT(*) FROM miint_versions() WHERE version = '' OR version IS NULL;
----
0

# All always-present library names
query I
SELECT COUNT(*) FROM miint_versions()
WHERE library IN ('miint', 'htslib', 'minimap2', 'kseq++', 'LBFGS++', 'WFA2-lib', 'zlib', 'rype');
----
8

# The mafft row appears exactly when align_mafft is registered. MAFFT is left
# out of some builds (WASM, Windows), and a row there would report a version of
# a library the build does not contain.
query I
SELECT (SELECT COUNT(*) FROM miint_versions() WHERE library = 'mafft')
     = (SELECT (COUNT(*) > 0)::INTEGER FROM duckdb_functions() WHERE function_name = 'align_mafft');
----
true

# Every row matches either a core or optional library name
query I
SELECT COUNT(*) FROM miint_versions()
WHERE library NOT IN ('miint', 'htslib', 'minimap2', 'kseq++', 'LBFGS++', 'WFA2-lib', 'HDF5', 'zlib', 'libdeflate', 'libcurl', 'rype', 'vsearch', 'mafft', 'abpoa', 'sylph', 'st3', 'unifrac', 'scikit-bio-binaries', 'krepp', 'krepp-openmp');
----
0

# Known stable versions (vendored — not submodule-dependent)
query I
SELECT version FROM miint_versions() WHERE library = 'kseq++';
----
1.1.2

query I
SELECT version FROM miint_versions() WHERE library = 'LBFGS++';
----
0.4.0
