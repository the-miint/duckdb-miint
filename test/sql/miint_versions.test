# name: test/sql/miint_versions.test
# description: Test miint_versions() table function
# group: [sql]

require miint

# At least 8 core libraries always present (HDF5 and vsearch are optional)
query I
SELECT COUNT(*) >= 8 FROM miint_versions();
----
true

# No empty or null versions
query I
SELECT COUNT(*) FROM miint_versions() WHERE version = '' OR version IS NULL;
----
0

# All always-present library names
query I
SELECT COUNT(*) FROM miint_versions()
WHERE library IN ('miint', 'htslib', 'minimap2', 'kseq++', 'WFA2-lib', 'zlib', 'rype', 'mafft');
----
8

# Every row matches either a core or optional library name
query I
SELECT COUNT(*) FROM miint_versions()
WHERE library NOT IN ('miint', 'htslib', 'minimap2', 'kseq++', 'WFA2-lib', 'HDF5', 'zlib', 'rype', 'vsearch', 'mafft');
----
0

# Known stable versions (vendored — not submodule-dependent)
query I
SELECT version FROM miint_versions() WHERE library = 'kseq++';
----
1.1.2
