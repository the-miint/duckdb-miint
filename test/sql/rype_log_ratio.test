# Test with views
statement ok
CREATE VIEW sequences_view AS SELECT * FROM sequences;

query I
SELECT COUNT(*) as result_count
FROM rype_log_ratio('data/rype/test_numerator.ryxdi', 'data/rype/test_denominator.ryxdi', 'sequences_view');
----
4

statement ok
DROP VIEW sequences_view;

# Test empty table → 0 rows
statement ok
CREATE TABLE empty_sequences AS SELECT * FROM sequences WHERE FALSE;

query I
SELECT COUNT(*) as empty_result
FROM rype_log_ratio('data/rype/test_numerator.ryxdi', 'data/rype/test_denominator.ryxdi', 'empty_sequences');
----
0

statement ok
DROP TABLE empty_sequences;

# Test with custom id_column
statement ok
CREATE TABLE sequences_custom_id AS SELECT * FROM (VALUES
    ('custom1', 'GGCCTTAAGGCCTTAAGGCCTTAAGGCCTTAAGGCCTTAAGGCCTTAAGGCC'),
    ('custom2', 'AATTAATTAATTAATTAATTAATTAATTAATTAATTAATTAATTAATTAATT')
) AS t(my_id, sequence1);

query I
SELECT COUNT(*) as result_count
FROM rype_log_ratio('data/rype/test_numerator.ryxdi', 'data/rype/test_denominator.ryxdi', 'sequences_custom_id',
    id_column := 'my_id');
----
2

statement ok
DROP TABLE sequences_custom_id;

# Test with paired-end sequences
statement ok
CREATE TABLE paired_sequences AS SELECT * FROM (VALUES
    ('paired1', 'ACGTACGTACGTACGTACGTACGTACGTACGTACGTACGTACGTACGTACGT', 'GGCCTTAAGGCCTTAAGGCCTTAAGGCCTTAAGGCCTTAAGGCCTTAAGGCC'),
    ('paired2', 'TGCATGCATGCATGCATGCATGCATGCATGCATGCATGCATGCATGCATGCA', 'AATTAATTAATTAATTAATTAATTAATTAATTAATTAATTAATTAATTAATT')
) AS t(read_id, sequence1, sequence2);

query I
SELECT COUNT(*) as result_count
FROM rype_log_ratio('data/rype/test_numerator.ryxdi', 'data/rype/test_denominator.ryxdi', 'paired_sequences');
----
2

statement ok
DROP TABLE paired_sequences;

# Clean up
statement ok
DROP TABLE sequences;
