# The slice is the read range that contributes slice-length bases, so the two must agree, and
# the range must fit the piece.
statement ok
COPY (SELECT * FROM constructed_gfa UNION ALL
      SELECT E'a\tu2000ctg,0-1500\t2000\t0\ts00000_lina_1000000_1008000_f\t-\t1400\tDP1:1,DP2:1,DP3:1,READ_LEN:1800,OL_LEN_NEXT:300,SNP_SHARE_NEXT:2,SNP_DIFF_NEXT:0')
TO '__TEST_DIR__/layout_round2/final_contig_graph.gfa' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '', DELIMITER E'\x01');

