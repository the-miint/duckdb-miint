fq_comment.fastq	bd8eff142932ce3a1221bda053248658
fq_empty_seq.fastq	0686f0561410c3fd677014ccf081ba44
fq_huge.fastq	3433ee5bc6928f033f1da44f04db6b99
fq_interleave.fastq	19b479264e093ae8bf253a20996919e1
fq_long.fastq	45e0a6dd65b245fd7298ba2d837b5f09
fq_offset64.fastq	e8dc51802094eceff037bfdd1ea33c74
fq_plain.fastq	9980dd7aafbb0ecc0ea7a396d7bac347
fq_seqindex.fastq	cadb7ca88fa500211fbe7259342b5ecc
fq_split.R1.fastq	9980dd7aafbb0ecc0ea7a396d7bac347
fq_split.R2.fastq	96826b15056aef96bda4563a2160daec
fq_uuid.fastq	b80b1ae553ece31bda1592ecd56deab0
fq_zero_rows.fastq	d41d8cd98f00b204e9800998ecf8427e

# Each gzip output decompresses to exactly the uncompressed output of the same query (pinned above).
query IIIIII
SELECT md5(ref_text('{TEST_DIR}/fxb{threads}_fa_plain.fasta.gz'))
           = (SELECT md5(content) FROM read_text('{TEST_DIR}/fxb{threads}_fa_plain.fasta')),
       md5(ref_text('{TEST_DIR}/fxb{threads}_fa_split.R1.fasta.gz'))
           = (SELECT md5(content) FROM read_text('{TEST_DIR}/fxb{threads}_fa_split.R1.fasta')),
       md5(ref_text('{TEST_DIR}/fxb{threads}_fa_split.R2.fasta.gz'))
           = (SELECT md5(content) FROM read_text('{TEST_DIR}/fxb{threads}_fa_split.R2.fasta')),
       md5(ref_text('{TEST_DIR}/fxb{threads}_fq_plain.fastq.gz'))
           = (SELECT md5(content) FROM read_text('{TEST_DIR}/fxb{threads}_fq_plain.fastq')),
       md5(ref_text('{TEST_DIR}/fxb{threads}_fq_split.R1.fastq.gz'))
           = (SELECT md5(content) FROM read_text('{TEST_DIR}/fxb{threads}_fq_split.R1.fastq')),
       md5(ref_text('{TEST_DIR}/fxb{threads}_fq_split.R2.fastq.gz'))
           = (SELECT md5(content) FROM read_text('{TEST_DIR}/fxb{threads}_fq_split.R2.fastq'));
----
true	true	true	true	true	true

endloop
