statement error
COPY bad TO '{TEST_DIR}/bad.gff' (FORMAT GFF);
----
attributes text (row 1) has a control character

# attributes of another type, a STRUCT among them, are refused.
statement ok
CREATE OR REPLACE VIEW bad AS SELECT * REPLACE ({'ID': 'a'} AS attributes) FROM one;

statement error
COPY bad TO '{TEST_DIR}/bad.gff' (FORMAT GFF);
----
attributes must be MAP(VARCHAR, VARCHAR) or VARCHAR (got STRUCT(

statement ok
CREATE OR REPLACE VIEW bad AS SELECT * REPLACE (5 AS attributes) FROM one;

statement error
COPY bad TO '{TEST_DIR}/bad.gff' (FORMAT GFF);
----
attributes must be MAP(VARCHAR, VARCHAR) or VARCHAR (got INTEGER)

# The row named is the relation's.
statement ok
CREATE TABLE two_rows AS SELECT * FROM one;

statement ok
INSERT INTO two_rows SELECT * REPLACE ('#c2' AS seqid) FROM one;

statement error
COPY two_rows TO '{TEST_DIR}/bad.gff' (FORMAT GFF);
