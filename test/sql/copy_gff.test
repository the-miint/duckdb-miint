# name: test/sql/copy_gff.test
# description: COPY ... (FORMAT GFF): GFF3 from read_gff's columns, and Prodigal's GFF from predict_genes' columns
# group: [sql]

require miint

# A written file's lines, in order, with tabs shown as ' | '.
statement ok
CREATE MACRO gff_lines(path) AS TABLE
SELECT replace(line, E'\t', ' | ') AS line FROM (
    SELECT unnest(range(len(s))) AS i, unnest(s) AS line
    FROM (SELECT string_split(rtrim(content, E'\n'), E'\n') AS s FROM read_text(path))
) ORDER BY i;

# -----------------------------------------------------------------------------
# read_gff's columns: what read_gff reads, COPY writes, and read_gff reads back the same
# -----------------------------------------------------------------------------
statement ok
CREATE TABLE features AS SELECT * FROM read_gff('data/gff/test.gff');

statement ok
COPY features TO '{TEST_DIR}/roundtrip.gff' (FORMAT GFF);

query I
SELECT count(*) FROM ((SELECT * FROM features EXCEPT ALL SELECT * FROM read_gff('{TEST_DIR}/roundtrip.gff'))
                      UNION ALL
                      (SELECT * FROM read_gff('{TEST_DIR}/roundtrip.gff') EXCEPT ALL SELECT * FROM features));
----
0

# The file: the version directive, then one line per feature; end is stop_position - 1, NULL is '.'.
query I
SELECT line FROM gff_lines('{TEST_DIR}/roundtrip.gff');
----
##gff-version 3
chr1 | NCBI | gene | 100 | 500 | . | + | . | ID=gene1;Name=TEST1;biotype=protein_coding
chr1 | NCBI | mRNA | 100 | 500 | . | + | . | ID=transcript1;Parent=gene1;Name=TEST1-RA
chr1 | NCBI | exon | 100 | 200 | . | + | . | ID=exon1;Parent=transcript1
chr1 | NCBI | exon | 300 | 500 | 50.5 | + | . | ID=exon2;Parent=transcript1
chr1 | NCBI | CDS | 150 | 200 | . | + | 0 | ID=cds1;Parent=transcript1
chr1 | NCBI | CDS | 300 | 450 | . | + | 2 | ID=cds2;Parent=transcript1
chr2 | Ensembl | gene | 1000 | 2000 | 100.0 | - | . | ID=gene2;Name=TEST2

# Reserved characters in attribute keys and values are percent-encoded, and read_gff decodes them.
statement ok
CREATE TABLE encoded AS SELECT * FROM read_gff('data/gff/encoded.gff');

statement ok
COPY encoded TO '{TEST_DIR}/encoded.gff' (FORMAT GFF);

query I
SELECT count(*) FROM ((SELECT * FROM encoded EXCEPT ALL SELECT * FROM read_gff('{TEST_DIR}/encoded.gff'))
                      UNION ALL
                      (SELECT * FROM read_gff('{TEST_DIR}/encoded.gff') EXCEPT ALL SELECT * FROM encoded));
----
0

statement ok
COPY (SELECT 'c1' AS seqid, 'src' AS source, 'gene' AS type, 1 AS position, 11 AS stop_position, NULL::DOUBLE AS score,
             NULL::VARCHAR AS strand, NULL::INTEGER AS phase,
             MAP {'ID': 'a;b=c&d,e%f', 'Note': E'tab\there'} AS attributes)
TO '{TEST_DIR}/reserved.gff' (FORMAT GFF);

query I
SELECT line FROM gff_lines('{TEST_DIR}/reserved.gff');
----
##gff-version 3
c1 | src | gene | 1 | 10 | . | . | . | ID=a%3Bb%3Dc%26d%2Ce%25f;Note=tab%09here

query II
SELECT attributes['ID'], replace(attributes['Note'], E'\t', '<TAB>') FROM read_gff('{TEST_DIR}/reserved.gff');
----
a;b=c&d,e%f	tab<TAB>here

# attributes may be text, written as given.
statement ok
COPY (SELECT 'c1' AS seqid, 'src' AS source, 'gene' AS type, 5 AS position, 6 AS stop_position, 1.5 AS score,
             '-' AS strand, 1 AS phase, 'ID=g1;Note=raw' AS attributes)
TO '{TEST_DIR}/text_attrs.gff' (FORMAT GFF);

query I
SELECT line FROM gff_lines('{TEST_DIR}/text_attrs.gff');
----
##gff-version 3
c1 | src | gene | 5 | 5 | 1.5 | - | 1 | ID=g1;Note=raw

# NULL or empty attributes are '.'.
statement ok
COPY (SELECT 'c1' AS seqid, 'src' AS source, 'gene' AS type, 5 AS position, 7 AS stop_position, NULL AS score,
             '+' AS strand, NULL AS phase, NULL::MAP(VARCHAR, VARCHAR) AS attributes)
TO '{TEST_DIR}/no_attrs.gff' (FORMAT GFF);

query I
SELECT line FROM gff_lines('{TEST_DIR}/no_attrs.gff');
----
##gff-version 3
c1 | src | gene | 5 | 6 | . | + | . | .

# gzip, by extension or by COMPRESSION.
statement ok
COPY features TO '{TEST_DIR}/roundtrip.gff.gz' (FORMAT GFF);

query I
SELECT count(*) FROM read_gff('{TEST_DIR}/roundtrip.gff.gz');
----
7

statement ok
COPY features TO '{TEST_DIR}/roundtrip_gz.gff' (FORMAT GFF, COMPRESSION gzip);

# read_gff detects gzip by the .gz extension, so check the gzip magic instead.
query I
SELECT content[1:2] = '\x1F\x8B'::BLOB FROM read_blob('{TEST_DIR}/roundtrip_gz.gff');
----
true

# An empty relation writes the version directive only.
statement ok
COPY (SELECT * FROM features WHERE false) TO '{TEST_DIR}/empty.gff' (FORMAT GFF);

query I
SELECT line FROM gff_lines('{TEST_DIR}/empty.gff');
----
##gff-version 3

# -----------------------------------------------------------------------------
# What COPY refuses
# -----------------------------------------------------------------------------

# A missing column, by name.
statement error
COPY (SELECT seqid, source, type, position, stop_position, score, strand, phase FROM features)
TO '{TEST_DIR}/bad.gff' (FORMAT GFF);
----
attributes

statement error
COPY (SELECT 'c1' AS seqid) TO '{TEST_DIR}/bad.gff' (FORMAT GFF);
----
source

