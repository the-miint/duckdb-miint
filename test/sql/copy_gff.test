# -----------------------------------------------------------------------------
# predict_genes' columns: Prodigal's GFF (copy_gff_prodigal.test checks it against the CLI's file); here, rows
# built by hand, so without gpl-boundary
# -----------------------------------------------------------------------------
statement ok
CREATE TABLE hand AS
SELECT 'g' AS genome_id, 'c1' AS read_id, 1 AS gene_index, 1::BIGINT AS position, 301::BIGINT AS stop_position,
       '+' AS strand, false AS partial_left, true AS partial_right, 'ATG' AS start_type, 'AGGAG' AS rbs_motif,
       '5-10bp' AS rbs_spacer, 10.5 AS score, 9.0 AS cscore, 1.5 AS sscore, 0.0 AS rscore, 0.5 AS uscore,
       1.0 AS tscore, 99.9 AS confidence, 0.4 AS gene_gc_content, 1000::BIGINT AS contig_length, 11 AS translation_table,
       true AS uses_sd, NULL::VARCHAR AS model_desc, 0.42 AS model_gc_content, 'ok' AS status;

statement ok
COPY hand TO '{TEST_DIR}/hand.gff' (FORMAT GFF, DIALECT 'prodigal');

query I
SELECT * FROM gff_lines('{TEST_DIR}/hand.gff');
----
##gff-version  3
# Sequence Data: seqnum=1;seqlen=1000;seqhdr="c1"
# Model Data: version=Prodigal.v2.6.5;run_type=Single;model="Ab initio";gc_cont=42.00;transl_table=11;uses_sd=1
c1 | Prodigal_v2.6.5 | CDS | 1 | 300 | 10.5 | + | 0 | ID=1_1;partial=01;start_type=ATG;rbs_motif=AGGAG;rbs_spacer=5-10bp;gc_cont=0.400;conf=99.90;score=10.50;cscore=9.00;sscore=1.50;rscore=0.00;uscore=0.50;tscore=1.00;

# A genome's own row (no contig) is skipped; a contig's row without a gene writes its header lines only; the same
# read_id in another genome is another contig.
statement ok
COPY (SELECT * FROM hand
      UNION ALL SELECT * REPLACE ('c2' AS read_id, NULL::INTEGER AS gene_index, 'no_genes' AS status) FROM hand
      UNION ALL SELECT * REPLACE (NULL::VARCHAR AS read_id, NULL::INTEGER AS gene_index, 'no_genes' AS status) FROM hand
      UNION ALL SELECT * REPLACE ('h' AS genome_id) FROM hand)
TO '{TEST_DIR}/hand_rows.gff' (FORMAT GFF, DIALECT 'prodigal', PRESERVE_ORDER true);

query I
SELECT regexp_extract(line, '^(# Sequence Data: [^;]*|[^ ]* \| [^ ]* \| CDS)') FROM gff_lines('{TEST_DIR}/hand_rows.gff')
WHERE line NOT LIKE '# Model Data%' AND line NOT LIKE '##%';
----
# Sequence Data: seqnum=1
c1 | Prodigal_v2.6.5 | CDS
# Sequence Data: seqnum=2
# Sequence Data: seqnum=3
c1 | Prodigal_v2.6.5 | CDS

query I
SELECT regexp_extract(line, 'ID=([0-9_]+)', 1) FROM gff_lines('{TEST_DIR}/hand_rows.gff') WHERE line LIKE '%ID=%';
----
1_1
3_1

# The same read_id in the next genome, right after it, is another contig.
statement ok
COPY (SELECT * FROM hand UNION ALL SELECT * REPLACE ('h' AS genome_id) FROM hand)
TO '{TEST_DIR}/hand_two_genomes.gff' (FORMAT GFF, DIALECT 'prodigal', PRESERVE_ORDER true);

query I
SELECT regexp_extract(line, 'ID=([0-9_]+)', 1) FROM gff_lines('{TEST_DIR}/hand_two_genomes.gff') WHERE line LIKE '%ID=%';
----
1_1
2_1

