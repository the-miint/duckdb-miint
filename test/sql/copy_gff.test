(row 2)

# -----------------------------------------------------------------------------
# COPY options
# -----------------------------------------------------------------------------

# FORMAT GFF is the default for a .gff path; COMPRESSION is the CSV writer's.
statement ok
COPY features TO '{TEST_DIR}/by_extension.gff';

query I
SELECT count(*) FROM read_gff('{TEST_DIR}/by_extension.gff');
----
7

statement ok
COPY features TO '{TEST_DIR}/explicit_gzip.gff' (FORMAT GFF, COMPRESSION gzip);

query I
SELECT hex(content[1:2]) FROM read_blob('{TEST_DIR}/explicit_gzip.gff');
----
1F8B

# Options that would break the file are refused.
statement error
COPY features TO '{TEST_DIR}/bad.gff' (FORMAT GFF, PER_THREAD_OUTPUT true);
----
COPY FORMAT GFF does not take PER_THREAD_OUTPUT

statement error
COPY features TO '{TEST_DIR}/bad.gff' (FORMAT GFF, APPEND true);
----
COPY FORMAT GFF does not take APPEND

statement error
COPY features TO '{TEST_DIR}/bad.gff' (FORMAT GFF, FILE_SIZE_BYTES 1000);
----
COPY FORMAT GFF does not take FILE_SIZE_BYTES

statement error
COPY features TO '{TEST_DIR}/bad.gff' (FORMAT GFF, PRESERVE_ORDER false);
----
COPY FORMAT GFF does not take PRESERVE_ORDER

statement error
COPY features TO '{TEST_DIR}/bad_dir' (FORMAT GFF, WRITE_PARTITION_COLUMNS true);
----
COPY FORMAT GFF does not take WRITE_PARTITION_COLUMNS

statement error
COPY features TO '{TEST_DIR}/bad_dir' (FORMAT GFF, PARTITION_BY (seqid), PARTITION_PATH 'x_' || seqid);
----
COPY FORMAT GFF does not take PARTITION_PATH

statement error
COPY features TO '{TEST_DIR}/bad_dir' (FORMAT GFF, PARTITION_BY (seqid));
----
PARTITION_BY is (genome_id) with DIALECT 'prodigal'

statement error
COPY features TO '{TEST_DIR}/bad.gff' (FORMAT GFF, DIALECT 'gtf');
----
DIALECT must be 'gff3' or 'prodigal' (got 'gtf')

statement error
COPY features TO '{TEST_DIR}/bad.gff' (FORMAT GFF, SOURCE 'x');
----
SOURCE is for DIALECT 'prodigal'

# predict_genes' columns without DIALECT 'prodigal': named, rather than failed on read_gff's columns.
statement error
COPY (SELECT 'c1' AS read_id, 1 AS gene_index) TO '{TEST_DIR}/bad.gff' (FORMAT GFF);
----
these look like predict_genes' columns; add DIALECT 'prodigal'

# read_gff's columns with a gene_index too are GFF3.
statement ok
COPY (SELECT *, 1 AS gene_index FROM features) TO '{TEST_DIR}/with_gene_index.gff' (FORMAT GFF);

query I
SELECT count(*) FROM read_gff('{TEST_DIR}/with_gene_index.gff');
----
7

# Types are checked as the query is bound: a column of the wrong type is refused even when every value is NULL.
statement error
COPY (SELECT * REPLACE (NULL::STRUCT(ID VARCHAR) AS attributes) FROM features) TO '{TEST_DIR}/bad.gff' (FORMAT GFF);
----
attributes must be MAP(VARCHAR, VARCHAR) or VARCHAR (got STRUCT(ID VARCHAR))

statement error
COPY (SELECT * REPLACE (NULL::JSON AS attributes) FROM features) TO '{TEST_DIR}/bad.gff' (FORMAT GFF);
----
attributes must be MAP(VARCHAR, VARCHAR) or VARCHAR (got JSON)

statement error
COPY (SELECT * REPLACE (MAP {'k': 3} AS attributes) FROM features) TO '{TEST_DIR}/bad.gff' (FORMAT GFF);
----
attributes must be MAP(VARCHAR, VARCHAR) or VARCHAR (got MAP(VARCHAR, INTEGER))

statement error
COPY (SELECT * REPLACE (NULL::VARCHAR AS score) FROM features) TO '{TEST_DIR}/bad.gff' (FORMAT GFF);
----
score must be a number (got VARCHAR)

statement error
COPY (SELECT * REPLACE (NULL::DOUBLE AS position) FROM features) TO '{TEST_DIR}/bad.gff' (FORMAT GFF);
----
position must be an integer (got DOUBLE)
