# Without genome_id (PARTITION_BY drops it from each file), a contig is told from the next by read_id.
statement ok
COPY (SELECT * EXCLUDE (genome_id) FROM hand UNION ALL SELECT * EXCLUDE (genome_id) REPLACE ('c2' AS read_id) FROM hand)
TO '{TEST_DIR}/hand_no_genome.gff' (FORMAT GFF, DIALECT 'prodigal', PRESERVE_ORDER true);

query I
SELECT regexp_extract(line, 'ID=([0-9_]+)', 1) FROM gff_lines('{TEST_DIR}/hand_no_genome.gff') WHERE line LIKE '%ID=%';
----
1_1
2_1

# DIALECT is explicit: predict_genes' columns without it are refused, naming it; an unknown dialect is refused;
# 'gff3' is the default and may be named.
statement error
COPY hand TO '{TEST_DIR}/bad.gff' (FORMAT GFF);
----
DIALECT 'prodigal'

statement error
COPY hand TO '{TEST_DIR}/bad.gff' (FORMAT GFF, DIALECT 'genbank');
----
DIALECT must be 'gff3' or 'prodigal'

statement ok
COPY features TO '{TEST_DIR}/explicit_gff3.gff' (FORMAT GFF, DIALECT 'GFF3');

query I
SELECT count(*) FROM ((SELECT * FROM features EXCEPT ALL SELECT * FROM read_gff('{TEST_DIR}/explicit_gff3.gff'))
                      UNION ALL (SELECT * FROM read_gff('{TEST_DIR}/explicit_gff3.gff') EXCEPT ALL SELECT * FROM features));
----
0

