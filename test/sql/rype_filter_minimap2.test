# name: test/sql/rype_filter_minimap2.test
# description: rype_filter with a minimap2 index also drops the reads minimap2 maps, when the reads are short
# group: [sql]

require miint

# ---------------------------------------------------------------------------
# WHAT rype_filter(relation, rype_index, minimap2_index) MUST BE EQUIVALENT TO
#
# For short reads (a mean sequence1 length under 300, sampled from the start of
# the scan), the two-stage host depletion
#
#   CREATE TABLE kept AS SELECT * FROM reads ANTI JOIN rype_classify(rype_index, 'reads', threshold := t) USING (read_id);
#   SELECT * FROM kept ANTI JOIN align_minimap2('kept', index_path := minimap2_index) USING (read_id);
#
# in one pass, and for long reads the RYpe stage alone: minimap2's short-read
# preset is the one used, and a host index is gigabytes not worth loading for
# reads it is not meant for.
#
# The host is three random 3000 nt sequences. data/rype/test.ryxdi was not built
# from it, so minimap2 removes reads RYpe kept. Read kinds:
#   0  a 150 nt piece of the host                   mapped
#   1  the same, reverse complemented               mapped
#   2  a random 150 nt read                         not mapped; RYpe matches a few at 0.05
#   3  an ACGT repeat                               RYpe matches it at any threshold
# At threshold 0.5 RYpe matches the single reads of kind 3 and nothing else
# here, so the checks at 0.5 can name the rows that must come out; the parity
# checks run at 0.05, where both stages remove reads of the same kinds.
# ---------------------------------------------------------------------------

statement ok
CREATE MACRO random_dna(seed, len) AS (
    SELECT string_agg(substr('ACGT', (hash(seed * 1000003 + j) % 4)::INTEGER + 1, 1), '' ORDER BY j)
    FROM range(len) t(j));

statement ok
CREATE TABLE host AS SELECT 'host' || h AS read_id, random_dna(h, 3000) AS sequence1 FROM range(3) t(h);

statement ok
CREATE MACRO host_piece(seed, len) AS
    substr((SELECT sequence1 FROM host WHERE read_id = 'host' || (seed % 3)), (seed % (3000 - len))::INTEGER + 1, len);

statement ok
CREATE MACRO read_of(kind, seed) AS CASE kind
    WHEN 0 THEN host_piece(seed, 150)
    WHEN 1 THEN reverse(translate(host_piece(seed, 150), 'ACGT', 'TGCA'))
    WHEN 2 THEN random_dna(seed + 100000, 150)
    ELSE 'ACGTACGTACGTACGTACGTACGTACGTACGTACGTACGTACGTACGTACGT' END;

query I
SELECT success FROM save_minimap2_index('host', '{TEST_DIR}/rype_filter_host.mmi');
----
true

# Kinds are scrambled by hash so that kept and dropped rows interleave at every
# position, as in rype_filter.test. The tables are stored in ord order, which
# the order checks below rely on: without ORDER BY, the subqueries that build
# the sequences leave the rows in no particular order.
statement ok
CREATE TABLE reads AS
SELECT i AS ord,
       'r' || i AS read_id,
       (hash(i) % 4)::INTEGER AS kind,
       read_of(hash(i) % 4, i) AS sequence1,
       [i % 256, (i + 1) % 256]::UTINYINT[] AS qual1
FROM range(3000) t(i)
ORDER BY i;

# The mate's kind is chosen independently, and every seventh mate is NULL, which
# both stages treat as a single-end read.
statement ok
CREATE TABLE pairs AS
SELECT *,
       (hash(ord + 7919) % 4)::INTEGER AS mate_kind,
       CASE WHEN ord % 7 = 0 THEN NULL ELSE read_of(hash(ord + 7919) % 4, ord + 50000) END AS sequence2
FROM reads
ORDER BY ord;

# The same pairs under the other read_id types align_minimap2 accepts. minimap2
# is given each read's id as its name, as align_minimap2 gives it.
statement ok
CREATE TABLE pairs_bigint AS SELECT * REPLACE (ord AS read_id) FROM pairs;

statement ok
CREATE TABLE pairs_uuid AS SELECT * REPLACE (md5(read_id)::UUID AS read_id) FROM pairs;

# ---------------------------------------------------------------------------
# Output schema: the relation's own columns, names, types and order
# ---------------------------------------------------------------------------

query II
SELECT list(column_name), list(column_type)
FROM (DESCRIBE SELECT * FROM rype_filter('pairs', 'data/rype/test.ryxdi', '{TEST_DIR}/rype_filter_host.mmi'));
----
[ord, read_id, kind, sequence1, qual1, mate_kind, sequence2]	[BIGINT, VARCHAR, INTEGER, VARCHAR, 'UTINYINT[]', INTEGER, VARCHAR]

# ---------------------------------------------------------------------------
# The kinds alone predict the answer at 0.5. This pins it, so the parity checks
# below cannot pass by both sides agreeing on nothing.
# ---------------------------------------------------------------------------

# RYpe alone keeps every host piece: its index was not built from the host.
query II
SELECT count(*) FILTER (WHERE kind IN (0, 1)) = (SELECT count(*) FROM reads WHERE kind IN (0, 1)),
       count(*) FILTER (WHERE kind = 3)
FROM rype_filter('reads', 'data/rype/test.ryxdi', threshold := 0.5);
----
true	0

# With the host index exactly the random reads are left: every host piece, on
# either strand, is mapped and dropped.
query II
SELECT count(*) = (SELECT count(*) FROM reads WHERE kind = 2), count(*) FILTER (WHERE kind != 2)
FROM rype_filter('reads', 'data/rype/test.ryxdi', '{TEST_DIR}/rype_filter_host.mmi', threshold := 0.5);
----
true	0

# A pair is kept only when neither mate maps and RYpe does not match the pair.
# RYpe scores a pair over both mates' minimizers, so at 0.5 it matches a pair of
# two ACGT repeats but not one whose other mate is random: rype_classify keeps
# those too.
statement ok
CREATE MACRO pair_kept(kind, mate_kind, has_mate) AS CASE
    WHEN NOT has_mate THEN kind = 2
    ELSE kind IN (2, 3) AND mate_kind IN (2, 3) AND NOT (kind = 3 AND mate_kind = 3) END;

query III
SELECT count(*) = (SELECT count(*) FROM pairs WHERE pair_kept(kind, mate_kind, sequence2 IS NOT NULL)),
       count(*) FILTER (WHERE NOT pair_kept(kind, mate_kind, sequence2 IS NOT NULL)),
       count(*) FILTER (WHERE kind = 3 OR mate_kind = 3) > 0
FROM rype_filter('pairs', 'data/rype/test.ryxdi', '{TEST_DIR}/rype_filter_host.mmi', threshold := 0.5);
----
true	0	true

statement ok
CREATE TABLE one_mate AS SELECT * FROM (VALUES
    ('r1_host', host_piece(1, 150), random_dna(1001, 150)),
    ('r2_host', random_dna(1002, 150), host_piece(2, 150)),
    ('neither', random_dna(1003, 150), random_dna(1004, 150)),
    ('r1_host_no_mate', host_piece(5, 150), NULL),
    ('random_no_mate', random_dna(1005, 150), NULL)
) AS t(read_id, sequence1, sequence2);

query I
SELECT read_id FROM rype_filter('one_mate', 'data/rype/test.ryxdi', '{TEST_DIR}/rype_filter_host.mmi', threshold := 0.5)
ORDER BY read_id;
----
neither
random_no_mate

# A pair is mapped as align_minimap2 maps it: as one fragment, with mate 2 read
# from the other strand. The pairs of the paired ground truth
# (align_minimap2_paired_ground_truth.test) whose mates map nowhere alone, the
# fragment_* pairs, map that way and are dropped; of its nine pairs only the one
# with neither mate in the subject is kept.
statement ok
CREATE TABLE fragment_subject AS SELECT * FROM read_fastx('data/minimap2/paired_subject.fasta');

query I
SELECT success FROM save_minimap2_index('fragment_subject', '{TEST_DIR}/rype_filter_fragment.mmi');
----
true

statement ok
CREATE TABLE fragment_pairs AS
SELECT * FROM read_fastx('data/minimap2/paired_R1.fasta', sequence2 := 'data/minimap2/paired_R2.fasta');

query I
SELECT read_id FROM rype_filter('fragment_pairs', 'data/rype/test.ryxdi', '{TEST_DIR}/rype_filter_fragment.mmi', threshold := 0.5)
ORDER BY read_id;
----
unmapped

# ---------------------------------------------------------------------------
# Parity with the two-stage join, single-end and paired, under every read_id
# type, at group sizes that end inside a scan chunk, one chunk, and automatic
# ---------------------------------------------------------------------------

foreach rel reads pairs pairs_bigint pairs_uuid

statement ok
CREATE OR REPLACE TABLE rype_kept AS
SELECT * FROM {rel} ANTI JOIN rype_classify('data/rype/test.ryxdi', '{rel}', threshold := 0.05) c USING (read_id);

statement ok
CREATE TABLE expected_{rel} AS
SELECT * FROM rype_kept ANTI JOIN align_minimap2('rype_kept', index_path := '{TEST_DIR}/rype_filter_host.mmi') a USING (read_id);

# Both stages removed something: the expected rows are neither all of RYpe's nor none.
query I
SELECT (SELECT count(*) FROM expected_{rel}) BETWEEN 1 AND (SELECT count(*) FROM rype_kept) - 1;
----
true

foreach group_rows 7 2048 0

statement ok
SET miint_rype_filter_group_rows = {group_rows};

query I
SELECT count(*) FROM (
    (SELECT * FROM rype_filter('{rel}', 'data/rype/test.ryxdi', '{TEST_DIR}/rype_filter_host.mmi', threshold := 0.05)
     EXCEPT ALL
     SELECT * FROM expected_{rel})
    UNION ALL
    (SELECT * FROM expected_{rel}
     EXCEPT ALL
     SELECT * FROM rype_filter('{rel}', 'data/rype/test.ryxdi', '{TEST_DIR}/rype_filter_host.mmi', threshold := 0.05)));
----
0

endloop

statement ok
RESET miint_rype_filter_group_rows;

endloop

# read_id keeps the relation's type for every id type, with minimap2 and
# without: typeof is fixed when the query binds, so this checks the bound type,
# as DESCRIBE does, in queries that also return rows. The EXCEPT ALL above
# compares values, and would cast a changed type to a common one.
query IIII
SELECT (SELECT DISTINCT typeof(read_id)
        FROM rype_filter('pairs_bigint', 'data/rype/test.ryxdi', '{TEST_DIR}/rype_filter_host.mmi', threshold := 0.05)),
       (SELECT DISTINCT typeof(read_id)
        FROM rype_filter('pairs_uuid', 'data/rype/test.ryxdi', '{TEST_DIR}/rype_filter_host.mmi', threshold := 0.05)),
       (SELECT DISTINCT typeof(read_id) FROM rype_filter('pairs_bigint', 'data/rype/test.ryxdi', threshold := 0.05)),
       (SELECT DISTINCT typeof(read_id) FROM rype_filter('pairs_uuid', 'data/rype/test.ryxdi', threshold := 0.05));
----
BIGINT	UUID	BIGINT	UUID

# ---------------------------------------------------------------------------
# read_id is optional: without one, or where it is NULL, minimap2 is given no name
# ---------------------------------------------------------------------------

statement ok
CREATE VIEW pairs_anonymous AS SELECT * EXCLUDE (read_id) FROM pairs;

query I
SELECT count(*) FROM (
    (SELECT * FROM rype_filter('pairs_anonymous', 'data/rype/test.ryxdi', '{TEST_DIR}/rype_filter_host.mmi', threshold := 0.05)
     EXCEPT ALL
     SELECT * EXCLUDE (read_id) FROM expected_pairs)
    UNION ALL
    (SELECT * EXCLUDE (read_id) FROM expected_pairs
     EXCEPT ALL
     SELECT * FROM rype_filter('pairs_anonymous', 'data/rype/test.ryxdi', '{TEST_DIR}/rype_filter_host.mmi', threshold := 0.05)));
----
0

# A host read with a NULL id is still a host read. (align_minimap2 skips such a
# row, so the two-stage join would keep it.)
statement ok
CREATE TABLE null_ids AS SELECT * FROM (VALUES
    (1, NULL, host_piece(7, 150)),
    (2, NULL, random_dna(1007, 150)),
    (3, 'named', host_piece(8, 150))
) AS t(ord, read_id, sequence1);

query I
SELECT ord FROM rype_filter('null_ids', 'data/rype/test.ryxdi', '{TEST_DIR}/rype_filter_host.mmi', threshold := 0.5)
ORDER BY ord;
----
2

# A read_id minimap2 cannot be given is refused at bind, before either index is
# loaded (neither path here exists). The RYpe stage alone never reads it.
statement ok
CREATE TABLE int_id AS SELECT 1::INTEGER AS read_id, random_dna(1009, 150) AS sequence1;

statement error
SELECT * FROM rype_filter('int_id', 'nonexistent.ryxdi', 'nonexistent.mmi');
----
Column 'read_id' in 'int_id' must be VARCHAR, BIGINT, or UUID

query I
SELECT read_id FROM rype_filter('int_id', 'data/rype/test.ryxdi', threshold := 0.5);
----
1

# ---------------------------------------------------------------------------
# Long reads skip minimap2, and the minimap2 index is then never opened
# ---------------------------------------------------------------------------

statement ok
COPY (SELECT 'not a minimap2 index') TO '{TEST_DIR}/rype_filter_corrupt.mmi' (FORMAT CSV, HEADER false);

statement ok
CREATE TABLE long_reads AS
SELECT i AS ord, 'l' || i AS read_id, i % 2 AS kind,
       CASE WHEN i % 2 = 0 THEN host_piece(i, 400) ELSE random_dna(i + 200000, 400) END AS sequence1
FROM range(50) t(i);

statement ok
CREATE TABLE len_300 AS SELECT i AS ord, host_piece(i, 300) AS sequence1 FROM range(20) t(i);

statement ok
CREATE TABLE len_299 AS SELECT i AS ord, host_piece(i, 299) AS sequence1 FROM range(20) t(i);

# The mean decides, not the first read.
statement ok
CREATE TABLE long_then_short AS
SELECT i AS ord, host_piece(i, CASE WHEN i = 0 THEN 1000 ELSE 150 END) AS sequence1 FROM range(10) t(i);

statement ok
CREATE TABLE short_then_long AS
SELECT i AS ord, host_piece(i, CASE WHEN i = 0 THEN 150 ELSE 400 END) AS sequence1 FROM range(10) t(i);

# sequence1 alone is measured: a short sequence1 with a long mate is a short
# read, and a long one with a short mate a long read.
statement ok
CREATE TABLE short_mate1 AS
SELECT i AS ord, host_piece(i, 150) AS sequence1, host_piece(i + 50, 1000) AS sequence2 FROM range(10) t(i);

statement ok
CREATE TABLE long_mate1 AS
SELECT i AS ord, host_piece(i, 400) AS sequence1, host_piece(i + 50, 150) AS sequence2 FROM range(10) t(i);

# The scan's first chunk decides, up to 2,048 rows: short reads there make the
# run a short-read one, though the longer reads after them lift the mean over 300.
statement ok
CREATE TABLE short_first_chunk AS
SELECT i AS ord, host_piece(i, CASE WHEN i < 2048 THEN 150 ELSE 1000 END) AS sequence1 FROM range(3000) t(i);

query I
SELECT avg(length(sequence1)) > 300 FROM short_first_chunk;
----
true

# The length is sampled whether the group size is automatic or set.
foreach group_rows 7 0

statement ok
SET miint_rype_filter_group_rows = {group_rows};

# The host pieces minimap2 would map are kept, as RYpe alone keeps them.
query II
SELECT count(*), count(*) FILTER (WHERE kind = 0)
FROM rype_filter('long_reads', 'data/rype/test.ryxdi', '{TEST_DIR}/rype_filter_host.mmi', threshold := 0.5);
----
50	25

# A damaged index, or none at all, is no error: it is never opened.
query I
SELECT count(*) FROM rype_filter('long_reads', 'data/rype/test.ryxdi', '{TEST_DIR}/rype_filter_corrupt.mmi', threshold := 0.5);
----
50

query I
SELECT count(*) FROM rype_filter('long_reads', 'data/rype/test.ryxdi', 'nonexistent.mmi', threshold := 0.5);
----
50

# 300 is long and 299 short: host pieces of 300 nt are kept, of 299 nt mapped.
query I
SELECT count(*) FROM rype_filter('len_300', 'data/rype/test.ryxdi', '{TEST_DIR}/rype_filter_host.mmi', threshold := 0.5);
----
20

query I
SELECT count(*) FROM rype_filter('len_300', 'data/rype/test.ryxdi', '{TEST_DIR}/rype_filter_corrupt.mmi', threshold := 0.5);
----
20

query I
SELECT count(*) FROM rype_filter('len_299', 'data/rype/test.ryxdi', '{TEST_DIR}/rype_filter_host.mmi', threshold := 0.5);
----
0

statement error
SELECT count(*) FROM rype_filter('len_299', 'data/rype/test.ryxdi', '{TEST_DIR}/rype_filter_corrupt.mmi', threshold := 0.5);
----
Failed to load minimap2 index

statement error
SELECT count(*) FROM rype_filter('long_then_short', 'data/rype/test.ryxdi', '{TEST_DIR}/rype_filter_corrupt.mmi', threshold := 0.5);
----
Failed to load minimap2 index

query I
SELECT count(*) FROM rype_filter('short_then_long', 'data/rype/test.ryxdi', '{TEST_DIR}/rype_filter_corrupt.mmi', threshold := 0.5);
----
10

statement error
SELECT count(*) FROM rype_filter('short_mate1', 'data/rype/test.ryxdi', '{TEST_DIR}/rype_filter_corrupt.mmi', threshold := 0.5);
----
Failed to load minimap2 index

query I
SELECT count(*) FROM rype_filter('long_mate1', 'data/rype/test.ryxdi', '{TEST_DIR}/rype_filter_corrupt.mmi', threshold := 0.5);
----
10

statement error
SELECT count(*) FROM rype_filter('short_first_chunk', 'data/rype/test.ryxdi', '{TEST_DIR}/rype_filter_corrupt.mmi', threshold := 0.5);
----
Failed to load minimap2 index

endloop

statement ok
RESET miint_rype_filter_group_rows;

# Short reads load the index, so a missing one is an error naming it.
statement error
SELECT * FROM rype_filter('reads', 'data/rype/test.ryxdi', 'nonexistent.mmi');
----
Failed to load minimap2 index 'nonexistent.mmi'

# An empty relation has no length to sample, and nothing for minimap2 to map.
statement ok
CREATE TABLE no_reads (read_id VARCHAR, sequence1 VARCHAR);

query I
SELECT count(*) FROM rype_filter('no_reads', 'data/rype/test.ryxdi', '{TEST_DIR}/rype_filter_corrupt.mmi');
----
0

# ---------------------------------------------------------------------------
# On one thread the rows come out in the relation's order
# ---------------------------------------------------------------------------

statement ok
SET threads = 1;

foreach group_rows 7 2000 0

statement ok
SET miint_rype_filter_group_rows = {group_rows};

query I
SELECT list(ord) = list_sort(list(ord))
FROM rype_filter('pairs', 'data/rype/test.ryxdi', '{TEST_DIR}/rype_filter_host.mmi', threshold := 0.05);
----
true

endloop

statement ok
RESET miint_rype_filter_group_rows;

# ---------------------------------------------------------------------------
# The relation is read exactly once
#
# As in rype_filter.test: the first 2000 rows any scan pulls carry a random
# read, which neither stage removes, and later ones a host piece, which minimap2
# maps. A single scan keeps all 2000 random reads; any second read of the
# relation, such as re-reading sequences to map them, moves a suffix to the host
# piece and drops it.
# ---------------------------------------------------------------------------

statement ok
CREATE SEQUENCE once_seq START 1;

statement ok
CREATE VIEW volatile_reads AS
SELECT i AS ord, CASE WHEN nextval('once_seq') <= 2000 THEN random_dna(42, 150) ELSE host_piece(7, 150) END AS sequence1
FROM range(2000) t(i);

statement ok
SET miint_rype_filter_group_rows = 7;

query II
SELECT count(*), count(*) FILTER (WHERE sequence1 != random_dna(42, 150))
FROM rype_filter('volatile_reads', 'data/rype/test.ryxdi', '{TEST_DIR}/rype_filter_host.mmi', threshold := 0.5);
----
2000	0
