# name: test/sql/sc_oracle_ecam.test
# description: validate the SQL fit/predict path against sc's ECAM oracle fixture
# group: [sql]

require miint

require json

statement ok
PRAGMA enable_verification;

# The only test here that checks against an EXTERNAL reference rather than our
# own output. sc's oracle fixtures were generated by scikit-learn 1.4.2 through
# the qiime2 amplicon pipeline (see the `generator` block), so clearing their
# bands means the whole path -- DuckDB table, COO builder, Arrow FFI, sc-core --
# reproduces what the reference implementation does on the same 126 x 150 data.
#
# Read straight out of ext/sc rather than copied into test data, so the test
# cannot drift from the fixture it is validating against.
statement ok
CREATE TABLE fx AS SELECT * FROM read_json('ext/sc/oracle/fixtures/forest/agg_ecam.json');

# unnest over three parallel lists zips them positionally -- that IS the COO.
#
# The zero-padding is load-bearing, not cosmetic. 'feat_0'..'feat_149' sorts
# lexically as feat_0, feat_1, feat_10, feat_100, ..., so the builder's sorted
# dictionary would map column 1 to feat_1 but column 2 to feat_10 and every
# learned split would read the wrong feature. Nothing would error; the r2 would
# just quietly get worse. Constant width makes lexical order equal numeric order.
statement ok
CREATE TABLE ecam AS
  SELECT printf('sample_%03d', unnest(data_coo.rows)) AS sample_id,
         printf('feat_%03d',   unnest(data_coo.cols)) AS feature_id,
         unnest(data_coo.vals) AS value
  FROM fx;

statement ok
CREATE TABLE ecam_meta AS
  SELECT printf('sample_%03d', generate_subscripts(values, 1) - 1) AS sample_id,
         unnest(values) AS value
  FROM fx;

statement ok
CREATE TABLE ecam_ref AS
  SELECT printf('feat_%03d', generate_subscripts(ref_importances, 1) - 1) AS feature_id,
         unnest(ref_importances) AS ref_importance
  FROM fx;

# The COO round-trips into relational form with nothing lost or duplicated.
query III
SELECT count(*), count(DISTINCT sample_id), count(DISTINCT feature_id) FROM ecam;
----
4648	126	150

query II
SELECT (SELECT count(*) FROM ecam_meta), (SELECT count(*) FROM ecam_ref);
----
126	150

# --- the oracle's own train/test split ---

statement ok
CREATE TABLE tr_ids AS SELECT printf('sample_%03d', unnest(train_idx)) AS sample_id FROM fx;

statement ok
CREATE TABLE te_ids AS SELECT printf('sample_%03d', unnest(test_idx)) AS sample_id FROM fx;

query II
SELECT (SELECT count(*) FROM tr_ids), (SELECT count(*) FROM te_ids);
----
94	32

statement ok
CREATE TABLE tr AS SELECT * FROM ecam SEMI JOIN tr_ids USING (sample_id);

statement ok
CREATE TABLE te AS SELECT * FROM ecam SEMI JOIN te_ids USING (sample_id);

statement ok
CREATE TABLE tr_meta AS SELECT * FROM ecam_meta SEMI JOIN tr_ids USING (sample_id);

statement ok
CREATE TABLE split_model AS
  SELECT * FROM sc_fit_regressor('tr', 'tr_meta', n_estimators := 25, random_state := 20260707, name := 'm53');

# The model's width is the training data's, and the split kept every feature.
query II
SELECT n_samples, n_features FROM split_model;
----
94	150

# r2 on the held-out samples must land inside the band scikit-learn produced on
# the same split. The bands come from the fixture, so this stays correct if the
# fixture is ever regenerated.
query I
WITH p AS (SELECT sample_id, prediction FROM sc_predict('te', 'split_model')),
     j AS (SELECT p.prediction AS yhat, m.value AS y FROM p JOIN ecam_meta m USING (sample_id)),
     ybar AS (SELECT avg(value) AS mu FROM ecam_meta SEMI JOIN te_ids USING (sample_id)),
     r AS (SELECT 1 - sum((y - yhat) * (y - yhat)) / sum((y - mu) * (y - mu)) AS r2 FROM j, ybar)
SELECT r2 BETWEEN (SELECT band.min - band.margin_abs FROM fx)
              AND (SELECT band.max + band.margin_abs FROM fx) FROM r;
----
true

# Every held-out sample is predicted, and all of them share the model's
# vocabulary because both splits came from one table.
query II
SELECT count(*), bool_and(sample_coverage = 1.0) FROM sc_predict('te', 'split_model');
----
32	true

# --- feature importances against sklearn's ---

statement ok
CREATE TABLE full_model AS
  SELECT * FROM sc_fit_regressor('ecam', 'ecam_meta', n_estimators := 25, random_state := 20260707, name := 'm54');

# sc's RNG is not sklearn's, so the forests differ and the importances cannot
# match exactly. The oracle compares them by rank correlation against a floor,
# and so does this.
query I
WITH ours AS (SELECT feature_id, importance FROM sc_feature_importances('full_model')),
     j AS (SELECT o.importance AS mine, r.ref_importance AS ref
           FROM ours o JOIN ecam_ref r USING (feature_id)),
     ranked AS (SELECT rank() OVER (ORDER BY mine) rm, rank() OVER (ORDER BY ref) rr FROM j)
SELECT corr(rm, rr) >= (SELECT rank_corr_floor - rank_corr_margin FROM fx) FROM ranked;
----
true

# Both sets are normalised over the same 150 features.
query II
SELECT abs(sum(importance) - 1.0) < 1e-9, count(*) FROM sc_feature_importances('full_model');
----
true	150

# --- the padding this test depends on ---

# If ids were not zero-padded, sorting would interleave and the mapping from
# column index to feature would break silently. Assert the property directly so
# a future edit to the printf format fails here rather than in the r2 band.
query I
SELECT list(feature_id ORDER BY feature_id)[1:3] = ['feat_000','feat_001','feat_002']
FROM (SELECT DISTINCT feature_id FROM ecam);
----
true
