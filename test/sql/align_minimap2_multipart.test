# name: test/sql/align_minimap2_multipart.test
# description: Test align_minimap2 streaming a multi-part prebuilt index (index_path)
# group: [sql]

require miint

# The fixture is generated by run_tests.sh (no SQL-level way to build a
# multi-part .mmi: save_minimap2_index always builds single-part). See the
# "Multi-part minimap2 index fixture" comment there for how it's built and why
# the paths below are hardcoded rather than read from the env var — same
# convention as align_sortmerna_realworld.test's SORTMERNA_REAL_ORACLE.
require-env MIINT_MINIMAP2_MULTIPART_FIXTURE

statement ok
CREATE TABLE multipart_queries AS SELECT * FROM (VALUES
    ('query_part1', 'ACGTACGTACGTACGTACGTACGTACGTACGTACGTACGTACGTACGTACGT'),
    ('query_part2', 'TTTTGGGGCCCCAAAATTTTGGGGCCCCAAAATTTTGGGGCCCCAAAATTTT')
) AS t(read_id, sequence1);

# Core correctness assertion — the bug this feature fixes: before streaming,
# align_minimap2(index_path := <multi-part>) silently returned alignments
# against part 1 only. query_part2 only matches part2_ref (in part 2), so if
# streaming ever regresses back to loading part 1 alone, this row disappears
# instead of erroring — exactly the silent-data-loss failure mode.
query II
SELECT read_id, reference
FROM align_minimap2('multipart_queries', index_path='data/shards/multipart_fixture.mmi', max_secondary=0)
ORDER BY read_id;
----
query_part1	part1_ref
query_part2	part2_ref

# Oracle: the same result set must equal the UNION ALL of aligning against
# each single-part index separately. Correct by construction (each call only
# ever sees one, unambiguously single-part, index) and independent of the
# multi-part streaming code path being exercised above.
query II
SELECT read_id, reference
FROM (
    SELECT * FROM align_minimap2('multipart_queries', index_path='data/shards/multipart_fixture_part1.mmi', max_secondary=0)
    UNION ALL
    SELECT * FROM align_minimap2('multipart_queries', index_path='data/shards/multipart_fixture_part2.mmi', max_secondary=0)
)
ORDER BY read_id;
----
query_part1	part1_ref
query_part2	part2_ref

# include_unmapped is rejected for a multi-part index (#185-style reasoning:
# a query with no chain in part 1 may still map in part 2, so a per-part
# synthetic "unmapped" row would be wrong).
statement error
SELECT * FROM align_minimap2('multipart_queries', index_path='data/shards/multipart_fixture.mmi', include_unmapped=true);
----
include_unmapped cannot be combined with a multi-part index

# A read that matches neither part still produces no row (not an error) —
# unrelated to include_unmapped, which is about the *representation* of "no
# match", not whether alignment across all parts still happens correctly.
statement ok
INSERT INTO multipart_queries VALUES ('query_nomatch', 'GCTAGCTAGCTAGCTAGCTAGCTAGCTAGCTAGCTAGCTAGCTAGCTAGCTA');

query II
SELECT read_id, reference
FROM align_minimap2('multipart_queries', index_path='data/shards/multipart_fixture.mmi', max_secondary=0)
ORDER BY read_id;
----
query_part1	part1_ref
query_part2	part2_ref

# align_minimap2_sharded fails loud (rather than silently truncating) if a
# shard's .mmi turns out to be multi-part -- it has no streaming path, so
# loading is a hard error instead of quietly aligning against part 1 only.
statement ok
CREATE TABLE sharded_queries AS SELECT * FROM (VALUES
    ('query_part1', 'ACGTACGTACGTACGTACGTACGTACGTACGTACGTACGTACGTACGTACGT')
) AS t(read_id, sequence1);

statement ok
CREATE TABLE sharded_read_to_shard AS SELECT * FROM (VALUES
    ('query_part1', 'multipart_fixture')
) AS t(read_id, shard_name);

# align_minimap2_sharded looks up '<shard_directory>/<shard_name>.mmi' — name
# the shard after the multi-part fixture created above so it resolves to
# data/shards/multipart_fixture.mmi. mm_idx_is_idx (the bind-time validity
# check) only inspects the MM_IDX_MAGIC header, so a multi-part file passes
# bind; the throw happens when ClaimWork actually loads it in Execute(), which
# a plain (non-WHERE-FALSE) query guarantees is reached.
statement error
SELECT * FROM align_minimap2_sharded('sharded_queries', shard_directory='data/shards', read_to_shard='sharded_read_to_shard');
----
multiple parts
