# name: test/sql/align_minimap2_multipart.test
# description: Test align_minimap2 streaming a multi-part prebuilt index (index_path)
# group: [sql]

require miint

# The fixture is generated by run_tests.sh (no SQL-level way to build a
# multi-part .mmi: save_minimap2_index always builds single-part). See the
# "Multi-part minimap2 index fixture" comment there for how it's built and why
# the paths below are hardcoded rather than read from the env var — same
# convention as align_sortmerna_realworld.test's SORTMERNA_REAL_ORACLE.
require-env MIINT_MINIMAP2_MULTIPART_FIXTURE

statement ok
CREATE TABLE multipart_queries AS SELECT * FROM (VALUES
    ('query_part1', 'ACGTACGTACGTACGTACGTACGTACGTACGTACGTACGTACGTACGTACGT'),
    ('query_part2', 'TTTTGGGGCCCCAAAATTTTGGGGCCCCAAAATTTTGGGGCCCCAAAATTTT')
) AS t(read_id, sequence1);

# Core correctness assertion — the bug this feature fixes: before streaming,
# align_minimap2(index_path := <multi-part>) silently returned alignments
# against part 1 only. query_part2 only matches part2_ref (in part 2), so if
# streaming ever regresses back to loading part 1 alone, this row disappears
# instead of erroring — exactly the silent-data-loss failure mode.
query II
SELECT read_id, reference
FROM align_minimap2('multipart_queries', index_path='data/shards/multipart_fixture.mmi', max_secondary=0)
ORDER BY read_id;
----
query_part1	part1_ref
query_part2	part2_ref

# Oracle: the same result set must equal the UNION ALL of aligning against
# each single-part index separately. Correct by construction (each call only
# ever sees one, unambiguously single-part, index) and independent of the
# multi-part streaming code path being exercised above.
query II
SELECT read_id, reference
FROM (
    SELECT * FROM align_minimap2('multipart_queries', index_path='data/shards/multipart_fixture_part1.mmi', max_secondary=0)
    UNION ALL
    SELECT * FROM align_minimap2('multipart_queries', index_path='data/shards/multipart_fixture_part2.mmi', max_secondary=0)
)
ORDER BY read_id;
----
query_part1	part1_ref
query_part2	part2_ref

# include_unmapped is rejected for a multi-part index (#185-style reasoning:
# a query with no chain in part 1 may still map in part 2, so a per-part
# synthetic "unmapped" row would be wrong).
statement error
SELECT * FROM align_minimap2('multipart_queries', index_path='data/shards/multipart_fixture.mmi', include_unmapped=true);
----
include_unmapped cannot be combined with a multi-part index

# A read that matches neither part still produces no row (not an error) —
# unrelated to include_unmapped, which is about the *representation* of "no
# match", not whether alignment across all parts still happens correctly.
statement ok
INSERT INTO multipart_queries VALUES ('query_nomatch', 'GCTAGCTAGCTAGCTAGCTAGCTAGCTAGCTAGCTAGCTAGCTAGCTAGCTA');

query II
SELECT read_id, reference
FROM align_minimap2('multipart_queries', index_path='data/shards/multipart_fixture.mmi', max_secondary=0)
ORDER BY read_id;
----
query_part1	part1_ref
query_part2	part2_ref

# Paired-end through the multi-part replay snapshot, with qual1/qual2 present
# on the query table (but NOT expected in the snapshot's projection —
# align_minimap2 never reads quality scores, so Bind() zeroes
# has_qual1/has_qual2 on the schema before it reaches MaterializeQueryReads).
# This is the only multi-part test exercising a query table with those columns
# present, so it's what would catch the qual columns leaking back into the
# snapshot's projection. Segment 1 (sequence1) matches part1_ref and segment 2
# (sequence2) matches part2_ref, so a correct projection produces exactly
# these two rows; a scrambled one would misroute a segment to the wrong
# reference or drop it.
statement ok
CREATE TABLE multipart_paired_queries AS SELECT * FROM (VALUES
    ('query_paired',
     'ACGTACGTACGTACGTACGTACGTACGTACGTACGTACGTACGTACGTACGT',
     'TTTTGGGGCCCCAAAATTTTGGGGCCCCAAAATTTTGGGGCCCCAAAATTTT',
     CAST(NULL AS INTEGER[]), CAST(NULL AS INTEGER[]))
) AS t(read_id, sequence1, sequence2, qual1, qual2);

query II
SELECT read_id, reference
FROM align_minimap2('multipart_paired_queries', index_path='data/shards/multipart_fixture.mmi', max_secondary=0)
ORDER BY reference;
----
query_paired	part1_ref
query_paired	part2_ref

# A query relation large enough to force the snapshot's Appender past its
# internal flush threshold (BaseAppender::DEFAULT_FLUSH_COUNT, 204,800 rows)
# while MaterializeQueryReads's source stream is still open -- regression
# test for a connection-reentrancy bug: an early version of the batched
# rewrite drove both the source SendQuery stream and the destination
# Appender through the same Connection, and Connection supports only one
# active pending query at a time. That bug was invisible to every other case
# in this file (a handful of rows never cross the flush threshold before the
# stream exhausts, so the conflict never triggered) and only reproduced with
# a genuinely large corpus -- which is also why it matters here: the whole
# point of streaming the snapshot in chunks is to handle corpora far larger
# than a few rows. A VIEW source (not a plain VALUES table) matches the
# shape of the real bug report (a view over read_fastx), though the
# reentrancy itself is independent of table vs. view.
statement ok
CREATE VIEW big_multipart_queries AS
    SELECT 'query_' || i AS read_id, 'ACGTACGTACGTACGTACGTACGTACGTACGTACGTACGTACGTACGTACGT' AS sequence1
    FROM range(250000) t(i);

query III
SELECT count(*), count(*) FILTER (reference = 'part1_ref'), count(*) FILTER (reference = 'part2_ref')
FROM align_minimap2('big_multipart_queries', index_path='data/shards/multipart_fixture.mmi', max_secondary=0);
----
250000	250000	0

# Regression test for a silent-truncation bug found while building the above:
# QueryResult::Fetch() returns null for BOTH a clean end-of-stream AND a
# mid-stream query error -- HasError() is the only way to tell them apart. An
# early version of MaterializeQueryReads's fetch loop treated every null
# Fetch() as "done", so a real error partway through the source relation
# (a malformed row, a corrupt input file, ...) silently truncated the
# snapshot to whatever had been read so far instead of failing the query --
# align_minimap2 would have returned a successful, quietly-incomplete result
# for a corpus that has a bad row anywhere past the first chunk. The error
# is deliberately placed past the flush threshold (i=210000, like the test
# above) so this also covers the error firing after at least one real flush.
statement ok
CREATE VIEW failing_multipart_queries AS
    SELECT 'query_' || i AS read_id,
           CASE WHEN i = 210000 THEN error('forced failure mid-stream')
                ELSE 'ACGTACGTACGTACGTACGTACGTACGTACGTACGTACGTACGTACGTACGT' END AS sequence1
    FROM range(250000) t(i);

statement error
SELECT count(*) FROM align_minimap2('failing_multipart_queries', index_path='data/shards/multipart_fixture.mmi', max_secondary=0);
----
forced failure mid-stream

# align_minimap2_sharded fails loud (rather than silently truncating) if a
# shard's .mmi turns out to be multi-part -- it has no streaming path, so
# loading is a hard error instead of quietly aligning against part 1 only.
statement ok
CREATE TABLE sharded_queries AS SELECT * FROM (VALUES
    ('query_part1', 'ACGTACGTACGTACGTACGTACGTACGTACGTACGTACGTACGTACGTACGT')
) AS t(read_id, sequence1);

statement ok
CREATE TABLE sharded_read_to_shard AS SELECT * FROM (VALUES
    ('query_part1', 'multipart_fixture')
) AS t(read_id, shard_name);

# align_minimap2_sharded looks up '<shard_directory>/<shard_name>.mmi' — name
# the shard after the multi-part fixture created above so it resolves to
# data/shards/multipart_fixture.mmi. mm_idx_is_idx (the bind-time validity
# check) only inspects the MM_IDX_MAGIC header, so a multi-part file passes
# bind; the throw happens when ClaimWork actually loads it in Execute(), which
# a plain (non-WHERE-FALSE) query guarantees is reached.
statement error
SELECT * FROM align_minimap2_sharded('sharded_queries', shard_directory='data/shards', read_to_shard='sharded_read_to_shard');
----
multiple parts
