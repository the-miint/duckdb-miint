# name: test/sql/ena_modify_sample_mock.test
# description: ena_modify_sample(...) table function — Webin V2 MODIFY for samples
# group: [sql]

require miint

require-env ENA_WEBIN_MOCK_URL

require-env MIINT_ENA_PORTAL_URL_BASE

require httpfs

statement ok
CREATE SECRET test_ena_modify_sample_mock (
    TYPE ENA,
    USER 'Webin-99999',
    PASSWORD 'mock-password',
    ENDPOINT 'test',
    ENDPOINT_URL '${ENA_WEBIN_MOCK_URL}'
);

statement ok
ATTACH '' AS ena (TYPE ENA, SECRET 'test_ena_modify_sample_mock');

# Happy path: MODIFY round-trips the user's ERS. era_accession is empty —
# wwwdev returns <SUBMISSION accession=""/> on MODIFY (matches L4a finding).
query IIIII
SELECT action, target, success, alias, era_accession
FROM ena_modify_sample(
    secret => 'test_ena_modify_sample_mock',
    accession => 'ERS9000001',
    alias => 'modify-sample-alpha',
    taxon_id => 408170,
    checklist => 'ERC000015',
    attributes => MAP {'collection date': '2026-05-07'});
----
MODIFY	ERS9000001	true	modify-sample-alpha	(empty)

# submission_log captures the request with action=MODIFY, target=ERS, and the
# per-object alias/accession lists populated from the receipt.
query IIIII
SELECT object_type, action, target, object_aliases, object_accessions
FROM ena.submission_log
WHERE action = 'MODIFY' AND target = 'ERS9000001'
ORDER BY submitted_at DESC LIMIT 1;
----
samples	MODIFY	ERS9000001	[modify-sample-alpha]	[ERS9000001]

# Alias-collision check is skipped on MODIFY (the alias belongs to the user).
query III
SELECT action, target, success
FROM ena_modify_sample(
    secret => 'test_ena_modify_sample_mock',
    accession => 'ERS9000002',
    alias => 'EXISTS_already_yours_sample',
    taxon_id => 408170);
----
MODIFY	ERS9000002	true

# Required parameters: accession is non-optional.
statement error
SELECT * FROM ena_modify_sample(
    secret => 'test_ena_modify_sample_mock',
    alias => 'no-accession',
    taxon_id => 408170);
----
accession

# Required parameters: alias is non-optional.
statement error
SELECT * FROM ena_modify_sample(
    secret => 'test_ena_modify_sample_mock',
    accession => 'ERS9000099',
    taxon_id => 408170);
----
alias

# Required parameters: taxon_id is non-optional. AppendSample emits
# `"taxonId":"<value>"` unconditionally — an unset taxon_id (defaulting to 0)
# would emit "taxonId":"0", which both our client-side ValidateSampleSpec
# AND ENA's server reject. Catch the omission at bind for a clean error.
statement error
SELECT * FROM ena_modify_sample(
    secret => 'test_ena_modify_sample_mock',
    accession => 'ERS9000099',
    alias => 'a');
----
taxon_id

# taxon_id <= 0 is rejected at bind (faster + clearer than letting the
# envelope builder's ValidateSampleSpec surface the same error mid-Execute).
statement error
SELECT * FROM ena_modify_sample(
    secret => 'test_ena_modify_sample_mock',
    accession => 'ERS9000099',
    alias => 'a',
    taxon_id => 0);
----
taxon_id

statement error
SELECT * FROM ena_modify_sample(
    secret => 'test_ena_modify_sample_mock',
    accession => 'ERS9000099',
    alias => 'a',
    taxon_id => -1);
----
taxon_id

# Whitespace-only accession / alias rejected at bind.
statement error
SELECT * FROM ena_modify_sample(
    secret => 'test_ena_modify_sample_mock',
    accession => '   ',
    alias => 'a',
    taxon_id => 408170);
----
accession

statement error
SELECT * FROM ena_modify_sample(
    secret => 'test_ena_modify_sample_mock',
    accession => 'ERS9000099',
    alias => '  ',
    taxon_id => 408170);
----
alias

# Whitespace-only checklist is rejected at bind: it would be emitted as the
# ENA-CHECKLIST attribute value verbatim and the server's "checklist '   '
# not found" surfaces only after a round-trip.
statement error
SELECT * FROM ena_modify_sample(
    secret => 'test_ena_modify_sample_mock',
    accession => 'ERS9000099',
    alias => 'a',
    taxon_id => 408170,
    checklist => '   ');
----
checklist

# MODIFY without checklist or attributes still works — the user might be
# updating just the title or scientific_name. No ENA-CHECKLIST attribute is
# emitted; the server keeps whatever checklist binding the original ADD
# carried (or rejects if it requires a checklist; we don't second-guess).
query III
SELECT action, target, success
FROM ena_modify_sample(
    secret => 'test_ena_modify_sample_mock',
    accession => 'ERS9000003',
    alias => 'modify-sample-no-checklist',
    taxon_id => 408170,
    title => 'just changing the title');
----
MODIFY	ERS9000003	true

# Failure path: alias containing FAIL triggers the mock's success="false".
statement error
SELECT * FROM ena_modify_sample(
    secret => 'test_ena_modify_sample_mock',
    accession => 'ERS9000004',
    alias => 'modify-sample-FAIL',
    taxon_id => 408170);
----
mock validation failure

query III
SELECT action, target, success
FROM ena.submission_log
WHERE NOT success AND action = 'MODIFY' AND object_type = 'samples'
ORDER BY submitted_at DESC LIMIT 1;
----
MODIFY	ERS9000004	false

# Explicit catalog correct.
query III
SELECT action, target, success
FROM ena_modify_sample(
    secret => 'test_ena_modify_sample_mock',
    accession => 'ERS9000005',
    alias => 'modify-sample-explicit-catalog',
    taxon_id => 408170,
    catalog => 'ena');
----
MODIFY	ERS9000005	true

# Explicit catalog missing → throw.
statement error
SELECT * FROM ena_modify_sample(
    secret => 'test_ena_modify_sample_mock',
    accession => 'ERS9000006',
    alias => 'modify-sample-bad-catalog',
    taxon_id => 408170,
    catalog => 'nonexistent_catalog');
----
nonexistent_catalog

statement ok
DETACH ena;

statement ok
DROP SECRET test_ena_modify_sample_mock;
