# Failure path: alias containing FAIL triggers the mock's success="false".
statement error
SELECT * FROM ena_modify_experiment(
    secret => 'test_ena_modify_experiment_mock',
    accession => 'ERX9000004',
    alias => 'modify-experiment-FAIL',
    study_ref => 'PRJEB42',
    sample_descriptor => 'SAMEA42',
    library_strategy => 'WGS',
    library_source => 'METAGENOMIC',
    library_selection => 'RANDOM',
    platform => 'ILLUMINA',
    instrument_model => 'Illumina NovaSeq 6000');
----
mock validation failure

query III
SELECT action, target, success
FROM ena.submission_log
WHERE NOT success AND action = 'MODIFY' AND object_type = 'experiments'
ORDER BY submitted_at DESC LIMIT 1;
----
MODIFY	ERX9000004	false

# Explicit catalog correct.
query III
SELECT action, target, success
FROM ena_modify_experiment(
    secret => 'test_ena_modify_experiment_mock',
    accession => 'ERX9000005',
    alias => 'modify-experiment-explicit-catalog',
    study_ref => 'PRJEB42',
    sample_descriptor => 'SAMEA42',
    library_strategy => 'WGS',
    library_source => 'METAGENOMIC',
    library_selection => 'RANDOM',
    platform => 'ILLUMINA',
    instrument_model => 'Illumina NovaSeq 6000',
    catalog => 'ena');
----
MODIFY	ERX9000005	true

# Explicit catalog missing → throw.
statement error
SELECT * FROM ena_modify_experiment(
    secret => 'test_ena_modify_experiment_mock',
    accession => 'ERX9000006',
    alias => 'modify-experiment-bad-catalog',
    study_ref => 'PRJEB42',
    sample_descriptor => 'SAMEA42',
    library_strategy => 'WGS',
    library_source => 'METAGENOMIC',
    library_selection => 'RANDOM',
    platform => 'ILLUMINA',
    instrument_model => 'Illumina NovaSeq 6000',
    catalog => 'nonexistent_catalog');
----
nonexistent_catalog

statement ok
DETACH ena;

statement ok
DROP SECRET test_ena_modify_experiment_mock;
