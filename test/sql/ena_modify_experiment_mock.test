# name: test/sql/ena_modify_experiment_mock.test
# description: ena_modify_experiment(...) table function — Webin V2 MODIFY for experiments
# group: [sql]

require miint

require-env ENA_WEBIN_MOCK_URL

require-env MIINT_ENA_PORTAL_URL_BASE

require httpfs

statement ok
CREATE SECRET test_ena_modify_experiment_mock (
    TYPE ENA,
    USER 'Webin-99999',
    PASSWORD 'mock-password',
    ENDPOINT 'test',
    ENDPOINT_URL '${ENA_WEBIN_MOCK_URL}'
);

statement ok
ATTACH '' AS ena (TYPE ENA, SECRET 'test_ena_modify_experiment_mock');

# Happy path: MODIFY round-trips the user's ERX. era_accession is empty —
# wwwdev returns <SUBMISSION accession=""/> on MODIFY (matches L4a/L4b finding).
# study_ref + sample_descriptor each accept either an accession or a refname;
# this case uses accessions. The disambiguation is the same as the INSERT
# path's column shape.
query IIIII
SELECT action, target, success, alias, era_accession
FROM ena_modify_experiment(
    secret => 'test_ena_modify_experiment_mock',
    accession => 'ERX9000001',
    alias => 'modify-experiment-alpha',
    study_ref => 'PRJEB42',
    sample_descriptor => 'SAMEA42',
    library_strategy => 'WGS',
    library_source => 'METAGENOMIC',
    library_selection => 'RANDOM',
    library_layout => 'PAIRED',
    platform => 'ILLUMINA',
    instrument_model => 'Illumina NovaSeq 6000',
    title => 'Updated experiment title');
----
MODIFY	ERX9000001	true	modify-experiment-alpha	(empty)

# submission_log captures the request with action=MODIFY, target=ERX, and the
# per-object alias/accession lists populated from the receipt.
query IIIII
SELECT object_type, action, target, object_aliases, object_accessions
FROM ena.submission_log
WHERE action = 'MODIFY' AND target = 'ERX9000001'
ORDER BY submitted_at DESC LIMIT 1;
----
experiments	MODIFY	ERX9000001	[modify-experiment-alpha]	[ERX9000001]

# Refname-style cross-references work too. Strings that don't match any
# accession prefix-then-digits pattern route to RefDescriptor::refname (matches
# the INSERT path).
query III
SELECT action, target, success
FROM ena_modify_experiment(
    secret => 'test_ena_modify_experiment_mock',
    accession => 'ERX9000002',
    alias => 'modify-experiment-refname',
    study_ref => 'p1',
    sample_descriptor => 's1',
    library_strategy => 'WGS',
    library_source => 'METAGENOMIC',
    library_selection => 'RANDOM',
    platform => 'ILLUMINA',
    instrument_model => 'Illumina NovaSeq 6000');
----
MODIFY	ERX9000002	true

# Required parameters: accession is non-optional.
statement error
