# Whitespace-only cross-references rejected at bind. Otherwise they'd route
# through ResolveENARefDescriptor as a refname (whitespace doesn't match any
# accession prefix) and emit `<STUDY_REF refname="   "/>` to the server.
statement error
SELECT * FROM ena_modify_experiment(
    secret => 'test_ena_modify_experiment_mock',
    accession => 'ERX9000099',
    alias => 'a',
    study_ref => '   ',
    sample_descriptor => 'SAMEA42',
    library_strategy => 'WGS',
    library_source => 'METAGENOMIC',
    library_selection => 'RANDOM',
    platform => 'ILLUMINA',
    instrument_model => 'Illumina NovaSeq 6000');
----
study_ref

