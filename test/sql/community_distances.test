# name: test/sql/community_distances.test
# description: community_distances structural invariants, exact small-matrix values, id polymorphism, end-to-end into pcoa (always run; no oracle dependency)
# group: [sql]

require miint

# community_distances is part of the unifrac/ordination feature group.
require-env UNIFRAC_AVAILABLE

# Tiny sparse feature table (zeros omitted) == the 3x4 matrix pinned by the
# Catch2 pure-core test. Sorted ids s1<s2<s3 give rows:
#   s1=[1,2,0,3]  s2=[0,2,4,1]  s3=[2,0,1,1]  over features f0..f3.
statement ok
CREATE TABLE feat AS
SELECT * FROM (VALUES
  ('s1','f0',1.0),('s1','f1',2.0),('s1','f3',3.0),
  ('s2','f1',2.0),('s2','f2',4.0),('s2','f3',1.0),
  ('s3','f0',2.0),('s3','f2',1.0),('s3','f3',1.0)
) t(sample_id, feature_id, value);

# Schema: (sample_a, sample_b, distance) with VARCHAR ids for a VARCHAR feature table.
query I
SELECT count(*) FROM (
  DESCRIBE SELECT * FROM community_distances('feat', 'bray_curtis')
) WHERE (column_name='sample_a' AND column_type='VARCHAR')
     OR (column_name='sample_b' AND column_type='VARCHAR')
     OR (column_name='distance' AND column_type='DOUBLE');
----
3

# 3 samples -> 3 unordered pairs (upper triangle, each pair once).
query I
SELECT count(*) FROM community_distances('feat', 'euclidean');
----
3

# Every pair is emitted with sample_a < sample_b (lexicographic dictionary order)
# and a finite non-negative distance.
query I
SELECT count(*) FROM community_distances('feat', 'gower')
WHERE sample_a < sample_b AND distance >= 0.0 AND isfinite(distance);
----
3

# bray_curtis (s1,s2): Sum|x-y|/Sum(x+y) = 7/13.
query I
SELECT abs(distance - 7.0/13.0) < 1e-9
FROM community_distances('feat', 'bray_curtis') WHERE sample_a='s1' AND sample_b='s2';
----
true

# soergel (s1,s2): 7/10.
query I
SELECT abs(distance - 0.7) < 1e-9
FROM community_distances('feat', 'soergel') WHERE sample_a='s1' AND sample_b='s2';
----
true

# morisita_horn (s1,s2): 61/103.
query I
SELECT abs(distance - 61.0/103.0) < 1e-9
FROM community_distances('feat', 'morisita_horn') WHERE sample_a='s1' AND sample_b='s2';
----
true

# gower (PyCogent, un-normalized), all three pairs: 2.5, 2.75, 2.75.
query II
SELECT sample_a || '-' || sample_b AS pair, round(distance, 6) AS d
FROM community_distances('feat', 'gower') ORDER BY sample_a, sample_b;
----
s1-s2	2.5
s1-s3	2.75
s2-s3	2.75

# chisq is non-negative and defined (positive row sums here).
query I
SELECT count(*) FROM community_distances('feat', 'chisq') WHERE distance >= 0.0 AND isfinite(distance);
----
3

# End-to-end: the condensed output feeds pcoa unchanged (3 samples -> 3 coords/axis).
statement ok
CREATE TABLE cd AS SELECT * FROM community_distances('feat', 'bray_curtis');

query I
SELECT count(DISTINCT sample_id) FROM pcoa('cd', n_dims := 2, seed := 1);
----
3

# ── id polymorphism: BIGINT sample_id mirrors onto sample_a/sample_b ────────────
statement ok
CREATE TABLE feat_bi AS
SELECT * FROM (VALUES
  (100::BIGINT,'f0',1.0),(100::BIGINT,'f1',2.0),
  (200::BIGINT,'f1',2.0),(200::BIGINT,'f2',4.0),
  (300::BIGINT,'f0',2.0),(300::BIGINT,'f2',1.0)
) t(sample_id, feature_id, value);

query I
SELECT count(*) FROM (
  DESCRIBE SELECT * FROM community_distances('feat_bi', 'euclidean')
) WHERE (column_name='sample_a' AND column_type='BIGINT')
     OR (column_name='sample_b' AND column_type='BIGINT');
----
2

# ── identical samples -> zero distance ─────────────────────────────────────────
statement ok
CREATE TABLE feat_dup AS
SELECT * FROM (VALUES
  ('a','f0',1.0),('a','f1',2.0),('a','f3',3.0),
  ('b','f0',1.0),('b','f1',2.0),('b','f3',3.0)
) t(sample_id, feature_id, value);

query I
SELECT distance < 1e-12 FROM community_distances('feat_dup', 'euclidean');
----
true

# ── UUID id polymorphism: sample_a/sample_b mirror onto UUID ───────────────────
statement ok
CREATE TABLE feat_uuid AS
SELECT * FROM (VALUES
  ('11111111-1111-1111-1111-111111111111'::UUID,'f0',1.0),('11111111-1111-1111-1111-111111111111'::UUID,'f1',2.0),
  ('22222222-2222-2222-2222-222222222222'::UUID,'f1',2.0),('22222222-2222-2222-2222-222222222222'::UUID,'f2',4.0),
  ('33333333-3333-3333-3333-333333333333'::UUID,'f0',2.0),('33333333-3333-3333-3333-333333333333'::UUID,'f2',1.0)
) t(sample_id, feature_id, value);

query I
SELECT count(*) FROM (
  DESCRIBE SELECT * FROM community_distances('feat_uuid', 'euclidean')
) WHERE (column_name='sample_a' AND column_type='UUID')
     OR (column_name='sample_b' AND column_type='UUID');
----
2

# ── all-zero sample is dropped (sparse contract; == unifrac_distances) ──────────
# s4's only cells are 0.0; the reader drops zero cells, so s4 has no rows and is
# absent from the dictionary. Documented behavior: an all-zero sample cannot be
# distinguished from an absent one in a sparse feature table.
statement ok
CREATE TABLE feat_z AS
SELECT * FROM (VALUES
  ('s1','f0',1.0),('s1','f1',2.0),
  ('s2','f0',3.0),('s2','f1',1.0),
  ('s3','f1',2.0),('s3','f2',4.0),
  ('s4','f0',0.0),('s4','f1',0.0)
) t(sample_id, feature_id, value);

query I
SELECT count(DISTINCT s) FROM (
  SELECT sample_a s FROM community_distances('feat_z', 'bray_curtis')
  UNION SELECT sample_b FROM community_distances('feat_z', 'bray_curtis')
);
----
3

query I
SELECT count(*) FROM community_distances('feat_z', 'bray_curtis') WHERE sample_a='s4' OR sample_b='s4';
----
0

# ── pearson NaN contract: a constant profile has undefined correlation ─────────
# feature universe is exactly {f0,f1}, so p=[5,5] is a constant profile -> NaN.
statement ok
CREATE TABLE feat_const AS
SELECT * FROM (VALUES
  ('p','f0',5.0),('p','f1',5.0),
  ('q','f0',1.0),('q','f1',9.0)
) t(sample_id, feature_id, value);

query I
SELECT isnan(distance) FROM community_distances('feat_const', 'pearson');
----
true

# ── threads param: parallelism must not change a single value ──────────────────
# threads:=4 reproduces the pinned serial morisita_horn (s1,s2) = 61/103.
query I
SELECT abs(distance - 61.0/103.0) < 1e-9
FROM community_distances('feat', 'morisita_horn', threads := 4) WHERE sample_a='s1' AND sample_b='s2';
----
true

# Every pair from threads:=8 is BIT-identical to threads:=1 (0 differing rows,
# and the join is non-vacuous: all 3 pairs match). Exact `IS DISTINCT FROM`, not
# a tolerance — the parallel path writes the same value into the same slot.
query II
SELECT
  (SELECT count(*) FROM community_distances('feat','gower', threads:=8) a
     JOIN community_distances('feat','gower', threads:=1) b USING (sample_a, sample_b)
   WHERE a.distance IS DISTINCT FROM b.distance) AS differing,
  (SELECT count(*) FROM community_distances('feat','gower', threads:=8) a
     JOIN community_distances('feat','gower', threads:=1) b USING (sample_a, sample_b)) AS matched;
----
0	3

# threads:=0 means "follow DuckDB's thread count" and still emits all 3 pairs.
query I
SELECT count(*) FROM community_distances('feat', 'euclidean', threads := 0);
----
3

# ── error paths ────────────────────────────────────────────────────────────────
statement error
SELECT * FROM community_distances('feat', 'manhattan');
----
manhattan

# negative threads is rejected at bind.
statement error
SELECT * FROM community_distances('feat', 'euclidean', threads := -1);
----
threads must be >= 0

statement error
SELECT * FROM community_distances('feat', 'euclidean', 'extra');
----
