----
read_hmm: {TEST_DIR}/no_leng.hmm: model 1 (line 20): No LENG found for HMM (or LENG <= 0)

# A HMMER2 model with no NULE line, whose null model its scores are relative to.
statement ok
COPY (SELECT rtrim(regexp_replace(content, 'NULE[^\n]*\n', ''), chr(10)) FROM read_text('data/hmmer/ecori.hmm2'))
TO '{TEST_DIR}/no_nule.hmm2' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '', DELIMITER E'\x01');

statement error
SELECT * FROM read_hmm('{TEST_DIR}/no_nule.hmm2');
----
read_hmm: {TEST_DIR}/no_nule.hmm2: model 1 (line 14): No NULE line (null model emissions)

# An MM line, which HMMER3/f introduced, in a HMMER3/e model: HMMER would read no mask column.
statement ok
COPY (SELECT rtrim(replace(content, 'LENG  5', 'MM    yes' || chr(10) || 'LENG  5'), chr(10)) FROM read_text('data/hmmer/XYPPX.hmm'))
TO '{TEST_DIR}/mm_before_3f.hmm' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '', DELIMITER E'\x01');

statement error
SELECT * FROM read_hmm('{TEST_DIR}/mm_before_3f.hmm');
----
read_hmm: {TEST_DIR}/mm_before_3f.hmm: model 1 (line 5): MM line in a file older than HMMER3/f

# A last model cut off before its closing //: an error, not a model dropped.
statement ok
COPY (SELECT rtrim(content || regexp_replace(content, '//\n$', ''), chr(10)) FROM read_text('data/hmmer/XYPPX.hmm'))
TO '{TEST_DIR}/truncated.hmm' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '', DELIMITER E'\x01');

statement error
SELECT * FROM read_hmm('{TEST_DIR}/truncated.hmm');
----
read_hmm: {TEST_DIR}/truncated.hmm: model 2 (line 81): Premature end of data: missing //?

# A file that is not a profile at all.
statement ok
COPY (SELECT '>seq1 not a model' || chr(10) || 'ACGT') TO '{TEST_DIR}/not_a_model.hmm'
(FORMAT csv, HEADER false, QUOTE '', ESCAPE '', DELIMITER E'\x01');

statement error
SELECT * FROM read_hmm('{TEST_DIR}/not_a_model.hmm');
----
read_hmm: {TEST_DIR}/not_a_model.hmm: model 1 (line 1): Format tag is '>seq1': unrecognized (expected HMMER3/a to HMMER3/f, or HMMER2.0)

# And is rejected at that line, without reading on, so a large file that isn't HMMER's is never held
# in memory. This gzipped FASTA is cut off near its end: reading it through would fail there instead.
statement error
SELECT * FROM read_hmm('data/hmmer/truncated_fasta.fa.gz');
----
read_hmm: data/hmmer/truncated_fasta.fa.gz: model 1 (line 1): Format tag is '>seq1': unrecognized (expected HMMER3/a to HMMER3/f, or HMMER2.0)

# A bad second model: the model number and the line count the whole file, not the model.
statement ok
COPY (SELECT rtrim(content || replace(content, 'ALPH  amino', 'ALPH  custom'), chr(10)) FROM read_text('data/hmmer/XYPPX.hmm'))
TO '{TEST_DIR}/second_bad.hmm' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '', DELIMITER E'\x01');

statement error
SELECT * FROM read_hmm('{TEST_DIR}/second_bad.hmm');
----
read_hmm: {TEST_DIR}/second_bad.hmm: model 2 (line 47): Unrecognized alphabet type custom

# One thread reads one file after another; each file's models and lines count from 1.
statement ok
SET threads = 1;

query TI
SELECT replace(filepath, '\', '/'), count(*)
FROM read_hmm(['data/hmmer/example.hmm.gz', 'data/hmmer/XYPPX.hmm'], include_filepath := true)
GROUP BY ALL ORDER BY 1;
----
data/hmmer/XYPPX.hmm	1
data/hmmer/example.hmm.gz	2

statement error
SELECT * FROM read_hmm(['data/hmmer/example.hmm.gz', '{TEST_DIR}/second_bad.hmm']);
----
read_hmm: {TEST_DIR}/second_bad.hmm: model 2 (line 47): Unrecognized alphabet type custom

statement ok
RESET threads;

