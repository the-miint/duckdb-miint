# name: test/sql/read_hmm.test
# description: read_hmm reads profile HMMs, one row per model, and fails loudly on a malformed model
# group: [sql]

require miint

require-env HMMER_AVAILABLE

# The fixtures are HMMER's and Easel's own model files (data/hmmer/README.md). Each expected
# header value is as written in the file, and is checked field by field: a query turns a
# model's row into (field, value) pairs, every value as VARCHAR, so a FLOAT prints as the
# shortest decimal that reads back as it, and is compared exactly. A consensus is the file's
# CONS column. HMMER computes two kinds of value as it reads a model, and for those the
# expected value is what the fork's hmmconvert prints for the same file: the consensus of a
# model with no CONS column (HMMER3/b and HMMER2.0 here), and a HMMER2 model's statistics,
# compared within the precision hmmconvert prints them with.

# --- Errors: arguments ---

statement error
SELECT * FROM read_hmm('data/hmmer/does_not_exist.hmm');
----
File not found: data/hmmer/does_not_exist.hmm

statement error
SELECT * FROM read_hmm(NULL);
----
read_hmm: first argument cannot be NULL

statement error
SELECT * FROM read_hmm(42);
----
read_hmm: first argument must be VARCHAR or VARCHAR[]

statement error
SELECT * FROM read_hmm('-');
----
read_hmm: stdin is not supported

statement error
SELECT * FROM read_hmm([]::VARCHAR[]);
----
read_hmm: at least one file path must be provided

# --- Schema ---

query TT
SELECT column_name, column_type FROM (DESCRIBE SELECT * FROM read_hmm('data/hmmer/XYPPX.hmm'));
----
hmm_name	VARCHAR
hmm_accession	VARCHAR
hmm_description	VARCHAR
hmm_length	BIGINT
alphabet	VARCHAR
format	VARCHAR
max_instance_length	BIGINT
sequence_count	BIGINT
effective_sequence_count	FLOAT
checksum	UINTEGER
gathering_threshold_sequence	FLOAT
gathering_threshold_domain	FLOAT
trusted_cutoff_sequence	FLOAT
trusted_cutoff_domain	FLOAT
noise_cutoff_sequence	FLOAT
noise_cutoff_domain	FLOAT
consensus	VARCHAR
msv_mu	FLOAT
msv_lambda	FLOAT
viterbi_mu	FLOAT
viterbi_lambda	FLOAT
forward_tau	FLOAT
forward_lambda	FLOAT

