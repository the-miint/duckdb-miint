TO '{TEST_DIR}/no_name.hmm' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '', DELIMITER E'\x01');

statement error
SELECT * FROM read_hmm('{TEST_DIR}/no_name.hmm');
----
read_hmm: {TEST_DIR}/no_name.hmm: model 1 (line 40): No NAME found for HMM

# Without its cutoff lines too, which HMMER otherwise rejects first (ALPH must precede them).
statement ok
COPY (SELECT rtrim(regexp_replace(content, '\n(ALPH|GA|TC|NC) [^\n]*', '', 'g'), chr(10)) FROM read_text('data/hmmer/XYPPX.hmm'))
TO '{TEST_DIR}/no_alph.hmm' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '', DELIMITER E'\x01');

statement error
SELECT * FROM read_hmm('{TEST_DIR}/no_alph.hmm');
----
read_hmm: {TEST_DIR}/no_alph.hmm: model 1 (line 17): No alphabet defined (no ALPH line?)

statement ok
COPY (SELECT rtrim(regexp_replace(content, '\nHMM [^\n]*', ''), chr(10)) FROM read_text('data/hmmer/XYPPX.hmm'))
TO '{TEST_DIR}/no_hmm_line.hmm' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '', DELIMITER E'\x01');

statement error
SELECT * FROM read_hmm('{TEST_DIR}/no_hmm_line.hmm');
----
read_hmm: {TEST_DIR}/no_hmm_line.hmm: model 1 (line 40): Premature end of data in the header: no HMM line

# A match line cut to its node number and three of its 20 emissions.
statement ok
COPY (SELECT rtrim(regexp_replace(content, '\n      1 [^\n]*', chr(10) || '      1   0.91707  5.48468  5.65823'), chr(10)) FROM read_text('data/hmmer/XYPPX.hmm'))
TO '{TEST_DIR}/short_node.hmm' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '', DELIMITER E'\x01');

statement error
SELECT * FROM read_hmm('{TEST_DIR}/short_node.hmm');
----
read_hmm: {TEST_DIR}/short_node.hmm: model 1 (line 26): Too few probability fields on match line, node 1: expected 20, got 3

# A HMMER3 model without NSEQ has no sequence_count.
statement ok
COPY (SELECT rtrim(replace(content, 'NSEQ  7' || chr(10), ''), chr(10)) FROM read_text('data/hmmer/XYPPX.hmm'))
TO '{TEST_DIR}/no_nseq.hmm' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '', DELIMITER E'\x01');

query II
SELECT sequence_count IS NULL, effective_sequence_count FROM read_hmm('{TEST_DIR}/no_nseq.hmm');
----
true	7.0

# HMMER reads a cutoff that is not a number as 0, unchecked (atof), and read_hmm with it.
statement ok
COPY (SELECT rtrim(replace(content, 'GA    14.30 0.70' || chr(10), 'GA    xx yy;' || chr(10)), chr(10)) FROM read_text('data/hmmer/XYPPX.hmm'))
TO '{TEST_DIR}/ga_not_numbers.hmm' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '', DELIMITER E'\x01');

query III
SELECT gathering_threshold_sequence, gathering_threshold_domain, trusted_cutoff_sequence FROM read_hmm('{TEST_DIR}/ga_not_numbers.hmm');
----
0.0	0.0	14.4

# HMMER reads a model's lines, its closing // included, through Easel's NextLine, which skips
# leading whitespace (a vertical tab or form feed too) before it takes the first word. hmmstat, on
# the same files: a model closed by "\v//" and the model after it are two models; a line holding
# only "\v" between two models is blank; and "\v" before a model's format tag is skipped.
statement ok
COPY (SELECT rtrim(replace(content, chr(10) || '//', chr(10) || chr(11) || '//') || content, chr(10)) FROM read_text('data/hmmer/XYPPX.hmm'))
TO '{TEST_DIR}/vt_end.hmm' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '', DELIMITER E'\x01');

query II
SELECT count(*), count(*) FILTER (WHERE hmm_name = 'XYPPX') FROM read_hmm('{TEST_DIR}/vt_end.hmm');
----
2	2

statement ok
COPY (SELECT rtrim(content || chr(11) || chr(10) || content, chr(10)) FROM read_text('data/hmmer/XYPPX.hmm'))
TO '{TEST_DIR}/vt_blank.hmm' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '', DELIMITER E'\x01');

query II
SELECT count(*), count(*) FILTER (WHERE hmm_name = 'XYPPX') FROM read_hmm('{TEST_DIR}/vt_blank.hmm');
----
2	2

statement ok
COPY (SELECT rtrim(chr(11) || content, chr(10)) FROM read_text('data/hmmer/XYPPX.hmm'))
TO '{TEST_DIR}/vt_tag.hmm' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '', DELIMITER E'\x01');

query II
SELECT count(*), count(*) FILTER (WHERE hmm_name = 'XYPPX') FROM read_hmm('{TEST_DIR}/vt_tag.hmm');
----
1	1

# Blank and comment lines before and between models count toward the line: a comment and a blank
# line, XYPPX (lines 3 to 43), a blank line and a comment, then the bad model from line 46, whose
# ALPH line is its sixth.
statement ok
COPY (SELECT rtrim('# leading comment' || chr(10) || chr(10) || content || chr(10) || '# between models' || chr(10)
                   || replace(content, 'ALPH  amino', 'ALPH  custom'), chr(10))
      FROM read_text('data/hmmer/XYPPX.hmm'))
TO '{TEST_DIR}/comments_bad.hmm' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '', DELIMITER E'\x01');

statement error
SELECT * FROM read_hmm('{TEST_DIR}/comments_bad.hmm');
----
read_hmm: {TEST_DIR}/comments_bad.hmm: model 2 (line 51): Unrecognized alphabet type custom

# More models than one output vector holds (2048), and a defect past the first vector, so the
# model number and line are checked where a per-chunk counter would reset. XYPPX.hmm is 41
# lines: model 2050 starts at line 2049 * 41 + 1, and its ALPH line is its sixth.
statement ok
COPY (SELECT rtrim(string_agg(content, '' ORDER BY i), chr(10)) FROM read_text('data/hmmer/XYPPX.hmm'), range(2100) t(i))
TO '{TEST_DIR}/many.hmm' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '', DELIMITER E'\x01');

query III
SELECT count(*), count(DISTINCT hmm_name), sum(hmm_length) FROM read_hmm('{TEST_DIR}/many.hmm');
----
2100	1	10500

statement ok
COPY (SELECT rtrim(string_agg(CASE WHEN i = 2049 THEN replace(content, 'ALPH  amino', 'ALPH  custom') ELSE content END, '' ORDER BY i), chr(10))
      FROM read_text('data/hmmer/XYPPX.hmm'), range(2100) t(i))
TO '{TEST_DIR}/many_damaged.hmm' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '', DELIMITER E'\x01');

statement error
SELECT count(*) FROM read_hmm('{TEST_DIR}/many_damaged.hmm');
----
read_hmm: {TEST_DIR}/many_damaged.hmm: model 2050 (line 84015): Unrecognized alphabet type custom

# A query stops at max_execution_time even partway through one output chunk: HMMER calibrates a
# HMMER2 model as it reads it, a millisecond or more a model, so these 2000 models, which fit one
# chunk, take seconds on one thread. read_hmm checks the deadline between models.
statement ok
COPY (SELECT rtrim(string_agg(content, '' ORDER BY i), chr(10)) FROM read_text('data/hmmer/ecori.hmm2'), range(2000) t(i))
TO '{TEST_DIR}/many_hmmer2.hmm' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '', DELIMITER E'\x01');

statement ok
SET threads = 1;

statement ok
SET max_execution_time = 200;

statement error
SELECT count(*) FROM read_hmm('{TEST_DIR}/many_hmmer2.hmm');
----
Query exceeded maximum execution time

statement ok
RESET max_execution_time;

statement ok
RESET threads;
