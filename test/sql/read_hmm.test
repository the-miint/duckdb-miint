# HMMER2 has no EFFN or MAXL, and HMMER ignores its CKSUM, which is a different checksum:
# all three are NULL. Every HMMER2 consensus is computed. The statistics are checked below.
query TT
FROM (SELECT COLUMNS(* EXCLUDE (msv_mu, msv_lambda, viterbi_mu, viterbi_lambda, forward_tau, forward_lambda))::VARCHAR
      FROM read_hmm('data/hmmer/example.hmm2.gz') WHERE hmm_name = 'Orn_DAP_Arg_deC')
UNPIVOT INCLUDE NULLS (value FOR field IN (COLUMNS(*)));
----
