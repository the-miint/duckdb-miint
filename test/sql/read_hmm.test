# A HMMER2 model's statistics are calibrated by HMMER as it reads the model, as hmmconvert
# does. Each must be within the precision hmmconvert prints it with: mu and tau to 4
# decimals, lambda to 5. This runs HMMER's SIMD filters, on whichever implementation the
# build uses.
query TT
SELECT r.hmm_name,
       abs(r.msv_mu::DOUBLE - e.msv_mu) <= 0.00005 AND abs(r.msv_lambda::DOUBLE - e.msv_lambda) <= 0.000005
       AND abs(r.viterbi_mu::DOUBLE - e.viterbi_mu) <= 0.00005 AND abs(r.viterbi_lambda::DOUBLE - e.viterbi_lambda) <= 0.000005
       AND abs(r.forward_tau::DOUBLE - e.forward_tau) <= 0.00005 AND abs(r.forward_lambda::DOUBLE - e.forward_lambda) <= 0.000005
FROM read_hmm(['data/hmmer/example.hmm2.gz', 'data/hmmer/ecori.hmm2']) r
JOIN (VALUES ('Orn_DAP_Arg_deC', -9.0990, 0.70304, -9.4619, 0.70304, -5.4947, 0.70304),
             ('NIF3', -10.4048, 0.69634, -10.7694, 0.69634, -6.5945, 0.69634),
             ('ecori', -8.4900, 1.84961, -8.7980, 1.84961, -0.8137, 1.84961))
     e(hmm_name, msv_mu, msv_lambda, viterbi_mu, viterbi_lambda, forward_tau, forward_lambda)
ON r.hmm_name = e.hmm_name
ORDER BY r.hmm_name;
----
NIF3	true
Orn_DAP_Arg_deC	true
ecori	true

# HMMER's own programs refuse a file whose alphabet changes from one model to the next.
# read_hmm reads each model on its own, so a file may mix alphabets and format versions.
statement ok
COPY (SELECT rtrim(x.content || h2.content, chr(10))
      FROM read_text('data/hmmer/XYPPX.hmm') x, read_text('data/hmmer/ecori.hmm2') h2)
TO '{TEST_DIR}/mixed.hmm' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '', DELIMITER E'\x01');

query TTTT
SELECT hmm_name, format, alphabet, consensus FROM read_hmm('{TEST_DIR}/mixed.hmm');
----
XYPPX	HMMER3/e	amino	GYPPq
ecori	HMMER2.0	DNA	gaattc

# --- Inputs ---

# gzip is read transparently and changes nothing.
query I
SELECT count(*) FROM (
    SELECT * FROM read_hmm('data/hmmer/XYPPX.hmm')
    EXCEPT
    SELECT * FROM read_hmm('data/hmmer/XYPPX.hmm.gz'));
----
0

query I
SELECT count(*) FROM (
    SELECT * FROM read_hmm('data/hmmer/XYPPX.hmm.gz')
    EXCEPT
    SELECT * FROM read_hmm('data/hmmer/XYPPX.hmm'));
----
0

# Nor do Windows line endings.
statement ok
COPY (SELECT rtrim(replace(content, chr(10), chr(13) || chr(10)), chr(10)) FROM read_text('data/hmmer/XYPPX.hmm'))
TO '{TEST_DIR}/crlf.hmm' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '', DELIMITER E'\x01');

query I
SELECT count(*) FROM (
    SELECT * FROM read_hmm('{TEST_DIR}/crlf.hmm')
    EXCEPT
    SELECT * FROM read_hmm('data/hmmer/XYPPX.hmm'));
----
0

query II
SELECT count(*), count(*) FILTER (WHERE hmm_name = 'XYPPX') FROM read_hmm('{TEST_DIR}/crlf.hmm');
----
1	1

query I
SELECT count(*) FROM (
    SELECT * FROM read_hmm('data/hmmer/XYPPX.hmm')
    EXCEPT
    SELECT * FROM read_hmm('{TEST_DIR}/crlf.hmm'));
----
0

query TI
SELECT replace(filepath, '\', '/'), count(*)
FROM read_hmm('data/hmmer/XYPPX.hmm*', include_filepath := true)
GROUP BY ALL ORDER BY 1;
----
data/hmmer/XYPPX.hmm	1
data/hmmer/XYPPX.hmm.gz	1

# globins4, fn3, Pkinase, MADE1, two in example.hmm.gz, and XYPPX.
query I
SELECT count(*) FROM read_hmm('data/hmmer/*.hmm.gz');
----
7

query I
SELECT count(*) FROM read_hmm(['data/hmmer/example.hmm.gz', 'data/hmmer/example.hmm2.gz', 'data/hmmer/ecori.hmm2']);
----
5

# The scan has a row estimate that grows with the files, not DuckDB's default of one row (why:
# EstimateFileScanCardinality in src/include/table_function_common.hpp).
query II
EXPLAIN SELECT * FROM read_hmm('data/hmmer/*.gz');
----
physical_plan	<!REGEX>:.*~1 row.*

# A model per 1000 bytes: XYPPX.hmm is 3399 bytes.
query II
EXPLAIN SELECT * FROM read_hmm('data/hmmer/XYPPX.hmm');
----
physical_plan	<REGEX>:.*~3 rows.*

# A file with no model in it, empty or holding only blank and comment lines, gives no rows.
# HMMER reads a line starting with # as a comment, and so does read_hmm.
statement ok
COPY (SELECT 'unused' AS line WHERE false) TO '{TEST_DIR}/empty.hmm'
(FORMAT csv, HEADER false, QUOTE '', ESCAPE '', DELIMITER E'\x01');

statement ok
COPY (SELECT chr(10) || '   ' || chr(10) || '# no models here') TO '{TEST_DIR}/blank.hmm'
(FORMAT csv, HEADER false, QUOTE '', ESCAPE '', DELIMITER E'\x01');

query II
SELECT (SELECT count(*) FROM read_hmm('{TEST_DIR}/empty.hmm')), (SELECT count(*) FROM read_hmm('{TEST_DIR}/blank.hmm'));
----
0	0

# Blank and comment lines after the last model are not a model either.
statement ok
COPY (SELECT content || chr(10) || '# end of models' || chr(10) FROM read_text('data/hmmer/XYPPX.hmm'))
TO '{TEST_DIR}/trailing_comment.hmm' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '', DELIMITER E'\x01');

query I
SELECT count(*) FROM read_hmm('{TEST_DIR}/trailing_comment.hmm');
----
1

# --- Malformed models ---

# Each is written here from XYPPX.hmm, or ecori.hmm2 for HMMER2, so the defect sits beside its
# assertion; COPY ends the text with one newline. Every message names the function, the file,
# the model's number in the file and the line HMMER stopped at, then HMMER's own message.

# A cutoff line before ALPH: HMMER needs the alphabet to know how many values the line holds.
statement ok
COPY (SELECT rtrim(replace(content, 'ALPH  amino', 'GA    25.00 25.00' || chr(10) || 'ALPH  amino'), chr(10))
      FROM read_text('data/hmmer/XYPPX.hmm'))
TO '{TEST_DIR}/ga_before_alph.hmm' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '', DELIMITER E'\x01');

statement error
SELECT * FROM read_hmm('{TEST_DIR}/ga_before_alph.hmm');
----
read_hmm: {TEST_DIR}/ga_before_alph.hmm: model 1 (line 6): ALPH must precede GA

statement ok
COPY (SELECT rtrim(replace(content, 'ALPH  amino', 'TC    25.00 25.00' || chr(10) || 'ALPH  amino'), chr(10))
      FROM read_text('data/hmmer/XYPPX.hmm'))
TO '{TEST_DIR}/tc_before_alph.hmm' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '', DELIMITER E'\x01');

statement error
SELECT * FROM read_hmm('{TEST_DIR}/tc_before_alph.hmm');
----
read_hmm: {TEST_DIR}/tc_before_alph.hmm: model 1 (line 6): ALPH must precede TC

statement ok
COPY (SELECT rtrim(replace(content, 'ALPH  amino', 'NC    25.00 25.00' || chr(10) || 'ALPH  amino'), chr(10))
      FROM read_text('data/hmmer/XYPPX.hmm'))
TO '{TEST_DIR}/nc_before_alph.hmm' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '', DELIMITER E'\x01');

statement error
SELECT * FROM read_hmm('{TEST_DIR}/nc_before_alph.hmm');
----
read_hmm: {TEST_DIR}/nc_before_alph.hmm: model 1 (line 6): ALPH must precede NC

# An alphabet Easel has no name for.
