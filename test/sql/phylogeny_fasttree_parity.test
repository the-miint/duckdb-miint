# Internal branch length sum match within tolerance scaled to the sum.
query I
WITH sums AS (
    SELECT
        (SELECT coalesce(sum(branch_length), 0) FROM moderate_miint  WHERE NOT is_tip AND parent_index IS NOT NULL) AS m_sum,
        (SELECT coalesce(sum(branch_length), 0) FROM moderate_golden WHERE NOT is_tip AND parent_index IS NOT NULL) AS g_sum
)
SELECT abs(m_sum - g_sum) <= greatest(1e-9, 1e-6 * greatest(abs(m_sum), abs(g_sum))) FROM sums;
