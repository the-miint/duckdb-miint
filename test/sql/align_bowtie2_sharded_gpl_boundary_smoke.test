# name: test/sql/align_bowtie2_sharded_gpl_boundary_smoke.test
# description: Phase 5 smoke test for align_bowtie2_sharded over the gpl-boundary daemon. Deleted at end of Phase 6 once the full sharded suite re-engages.
# group: [sql]

require miint

require-env GPL_BOUNDARY_AVAILABLE

# Match the sqllogictest-framework convention used by align_bowtie2_sharded.test.
statement ok
SET threads=1;

statement ok
CREATE TABLE queries AS SELECT * FROM (VALUES
    ('q1', 'ACGTACGTACGTACGTACGTACGTACGTACGTACGTACGTACGTACGTACGT'),
    ('q2', 'TGCATGCATGCATGCATGCATGCATGCATGCATGCATGCATGCATGCATGCA')
) AS t(read_id, sequence1);

statement ok
CREATE TABLE rts AS SELECT * FROM (VALUES
    ('q1', 'shard_a'),
    ('q2', 'shard_b')
) AS t(read_id, shard_name);

# Basic sharded alignment: each read lands in its respective shard's reference.
# Filter out unmapped (flags & 4) so the test doesn't depend on whether the
# daemon also emits no-alignment records.
query II
SELECT read_id, reference
FROM align_bowtie2_sharded('queries',
    shard_directory := 'data/bowtie2_shards/',
    read_to_shard := 'rts',
    max_secondary := 0)
WHERE flags & 4 = 0
ORDER BY read_id;
----
q1	ref1
q2	ref2

# include_shard_name = true synthesizes a shard_name column on output.
query III
SELECT read_id, reference, shard_name
FROM align_bowtie2_sharded('queries',
    shard_directory := 'data/bowtie2_shards/',
    read_to_shard := 'rts',
    include_shard_name := true,
    max_secondary := 0)
WHERE flags & 4 = 0
ORDER BY read_id;
----
q1	ref1	shard_a
q2	ref2	shard_b

statement ok
DROP TABLE queries;

statement ok
DROP TABLE rts;
