# name: test/sql/copy_biom.test
# description: Test COPY FORMAT BIOM
# group: [sql]

require miint

require-env HDF5_AVAILABLE

# Test 1: Basic BIOM write and read-back (round-trip)
statement ok
CREATE TABLE test_biom_basic AS
SELECT * FROM (VALUES
    ('Feature1', 'Sample1', 1.0::DOUBLE),
    ('Feature1', 'Sample2', 2.0::DOUBLE),
    ('Feature2', 'Sample1', 3.0::DOUBLE)
) AS t(feature_id, sample_id, value);

statement ok
COPY (SELECT feature_id, sample_id, value FROM test_biom_basic ORDER BY feature_id, sample_id)
TO '{TEST_DIR}/output1.biom' (FORMAT BIOM);

query TTR
SELECT feature_id, sample_id, value FROM read_biom('{TEST_DIR}/output1.biom')
ORDER BY feature_id, sample_id;
----
Feature1	Sample1	1.0
Feature1	Sample2	2.0
Feature2	Sample1	3.0

# Test 2: Single value
statement ok
CREATE TABLE test_biom_single AS SELECT 'F1' as feature_id, 'S1' as sample_id, 5.0::DOUBLE as value;

statement ok
COPY (SELECT feature_id, sample_id, value FROM test_biom_single)
TO '{TEST_DIR}/output2.biom' (FORMAT BIOM);

query TTR
SELECT feature_id, sample_id, value FROM read_biom('{TEST_DIR}/output2.biom');
----
F1	S1	5.0

# Test 3: Empty table (0 rows)
statement ok
CREATE TABLE test_biom_empty (feature_id VARCHAR, sample_id VARCHAR, value DOUBLE);

statement ok
COPY (SELECT feature_id, sample_id, value FROM test_biom_empty)
TO '{TEST_DIR}/output3.biom' (FORMAT BIOM);

query I
SELECT COUNT(*) FROM read_biom('{TEST_DIR}/output3.biom');
----
0

# Test 4: Duplicate handling (should merge duplicates via compression)
statement ok
CREATE TABLE test_biom_dups AS
SELECT * FROM (VALUES
    ('F1', 'S1', 1.0::DOUBLE),
    ('F1', 'S1', 3.0::DOUBLE),
    ('F2', 'S2', 2.0::DOUBLE)
) AS t(feature_id, sample_id, value);

statement ok
COPY (SELECT feature_id, sample_id, value FROM test_biom_dups)
TO '{TEST_DIR}/output4.biom' (FORMAT BIOM);

query TTR
SELECT feature_id, sample_id, value FROM read_biom('{TEST_DIR}/output4.biom')
ORDER BY feature_id, sample_id;
----
F1	S1	4.0
F2	S2	2.0

# Test 5: Zeros should be removed during compression
statement ok
CREATE TABLE test_biom_zeros AS
SELECT * FROM (VALUES
    ('F1', 'S1', 1.0::DOUBLE),
    ('F1', 'S2', 0.0::DOUBLE),
    ('F2', 'S1', 2.0::DOUBLE),
    ('F2', 'S2', 0.0::DOUBLE)
) AS t(feature_id, sample_id, value);

statement ok
COPY (SELECT feature_id, sample_id, value FROM test_biom_zeros)
TO '{TEST_DIR}/output5.biom' (FORMAT BIOM);

query TTR
SELECT feature_id, sample_id, value FROM read_biom('{TEST_DIR}/output5.biom')
ORDER BY feature_id, sample_id;
----
F1	S1	1.0
F2	S1	2.0

# Test 6: Duplicates with zeros (sum to zero = removed)
statement ok
CREATE TABLE test_biom_dup_zeros AS
SELECT * FROM (VALUES
    ('F1', 'S1', 1.0::DOUBLE),
    ('F1', 'S1', -1.0::DOUBLE),
    ('F2', 'S2', 5.0::DOUBLE)
) AS t(feature_id, sample_id, value);

statement ok
COPY (SELECT feature_id, sample_id, value FROM test_biom_dup_zeros)
TO '{TEST_DIR}/output6.biom' (FORMAT BIOM);

query TTR
SELECT feature_id, sample_id, value FROM read_biom('{TEST_DIR}/output6.biom')
ORDER BY feature_id, sample_id;
----
F2	S2	5.0

# Test 7: With COMPRESSION parameter (HDF5 internal compression)
statement ok
COPY (SELECT feature_id, sample_id, value FROM test_biom_basic)
TO '{TEST_DIR}/output7.biom' (FORMAT BIOM, COMPRESSION 'gzip');

query TTR
SELECT feature_id, sample_id, value FROM read_biom('{TEST_DIR}/output7.biom')
ORDER BY feature_id, sample_id;
----
Feature1	Sample1	1.0
Feature1	Sample2	2.0
Feature2	Sample1	3.0

# Test 8: With custom ID parameter
statement ok
COPY (SELECT feature_id, sample_id, value FROM test_biom_basic)
TO '{TEST_DIR}/output8.biom' (FORMAT BIOM, ID 'MyCustomID');

query TTR
SELECT feature_id, sample_id, value FROM read_biom('{TEST_DIR}/output8.biom')
ORDER BY feature_id, sample_id;
----
Feature1	Sample1	1.0
Feature1	Sample2	2.0
Feature2	Sample1	3.0

# Test 9: With custom GENERATED_BY parameter
statement ok
COPY (SELECT feature_id, sample_id, value FROM test_biom_basic)
TO '{TEST_DIR}/output9.biom' (FORMAT BIOM, GENERATED_BY 'MyTool v1.0');

query TTR
SELECT feature_id, sample_id, value FROM read_biom('{TEST_DIR}/output9.biom')
ORDER BY feature_id, sample_id;
----
Feature1	Sample1	1.0
Feature1	Sample2	2.0
Feature2	Sample1	3.0

# Test 10: Larger table with more features and samples
statement ok
CREATE TABLE test_biom_larger AS
SELECT
    'Feature' || (i % 10)::VARCHAR as feature_id,
    'Sample' || (i % 5)::VARCHAR as sample_id,
    (i * 1.5)::DOUBLE as value
FROM range(50) t(i)
WHERE (i % 7) != 0;

statement ok
COPY (SELECT feature_id, sample_id, value FROM test_biom_larger)
TO '{TEST_DIR}/output10.biom' (FORMAT BIOM);

query I
SELECT COUNT(*) FROM read_biom('{TEST_DIR}/output10.biom');
----
10

# Test 11: Table with additional columns (only select required columns)
statement ok
CREATE TABLE test_biom_extra_cols AS
SELECT * FROM (VALUES
    ('F1', 'S1', 1.0::DOUBLE, 'metadata1', 100),
    ('F1', 'S2', 2.0::DOUBLE, 'metadata2', 200),
    ('F2', 'S1', 3.0::DOUBLE, 'metadata3', 300)
) AS t(feature_id, sample_id, value, description, count);

statement ok
COPY (SELECT feature_id, sample_id, value FROM test_biom_extra_cols ORDER BY feature_id, sample_id)
TO '{TEST_DIR}/output11.biom' (FORMAT BIOM);

query TTR
SELECT feature_id, sample_id, value FROM read_biom('{TEST_DIR}/output11.biom')
ORDER BY feature_id, sample_id;
----
F1	S1	1.0
F1	S2	2.0
F2	S1	3.0

# Test 12: Verify correct ordering is preserved (feature/sample IDs in first-appearance order)
statement ok
CREATE TABLE test_biom_order AS
SELECT * FROM (VALUES
    ('Zebra', 'Alpha', 1.0::DOUBLE),
    ('Apple', 'Zulu', 2.0::DOUBLE),
    ('Zebra', 'Zulu', 3.0::DOUBLE),
    ('Apple', 'Alpha', 4.0::DOUBLE)
) AS t(feature_id, sample_id, value);

statement ok
COPY (SELECT feature_id, sample_id, value FROM test_biom_order)
TO '{TEST_DIR}/output12.biom' (FORMAT BIOM);

query TTR
SELECT feature_id, sample_id, value FROM read_biom('{TEST_DIR}/output12.biom')
ORDER BY feature_id, sample_id;
----
Apple	Alpha	4.0
Apple	Zulu	2.0
Zebra	Alpha	1.0
Zebra	Zulu	3.0

# Test 13: Error - missing feature_id column
statement error
COPY (SELECT sample_id, value FROM test_biom_basic)
TO '{TEST_DIR}/error1.biom' (FORMAT BIOM);
----
feature_id

# Test 14: Error - missing sample_id column
statement error
COPY (SELECT feature_id, value FROM test_biom_basic)
TO '{TEST_DIR}/error2.biom' (FORMAT BIOM);
----
sample_id

# Test 15: Error - missing value column
statement error
COPY (SELECT feature_id, sample_id FROM test_biom_basic)
TO '{TEST_DIR}/error3.biom' (FORMAT BIOM);
----
value

# Test 16: Error - NULL in feature_id
statement error
COPY (SELECT NULL::VARCHAR as feature_id, 'S1' as sample_id, 1.0::DOUBLE as value)
TO '{TEST_DIR}/error4.biom' (FORMAT BIOM);
----
NULL

# Test 17: Error - NULL in sample_id
statement error
COPY (SELECT 'F1' as feature_id, NULL::VARCHAR as sample_id, 1.0::DOUBLE as value)
TO '{TEST_DIR}/error5.biom' (FORMAT BIOM);
----
NULL

# Test 18: Error - NULL in value
statement error
COPY (SELECT 'F1' as feature_id, 'S1' as sample_id, NULL::DOUBLE as value)
TO '{TEST_DIR}/error6.biom' (FORMAT BIOM);
----
NULL

# feature_id and sample_id are ids, so each takes VARCHAR, BIGINT or UUID, as a read_id does, and is
# written as its text: BIGINT in decimal, UUID in the lowercase hyphenated form. The two columns here
# have different types, so reading one with the other's type would show.
statement ok
COPY (SELECT * FROM (VALUES (10::BIGINT, 'A0EEBC99-9C0B-4EF8-BB6D-6BB9BD380A11'::UUID, 1.0::DOUBLE),
                            (-5::BIGINT, 'A0EEBC99-9C0B-4EF8-BB6D-6BB9BD380A11'::UUID, 2.0::DOUBLE),
                            (10::BIGINT, '00000000-0000-0000-0000-000000000001'::UUID, 3.0::DOUBLE))
      AS t(feature_id, sample_id, value))
TO '{TEST_DIR}/id_types.biom' (FORMAT BIOM);

query TTR
SELECT feature_id, sample_id, value FROM read_biom('{TEST_DIR}/id_types.biom') ORDER BY value;
----
10	a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11	1.0
-5	a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11	2.0
10	00000000-0000-0000-0000-000000000001	3.0

# A NULL id is refused whatever its type.
statement error
COPY (SELECT NULL::BIGINT AS feature_id, 'S1' AS sample_id, 1.0::DOUBLE AS value) TO '{TEST_DIR}/null_bigint.biom' (FORMAT BIOM);
----
NULL values not allowed in feature_id column

statement error
COPY (SELECT 'F1' AS feature_id, NULL::UUID AS sample_id, 1.0::DOUBLE AS value) TO '{TEST_DIR}/null_uuid.biom' (FORMAT BIOM);
----
NULL values not allowed in sample_id column

# Any other type is refused when the COPY is planned, naming the column and the types it takes. An untyped
# integer literal is INTEGER, and an untyped decimal literal is DECIMAL, not DOUBLE.
statement error
COPY (SELECT 1 AS feature_id, 'S1' AS sample_id, 1.0::DOUBLE AS value) TO '{TEST_DIR}/int_id.biom' (FORMAT BIOM);
----
Binder Error: COPY FORMAT BIOM: column 'feature_id' must be VARCHAR, BIGINT, or UUID, got INTEGER

statement error
COPY (SELECT 'F1' AS feature_id, 'S1'::BLOB AS sample_id, 1.0::DOUBLE AS value) TO '{TEST_DIR}/blob_id.biom' (FORMAT BIOM);
----
Binder Error: COPY FORMAT BIOM: column 'sample_id' must be VARCHAR, BIGINT, or UUID, got BLOB

statement error
COPY (SELECT 'F1' AS feature_id, 'S1' AS sample_id, 1.0 AS value) TO '{TEST_DIR}/decimal_value.biom' (FORMAT BIOM);
----
Binder Error: COPY FORMAT BIOM: column 'value' must be DOUBLE, got DECIMAL(2,1)

# Test 19: Error - invalid COMPRESSION parameter
statement error
COPY (SELECT feature_id, sample_id, value FROM test_biom_basic)
TO '{TEST_DIR}/error7.biom' (FORMAT BIOM, COMPRESSION 'invalid');
----
Binder Error: COMPRESSION must be 'gzip', 'gz', 'none' or 'uncompressed', got 'invalid'

# COMPRESSION takes the values it takes in the text formats, in any case: 'gzip' or 'gz', and 'none' or
# 'uncompressed'. HDF5 has no zstd filter here, so zstd is refused as any other value is.
statement error
COPY test_biom_basic TO '{TEST_DIR}/zstd.biom' (FORMAT BIOM, COMPRESSION 'zstd');
----
Binder Error: COMPRESSION must be 'gzip', 'gz', 'none' or 'uncompressed', got 'zstd'

statement ok
CREATE TABLE biom_compressible AS
SELECT 'F' || (r % 50) AS feature_id, 'S' || (r // 50) AS sample_id, (r + 1)::DOUBLE AS value FROM range(2000) t(r);

foreach comp gzip GZ none Uncompressed

statement ok
COPY biom_compressible TO '{TEST_DIR}/comp_{comp}.biom' (FORMAT BIOM, COMPRESSION '{comp}');

query IR
SELECT count(*), sum(value) FROM read_biom('{TEST_DIR}/comp_{comp}.biom');
----
2000	2001000.0

endloop

# 'uncompressed' writes what 'none' writes, and 'gz' what 'gzip' writes; the gzip file is the smaller.
query III
SELECT max(size) FILTER (filename LIKE '%comp_none.biom') = max(size) FILTER (filename LIKE '%comp_Uncompressed.biom'),
       max(size) FILTER (filename LIKE '%comp_gzip.biom') = max(size) FILTER (filename LIKE '%comp_GZ.biom'),
       max(size) FILTER (filename LIKE '%comp_gzip.biom') < max(size) FILTER (filename LIKE '%comp_none.biom')
FROM read_blob('{TEST_DIR}/comp_*.biom');
----
true	true	true

statement ok
DROP TABLE biom_compressible;

# Test 20: Error - cannot overwrite existing file (file exists protection)
statement ok
COPY (SELECT feature_id, sample_id, value FROM test_biom_basic)
TO '{TEST_DIR}/output_overwrite_test.biom' (FORMAT BIOM);

statement error
COPY (SELECT feature_id, sample_id, value FROM test_biom_basic)
TO '{TEST_DIR}/output_overwrite_test.biom' (FORMAT BIOM);
----
Cannot overwrite existing file

# DuckDB binds a prepared COPY again at EXECUTE, so a file made after PREPARE is refused too, and left as it
# was.
statement ok
PREPARE biom_planned_early AS COPY test_biom_single TO '{TEST_DIR}/made_after_prepare.biom' (FORMAT BIOM);

statement ok
COPY test_biom_basic TO '{TEST_DIR}/made_after_prepare.biom' (FORMAT BIOM);

statement error
EXECUTE biom_planned_early;
----
Cannot overwrite existing file

query TTR
SELECT feature_id, sample_id, value FROM read_biom('{TEST_DIR}/made_after_prepare.biom') ORDER BY ALL;
----
Feature1	Sample1	1.0
Feature1	Sample2	2.0
Feature2	Sample1	3.0

# An option BIOM does not have is refused and named, and GENERATED_BY with no value is refused.
statement error
COPY (SELECT feature_id, sample_id, value FROM test_biom_single) TO '{TEST_DIR}/bogus.biom' (FORMAT BIOM, BOGUS 1);
----
Unrecognized option "bogus"

statement error
COPY (SELECT feature_id, sample_id, value FROM test_biom_single) TO '{TEST_DIR}/bare.biom' (FORMAT BIOM, GENERATED_BY);
----
<REGEX>:.*Copy option "?generated_by"? requires an argument of type VARCHAR.*

# The HDF5 writer writes local files only, so a remote target is refused at bind.
statement error
COPY (SELECT feature_id, sample_id, value FROM test_biom_single) TO 'foo://miint-test/x.biom' (FORMAT BIOM);
----
COPY FORMAT BIOM writes local files only

# A file:// target is the local file it names: BIOM writes the path DuckDB resolves for the COPY, as
# every other format does, so HDF5 is handed a plain path.
statement ok
SET VARIABLE abs_test_dir = CASE WHEN '{TEST_DIR}' LIKE '/%' THEN '{TEST_DIR}' ELSE '{WORKING_DIRECTORY}/{TEST_DIR}' END;

statement ok
COPY test_biom_basic TO ('file://' || getvariable('abs_test_dir') || '/uri.biom') (FORMAT BIOM);

query III
SELECT feature_id, sample_id, value FROM read_biom('{TEST_DIR}/uri.biom') ORDER BY ALL;
----
Feature1	Sample1	1.0
Feature1	Sample2	2.0
Feature2	Sample1	3.0

# HDF5's failures name the file and HDF5's reason, rather than escaping as an unknown exception.
statement error
COPY test_biom_basic TO '{TEST_DIR}/no_such_dir/x.biom' (FORMAT BIOM);
----
<REGEX>:IO Error: COPY FORMAT BIOM: cannot write '.*no_such_dir/x\.biom': H5Fcreate failed: No such file or directory.*

# PARTITION_BY writes a .biom file per partition, and DuckDB finalizes the partitions' files at once
# (by its own scheduling, whatever the thread count). Every HDF5 call is serialized, so none of them
# fails or corrupts another; the write is repeated so that a lost serialization fails this test almost
# surely, not now and then. Each partition holds 25 features (i % 50 has the parity of i % 8) by 7 samples.
loop run 0 10

statement ok
COPY (SELECT 'F' || (i % 50) AS feature_id, 'S' || (i % 7) AS sample_id, 1.0::DOUBLE AS value, i % 8 AS grp
      FROM range(200000) t(i))
TO '{TEST_DIR}/biom_parts_${run}' (FORMAT BIOM, PARTITION_BY (grp));

query III
SELECT count(DISTINCT filepath), count(*), sum(value)
FROM read_biom('{TEST_DIR}/biom_parts_${run}/*/*.biom', include_filepath := true);
----
8	1400	200000.0

endloop

# PER_THREAD_OUTPUT writes a .biom file per thread that sinks rows. range() runs on one thread, so the
# rows come from a table of more than three row groups, which four threads scan.
statement ok
SET threads = 4;

statement ok
CREATE TABLE biom_many AS
SELECT 'F' || (i % 50) AS feature_id, 'S' || (i % 7) AS sample_id, 1.0::DOUBLE AS value FROM range(500000) t(i);

statement ok
COPY biom_many TO '{TEST_DIR}/biom_threads' (FORMAT BIOM, PER_THREAD_OUTPUT true);

query II
SELECT count(DISTINCT filepath) > 1, sum(value) FROM read_biom('{TEST_DIR}/biom_threads/*.biom', include_filepath := true);
----
true	500000.0

statement ok
RESET threads;

statement ok
DROP TABLE biom_many;

# OVERWRITE_OR_IGNORE replaces a partition's file of the same name, as that option asks: the writer does not
# refuse an existing file itself, so this is DuckDB's rule, and a single target is refused at bind instead.
statement ok
COPY (SELECT 'F1' AS feature_id, 'S1' AS sample_id, 1.0::DOUBLE AS value, 1 AS grp) TO '{TEST_DIR}/biom_replaced' (FORMAT BIOM, PARTITION_BY (grp));

statement ok
COPY (SELECT 'F2' AS feature_id, 'S2' AS sample_id, 9.0::DOUBLE AS value, 1 AS grp) TO '{TEST_DIR}/biom_replaced' (FORMAT BIOM, PARTITION_BY (grp), OVERWRITE_OR_IGNORE);

query TTR
SELECT feature_id, sample_id, value FROM read_biom('{TEST_DIR}/biom_replaced/*/*.biom');
----
F2	S2	9.0

# Test 21: concurrent COPY TO BIOM and read_biom return correct values
concurrentloop i 0 8

loop j 0 10

statement ok
COPY (SELECT 'F' || (r % 50) AS feature_id, 'S' || (r // 50) AS sample_id, (r + 1)::DOUBLE AS value FROM range(2000) t(r))
TO '{TEST_DIR}/concurrent_{i}_{j}.biom' (FORMAT BIOM);

query IIIR
SELECT COUNT(*), COUNT(DISTINCT feature_id), COUNT(DISTINCT sample_id), SUM(value) FROM read_biom('{TEST_DIR}/concurrent_{i}_{j}.biom');
----
2000	50	40	2001000.0

query IR
SELECT COUNT(*), SUM(value) FROM read_biom('data/biom/test.biom');
----
15	27.0

endloop

endloop

# Cleanup
statement ok
DROP TABLE test_biom_basic;

statement ok
DROP TABLE test_biom_single;

statement ok
DROP TABLE test_biom_empty;

statement ok
DROP TABLE test_biom_dups;

statement ok
DROP TABLE test_biom_zeros;

statement ok
DROP TABLE test_biom_dup_zeros;

statement ok
DROP TABLE test_biom_larger;

statement ok
DROP TABLE test_biom_extra_cols;

statement ok
DROP TABLE test_biom_order;
