# name: test/sql/align_sortmerna.test
# description: Test align_sortmerna (SAM schema) table function
# group: [sql]

require miint

require-env SORTMERNA_AVAILABLE

statement ok
CREATE TABLE smr_q (read_id VARCHAR, sequence1 VARCHAR);

# --- Output schema matches the shared alignment SAM schema ---
query II
SELECT column_name, column_type FROM (
    DESCRIBE SELECT * FROM align_sortmerna(
        'smr_q', ref_paths := ['ext/sortmerna/data/test_ref.fasta'])
) ORDER BY column_name;
----
cigar	VARCHAR
flags	USMALLINT
mapq	UTINYINT
mate_position	BIGINT
mate_reference	VARCHAR
position	BIGINT
read_id	VARCHAR
reference	VARCHAR
stop_position	BIGINT
tag_as	BIGINT
tag_md	VARCHAR
tag_nm	BIGINT
tag_sa	VARCHAR
tag_xg	BIGINT
tag_xm	BIGINT
tag_xn	BIGINT
tag_xo	BIGINT
tag_xs	BIGINT
tag_ys	BIGINT
tag_yt	VARCHAR
template_length	BIGINT

# --- ref_paths is required ---
statement error
SELECT * FROM align_sortmerna('smr_q');
----
ref_paths

# --- ref_paths must be non-empty ---
statement error
SELECT * FROM align_sortmerna('smr_q', ref_paths := []);
----
ref_paths

# --- Single-end forward: SAM flags + coords derived from AB271211 golden ---
# Same sequence / reference as align_sortmerna_rrna fwd test.
# Expected mapping: strand=1 → flags=0; ref_end=1446 → stop_position=1447.
statement ok
CREATE TABLE smr_fwd (read_id VARCHAR, sequence1 VARCHAR);

statement ok
INSERT INTO smr_fwd VALUES (
  'AB271211',
  ''
);

query IIIIIIIIII
SELECT read_id, flags, reference, position, stop_position, mapq, cigar,
       mate_reference, mate_position, template_length
FROM align_sortmerna(
    'smr_fwd', ref_paths := ['ext/sortmerna/data/test_ref.fasta'], num_threads := 1);
----
AB271211	0	Unc49508	1	1447	255	57S57M2I12M2D4M2I29M1D11M2I3M2D11M1I7M1D13M5D4M3D9M2D3M7D1260M	*	0	0

query II
SELECT tag_as, tag_nm
FROM align_sortmerna(
    'smr_fwd', ref_paths := ['ext/sortmerna/data/test_ref.fasta'], num_threads := 1);
----
2430	94

# Unused SAM tags (XS/YS/XN/XM/XO/XG/YT/MD/SA) must be NULL for sortmerna output.
query I
SELECT (tag_xs IS NULL) AND (tag_ys IS NULL) AND (tag_xn IS NULL)
   AND (tag_xm IS NULL) AND (tag_xo IS NULL) AND (tag_xg IS NULL)
   AND (tag_yt IS NULL) AND (tag_md IS NULL) AND (tag_sa IS NULL)
FROM align_sortmerna(
    'smr_fwd', ref_paths := ['ext/sortmerna/data/test_ref.fasta'], num_threads := 1);
----
true

# --- Reverse-complement read → flags & 0x10 set ---
statement ok
CREATE TABLE smr_rc (read_id VARCHAR, sequence1 VARCHAR);

statement ok
INSERT INTO smr_rc VALUES (
  'AB271211_rc',
  ''
);

query IIIII
SELECT flags, reference, position, stop_position, cigar
FROM align_sortmerna(
    'smr_rc', ref_paths := ['ext/sortmerna/data/test_ref.fasta'], num_threads := 1);
----
16	Unc49508	1	1447	57S57M2I12M2D4M2I29M1D11M2I3M2D11M1I7M1D13M5D4M3D9M2D3M7D1260M

# --- Paired-end: flags 0x1|0x2|0x40 for fwd, 0x1|0x2|0x80 for rev ---
# Both segments align to the same reference → proper-pair bit (0x2) set,
# mate_reference = "=", mate_position = partner's position.
statement ok
CREATE TABLE smr_pe (read_id VARCHAR, sequence1 VARCHAR, sequence2 VARCHAR);

statement ok
INSERT INTO smr_pe SELECT read_id, sequence1, sequence1 AS sequence2 FROM smr_fwd;

query IIIII
SELECT flags, reference, position, mate_reference, mate_position
FROM align_sortmerna(
    'smr_pe', ref_paths := ['ext/sortmerna/data/test_ref.fasta'],
    num_threads := 1, paired := true)
ORDER BY flags;
----
67	Unc49508	1	=	1
131	Unc49508	1	=	1

# --- Paired flag mismatch at bind ---
statement error
SELECT * FROM align_sortmerna(
    'smr_fwd', ref_paths := ['ext/sortmerna/data/test_ref.fasta'], paired := true);
----
paired

# --- Multi-batch streaming: same 3000-row cross-join as rrna test.
# Every row must emit exactly once with flags=0 (strand=1, unpaired) and
# identical ref/coords to confirm the streaming refill path preserves
# per-row SAM projection.
statement ok
CREATE TABLE smr_big AS
  SELECT 'r' || (range % 3000) AS read_id, sequence1
  FROM generate_series(0, 2999) AS t(range), smr_fwd;

query III
SELECT COUNT(*), COUNT(DISTINCT read_id), COUNT(*) FILTER (WHERE flags = 0)
FROM align_sortmerna(
    'smr_big', ref_paths := ['ext/sortmerna/data/test_ref.fasta'], num_threads := 1);
----
3000	3000	3000

query IIIII
SELECT COUNT(DISTINCT reference), COUNT(DISTINCT position),
       COUNT(DISTINCT stop_position), COUNT(DISTINCT tag_as),
       COUNT(DISTINCT tag_nm)
FROM align_sortmerna(
    'smr_big', ref_paths := ['ext/sortmerna/data/test_ref.fasta'], num_threads := 1);
----
1	1	1	1	1
