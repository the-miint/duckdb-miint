# ── The same oracle with an EXPLICIT anchor set, so the result does not depend on
#    the seeded draw agreeing between the two functions. ──

statement ok
CREATE TABLE pf_mh_x AS SELECT sample_id, axis, coordinate FROM progressive_pcoa_from_features('ft', 'morisita_horn',
    n_dims := 3, batch_size := 12, seed := 42, threads := 1,
    anchors := ['s000','s004','s008','s012','s016','s020','s024','s028','s032','s036']);

statement ok
CREATE TABLE pd_mh_x AS SELECT sample_id, axis, coordinate FROM progressive_pcoa_from_distances('cd_mh',
    n_dims := 3, batch_size := 12, seed := 42, threads := 1,
    anchors := ['s000','s004','s008','s012','s016','s020','s024','s028','s032','s036']);

query TT
SELECT max(abs(a.coordinate - b.coordinate)) = 0.0, count(*) = 120
FROM pf_mh_x a JOIN pd_mh_x b USING (sample_id, axis);
----
true	true

# ── A different batch_size changes which samples share a block. For a
#    pairwise-local metric the DISTANCES are unaffected, so this must still track
#    the matching from_distances run exactly. A metric that read its block would
#    drift here even though it matched at batch_size 12. ──

statement ok
CREATE TABLE pf_bray_b5 AS SELECT sample_id, axis, coordinate FROM progressive_pcoa_from_features('ft', 'bray_curtis', n_dims := 3, n_anchors := 15, batch_size := 5, seed := 42, threads := 1);

statement ok
CREATE TABLE pd_bray_b5 AS SELECT sample_id, axis, coordinate FROM progressive_pcoa_from_distances('cd_bray', n_dims := 3, n_anchors := 15, batch_size := 5, seed := 42, threads := 1);

query TT
SELECT max(abs(a.coordinate - b.coordinate)) = 0.0, count(*) = 120
FROM pf_bray_b5 a JOIN pd_bray_b5 b USING (sample_id, axis);
----
true	true

# ── Samples carrying no signal are dropped identically on both paths: the sparse
#    feature-table contract cannot tell an all-zero sample from an absent one. ──

statement ok
CREATE TABLE ft_hole AS
SELECT * FROM ft
UNION ALL
SELECT 'szzz' AS sample_id, 'F_01' AS feature_id, 0.0 AS value;

query I
SELECT count(DISTINCT sample_id) FROM progressive_pcoa_from_features('ft_hole', 'bray_curtis', n_dims := 3, n_anchors := 15, batch_size := 12, seed := 42, threads := 1);
----
40

# ══════════════════════════════════════════════════════════════════════════════
# CONCURRENCY — a wave's blocks are computed by several workers at once, each
# opening its own connection and reading the shared anchor-row cache read-only.
# Raising `threads` must change only how fast the run goes, never where the
# samples land. Compared as an ORDINATION rather than coordinate-for-coordinate:
# skbb's centering reduction sums in thread-count-dependent order, so the last
# bits legitimately move (see docs/diversity.md). batch_size := 5 gives 5 batches,
# so there is genuinely something for the workers to overlap.
# ══════════════════════════════════════════════════════════════════════════════

statement ok
CREATE TABLE pf_bray_t4 AS SELECT sample_id, axis, coordinate FROM progressive_pcoa_from_features('ft', 'bray_curtis', n_dims := 3, n_anchors := 15, batch_size := 5, seed := 42, threads := 4);

query T
SELECT DISTINCT m2 < 1e-9 FROM procrustes('pf_bray_b5', 'pf_bray_t4', permutations := 0);
----
true

query I
SELECT count(DISTINCT sample_id) FROM pf_bray_t4;
----
40

# ══════════════════════════════════════════════════════════════════════════════
# NEGATIVE ABUNDANCES — the two paths must still agree.
#
# Nothing rejects a negative value: the feature-table contract drops NULL, zero and
# NaN only. They are not biologically meaningful for a count table, but they are
# accepted input, and they are where a presence test or a denominator guard written
# as `!= 0` silently parts company with community_distances' `> 0` — including by
# emitting a NEGATIVE distance into the ordination. Measured before the guards were
# matched: this comparison read 1.019 instead of 0.0.
# ══════════════════════════════════════════════════════════════════════════════

statement ok
CREATE TABLE ft_neg AS
SELECT sample_id, feature_id,
       CASE WHEN (abs(hash(sample_id || feature_id)) % 5) = 0 THEN -value ELSE value END AS value
FROM ft;

statement ok
CREATE TABLE cd_neg AS SELECT * FROM community_distances('ft_neg', 'bray_curtis');

statement ok
CREATE TABLE pf_neg AS SELECT sample_id, axis, coordinate FROM progressive_pcoa_from_features('ft_neg', 'bray_curtis', n_dims := 3, n_anchors := 15, batch_size := 12, seed := 42, threads := 1);

statement ok
CREATE TABLE pd_neg AS SELECT sample_id, axis, coordinate FROM progressive_pcoa_from_distances('cd_neg', n_dims := 3, n_anchors := 15, batch_size := 12, seed := 42, threads := 1);

query TT
SELECT max(abs(a.coordinate - b.coordinate)) = 0.0, count(*) = 120
FROM pf_neg a JOIN pd_neg b USING (sample_id, axis);
----
true	true

statement ok
CREATE TABLE cd_neg_j AS SELECT * FROM community_distances('ft_neg', 'jaccard');

statement ok
CREATE TABLE pf_neg_j AS SELECT sample_id, axis, coordinate FROM progressive_pcoa_from_features('ft_neg', 'jaccard', n_dims := 3, n_anchors := 15, batch_size := 12, seed := 42, threads := 1);

statement ok
CREATE TABLE pd_neg_j AS SELECT sample_id, axis, coordinate FROM progressive_pcoa_from_distances('cd_neg_j', n_dims := 3, n_anchors := 15, batch_size := 12, seed := 42, threads := 1);

query TT
SELECT max(abs(a.coordinate - b.coordinate)) = 0.0, count(*) = 120
FROM pf_neg_j a JOIN pd_neg_j b USING (sample_id, axis);
----
true	true
