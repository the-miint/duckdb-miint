COPY (SELECT * FROM read_newick('data/newick/with_edge_ids.nwk'))
TO '{TEST_DIR}/compressed_placements.nwk.gz' (FORMAT NEWICK, PLACEMENTS 'single_placement');

query I
SELECT COUNT(*) FROM read_newick('{TEST_DIR}/compressed_placements.nwk.gz');
----
7

# =============================================================================
# View Support: PLACEMENTS can be a view (not just a table)
# =============================================================================

# Create a view that selects from the placements table
statement ok
CREATE VIEW placements_view AS
SELECT fragment_id, edge_id, like_weight_ratio, distal_length, pendant_length
FROM valid_placements;

# Using a view as PLACEMENTS should work
statement ok
COPY (SELECT * FROM read_newick('data/newick/with_edge_ids.nwk'))
TO '{TEST_DIR}/view_placements.nwk' (FORMAT NEWICK, PLACEMENTS 'placements_view');

# Verify the output is correct
query I
SELECT COUNT(*) FROM read_newick('{TEST_DIR}/view_placements.nwk');
----
9

# Verify both fragments from the view are present
query T
SELECT name FROM read_newick('{TEST_DIR}/view_placements.nwk')
WHERE name IN ('frag1', 'frag2') ORDER BY name;
----
frag1
frag2

statement ok
DROP VIEW placements_view;

# Create a more complex view with filtering
statement ok
CREATE VIEW filtered_placements_view AS
SELECT fragment_id, edge_id, like_weight_ratio, distal_length, pendant_length
FROM valid_placements
WHERE like_weight_ratio > 0.85;

statement ok
COPY (SELECT * FROM read_newick('data/newick/with_edge_ids.nwk'))
TO '{TEST_DIR}/filtered_view.nwk' (FORMAT NEWICK, PLACEMENTS 'filtered_placements_view');

# Only frag1 (lwr=0.95) should be included, not frag2 (lwr=0.80)
query I
SELECT COUNT(*) FROM read_newick('{TEST_DIR}/filtered_view.nwk');
----
7

query I
SELECT COUNT(*) FROM read_newick('{TEST_DIR}/filtered_view.nwk') WHERE name = 'frag1';
----
1

query I
SELECT COUNT(*) FROM read_newick('{TEST_DIR}/filtered_view.nwk') WHERE name = 'frag2';
----
0

statement ok
DROP VIEW filtered_placements_view;

# =============================================================================
# Integration: read_jplace -> PLACEMENTS workflow
# =============================================================================

# Create a table from jplace data that matches with_edge_ids.nwk tree
statement ok
CREATE TABLE jplace_style_placements AS
SELECT fragment_id, edge_id, like_weight_ratio, distal_length, pendant_length
FROM valid_placements;

statement ok
COPY (SELECT * FROM read_newick('data/newick/with_edge_ids.nwk'))
TO '{TEST_DIR}/jplace_workflow.nwk' (FORMAT NEWICK, PLACEMENTS 'jplace_style_placements');

query I
SELECT COUNT(*) FROM read_newick('{TEST_DIR}/jplace_workflow.nwk');
----
9

# Verify both fragments are present
query T
SELECT name FROM read_newick('{TEST_DIR}/jplace_workflow.nwk')
WHERE name IN ('frag1', 'frag2') ORDER BY name;
----
frag1
frag2

statement ok
DROP TABLE jplace_style_placements;

# =============================================================================
# fragment_id types
# =============================================================================

# fragment_id is a read id, so it takes the types read_id does (VARCHAR, BIGINT or UUID), as
# place_krepp's fragment column has, and the placed tip is named with its text.
statement ok
CREATE TABLE typed_placements AS
SELECT 42::BIGINT AS bigint_id, '00000000-0000-0000-0000-000000000042'::UUID AS uuid_id,
       edge_id, like_weight_ratio, distal_length, pendant_length
FROM single_placement;

statement ok
CREATE VIEW bigint_placements AS
SELECT bigint_id AS fragment_id, edge_id, like_weight_ratio, distal_length, pendant_length FROM typed_placements;

statement ok
COPY (SELECT * FROM read_newick('data/newick/with_edge_ids.nwk'))
TO '{TEST_DIR}/bigint_fragment.nwk' (FORMAT NEWICK, PLACEMENTS 'bigint_placements');

query T
SELECT name FROM read_newick('{TEST_DIR}/bigint_fragment.nwk') WHERE is_tip ORDER BY name;
----
42
A
B
C

statement ok
CREATE VIEW uuid_placements AS
SELECT uuid_id AS fragment_id, edge_id, like_weight_ratio, distal_length, pendant_length FROM typed_placements;

statement ok
COPY (SELECT * FROM read_newick('data/newick/with_edge_ids.nwk'))
TO '{TEST_DIR}/uuid_fragment.nwk' (FORMAT NEWICK, PLACEMENTS 'uuid_placements');

query T
SELECT name FROM read_newick('{TEST_DIR}/uuid_fragment.nwk') WHERE is_tip ORDER BY name;
----
00000000-0000-0000-0000-000000000042
A
B
C

# Any other type is refused when the COPY is planned.
statement ok
CREATE VIEW integer_placements AS
SELECT bigint_id::INTEGER AS fragment_id, edge_id, like_weight_ratio, distal_length, pendant_length
FROM typed_placements;

statement error
COPY (SELECT * FROM read_newick('data/newick/with_edge_ids.nwk'))
TO '{TEST_DIR}/integer_fragment.nwk' (FORMAT NEWICK, PLACEMENTS 'integer_placements');
----
Binder Error: Column 'fragment_id' in table 'integer_placements' must be VARCHAR, BIGINT, or UUID

statement ok
DROP VIEW integer_placements;

statement ok
DROP VIEW uuid_placements;

statement ok
DROP VIEW bigint_placements;

statement ok
DROP TABLE typed_placements;

# =============================================================================
# The placements are read when the COPY runs, not when it is planned
# =============================================================================

# A prepared COPY writes the placements as they are when it is executed, so a fragment added
# after PREPARE is in the tree.
statement ok
CREATE TABLE growing_placements AS SELECT * FROM single_placement;

statement ok
PREPARE copy_growing AS
COPY (SELECT * FROM read_newick('data/newick/with_edge_ids.nwk'))
TO '{TEST_DIR}/prepared_placements.nwk' (FORMAT NEWICK, PLACEMENTS 'growing_placements');

statement ok
INSERT INTO growing_placements VALUES ('late_frag', 1::BIGINT, 0.80::DOUBLE, 0.10::DOUBLE, 0.002::DOUBLE);

statement ok
EXECUTE copy_growing;

query T
SELECT name FROM read_newick('{TEST_DIR}/prepared_placements.nwk')
WHERE name IN ('single_frag', 'late_frag') ORDER BY name;
----
late_frag
single_frag

statement ok
DROP TABLE growing_placements;

# Planning the COPY reads no placement rows: EXPLAIN succeeds with a view whose rows cannot be
# read, and the COPY fails only when it runs.
statement ok
CREATE VIEW unreadable_placements AS
SELECT fragment_id, edge_id, like_weight_ratio, distal_length,
       CAST(error('placement rows were read') AS DOUBLE) AS pendant_length
FROM single_placement;

statement ok
EXPLAIN COPY (SELECT * FROM read_newick('data/newick/with_edge_ids.nwk'))
TO '{TEST_DIR}/explain_placements.nwk' (FORMAT NEWICK, PLACEMENTS 'unreadable_placements');

statement error
COPY (SELECT * FROM read_newick('data/newick/with_edge_ids.nwk'))
TO '{TEST_DIR}/unreadable_placements.nwk' (FORMAT NEWICK, PLACEMENTS 'unreadable_placements');
----
placement rows were read

statement ok
DROP VIEW unreadable_placements;

# The placement columns' types are checked again when the rows are read. A relation's types can
# change after the COPY is planned with no change to the catalog, so a prepared COPY is not bound
# again: here a view over a CSV file whose fragment_id changes type.
statement ok
COPY single_placement TO '{TEST_DIR}/changing_placements.csv';

statement ok
CREATE VIEW csv_placements AS SELECT * FROM read_csv('{TEST_DIR}/changing_placements.csv');

statement ok
PREPARE copy_csv AS
COPY (SELECT * FROM read_newick('data/newick/with_edge_ids.nwk'))
TO '{TEST_DIR}/csv_placements.nwk' (FORMAT NEWICK, PLACEMENTS 'csv_placements');

# A fragment_id that becomes another id type is read as the type it now has.
statement ok
COPY (SELECT 42 AS fragment_id, edge_id, like_weight_ratio, distal_length, pendant_length FROM single_placement)
TO '{TEST_DIR}/changing_placements.csv';

statement ok
EXECUTE copy_csv;

query T
SELECT name FROM read_newick('{TEST_DIR}/csv_placements.nwk') WHERE name = '42';
----
42

# One that becomes a type ids do not take is refused.
statement ok
COPY (SELECT 4.5 AS fragment_id, edge_id, like_weight_ratio, distal_length, pendant_length FROM single_placement)
TO '{TEST_DIR}/changing_placements.csv';

statement error
EXECUTE copy_csv;
----
<REGEX>:Invalid Input Error: Column 'fragment_id' in table 'csv_placements' must be VARCHAR, BIGINT, or UUID.*

# Every column is checked, not only the first: here like_weight_ratio becomes an integer.
statement ok
COPY (SELECT fragment_id, edge_id, 1 AS like_weight_ratio, distal_length, pendant_length FROM single_placement)
TO '{TEST_DIR}/changing_placements.csv';

statement error
EXECUTE copy_csv;
----
<REGEX>:Invalid Input Error: Column 'like_weight_ratio' in table 'csv_placements' must be DOUBLE or FLOAT.*

query I
SELECT 1;
----
1

statement ok
DROP VIEW csv_placements;

# =============================================================================
# Cleanup
# =============================================================================

statement ok
DROP TABLE valid_placements;

statement ok
DROP TABLE single_placement;
