# name: test/sql/read_newick_https.test
# description: Test read_newick from HTTP URL
# group: [sql]

# `make test` skips this file because httpfs is not linked into unittest;
# run_tests.sh runs it in its httpfs pass.

require miint

require httpfs

require-env MIINT_HTTPS_TEST_URL

# Newick via HTTP
query I
SELECT COUNT(*) FROM read_newick('${MIINT_HTTPS_TEST_URL}/newick/simple.nwk');
----
5

# Gzipped Newick via HTTP
query I
SELECT COUNT(*) FROM read_newick('${MIINT_HTTPS_TEST_URL}/newick/simple.nwk.gz');
----
5

