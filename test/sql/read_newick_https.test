# name: test/sql/read_newick_https.test
# description: Test read_newick from HTTP URL
# group: [sql]

# NOTE: Skipped in CI because httpfs is disabled at build time.
# Active coverage is in test/shell/read_https.sh (uses LOAD httpfs at runtime).

require miint

require httpfs

require-env MIINT_HTTPS_TEST_URL

# Newick via HTTP
query I
SELECT COUNT(*) FROM read_newick(getenv('MIINT_HTTPS_TEST_URL') || '/newick/simple.nwk');
----
5

# Gzipped Newick via HTTP
query I
SELECT COUNT(*) FROM read_newick(getenv('MIINT_HTTPS_TEST_URL') || '/newick/simple.nwk.gz');
----
5

