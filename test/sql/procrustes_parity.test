# name: test/sql/procrustes_parity.test
# description: procrustes parity vs SciPy (scipy.spatial.procrustes full + q2#338 numpy partial). Goldens SHA-pinned in data/procrustes/goldens.sha256; gate exported by run_tests.sh only when they match.
# group: [sql]

require miint

require-env MIINT_PROCRUSTES_PARITY_OK

# ── full_small: n=6, d=3 ──
statement ok
CREATE TABLE fs_ref AS SELECT * FROM read_csv('data/procrustes/full_small.reference.csv');

statement ok
CREATE TABLE fs_oth AS SELECT * FROM read_csv('data/procrustes/full_small.other.csv');

# every one of the 2*n*d = 36 transformed coordinates matches SciPy's
query I
WITH got AS (SELECT * FROM procrustes('fs_ref', 'fs_oth', permutations := 0)),
     exp AS (SELECT * FROM read_csv('data/procrustes/full_small.expected.csv'))
SELECT count(*) FROM got g JOIN exp e
  ON g.matrix = e.matrix AND g.sample_id = e.sample_id AND g.axis = e.axis
WHERE abs(g.coordinate - e.coordinate) < 1e-9;
----
36

# disparity matches SciPy's
query I
WITH got AS (SELECT DISTINCT m2 FROM procrustes('fs_ref', 'fs_oth', permutations := 0)),
     exp AS (SELECT m2 FROM read_csv('data/procrustes/full_small.m2.csv'))
SELECT count(*) FROM got g, exp e WHERE abs(g.m2 - e.m2) < 1e-12;
----
1

# ── full_reflect: n=8, d=3, includes a reflection (det R = -1) ──
statement ok
CREATE TABLE fr_ref AS SELECT * FROM read_csv('data/procrustes/full_reflect.reference.csv');

statement ok
CREATE TABLE fr_oth AS SELECT * FROM read_csv('data/procrustes/full_reflect.other.csv');

query I
WITH got AS (SELECT * FROM procrustes('fr_ref', 'fr_oth', permutations := 0)),
     exp AS (SELECT * FROM read_csv('data/procrustes/full_reflect.expected.csv'))
SELECT count(*) FROM got g JOIN exp e
  ON g.matrix = e.matrix AND g.sample_id = e.sample_id AND g.axis = e.axis
WHERE abs(g.coordinate - e.coordinate) < 1e-9;
----
48

query I
WITH got AS (SELECT DISTINCT m2 FROM procrustes('fr_ref', 'fr_oth', permutations := 0)),
     exp AS (SELECT m2 FROM read_csv('data/procrustes/full_reflect.m2.csv'))
SELECT count(*) FROM got g, exp e WHERE abs(g.m2 - e.m2) < 1e-12;
----
1

