# ── partial_anchored: 6 anchors + 4 extra in `other`, d=3 (q2#338 technique) ──
statement ok
CREATE TABLE pa_ref AS SELECT * FROM read_csv('data/procrustes/partial_anchored.reference.csv');

statement ok
CREATE TABLE pa_oth AS SELECT * FROM read_csv('data/procrustes/partial_anchored.other.csv');

statement ok
CREATE TABLE pa_pair AS SELECT * FROM read_csv('data/procrustes/partial_anchored.pairing.csv');

# (6 reference + 10 other) * 3 axes = 48 rows, all matching the numpy partial oracle
query I
WITH got AS (SELECT * FROM procrustes('pa_ref', 'pa_oth', pairing := 'pa_pair')),
     exp AS (SELECT * FROM read_csv('data/procrustes/partial_anchored.expected.csv'))
SELECT count(*) FROM got g JOIN exp e
  ON g.matrix = e.matrix AND g.sample_id = e.sample_id AND g.axis = e.axis
WHERE abs(g.coordinate - e.coordinate) < 1e-9;
----
48

# anchor disparity matches the oracle m2
query I
WITH got AS (SELECT DISTINCT m2 FROM procrustes('pa_ref', 'pa_oth', pairing := 'pa_pair')),
     exp AS (SELECT m2 FROM read_csv('data/procrustes/partial_anchored.m2.csv'))
SELECT count(*) FROM got g, exp e WHERE abs(g.m2 - e.m2) < 1e-12;
----
1

# partial case leaves the p-value NULL (q2 partial_procrustes runs no Monte Carlo test)
query T
SELECT DISTINCT pvalue IS NULL FROM procrustes('pa_ref', 'pa_oth', pairing := 'pa_pair');
----
true
